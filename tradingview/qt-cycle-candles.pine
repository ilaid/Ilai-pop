color  bullBody  = input.color(#26a69a, "עולה", group = GC, inline = "bu")
color  bullBord  = input.color(#26a69a, "", group = GC, inline = "bu")
color  bullWick  = input.color(#26a69a, "", group = GC, inline = "bu")
color  bearBody  = input.color(#ef5350, "יורד", group = GC, inline = "be")
color  bearBord  = input.color(#ef5350, "", group = GC, inline = "be")
color  bearWick  = input.color(#ef5350, "", group = GC, inline = "be")
