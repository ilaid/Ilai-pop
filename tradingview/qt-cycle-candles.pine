string clMode  = input.string("האפר", "SSMT closed", options = ["הצג", "האפר", "הסתר"], group = GM)
color  bearC   = input.color(#ef5350, "דובית", group = GM, inline = "sc")
color  bullC   = input.color(#26a69a, "שורית", group = GM, inline = "sc")
color  pairC   = input.color(#ff9800, "זוג", group = GM, inline = "sc")
color  clC     = input.color(color.gray, "closed", group = GM, inline = "sc")
int    smtW    = input.int(1, "עובי קו", minval = 1, maxval = 4, group = GM, inline = "sl")
string smtStyS = input.string("solid", "", options = ["solid", "dashed", "dotted"], group = GM, inline = "sl")
string smtSzS  = input.string("tiny", "גודל תווית", options = ["tiny", "small", "normal"], group = GM)

f_size(string s) => s == "tiny" ? size.tiny : s == "normal" ? size.normal : size.small
f_lstyle(string s) => s == "dashed" ? line.style_dashed : s == "solid" ? line.style_solid : line.style_dotted

// ════════════════════════════════════════════
// מיפוי מחזורים
// ════════════════════════════════════════════
f_cycId(string s) =>
    switch s
        CY0 => 0
        CY1 => 1
        CY2 => 2
        CY3 => 3
        CY4 => 4
        CY5 => 5
        CY6 => 6
        CY7 => 7
        => 8

// טווח הנתונים שממנו בונים את הנרות. אם הגרף גבוה יותר — משתמשים בגרף (קירוב, מסומן ~).
f_desTf(int c) =>
    switch c
        0 => "15S"
        1 => "1"
        2 => "30"
        3 => "60"
        4 => "60"
        5 => "60"
        => "D"

f_srcTf(int c) =>
    string d = f_desTf(c)
    timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(d) ? d : timeframe.period

f_autoTitle(int c) =>
    switch c
        0 => "22.5m · 5.625m"
        1 => "90m · 22.5m"
        2 => "Session · 90m"
        3 => "Day · 6H"
        4 => "Week · Days"
        5 => "Month · Weeks"
        6 => "Quarter · QQ"
        7 => "Year · Quarters"
        => "4Y · Years"

// ════════════════════════════════════════════
// חישובי זמן QT
// ════════════════════════════════════════════
f_dayNum(int y, int m, int d) => int(math.floor(timestamp("UTC", y, m, d, 0, 0) / 86400000))

// מחזיר [מפתח מיכל, אינדקס תת-מחזור 0..4, aux, חסום]
f_key(int c, int t) =>
    int h    = hour(t, TZ)
    int mi   = minute(t, TZ)
    int s    = second(t, TZ)
    int tsec = ((h + 6) % 24) * 3600 + mi * 60 + s          // שניות מתחילת יום המסחר (18:00)
    int t6   = t + 6 * 3600000                           // תאריך יום המסחר
    int y    = year(t6, TZ)
    int m    = month(t6, TZ)
    int d    = dayofmonth(t6, TZ)
    int dow  = dayofweek(t6, TZ)
    int dn   = f_dayNum(y, m, d)
    int wd   = dow == 1 ? 6 : dow - 2                       // שני=0 .. שישי=4, שבת=5, ראשון=6
    int key  = 0
    int slot = 0
    int aux  = 5
    bool blk = false
    if c == 0
        key  := dn * 100 + int(tsec / 1350)
        slot := int((tsec % 1350) / 337.5)
    else if c == 1
        key  := dn * 100 + int(tsec / 5400)
        slot := int((tsec % 5400) / 1350)
    else if c == 2
        key  := dn * 10 + int(tsec / 21600)
        slot := int((tsec % 21600) / 5400)
    else if c == 3
        key  := dn
        slot := int(tsec / 21600)
    else if c == 4
        key  := dn - wd
        slot := math.min(wd, 4)
        blk  := slot == 4                                    // 1H: שישי חסום תמיד
    else if c == 5
        int mon  = dn - wd
        int tueT = (mon + 1) * 86400000
        int ty   = year(tueT, "UTC")
        int tm   = month(tueT, "UTC")
        int td   = dayofmonth(tueT, "UTC")
        int thm  = month((mon + 3) * 86400000, "UTC")
        bool dead = tm != thm
        int wn   = int((td - 1) / 7) + 1
        key  := ty * 12 + tm - 1                            // החודש של יום שלישי
        slot := dead or wn >= 5 ? 4 : wn - 1                 // 4 = שבוע 5 / שבוע מת
        aux  := dead ? 0 : 5
        blk  := slot == 4 or (wn == 4 and wd >= 4)           // 4H: שבוע 5 / מת חסומים, שישי חסום רק בשבוע 4
    else if c == 6
        int q   = int((m - 1) / 3)
        int qs  = f_dayNum(y, q * 3 + 1, 1)
        int qe  = q == 3 ? f_dayNum(y + 1, 1, 1) : f_dayNum(y, q * 3 + 4, 1)
        int len = qe - qs
        int dd  = dn - qs
        key  := y * 4 + q
        // נר שהגבול נופל באמצעו שייך לרבע הבא
        slot := math.max(0, math.min(3, int(math.ceil((dd + 1) * 4.0 / len)) - 1))
    else if c == 7
        key  := y
        slot := int((m - 1) / 3)
    else
        int k = int(math.floor((y - 2023) / 4.0))
        key  := k
        slot := (y - 2023) - 4 * k
    [key, slot, aux, blk]

// בונה את נרות הרבעים של המיכל הנוכחי (רץ בתוך request.security)
f_agg(int c) =>
    var array<float> ao = array.new_float(5, na)
    var array<float> ah = array.new_float(5, na)
    var array<float> al = array.new_float(5, na)
    var array<float> ac = array.new_float(5, na)
    var int lastKey = na
    var int xAux    = 5
    [key, slot, aux, blk] = f_key(c, time)
    if na(lastKey) or key != lastKey
        ao.fill(na)
        ah.fill(na)
        al.fill(na)
        ac.fill(na)
        lastKey := key
        xAux    := 5
    if slot == 4
        xAux := aux
    if na(ao.get(slot))
        ao.set(slot, open)
        ah.set(slot, high)
        al.set(slot, low)
    else
        ah.set(slot, math.max(ah.get(slot), high))
        al.set(slot, math.min(al.get(slot), low))
    ac.set(slot, close)
    [key, slot, xAux,
     ao.get(0), ah.get(0), al.get(0), ac.get(0),
     ao.get(1), ah.get(1), al.get(1), ac.get(1),
     ao.get(2), ah.get(2), al.get(2), ac.get(2),
     ao.get(3), ah.get(3), al.get(3), ac.get(3),
     ao.get(4), ah.get(4), al.get(4), ac.get(4)]

// ════════════════════════════════════════════
// SMT — מנוע
// ════════════════════════════════════════════
// טווח החישוב של השבירות = הטווח שהמיכל שייך לו בטבלה (יום→15m, שבוע→1H, חודש→4H ...)
f_smtTf(int c) =>
    string d = switch c
        0 => "15S"
        1 => "1"
        2 => "5"
        3 => "15"
        4 => "60"
        5 => "240"
        6 => "D"
        7 => "W"
        => "M"
    timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(d) ? d : timeframe.period

// רץ על כל נכס בנפרד. לכל תת-מחזור סגור j שומר את הרמות שלו ואת הזמן הראשון שבו נלקחו
// פלט: [key, slot, tH0..3, tL0..3, tHC0..3, tLC0..3, sH0..3, sL0..3, sHC0..3, sLC0..3]
f_smtAgg(int c) =>
    var array<float> sH  = array.new_float(4, na)
    var array<float> sL  = array.new_float(4, na)
    var array<float> sHC = array.new_float(4, na)
    var array<float> sLC = array.new_float(4, na)
    var array<float> tH  = array.new_float(4, na)
    var array<float> tL  = array.new_float(4, na)
    var array<float> tHC = array.new_float(4, na)
    var array<float> tLC = array.new_float(4, na)
    var int lastKey = na
    [key, slot, aux, blk] = f_key(c, time)
    if na(lastKey) or key != lastKey
        sH.fill(na)
        sL.fill(na)
        sHC.fill(na)
        sLC.fill(na)
        tH.fill(na)
        tL.fill(na)
        tHC.fill(na)
        tLC.fill(na)
        lastKey := key
    if not blk and slot <= 3
        if slot > 0
            for j = 0 to slot - 1
                if not na(sH.get(j))
                    if na(tH.get(j)) and high > sH.get(j)
                        tH.set(j, time)
                    if na(tL.get(j)) and low < sL.get(j)
                        tL.set(j, time)
                    if na(tHC.get(j)) and close > sHC.get(j)
                        tHC.set(j, time)
                    if na(tLC.get(j)) and close < sLC.get(j)
                        tLC.set(j, time)
        if na(sH.get(slot))
            sH.set(slot, high)
            sL.set(slot, low)
            sHC.set(slot, close)
            sLC.set(slot, close)
        else
            sH.set(slot, math.max(sH.get(slot), high))
            sL.set(slot, math.min(sL.get(slot), low))
            sHC.set(slot, math.max(sHC.get(slot), close))
            sLC.set(slot, math.min(sLC.get(slot), close))
    array<float> out = array.from(float(key), float(slot))
    out.concat(tH)
    out.concat(tL)
    out.concat(tHC)
    out.concat(tLC)
    out.concat(sH)
    out.concat(sL)
    out.concat(sHC)
    out.concat(sLC)
    out

// kind: 0 = High (פתיל), 1 = Low (פתיל), 2 = סגירה גבוהה, 3 = סגירה נמוכה
f_t(array<float> A, int kind, int j)  => A.get(2 + kind * 4 + j)
f_lv(array<float> A, int kind, int j) => A.get(18 + kind * 4 + j)
f_valid(array<float> A, int key) => not na(A) and A.size() >= 34 and A.get(0) == key
f_minNa(float x, float y) => na(x) ? y : na(y) ? x : math.min(x, y)

// שבירה = לקיחה חלקית. a,b,c = 1,2,3 בשלישייה. c,d = 3,4 בזוג
f_partial(int grp, bool bear, bool a, bool b, bool c, bool d) =>
    grp == 1 ? (c != d) : bear ? ((a or b or c) and not (a and b)) : ((a or b) and not (a and b and c))
f_cons(int grp, bool bear, bool a, bool b, bool c, bool d) =>
    grp == 1 ? (c and d) : bear ? (a and b) : (a and b and c)
f_btime(int grp, bool bear, float ta, float tb, float tc, float td) =>
    grp == 1 ? f_minNa(tc, td) : bear ? f_minNa(f_minNa(ta, tb), tc) : f_minNa(ta, tb)

f_norm(string sym) =>
    string tk = str.contains(sym, ":") ? str.split(sym, ":").get(1) : sym
    tk := str.replace_all(tk, "1!", "")
    tk := str.replace_all(tk, "2!", "")
    tk == "M2K" ? "RTY" : str.length(tk) == 3 and str.startswith(tk, "M") ? str.substring(tk, 1) : tk

array<string> gNames = array.from(f_norm(tk1), f_norm(tk2), f_norm(tk3), f_norm(tk4))
string chartN = f_norm(syminfo.root)
int ci = chartN == gNames.get(0) ? 0 : chartN == gNames.get(1) ? 1 : chartN == gNames.get(2) ? 2 : use4 and chartN == gNames.get(3) ? 3 : -1

f_bit(int m, int i) => math.floor(m / array.from(1, 2, 4, 8).get(i)) % 2 == 1

// בוחר את השבירה הראשית: HSSMT > SSMT > SSMT closed, ואז האחרונה שנעשתה
// פלט: [rank, dir(0 דובי / 1 שורי), grp(0 שלישייה / 1 זוג), j, time, maskH, maskS, tag(0/1 all/2 core)]
f_smtEval(int key, int cur, array<float> A0, array<float> A1, array<float> A2, array<float> A3) =>
    array<float> best = array.new_float(0)
    bool v0 = f_valid(A0, key)
    bool v1 = f_valid(A1, key)
    bool v2 = f_valid(A2, key)
    bool v3 = use4 and f_valid(A3, key)
    int jmax = math.min(cur, 4) - 1
    if jmax >= 0
        for j = 0 to jmax
            for dir = 0 to 1
                for grp = 0 to 1
                    bool ok = grp == 0 ? (v0 and v1 and v2) : (v2 and v3)
                    if ok
                        bool bear = dir == 0
                        int kw = bear ? 0 : 1
                        int kc = bear ? 2 : 3
                        bool lvOk = grp == 0 ? (not na(f_lv(A0, kw, j)) and not na(f_lv(A1, kw, j)) and not na(f_lv(A2, kw, j))) : (not na(f_lv(A2, kw, j)) and not na(f_lv(A3, kw, j)))
                        if lvOk
                            float w0 = grp == 0 ? f_t(A0, kw, j) : na
                            float w1 = grp == 0 ? f_t(A1, kw, j) : na
                            float w2 = f_t(A2, kw, j)
                            float w3 = grp == 1 ? f_t(A3, kw, j) : na
                            float q0 = grp == 0 ? f_t(A0, kc, j) : na
                            float q1 = grp == 0 ? f_t(A1, kc, j) : na
                            float q2 = f_t(A2, kc, j)
                            float q3 = grp == 1 ? f_t(A3, kc, j) : na
                            array<bool> W  = array.from(not na(w0), not na(w1), not na(w2), not na(w3))
                            array<bool> CC = array.from(not na(q0), not na(q1), not na(q2), not na(q3))
                            bool cPart = f_partial(grp, bear, CC.get(0), CC.get(1), CC.get(2), CC.get(3))
                            bool cCons = f_cons(grp, bear, CC.get(0), CC.get(1), CC.get(2), CC.get(3))
                            bool wPart = f_partial(grp, bear, W.get(0), W.get(1), W.get(2), W.get(3))
                            int rank = -1
                            int tag = 0
                            float bt = na
                            if cPart
                                rank := 2
                                bt := f_btime(grp, bear, q0, q1, q2, q3)
                            else if wPart
                                rank := cCons ? 0 : 1
                                tag := cCons ? (grp == 0 and bear and not CC.get(2) ? 2 : 1) : 0
                                bt := f_btime(grp, bear, w0, w1, w2, w3)
                            if rank == 0 and clMode == "הסתר"
                                rank := -1
                            if rank >= 0 and not na(bt)
                                int mH = 0
                                int mS = 0
                                for i = 0 to 3
                                    // בשלישייה שורית YM לא נכתב בתווית
                                    bool inG = grp == 0 ? (i < 2 or (i == 2 and bear)) : i >= 2
                                    if inG
                                        int bit = array.from(1, 2, 4, 8).get(i)
                                        if CC.get(i)
                                            mH += bit
                                        else if W.get(i)
                                            mS += bit
                                bool better = true
                                if best.size() > 0
                                    better := rank > best.get(0) or (rank == best.get(0) and bt > best.get(4))
                                if better
                                    best := array.from(float(rank), float(dir), float(grp), float(j), bt, float(mH), float(mS), float(tag))
    best

// פלט לציור: [rank, dir, grp, j, slotשבירה, רמה לקו (na = רק תווית), maskH, maskS, tag]
f_brk(int c, int key, int cur, array<float> A0, array<float> A1, array<float> A2, array<float> A3) =>
    array<float> out = array.new_float(0)
    if smtOn
        array<float> best = f_smtEval(key, cur, A0, A1, A2, A3)
        if best.size() > 0
            int rank = int(best.get(0))
            bool bear = best.get(1) == 0
            int j = int(best.get(3))
            [bk, bslot, ba, bb] = f_key(c, int(best.get(4)))
            int mH = int(best.get(5))
            int mS = int(best.get(6))
            float lv = na
            // קו רק כשהנכס של הגרף חלק מהשבירה
            if ci >= 0 and (f_bit(mH, ci) or f_bit(mS, ci))
                array<float> AC = ci == 0 ? A0 : ci == 1 ? A1 : ci == 2 ? A2 : A3
                lv := f_lv(AC, rank == 2 ? (bear ? 2 : 3) : (bear ? 0 : 1), j)
            out := array.from(best.get(0), best.get(1), best.get(2), best.get(3), float(bslot), lv, best.get(5), best.get(6), best.get(7))
    out

f_maskTxt(string pre, int m) =>
    string s = ""
    for i = 0 to 3
        if f_bit(m, i)
            s := s == "" ? gNames.get(i) : s + " " + gNames.get(i)
    s == "" ? "" : pre + " " + s

// ════════════════════════════════════════════
// שמות לכל נר
// ════════════════════════════════════════════
f_fmt(float tradingSec, bool withSec) =>
    float r = tradingSec + 64800
    r := r >= 86400 ? r - 86400 : r
    int hh = int(r / 3600)
    int mm = int((r - hh * 3600) / 60)
    int ss = int(r - hh * 3600 - mm * 60)
    string base = str.format("{0,number,00}:{1,number,00}", hh, mm)
    withSec and ss != 0 ? base + str.format(":{0,number,00}", ss) : base

f_name(int c, int key, int i, int aux) =>
    string out = ""
    if c == 0
        out := f_fmt((key % 100) * 1350 + i * 337.5, true)
    else if c == 1
        out := f_fmt((key % 100) * 5400 + i * 1350, true)
    else if c == 2
        out := f_fmt((key % 10) * 21600 + i * 5400, false)
    else if c == 3
        out := array.from("Asia", "Lon", "AM", "PM").get(i)
    else if c == 4
        out := array.from("Mon", "Tue", "Wed", "Thu", "Fri").get(i)
    else if c == 5
        out := i < 4 ? "W" + str.tostring(i + 1) : aux == 0 ? "Dead" : "W5"
    else if c == 6
        int y   = int(math.floor(key / 4))
        int q   = key - 4 * y
        int qs  = f_dayNum(y, q * 3 + 1, 1)
        int qe  = q == 3 ? f_dayNum(y + 1, 1, 1) : f_dayNum(y, q * 3 + 4, 1)
        int st  = qs + int(math.floor(i * (qe - qs) / 4.0))
        int t   = st * 86400000
        out := str.format("{0}/{1}", dayofmonth(t, "UTC"), month(t, "UTC"))
    else if c == 7
        out := array.from("Jan-Mar", "Apr-Jun", "Jul-Sep", "Oct-Dec").get(i)
    else
        out := str.tostring(2023 + 4 * key + i)
    out

f_nSlots(int c, int cur, array<float> O) =>
    c == 4 ? (showFri ? 5 : 4) : c == 5 ? (not na(O.get(4)) or cur == 4 ? 5 : 4) : 4

// ════════════════════════════════════════════
// נתונים
// ════════════════════════════════════════════
int c1 = f_cycId(cs1)
int c2 = f_cycId(cs2)
int c3 = f_cycId(cs3)

[k1, s1, x1, o10, h10, l10, c10, o11, h11, l11, c11, o12, h12, l12, c12, o13, h13, l13, c13, o14, h14, l14, c14] = request.security(syminfo.tickerid, f_srcTf(c1), f_agg(c1), lookahead = barmerge.lookahead_on)
[k2, s2, x2, o20, h20, l20, c20, o21, h21, l21, c21, o22, h22, l22, c22, o23, h23, l23, c23, o24, h24, l24, c24] = request.security(syminfo.tickerid, f_srcTf(c2), f_agg(c2), lookahead = barmerge.lookahead_on)
[k3, s3, x3, o30, h30, l30, c30, o31, h31, l31, c31, o32, h32, l32, c32, o33, h33, l33, c33, o34, h34, l34, c34] = request.security(syminfo.tickerid, f_srcTf(c3), f_agg(c3), lookahead = barmerge.lookahead_on)

array<float> A10 = request.security(tk1, f_smtTf(c1), f_smtAgg(c1), lookahead = barmerge.lookahead_on)
array<float> A11 = request.security(tk2, f_smtTf(c1), f_smtAgg(c1), lookahead = barmerge.lookahead_on)
array<float> A12 = request.security(tk3, f_smtTf(c1), f_smtAgg(c1), lookahead = barmerge.lookahead_on)
array<float> A13 = request.security(tk4, f_smtTf(c1), f_smtAgg(c1), lookahead = barmerge.lookahead_on)
array<float> A20 = request.security(tk1, f_smtTf(c2), f_smtAgg(c2), lookahead = barmerge.lookahead_on)
array<float> A21 = request.security(tk2, f_smtTf(c2), f_smtAgg(c2), lookahead = barmerge.lookahead_on)
array<float> A22 = request.security(tk3, f_smtTf(c2), f_smtAgg(c2), lookahead = barmerge.lookahead_on)
array<float> A23 = request.security(tk4, f_smtTf(c2), f_smtAgg(c2), lookahead = barmerge.lookahead_on)
array<float> A30 = request.security(tk1, f_smtTf(c3), f_smtAgg(c3), lookahead = barmerge.lookahead_on)
array<float> A31 = request.security(tk2, f_smtTf(c3), f_smtAgg(c3), lookahead = barmerge.lookahead_on)
array<float> A32 = request.security(tk3, f_smtTf(c3), f_smtAgg(c3), lookahead = barmerge.lookahead_on)
array<float> A33 = request.security(tk4, f_smtTf(c3), f_smtAgg(c3), lookahead = barmerge.lookahead_on)

// טווח המחירים הנראה בגרף — לצורך מיקום מכווץ בפינה
var float visHi = na
var float visLo = na
if time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
    visHi := na(visHi) ? high : math.max(visHi, high)
    visLo := na(visLo) ? low  : math.min(visLo, low)

// ════════════════════════════════════════════
// ציור
// ════════════════════════════════════════════
var array<box>   gBoxes  = array.new<box>()
var array<line>  gLines  = array.new<line>()
var array<label> gLabels = array.new<label>()

f_y(float p, float hi, float lo, float yTop, float yBot) =>
    hi > lo ? yBot + (p - lo) / (hi - lo) * (yTop - yBot) : (yTop + yBot) / 2

f_draw(int c, string ttl, int x0, float yTop0, float yBot0, bool real, int key, int cur, int aux, array<float> O, array<float> H, array<float> L, array<float> C, array<float> brk) =>
    int n = f_nSlots(c, cur, O)
    float hi = na
    float lo = na
    for i = 0 to n - 1
        if not na(H.get(i))
            hi := na(hi) ? H.get(i) : math.max(hi, H.get(i))
            lo := na(lo) ? L.get(i) : math.min(lo, L.get(i))
    // במצב "מחירים אמיתיים" גבולות הסט = High/Low של המיכל, ולכן אין כיווץ
    float yTop = real and not na(hi) ? hi : yTop0
    float yBot = real and not na(lo) ? lo : yBot0
    int xEnd = x0 + n * (cw + cgap) - cgap
    color cClr = color.new(color.black, 100)
    for i = 0 to n - 1
        int left  = x0 + i * (cw + cgap)
        int right = left + cw
        int mid   = left + int(cw / 2)
        if not na(O.get(i)) and not na(hi)
            float o = O.get(i)
            float cl = C.get(i)
            bool  up    = cl >= o
            float yBT   = f_y(math.max(o, cl), hi, lo, yTop, yBot)
            float yBB   = f_y(math.min(o, cl), hi, lo, yTop, yBot)
            float yH    = f_y(H.get(i), hi, lo, yTop, yBot)
            float yL    = f_y(L.get(i), hi, lo, yTop, yBot)
            color wCol  = up ? bullWick : bearWick
            // פתיל עליון ותחתון בנפרד — לא עובר דרך הגוף (חשוב לנרות חלולים)
            if yH > yBT
                gLines.push(line.new(mid, yH, mid, yBT, color = wCol, width = wickW))
            if yL < yBB
                gLines.push(line.new(mid, yBB, mid, yL, color = wCol, width = wickW))
            gBoxes.push(box.new(left, yBT, right, yBB, border_color = up ? bullBord : bearBord, bgcolor = up ? bullBody : bearBody, border_width = bordW))
        else if showEmpty
            gBoxes.push(box.new(left, yTop, right, yBot, border_color = emptyCol, bgcolor = cClr, border_style = line.style_dotted, border_width = 1))
        string qtxt = i < 4 ? "Q" + str.tostring(i + 1) : "·"
        string txt  = showNames ? qtxt + "\n" + f_name(c, key, i, aux) : qtxt
        gLabels.push(label.new(mid, yBot, txt, color = cClr, textcolor = txtCol, style = label.style_label_up, size = f_size(txtSzS)))
    bool approx = f_srcTf(c) != f_desTf(c)
    string head = (ttl == "" ? f_autoTitle(c) : ttl) + (approx ? " ~" : "")
    gLabels.push(label.new(int((x0 + xEnd) / 2), yTop, head, color = cClr, textcolor = ttlCol, style = label.style_label_down, size = f_size(ttlSzS)))
    if showHL and not na(hi)
        gLines.push(line.new(x0, yTop, xEnd, yTop, color = hlCol, style = f_lstyle(hlStyS)))
        gLines.push(line.new(x0, yBot, xEnd, yBot, color = hlCol, style = f_lstyle(hlStyS)))
        if showHLPx
            gLabels.push(label.new(xEnd, yTop, "H " + str.tostring(hi, format.mintick), color = cClr, textcolor = hlCol, style = label.style_label_left, size = size.tiny))
            gLabels.push(label.new(xEnd, yBot, "L " + str.tostring(lo, format.mintick), color = cClr, textcolor = hlCol, style = label.style_label_left, size = size.tiny))
    // שבירה ראשית
    if brk.size() > 0 and not na(hi)
        int  rank = int(brk.get(0))
        bool bear = brk.get(1) == 0
        int  grp  = int(brk.get(2))
        int  j    = int(brk.get(3))
        int  b    = int(brk.get(4))
        float lv  = brk.get(5)
        int  tag  = int(brk.get(8))
        if b < n
            color col = rank == 0 and clMode == "האפר" ? clC : grp == 1 ? pairC : bear ? bearC : bullC
            string typ = rank == 2 ? "HSSMT" : rank == 1 ? "SSMT" : tag == 2 ? "SSMT (core closed)" : "SSMT (all closed)"
            string hT = f_maskTxt("H", int(brk.get(6)))
            string sT = f_maskTxt("S", int(brk.get(7)))
            string asT = hT == "" ? sT : sT == "" ? hT : hT + " " + sT
            int xj = x0 + j * (cw + cgap) + int(cw / 2)
            int xb = x0 + b * (cw + cgap) + int(cw / 2)
            float y = na
            if not na(lv)
                y := f_y(lv, hi, lo, yTop, yBot)
                gLines.push(line.new(xj, y, xb, y, color = col, width = smtW, style = f_lstyle(smtStyS)))
            else
                float pb = bear ? H.get(b) : L.get(b)
                y := na(pb) ? (bear ? yTop : yBot) : f_y(pb, hi, lo, yTop, yBot)
            gLabels.push(label.new(xb, y, typ + "\n" + asT, color = cClr, textcolor = col, style = bear ? label.style_label_down : label.style_label_up, size = f_size(smtSzS)))
    xEnd

if barstate.islast
    for b in gBoxes
        b.delete()
    for l in gLines
        l.delete()
    for lb in gLabels
        lb.delete()
    gBoxes.clear()
    gLines.clear()
    gLabels.clear()

    float vh  = na(visHi) ? high : visHi
    float vl  = na(visLo) ? low  : visLo
    float rng = math.max(vh - vl, syminfo.mintick * 10)
    float bandH = rng * heightPct / 100
    float vgap  = rng * vgapPct / 100
    float marg  = rng * marginPct / 100

    int nAct = (en1 ? 1 : 0) + (en2 ? 1 : 0) + (en3 ? 1 : 0)
    bool real = vpos == "מחירים אמיתיים"
    bool vert = setLayout == "אחד מתחת לשני" and not real
    float totalH = vert ? nAct * bandH + math.max(nAct - 1, 0) * vgap : bandH
    float top0 = switch vpos
        "פינה למעלה" => vh - marg
        "פינה למטה"  => vl + marg + totalH
        "פינה באמצע" => (vh + vl) / 2 + totalH / 2
        => close + totalH / 2

    int x = bar_index + offBars
    int j = 0
    if en1
        float yT = top0 - (vert ? j * (bandH + vgap) : 0)
        int xe = f_draw(c1, tt1, x, yT, yT - bandH, real, k1, s1, x1, array.from(o10, o11, o12, o13, o14), array.from(h10, h11, h12, h13, h14), array.from(l10, l11, l12, l13, l14), array.from(c10, c11, c12, c13, c14), f_brk(c1, k1, s1, A10, A11, A12, A13))
        x := vert ? x : xe + sgap
        j += 1
    if en2
        float yT = top0 - (vert ? j * (bandH + vgap) : 0)
        int xe = f_draw(c2, tt2, x, yT, yT - bandH, real, k2, s2, x2, array.from(o20, o21, o22, o23, o24), array.from(h20, h21, h22, h23, h24), array.from(l20, l21, l22, l23, l24), array.from(c20, c21, c22, c23, c24), f_brk(c2, k2, s2, A20, A21, A22, A23))
        x := vert ? x : xe + sgap
        j += 1
    if en3
        float yT = top0 - (vert ? j * (bandH + vgap) : 0)
        f_draw(c3, tt3, x, yT, yT - bandH, real, k3, s3, x3, array.from(o30, o31, o32, o33, o34), array.from(h30, h31, h32, h33, h34), array.from(l30, l31, l32, l33, l34), array.from(c30, c31, c32, c33, c34), f_brk(c3, k3, s3, A30, A31, A32, A33))
