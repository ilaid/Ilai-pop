bool   smtOn   = input.bool(true, "הצג שבירה ראשית", group = GM)
string tk1     = input.symbol("CME_MINI:MNQ1!", "נכס 1 (חזק)", group = GM)
string tk2     = input.symbol("CME_MINI:MES1!", "נכס 2 (חזק)", group = GM)
string tk3     = input.symbol("CBOT_MINI:MYM1!", "נכס 3 (חלש)", group = GM)
