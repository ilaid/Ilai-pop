//@version=5
indicator("SSMT + HSSMT | Quarterly Theory", overlay = true, max_labels_count = 20, max_lines_count = 20)

// ═══════════════════════════════════════════════════════════════════
// הגדרות משתמש
// ═══════════════════════════════════════════════════════════════════

grpSym = "סימבולים"
useMicro  = input.bool(false, "השתמש בחוזי מיקרו", group = grpSym)
symNQ_std = input.symbol("CME_MINI:NQ1!",  "NQ רגיל", group = grpSym)
symES_std = input.symbol("CME_MINI:ES1!",  "ES רגיל", group = grpSym)
symYM_std = input.symbol("CBOT_MINI:YM1!", "YM רגיל", group = grpSym)
symNQ_mic = input.symbol("CME_MINI:MNQ1!",  "NQ מיקרו", group = grpSym)
symES_mic = input.symbol("CME_MINI:MES1!",  "ES מיקרו", group = grpSym)
symYM_mic = input.symbol("CBOT_MINI:MYM1!", "YM מיקרו", group = grpSym)

grpVis = "תצוגה"
colBull    = input.color(#26a69a, "צבע שורי", group = grpVis)
colBear    = input.color(#ef5350, "צבע דובי", group = grpVis)
labelSize  = input.string("small", "גודל תווית", options = ["tiny", "small", "normal"], group = grpVis)
offsetMlt  = input.float(0.6, "מרחק התווית מהנר (ATR)", minval = 0.1, maxval = 3.0, step = 0.1, group = grpVis)
showLine   = input.bool(true, "הצג קו שבירה", group = grpVis)
lineWidth  = input.int(2, "עובי קו", minval = 1, maxval = 4, group = grpVis)
showDebug  = input.bool(false, "הצג טבלת בדיקה", group = grpVis)

grpLogic = "לוגיקה"
requireTrueOpen = input.bool(false, "סנן לפי True Open (פרימיום/דיסקאונט)", group = grpLogic)
blockDeadWeek   = input.bool(true, "חסום שבירות בשבוע מת (4H בלבד)", group = grpLogic)

// ═══════════════════════════════════════════════════════════════════
// בחירת סימבולים
// ═══════════════════════════════════════════════════════════════════

sNQ = useMicro ? symNQ_mic : symNQ_std
sES = useMicro ? symES_mic : symES_std
sYM = useMicro ? symYM_mic : symYM_std

// ═══════════════════════════════════════════════════════════════════
// זיהוי Timeframe
// ═══════════════════════════════════════════════════════════════════

tfMin   = timeframe.in_seconds() / 60
tfClass = tfMin <= 1 ? 1 : tfMin <= 5 ? 2 : tfMin <= 15 ? 3 : tfMin <= 60 ? 4 : tfMin <= 240 ? 5 : 0

// ═══════════════════════════════════════════════════════════════════
// חישובי זמן EST
// ═══════════════════════════════════════════════════════════════════

TZ = "America/New_York"
estHour = hour(time, TZ)
estMin  = minute(time, TZ)

minutesOfDay = estHour * 60 + estMin

isPostOpen       = minutesOfDay >= 1080
minsFromDayStart = isPostOpen ? minutesOfDay - 1080 : minutesOfDay + 360

tradeDayTime = isPostOpen ? time + 86400000 : time
tdYear = year(tradeDayTime, TZ)
tdMon  = month(tradeDayTime, TZ)
tdDom  = dayofmonth(tradeDayTime, TZ)
tdDow  = dayofweek(tradeDayTime, TZ)

sessionIdx    = math.floor(minsFromDayStart / 360)
minsInSession = minsFromDayStart % 360
microIdx      = math.floor(minsInSession / 90)
minsInMicro   = minsInSession % 90
quarterIdx    = math.floor(minsInMicro / 22.5)

// ═══════════════════════════════════════════════════════════════════
// מספור שבועות לפי QT
// ═══════════════════════════════════════════════════════════════════

daysSinceMonday = tdDow == dayofweek.sunday ? 6 : tdDow - 2
mondayTime      = tradeDayTime - daysSinceMonday * 86400000
fridayTime      = mondayTime + 4 * 86400000

monMonth = month(mondayTime, TZ)
monDom   = dayofmonth(mondayTime, TZ)
monYear  = year(mondayTime, TZ)
friMonth = month(fridayTime, TZ)

isDeadWeek = monMonth != friMonth
qtWeekNum  = isDeadWeek ? 0 : math.floor((monDom - 1) / 7) + 1

// ═══════════════════════════════════════════════════════════════════
// מזהי מחזורים
// ═══════════════════════════════════════════════════════════════════

tradeDayId = tdYear * 10000 + tdMon * 100 + tdDom
weekId     = monYear * 10000 + monMonth * 100 + monDom
monthId    = tdYear * 100 + tdMon
sessionId  = tradeDayId * 10 + sessionIdx
microId    = sessionId * 10 + microIdx
quarterId  = microId * 10 + quarterIdx

refCycleId = 0
if tfClass == 5
    refCycleId := weekId
else if tfClass == 4
    refCycleId := tradeDayId
else if tfClass == 3
    refCycleId := sessionId
else if tfClass == 2
    refCycleId := microId
else if tfClass == 1
    refCycleId := quarterId

lifeCycleId = 0
if tfClass == 5
    lifeCycleId := monthId
else if tfClass == 4
    lifeCycleId := weekId
else if tfClass == 3
    lifeCycleId := tradeDayId
else if tfClass == 2
    lifeCycleId := sessionId
else if tfClass == 1
    lifeCycleId := microId

newRefCycle  = ta.change(refCycleId)  != 0
newLifeCycle = ta.change(lifeCycleId) != 0

// בטיימפריימים תוך-יומיים (15M/5M/1M) רמת הייחוס מתאפסת בגבול המיכל,
// כך שהיחידה הראשונה בכל מיכל לא מסתכלת אחורה למיכל הקודם.
resetRef = newLifeCycle and (tfClass == 1 or tfClass == 2 or tfClass == 3)

// ═══════════════════════════════════════════════════════════════════
// True Open
// ═══════════════════════════════════════════════════════════════════

inMonthlyQ2 = qtWeekNum == 2
inWeeklyQ2  = tdDow == dayofweek.tuesday
inDailyQ2   = minsFromDayStart >= 360 and minsFromDayStart < 720
inSessionQ2 = microIdx == 1
inMicroQ2   = quarterIdx == 1

var bool pMonQ2 = false
var bool pWkQ2  = false
var bool pDayQ2 = false
var bool pSesQ2 = false
var bool pMicQ2 = false

isTrueOpenBar = false
if tfClass == 5
    isTrueOpenBar := inMonthlyQ2 and not pMonQ2
else if tfClass == 4
    isTrueOpenBar := inWeeklyQ2 and not pWkQ2
else if tfClass == 3
    isTrueOpenBar := inDailyQ2 and not pDayQ2
else if tfClass == 2
    isTrueOpenBar := inSessionQ2 and not pSesQ2
else if tfClass == 1
    isTrueOpenBar := inMicroQ2 and not pMicQ2

pMonQ2 := inMonthlyQ2
pWkQ2  := inWeeklyQ2
pDayQ2 := inDailyQ2
pSesQ2 := inSessionQ2
pMicQ2 := inMicroQ2

var float trueOpenPrice = na
if isTrueOpenBar
    trueOpenPrice := open

// ═══════════════════════════════════════════════════════════════════
// משיכת נתוני שלושת הנכסים
// ═══════════════════════════════════════════════════════════════════

[nqH, nqL, nqC] = request.security(sNQ, timeframe.period, [high, low, close], lookahead = barmerge.lookahead_off)
[esH, esL, esC] = request.security(sES, timeframe.period, [high, low, close], lookahead = barmerge.lookahead_off)
[ymH, ymL, ymC] = request.security(sYM, timeframe.period, [high, low, close], lookahead = barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════
// צבירת מחזור + bar_index של הנר שקבע כל רמה
// ═══════════════════════════════════════════════════════════════════

// NQ
var float nqCH = na
var float nqCL = na
var float nqCHC = na
var float nqCLC = na
var int   nqCHb = 0
var int   nqCLb = 0
var int   nqCHCb = 0
var int   nqCLCb = 0
var float nqRH = na
var float nqRL = na
var float nqRHC = na
var float nqRLC = na
var int   nqRHb = 0
var int   nqRLb = 0
var int   nqRHCb = 0
var int   nqRLCb = 0

if newRefCycle
    if resetRef
        nqRH := na
        nqRL := na
        nqRHC := na
        nqRLC := na
        nqRHb := 0
        nqRLb := 0
        nqRHCb := 0
        nqRLCb := 0
    else
        nqRH := nqCH
        nqRL := nqCL
        nqRHC := nqCHC
        nqRLC := nqCLC
        nqRHb := nqCHb
        nqRLb := nqCLb
        nqRHCb := nqCHCb
        nqRLCb := nqCLCb
    nqCH := nqH
    nqCL := nqL
    nqCHC := nqC
    nqCLC := nqC
    nqCHb := bar_index
    nqCLb := bar_index
    nqCHCb := bar_index
    nqCLCb := bar_index
else
    if na(nqCH) or nqH > nqCH
        nqCH := nqH
        nqCHb := bar_index
    if na(nqCL) or nqL < nqCL
        nqCL := nqL
        nqCLb := bar_index
    if na(nqCHC) or nqC > nqCHC
        nqCHC := nqC
        nqCHCb := bar_index
    if na(nqCLC) or nqC < nqCLC
        nqCLC := nqC
        nqCLCb := bar_index

// ES
var float esCH = na
var float esCL = na
var float esCHC = na
var float esCLC = na
var int   esCHb = 0
var int   esCLb = 0
var int   esCHCb = 0
var int   esCLCb = 0
var float esRH = na
var float esRL = na
var float esRHC = na
var float esRLC = na
var int   esRHb = 0
var int   esRLb = 0
var int   esRHCb = 0
var int   esRLCb = 0

if newRefCycle
    if resetRef
        esRH := na
        esRL := na
        esRHC := na
        esRLC := na
        esRHb := 0
        esRLb := 0
        esRHCb := 0
        esRLCb := 0
    else
        esRH := esCH
        esRL := esCL
        esRHC := esCHC
        esRLC := esCLC
        esRHb := esCHb
        esRLb := esCLb
        esRHCb := esCHCb
        esRLCb := esCLCb
    esCH := esH
    esCL := esL
    esCHC := esC
    esCLC := esC
    esCHb := bar_index
    esCLb := bar_index
    esCHCb := bar_index
    esCLCb := bar_index
else
    if na(esCH) or esH > esCH
        esCH := esH
        esCHb := bar_index
    if na(esCL) or esL < esCL
        esCL := esL
        esCLb := bar_index
    if na(esCHC) or esC > esCHC
        esCHC := esC
        esCHCb := bar_index
    if na(esCLC) or esC < esCLC
        esCLC := esC
        esCLCb := bar_index

// YM
var float ymCH = na
var float ymCL = na
var float ymCHC = na
var float ymCLC = na
var int   ymCHb = 0
var int   ymCLb = 0
var int   ymCHCb = 0
var int   ymCLCb = 0
var float ymRH = na
var float ymRL = na
var float ymRHC = na
var float ymRLC = na
var int   ymRHb = 0
var int   ymRLb = 0
var int   ymRHCb = 0
var int   ymRLCb = 0

if newRefCycle
    if resetRef
        ymRH := na
        ymRL := na
        ymRHC := na
        ymRLC := na
        ymRHb := 0
        ymRLb := 0
        ymRHCb := 0
        ymRLCb := 0
    else
        ymRH := ymCH
        ymRL := ymCL
        ymRHC := ymCHC
        ymRLC := ymCLC
        ymRHb := ymCHb
        ymRLb := ymCLb
        ymRHCb := ymCHCb
        ymRLCb := ymCLCb
    ymCH := ymH
    ymCL := ymL
    ymCHC := ymC
    ymCLC := ymC
    ymCHb := bar_index
    ymCLb := bar_index
    ymCHCb := bar_index
    ymCLCb := bar_index
else
    if na(ymCH) or ymH > ymCH
        ymCH := ymH
        ymCHb := bar_index
    if na(ymCL) or ymL < ymCL
        ymCL := ymL
        ymCLb := bar_index
    if na(ymCHC) or ymC > ymCHC
        ymCHC := ymC
        ymCHCb := bar_index
    if na(ymCLC) or ymC < ymCLC
        ymCLC := ymC
        ymCLCb := bar_index

// ═══════════════════════════════════════════════════════════════════
// דגלי "לקיחה" מצטברים לאורך מחזור הייחוס (לזיהוי שבירות חדשות)
// ─ פתיל: מתעדכן תוך-נרי
// ─ סגירה: מתעדכן רק בסגירת נר
// ═══════════════════════════════════════════════════════════════════

var bool nqTkHi  = false
var bool nqTkLo  = false
var bool nqTkCHi = false
var bool nqTkCLo = false
var bool esTkHi  = false
var bool esTkLo  = false
var bool esTkCHi = false
var bool esTkCLo = false
var bool ymTkHi  = false
var bool ymTkLo  = false
var bool ymTkCHi = false
var bool ymTkCLo = false

if newRefCycle
    nqTkHi  := false
    nqTkLo  := false
    nqTkCHi := false
    nqTkCLo := false
    esTkHi  := false
    esTkLo  := false
    esTkCHi := false
    esTkCLo := false
    ymTkHi  := false
    ymTkLo  := false
    ymTkCHi := false
    ymTkCLo := false

nqTkHi := nqTkHi or (not na(nqRH) and nqH > nqRH)
nqTkLo := nqTkLo or (not na(nqRL) and nqL < nqRL)
esTkHi := esTkHi or (not na(esRH) and esH > esRH)
esTkLo := esTkLo or (not na(esRL) and esL < esRL)
ymTkHi := ymTkHi or (not na(ymRH) and ymH > ymRH)
ymTkLo := ymTkLo or (not na(ymRL) and ymL < ymRL)

if barstate.isconfirmed
    nqTkCHi := nqTkCHi or (not na(nqRHC) and nqC > nqRHC)
    nqTkCLo := nqTkCLo or (not na(nqRLC) and nqC < nqRLC)
    esTkCHi := esTkCHi or (not na(esRHC) and esC > esRHC)
    esTkCLo := esTkCLo or (not na(esRLC) and esC < esRLC)
    ymTkCHi := ymTkCHi or (not na(ymRHC) and ymC > ymRHC)
    ymTkCLo := ymTkCLo or (not na(ymRLC) and ymC < ymRLC)

// ═══════════════════════════════════════════════════════════════════
// מוכנות נתונים + חסימת שבוע מת (4H בלבד)
// ═══════════════════════════════════════════════════════════════════

dataReady = not na(nqRH) and not na(esRH) and not na(ymRH) and not na(nqRL) and not na(esRL) and not na(ymRL) and not na(nqRHC) and not na(esRHC) and not na(ymRHC) and not na(nqRLC) and not na(esRLC) and not na(ymRLC)

var bool refDeadWk = false
if newRefCycle
    refDeadWk := isDeadWeek[1]

weekBlocked = tfClass == 5 and blockDeadWeek and (isDeadWeek or refDeadWk)
cycleOK   = not weekBlocked
baseOK    = dataReady and cycleOK

// ═══════════════════════════════════════════════════════════════════
// זיהוי סטיות — חוק YM אסימטרי
// ─ דובי (גבוהים): הליבה היא NQ מול ES. YM חלש וצפוי לא לקחת גבוה,
//   לכן: אם *שני* החזקים לקחו → הם מסכימים → אין סטייה. YM לבד = חזק.
// ─ שורי (נמוכים): YM חלש ומוביל למטה, לקיחתו צפויה ומושמטת.
//   נדרש ש-NQ *או* ES ייקח, ומתבטל כששניהם לקחו.
// ═══════════════════════════════════════════════════════════════════

anyTkHi  = nqTkHi  or esTkHi  or ymTkHi
anyTkCHi = nqTkCHi or esTkCHi or ymTkCHi

divWBear = baseOK and anyTkHi  and not (nqTkHi  and esTkHi)
divCBear = baseOK and anyTkCHi and not (nqTkCHi and esTkCHi)
divWBull = baseOK and (nqTkLo  or esTkLo)  and not (nqTkLo  and esTkLo  and ymTkLo)
divCBull = baseOK and (nqTkCLo or esTkCLo) and not (nqTkCLo and esTkCLo and ymTkCLo)

// SSMT נפסל אם הנכסים סגרו לאותו כיוון (הפך למהלך סגירה מלא)
// דובי: מספיק ששני החזקים סגרו (YM חסר-חשיבות בגבוהים).
// שורי: נדרשים כל השלושה (כולל YM) כדי לבטל.
validWBear = divWBear and not (nqTkCHi and esTkCHi)
validWBull = divWBull and not (nqTkCLo and esTkCLo and ymTkCLo)

bearOK = not requireTrueOpen or (not na(trueOpenPrice) and close > trueOpenPrice)
bullOK = not requireTrueOpen or (not na(trueOpenPrice) and close < trueOpenPrice)

// שבירות 4H ו-1H לא נוצרות ביום שישי (סוף השבוע המסחרי לפי QT)
friBlock = (tfClass == 5 or tfClass == 4) and tdDow == dayofweek.friday

// ═══════════════════════════════════════════════════════════════════
// מחרוזת נכסים — בשורי YM מושמט
// ═══════════════════════════════════════════════════════════════════

f_str(bNQ, bES, bYM, isBull) =>
    s = ""
    s := bNQ ? s + "NQ " : s
    s := bES ? s + "ES " : s
    s := (bYM and not isBull) ? s + "YM " : s
    str.trim(s)

// ═══════════════════════════════════════════════════════════════════
// רמות וברים לפי הנכס שעל הגרף
// ═══════════════════════════════════════════════════════════════════

cs = syminfo.tickerid
isNQc = str.contains(cs, "NQ")
isESc = str.contains(cs, "ES")
isYMc = str.contains(cs, "YM")

mRH  = isNQc ? nqRH  : isESc ? esRH  : isYMc ? ymRH  : na
mRL  = isNQc ? nqRL  : isESc ? esRL  : isYMc ? ymRL  : na
mRHC = isNQc ? nqRHC : isESc ? esRHC : isYMc ? ymRHC : na
mRLC = isNQc ? nqRLC : isESc ? esRLC : isYMc ? ymRLC : na

mRHb  = isNQc ? nqRHb  : isESc ? esRHb  : isYMc ? ymRHb  : 0
mRLb  = isNQc ? nqRLb  : isESc ? esRLb  : isYMc ? ymRLb  : 0
mRHCb = isNQc ? nqRHCb : isESc ? esRHCb : isYMc ? ymRHCb : 0
mRLCb = isNQc ? nqRLCb : isESc ? esRLCb : isYMc ? ymRLCb : 0

// ═══════════════════════════════════════════════════════════════════
// מצב מבוסס אירוע
// ═══════════════════════════════════════════════════════════════════

atr = ta.atr(14)

var int    bearType = 0
var string bearStr  = ""
var float  bearLvl  = na
var int    bearRefB = 0
var int    bearSigB = 0
var float  bearYPos = na
var int    bearSeq  = 0
// רמות ייחוס קפואות ומעקב אחרי הנכס המפגר (NQ/ES) לאורך כל חיי השבירה
var float  bearWFrozNQ = na
var float  bearWFrozES = na
var float  bearCFrozNQ = na
var float  bearCFrozES = na
var bool   bearWTkNQ = false
var bool   bearWTkES = false
var bool   bearCTkNQ = false
var bool   bearCTkES = false

var int    bullType = 0
var string bullStr  = ""
var float  bullLvl  = na
var int    bullRefB = 0
var int    bullSigB = 0
var float  bullYPos = na
var int    bullSeq  = 0
var float  bullWFrozNQ = na
var float  bullWFrozES = na
var float  bullWFrozYM = na
var float  bullCFrozNQ = na
var float  bullCFrozES = na
var float  bullCFrozYM = na
var bool   bullWTkNQ = false
var bool   bullWTkES = false
var bool   bullWTkYM = false
var bool   bullCTkNQ = false
var bool   bullCTkES = false
var bool   bullCTkYM = false

var int seqCounter = 0

// ── פקיעת מחזור־על — מוחקת הכול ──
if newLifeCycle
    bearType := 0
    bullType := 0
    bearStr  := ""
    bullStr  := ""

// ── עדכון מעקב מול הרמות הקפואות + ביטול לפי השלמת הנכס המפגר ──
// דובי: מת כששני החזקים (NQ+ES) לקחו את אותה רמה שהוקפאה בלידה.
if bearType != 0
    if not na(bearWFrozNQ) and nqH > bearWFrozNQ
        bearWTkNQ := true
    if not na(bearWFrozES) and esH > bearWFrozES
        bearWTkES := true
    if barstate.isconfirmed
        if not na(bearCFrozNQ) and nqC > bearCFrozNQ
            bearCTkNQ := true
        if not na(bearCFrozES) and esC > bearCFrozES
            bearCTkES := true
    dieBear = bearType == 1 ? ((bearWTkNQ and bearWTkES) or (barstate.isconfirmed and bearCTkNQ and bearCTkES)) : (barstate.isconfirmed and bearCTkNQ and bearCTkES)
    if dieBear
        bearType := 0
        bearStr  := ""

// שורי: מת כשכל שלושת הנכסים לקחו את אותו נמוך שהוקפא בלידה (YM משלים).
if bullType != 0
    if not na(bullWFrozNQ) and nqL < bullWFrozNQ
        bullWTkNQ := true
    if not na(bullWFrozES) and esL < bullWFrozES
        bullWTkES := true
    if not na(bullWFrozYM) and ymL < bullWFrozYM
        bullWTkYM := true
    if barstate.isconfirmed
        if not na(bullCFrozNQ) and nqC < bullCFrozNQ
            bullCTkNQ := true
        if not na(bullCFrozES) and esC < bullCFrozES
            bullCTkES := true
        if not na(bullCFrozYM) and ymC < bullCFrozYM
            bullCTkYM := true
    dieBull = bullType == 1 ? ((bullWTkNQ and bullWTkES and bullWTkYM) or (barstate.isconfirmed and bullCTkNQ and bullCTkES and bullCTkYM)) : (barstate.isconfirmed and bullCTkNQ and bullCTkES and bullCTkYM)
    if dieBull
        bullType := 0
        bullStr  := ""

// ── רישום שבירות חדשות בסגירת נר ──
if barstate.isconfirmed and tfClass != 0 and not friBlock

    newBearType = 0
    newBearStr  = ""
    newBearLvl  = 0.0
    newBearRefB = 0
    if divCBear and bearOK
        newBearType := 2
        newBearStr  := f_str(nqTkCHi, esTkCHi, ymTkCHi, false)
        newBearLvl  := mRHC
        newBearRefB := mRHCb
    else if validWBear and bearOK
        newBearType := 1
        newBearStr  := f_str(nqTkHi, esTkHi, ymTkHi, false)
        newBearLvl  := mRH
        newBearRefB := mRHb

    if newBearType != 0
        if newBearType != bearType or newBearStr != bearStr
            seqCounter += 1
            bearType := newBearType
            bearStr  := newBearStr
            bearLvl  := newBearLvl
            bearRefB := newBearRefB
            bearSigB := bar_index
            bearYPos := high + atr * offsetMlt
            bearSeq  := seqCounter
            // הקפאת רמות ואתחול מעקב הנכס המפגר
            bearWFrozNQ := nqRH
            bearWFrozES := esRH
            bearCFrozNQ := nqRHC
            bearCFrozES := esRHC
            bearWTkNQ := nqTkHi
            bearWTkES := esTkHi
            bearCTkNQ := nqTkCHi
            bearCTkES := esTkCHi
            // שבירה נגדית מוחקת לגמרי את השורית הקיימת
            bullType := 0
            bullStr  := ""

    newBullType = 0
    newBullStr  = ""
    newBullLvl  = 0.0
    newBullRefB = 0
    if divCBull and bullOK
        newBullType := 2
        newBullStr  := f_str(nqTkCLo, esTkCLo, ymTkCLo, true)
        newBullLvl  := mRLC
        newBullRefB := mRLCb
    else if validWBull and bullOK
        newBullType := 1
        newBullStr  := f_str(nqTkLo, esTkLo, ymTkLo, true)
        newBullLvl  := mRL
        newBullRefB := mRLb

    if newBullType != 0
        if newBullType != bullType or newBullStr != bullStr
            seqCounter += 1
            bullType := newBullType
            bullStr  := newBullStr
            bullLvl  := newBullLvl
            bullRefB := newBullRefB
            bullSigB := bar_index
            bullYPos := low - atr * offsetMlt
            bullSeq  := seqCounter
            bullWFrozNQ := nqRL
            bullWFrozES := esRL
            bullCFrozNQ := nqRLC
            bullCFrozES := esRLC
            bullWFrozYM := ymRL
            bullCFrozYM := ymRLC
            bullWTkNQ := nqTkLo
            bullWTkES := esTkLo
            bullWTkYM := ymTkLo
            bullCTkNQ := nqTkCLo
            bullCTkES := esTkCLo
            bullCTkYM := ymTkCLo
            // שבירה נגדית מוחקת לגמרי את הדובית הקיימת
            bearType := 0
            bearStr  := ""

// ═══════════════════════════════════════════════════════════════════
// בחירת מה מוצג
// ═══════════════════════════════════════════════════════════════════

showDir = 0
if bearType != 0 and bullType != 0
    showDir := bearSeq > bullSeq ? -1 : 1
else if bearType != 0
    showDir := -1
else if bullType != 0
    showDir := 1

dispType = showDir == -1 ? bearType : showDir == 1 ? bullType : 0
dispStr  = showDir == -1 ? bearStr  : showDir == 1 ? bullStr  : ""
dispLvl  = showDir == -1 ? bearLvl  : showDir == 1 ? bullLvl  : na
dispRefB = showDir == -1 ? bearRefB : showDir == 1 ? bullRefB : 0
dispSigB = showDir == -1 ? bearSigB : showDir == 1 ? bullSigB : 0
dispYPos = showDir == -1 ? bearYPos : showDir == 1 ? bullYPos : na
curSeq   = showDir == -1 ? bearSeq  : showDir == 1 ? bullSeq  : -1

// ═══════════════════════════════════════════════════════════════════
// ציור
// ═══════════════════════════════════════════════════════════════════

var label aLbl  = na
var line  aLine = na
var int   drawnSeq  = -999
var int   drawnDir  = -999
var int   drawnType = -999

needRedraw = curSeq != drawnSeq or showDir != drawnDir or dispType != drawnType

if needRedraw
    if not na(aLbl)
        label.delete(aLbl)
        aLbl := na
    if not na(aLine)
        line.delete(aLine)
        aLine := na
    if showDir != 0 and not na(dispYPos)
        col  = showDir == 1 ? colBull : colBear
        cFin = dispType == 2 ? col : color.new(col, 30)
        txt  = "W " + (dispType == 2 ? "H " : "S ") + dispStr
        aLbl := label.new(dispSigB, dispYPos, txt, style = label.style_none, textcolor = cFin, size = labelSize, textalign = text.align_center)
        if showLine and not na(dispLvl) and dispRefB > 0
            aLine := line.new(dispRefB, dispLvl, bar_index, dispLvl, color = cFin, style = line.style_solid, width = lineWidth)
    drawnSeq  := curSeq
    drawnDir  := showDir
    drawnType := dispType

if not na(aLine) and showDir != 0
    line.set_x2(aLine, bar_index)

// ═══════════════════════════════════════════════════════════════════
// טבלת בדיקה (אבחון — כבויה כברירת מחדל)
// ═══════════════════════════════════════════════════════════════════

var table dbg = table.new(position.top_right, 2, 9, border_width = 1)
if showDebug and barstate.islast
    table.cell(dbg, 0, 0, "tfClass", bgcolor = color.gray, text_color = color.white)
    table.cell(dbg, 1, 0, str.tostring(tfClass), bgcolor = color.white)
    table.cell(dbg, 0, 1, "dataReady", bgcolor = color.gray, text_color = color.white)
    table.cell(dbg, 1, 1, str.tostring(dataReady), bgcolor = color.white)
    table.cell(dbg, 0, 2, "bear/bull", bgcolor = color.gray, text_color = color.white)
    table.cell(dbg, 1, 2, str.tostring(bearType) + " / " + str.tostring(bullType), bgcolor = color.white)
    table.cell(dbg, 0, 3, "showDir", bgcolor = color.gray, text_color = color.white)
    table.cell(dbg, 1, 3, str.tostring(showDir), bgcolor = color.white)
    table.cell(dbg, 0, 4, "bearStr", bgcolor = color.gray, text_color = color.white)
    table.cell(dbg, 1, 4, bearStr, bgcolor = color.white)
    table.cell(dbg, 0, 5, "bullStr", bgcolor = color.gray, text_color = color.white)
    table.cell(dbg, 1, 5, bullStr, bgcolor = color.white)
    table.cell(dbg, 0, 6, "NQ Hi/Lo", bgcolor = color.gray, text_color = color.white)
    table.cell(dbg, 1, 6, str.tostring(nqTkHi) + "/" + str.tostring(nqTkLo), bgcolor = color.white)
    table.cell(dbg, 0, 7, "ES Hi/Lo", bgcolor = color.gray, text_color = color.white)
    table.cell(dbg, 1, 7, str.tostring(esTkHi) + "/" + str.tostring(esTkLo), bgcolor = color.white)
    table.cell(dbg, 0, 8, "YM Hi/Lo", bgcolor = color.gray, text_color = color.white)
    table.cell(dbg, 1, 8, str.tostring(ymTkHi) + "/" + str.tostring(ymTkLo), bgcolor = color.white)

// ═══════════════════════════════════════════════════════════════════
// אזהרת TF לא נתמך
// ═══════════════════════════════════════════════════════════════════

if barstate.islast and tfClass == 0
    label.new(bar_index, high, "TF לא נתמך — השתמש ב: 1M / 5M / 15M / 1H / 4H", style = label.style_label_down, color = color.new(color.red, 20), textcolor = color.white, size = size.small)
