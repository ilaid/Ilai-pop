//@version=5
indicator("SSMT + HSSMT | Quarterly Theory", overlay = true, max_labels_count = 20, max_lines_count = 20)

// ═══════════════════════════════════════════════════════════════════
// הגדרות משתמש
// ═══════════════════════════════════════════════════════════════════

grpSym = "סימבולים"
useMicro  = input.bool(false, "השתמש בחוזי מיקרו", group = grpSym)
symNQ_std = input.symbol("CME_MINI:NQ1!",  "NQ רגיל", group = grpSym)
symES_std = input.symbol("CME_MINI:ES1!",  "ES רגיל", group = grpSym)
symYM_std = input.symbol("CBOT_MINI:YM1!", "YM רגיל", group = grpSym)
symNQ_mic = input.symbol("CME_MINI:MNQ1!",  "NQ מיקרו", group = grpSym)
symES_mic = input.symbol("CME_MINI:MES1!",  "ES מיקרו", group = grpSym)
symYM_mic = input.symbol("CBOT_MINI:MYM1!", "YM מיקרו", group = grpSym)

grpVis = "תצוגה"
colBull    = input.color(#26a69a, "צבע שורי", group = grpVis)
colBear    = input.color(#ef5350, "צבע דובי", group = grpVis)
labelSize  = input.string("small", "גודל תווית", options = ["tiny", "small", "normal"], group = grpVis)
offsetMlt  = input.float(1.5, "מרחק התווית מהנר (ATR)", minval = 0.1, maxval = 6.0, step = 0.1, group = grpVis)
showLine   = input.bool(true, "הצג קו שבירה", group = grpVis)
lineWidth  = input.int(2, "עובי קו", minval = 1, maxval = 4, group = grpVis)
showDebug  = input.bool(false, "הצג טבלת בדיקה", group = grpVis)

grpLogic = "לוגיקה"
requireTrueOpen = input.bool(false, "סנן לפי True Open (פרימיום/דיסקאונט)", group = grpLogic)
blockDeadWeek   = input.bool(true, "חסום שבירות בשבוע מת (4H בלבד)", group = grpLogic)

// ═══════════════════════════════════════════════════════════════════
// בחירת סימבולים
// ═══════════════════════════════════════════════════════════════════

sNQ = useMicro ? symNQ_mic : symNQ_std
sES = useMicro ? symES_mic : symES_std
sYM = useMicro ? symYM_mic : symYM_std

// ═══════════════════════════════════════════════════════════════════
// זיהוי Timeframe
// ═══════════════════════════════════════════════════════════════════

tfMin   = timeframe.in_seconds() / 60
tfClass = tfMin <= 1 ? 1 : tfMin <= 5 ? 2 : tfMin <= 15 ? 3 : tfMin <= 60 ? 4 : tfMin <= 240 ? 5 : 0

// ═══════════════════════════════════════════════════════════════════
// חישובי זמן EST
// ═══════════════════════════════════════════════════════════════════

TZ = "America/New_York"
estHour = hour(time, TZ)
estMin  = minute(time, TZ)

minutesOfDay = estHour * 60 + estMin

isPostOpen       = minutesOfDay >= 1080
minsFromDayStart = isPostOpen ? minutesOfDay - 1080 : minutesOfDay + 360

tradeDayTime = isPostOpen ? time + 86400000 : time
tdYear = year(tradeDayTime, TZ)
tdMon  = month(tradeDayTime, TZ)
tdDom  = dayofmonth(tradeDayTime, TZ)
tdDow  = dayofweek(tradeDayTime, TZ)

sessionIdx    = math.floor(minsFromDayStart / 360)
minsInSession = minsFromDayStart % 360
microIdx      = math.floor(minsInSession / 90)
minsInMicro   = minsInSession % 90
quarterIdx    = math.floor(minsInMicro / 22.5)

// ═══════════════════════════════════════════════════════════════════
// מספור שבועות לפי QT
// ═══════════════════════════════════════════════════════════════════

daysSinceMonday = tdDow == dayofweek.sunday ? 6 : tdDow - 2
mondayTime      = tradeDayTime - daysSinceMonday * 86400000
fridayTime      = mondayTime + 4 * 86400000

monMonth = month(mondayTime, TZ)
monDom   = dayofmonth(mondayTime, TZ)
monYear  = year(mondayTime, TZ)
friMonth = month(fridayTime, TZ)

isDeadWeek = monMonth != friMonth
qtWeekNum  = isDeadWeek ? 0 : math.floor((monDom - 1) / 7) + 1

// ═══════════════════════════════════════════════════════════════════
// מזהי מחזורים
// ═══════════════════════════════════════════════════════════════════

tradeDayId = tdYear * 10000 + tdMon * 100 + tdDom
weekId     = monYear * 10000 + monMonth * 100 + monDom
// חודש-מחזור ל-4H נקבע לפי חודש יום-שני של השבוע — כך הגבול נופל תמיד בתחילת שבוע
// (ולא באמצע שבוע מת), המיכל מתאפס נכון, ושבוע 1 = השבוע הראשון שכולו בחודש.
monthId    = monYear * 100 + monMonth
sessionId  = tradeDayId * 10 + sessionIdx
microId    = sessionId * 10 + microIdx
quarterId  = microId * 10 + quarterIdx

refCycleId = 0
if tfClass == 5
    refCycleId := weekId
else if tfClass == 4
    refCycleId := tradeDayId
else if tfClass == 3
    refCycleId := sessionId
else if tfClass == 2
    refCycleId := microId
else if tfClass == 1
    refCycleId := quarterId

lifeCycleId = 0
if tfClass == 5
    lifeCycleId := monthId
else if tfClass == 4
    lifeCycleId := weekId
else if tfClass == 3
    lifeCycleId := tradeDayId
else if tfClass == 2
    lifeCycleId := sessionId
else if tfClass == 1
    lifeCycleId := microId

newRefCycle  = ta.change(refCycleId)  != 0
newLifeCycle = ta.change(lifeCycleId) != 0

// ב-1H תת-המחזור הראשון (יום שני) משווה לתת-המחזור האחרון של השבוע הקודם (שישי),
// אבל אותו "זרע" נמחק אחרי היום הראשון — שישי משווה רק לשני, לא לשאר השבוע.
// ב-4H המחזור החודשי עומד בפני עצמו: השבועות משווים רק בתוך אותו חודש (בלי חודש קודם).
keepLast = tfClass == 4

// ═══════════════════════════════════════════════════════════════════
// True Open
// ═══════════════════════════════════════════════════════════════════

inMonthlyQ2 = qtWeekNum == 2
inWeeklyQ2  = tdDow == dayofweek.tuesday
inDailyQ2   = minsFromDayStart >= 360 and minsFromDayStart < 720
inSessionQ2 = microIdx == 1
inMicroQ2   = quarterIdx == 1

var bool pMonQ2 = false
var bool pWkQ2  = false
var bool pDayQ2 = false
var bool pSesQ2 = false
var bool pMicQ2 = false

isTrueOpenBar = false
if tfClass == 5
    isTrueOpenBar := inMonthlyQ2 and not pMonQ2
else if tfClass == 4
    isTrueOpenBar := inWeeklyQ2 and not pWkQ2
else if tfClass == 3
    isTrueOpenBar := inDailyQ2 and not pDayQ2
else if tfClass == 2
    isTrueOpenBar := inSessionQ2 and not pSesQ2
else if tfClass == 1
    isTrueOpenBar := inMicroQ2 and not pMicQ2

pMonQ2 := inMonthlyQ2
pWkQ2  := inWeeklyQ2
pDayQ2 := inDailyQ2
pSesQ2 := inSessionQ2
pMicQ2 := inMicroQ2

var float trueOpenPrice = na
if isTrueOpenBar
    trueOpenPrice := open

// ═══════════════════════════════════════════════════════════════════
// משיכת נתוני שלושת הנכסים
// ═══════════════════════════════════════════════════════════════════

[nqH, nqL, nqC] = request.security(sNQ, timeframe.period, [high, low, close], lookahead = barmerge.lookahead_off)
[esH, esL, esC] = request.security(sES, timeframe.period, [high, low, close], lookahead = barmerge.lookahead_off)
[ymH, ymL, ymC] = request.security(sYM, timeframe.period, [high, low, close], lookahead = barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════
// צבירת מחזור + מערך רמות לכל תת-מחזור שהסתיים בתוך המיכל
// ═══════════════════════════════════════════════════════════════════

// NQ — מצבר תת-מחזור נוכחי
var float nqCH = na
var float nqCL = na
var float nqCHC = na
var float nqCLC = na
var int   nqCHb = 0
var int   nqCLb = 0
var int   nqCHCb = 0
var int   nqCLCb = 0
var nqHiA  = array.new_float()
var nqLoA  = array.new_float()
var nqHiCA = array.new_float()
var nqLoCA = array.new_float()
var nqHiBA  = array.new_int()
var nqLoBA  = array.new_int()
var nqHiCBA = array.new_int()
var nqLoCBA = array.new_int()

// ES
var float esCH = na
var float esCL = na
var float esCHC = na
var float esCLC = na
var int   esCHb = 0
var int   esCLb = 0
var int   esCHCb = 0
var int   esCLCb = 0
var esHiA  = array.new_float()
var esLoA  = array.new_float()
var esHiCA = array.new_float()
var esLoCA = array.new_float()
var esHiBA  = array.new_int()
var esLoBA  = array.new_int()
var esHiCBA = array.new_int()
var esLoCBA = array.new_int()

// YM
var float ymCH = na
var float ymCL = na
var float ymCHC = na
var float ymCLC = na
var int   ymCHb = 0
var int   ymCLb = 0
var int   ymCHCb = 0
var int   ymCLCb = 0
var ymHiA  = array.new_float()
var ymLoA  = array.new_float()
var ymHiCA = array.new_float()
var ymLoCA = array.new_float()
var ymHiBA  = array.new_int()
var ymLoBA  = array.new_int()
var ymHiCBA = array.new_int()
var ymLoCBA = array.new_int()

// דגלי ה"זרע" — מחושבים כאן, כשהמצברים עדיין מחזיקים את ערך התת-מחזור הקודם.
var bool seedActive = false
seedPushNow = newRefCycle and newLifeCycle and keepLast and not na(nqCH)
dropSeedNow = newRefCycle and (not newLifeCycle) and seedActive

// ── NQ צבירה ──
if newRefCycle
    if newLifeCycle
        array.clear(nqHiA)
        array.clear(nqLoA)
        array.clear(nqHiCA)
        array.clear(nqLoCA)
        array.clear(nqHiBA)
        array.clear(nqLoBA)
        array.clear(nqHiCBA)
        array.clear(nqLoCBA)
    if ((not newLifeCycle) or keepLast) and not na(nqCH)
        array.push(nqHiA,  nqCH)
        array.push(nqLoA,  nqCL)
        array.push(nqHiCA, nqCHC)
        array.push(nqLoCA, nqCLC)
        array.push(nqHiBA,  nqCHb)
        array.push(nqLoBA,  nqCLb)
        array.push(nqHiCBA, nqCHCb)
        array.push(nqLoCBA, nqCLCb)
    if dropSeedNow and array.size(nqHiA) > 0
        array.remove(nqHiA, 0)
        array.remove(nqLoA, 0)
        array.remove(nqHiCA, 0)
        array.remove(nqLoCA, 0)
        array.remove(nqHiBA, 0)
        array.remove(nqLoBA, 0)
        array.remove(nqHiCBA, 0)
        array.remove(nqLoCBA, 0)
    nqCH := nqH
    nqCL := nqL
    nqCHC := nqC
    nqCLC := nqC
    nqCHb := bar_index
    nqCLb := bar_index
    nqCHCb := bar_index
    nqCLCb := bar_index
else
    if na(nqCH) or nqH > nqCH
        nqCH := nqH
        nqCHb := bar_index
    if na(nqCL) or nqL < nqCL
        nqCL := nqL
        nqCLb := bar_index
    if na(nqCHC) or nqC > nqCHC
        nqCHC := nqC
        nqCHCb := bar_index
    if na(nqCLC) or nqC < nqCLC
        nqCLC := nqC
        nqCLCb := bar_index

// ── ES צבירה ──
if newRefCycle
    if newLifeCycle
        array.clear(esHiA)
        array.clear(esLoA)
        array.clear(esHiCA)
        array.clear(esLoCA)
        array.clear(esHiBA)
        array.clear(esLoBA)
        array.clear(esHiCBA)
        array.clear(esLoCBA)
    if ((not newLifeCycle) or keepLast) and not na(esCH)
        array.push(esHiA,  esCH)
        array.push(esLoA,  esCL)
        array.push(esHiCA, esCHC)
        array.push(esLoCA, esCLC)
        array.push(esHiBA,  esCHb)
        array.push(esLoBA,  esCLb)
        array.push(esHiCBA, esCHCb)
        array.push(esLoCBA, esCLCb)
    if dropSeedNow and array.size(esHiA) > 0
        array.remove(esHiA, 0)
        array.remove(esLoA, 0)
        array.remove(esHiCA, 0)
        array.remove(esLoCA, 0)
        array.remove(esHiBA, 0)
        array.remove(esLoBA, 0)
        array.remove(esHiCBA, 0)
        array.remove(esLoCBA, 0)
    esCH := esH
    esCL := esL
    esCHC := esC
    esCLC := esC
    esCHb := bar_index
    esCLb := bar_index
    esCHCb := bar_index
    esCLCb := bar_index
else
    if na(esCH) or esH > esCH
        esCH := esH
        esCHb := bar_index
    if na(esCL) or esL < esCL
        esCL := esL
        esCLb := bar_index
    if na(esCHC) or esC > esCHC
        esCHC := esC
        esCHCb := bar_index
    if na(esCLC) or esC < esCLC
        esCLC := esC
        esCLCb := bar_index

// ── YM צבירה ──
if newRefCycle
    if newLifeCycle
        array.clear(ymHiA)
        array.clear(ymLoA)
        array.clear(ymHiCA)
        array.clear(ymLoCA)
        array.clear(ymHiBA)
        array.clear(ymLoBA)
        array.clear(ymHiCBA)
        array.clear(ymLoCBA)
    if ((not newLifeCycle) or keepLast) and not na(ymCH)
        array.push(ymHiA,  ymCH)
        array.push(ymLoA,  ymCL)
        array.push(ymHiCA, ymCHC)
        array.push(ymLoCA, ymCLC)
        array.push(ymHiBA,  ymCHb)
        array.push(ymLoBA,  ymCLb)
        array.push(ymHiCBA, ymCHCb)
        array.push(ymLoCBA, ymCLCb)
    if dropSeedNow and array.size(ymHiA) > 0
        array.remove(ymHiA, 0)
        array.remove(ymLoA, 0)
        array.remove(ymHiCA, 0)
        array.remove(ymLoCA, 0)
        array.remove(ymHiBA, 0)
        array.remove(ymLoBA, 0)
        array.remove(ymHiCBA, 0)
        array.remove(ymLoCBA, 0)
    ymCH := ymH
    ymCL := ymL
    ymCHC := ymC
    ymCLC := ymC
    ymCHb := bar_index
    ymCLb := bar_index
    ymCHCb := bar_index
    ymCLCb := bar_index
else
    if na(ymCH) or ymH > ymCH
        ymCH := ymH
        ymCHb := bar_index
    if na(ymCL) or ymL < ymCL
        ymCL := ymL
        ymCLb := bar_index
    if na(ymCHC) or ymC > ymCHC
        ymCHC := ymC
        ymCHCb := bar_index
    if na(ymCLC) or ymC < ymCLC
        ymCLC := ymC
        ymCLCb := bar_index

// עדכון דגל ה"זרע" (המבט אחורה) — פעיל רק ליחידה הראשונה של המיכל
if newRefCycle and newLifeCycle
    seedActive := seedPushNow
else if newRefCycle
    seedActive := false

// ═══════════════════════════════════════════════════════════════════
// חסימות
// ═══════════════════════════════════════════════════════════════════

nLevels = array.size(nqHiA)
cycleOK   = not (tfClass == 5 and blockDeadWeek and isDeadWeek)
friBlock  = (tfClass == 5 or tfClass == 4) and tdDow == dayofweek.friday

bearOK = not requireTrueOpen or (not na(trueOpenPrice) and close > trueOpenPrice)
bullOK = not requireTrueOpen or (not na(trueOpenPrice) and close < trueOpenPrice)

// ═══════════════════════════════════════════════════════════════════
// מחרוזת נכסים — בשורי YM מושמט
// ═══════════════════════════════════════════════════════════════════

f_str(bNQ, bES, bYM, isBull) =>
    s = ""
    s := bNQ ? s + "NQ " : s
    s := bES ? s + "ES " : s
    s := (bYM and not isBull) ? s + "YM " : s
    str.trim(s)

// ═══════════════════════════════════════════════════════════════════
// זיהוי — השבירה נמדדת מול ה-swing של המיכל (השיא הכי גבוה / השפל הכי נמוך).
// שבירה נוצרת כשנכס עושה קיצון חדש מעבר ל-swing בזמן שהאחר לא, והרמה מוקפאת.
// דובי מתבטל כששני החזקים לקחו את הרמה; שורי — כשכל השלושה לקחו.
// ═══════════════════════════════════════════════════════════════════

f_argmax(a) =>
    idx = 0
    m = array.get(a, 0)
    for i = 1 to array.size(a) - 1
        v = array.get(a, i)
        if v > m
            m := v
            idx := i
    idx

f_argmin(a) =>
    idx = 0
    m = array.get(a, 0)
    for i = 1 to array.size(a) - 1
        v = array.get(a, i)
        if v < m
            m := v
            idx := i
    idx

// ═══════════════════════════════════════════════════════════════════
// נכס הגרף
// ═══════════════════════════════════════════════════════════════════

cs = syminfo.tickerid
isNQc = str.contains(cs, "NQ")
isESc = str.contains(cs, "ES")
isYMc = str.contains(cs, "YM")

// ═══════════════════════════════════════════════════════════════════
// מצב מבוסס אירוע
// ═══════════════════════════════════════════════════════════════════

atr = ta.atr(14)

var int    bearType = 0
var string bearStr  = ""
var float  bearLvl  = na
var int    bearRefB = 0
var int    bearSigB = 0
var float  bearYPos = na
var int    bearSeq  = 0
var float  bfBearNQw = na
var float  bfBearESw = na
var float  bfBearYMw = na
var float  bfBearNQc = na
var float  bfBearESc = na
var float  bfBearYMc = na
var bool   tkBearNQw = false
var bool   tkBearESw = false
var bool   tkBearYMw = false
var bool   tkBearNQc = false
var bool   tkBearESc = false
var bool   tkBearYMc = false

var int    bullType = 0
var string bullStr  = ""
var float  bullLvl  = na
var int    bullRefB = 0
var int    bullSigB = 0
var float  bullYPos = na
var int    bullSeq  = 0
var float  bfBullNQw = na
var float  bfBullESw = na
var float  bfBullYMw = na
var float  bfBullNQc = na
var float  bfBullESc = na
var float  bfBullYMc = na
var bool   tkBullNQw = false
var bool   tkBullESw = false
var bool   tkBullYMw = false
var bool   tkBullNQc = false
var bool   tkBullESc = false
var bool   tkBullYMc = false

var int seqCounter = 0

// בונה תווית מפוצלת: H = סגרו מעבר, S = רק פתיל
f_lbl(nqC_, esC_, ymC_, nqW_, esW_, ymW_, isBull) =>
    hs = f_str(nqC_, esC_, ymC_, isBull)
    ss = f_str(nqW_ and not nqC_, esW_ and not esC_, ymW_ and not ymC_, isBull)
    lbl = hs != "" ? "H " + hs : ""
    lbl := ss != "" ? (lbl != "" ? lbl + " S " + ss : "S " + ss) : lbl
    [lbl, hs != "" ? 2 : 1]

// ── פקיעת מחזור־על — מאפסת את מצב התצוגה ──
if newLifeCycle
    bearType := 0
    bullType := 0

// ═══════════════════════════════════════════════════════════════════
// שבירה דובית: מעקב לקיחה + תווית + ביטול (על שבירה פעילה)
// ═══════════════════════════════════════════════════════════════════
if bearType != 0
    if not na(bfBearNQw) and nqH > bfBearNQw
        tkBearNQw := true
    if not na(bfBearESw) and esH > bfBearESw
        tkBearESw := true
    if not na(bfBearYMw) and ymH > bfBearYMw
        tkBearYMw := true
    if barstate.isconfirmed
        if not na(bfBearNQc) and nqC > bfBearNQc
            tkBearNQc := true
        if not na(bfBearESc) and esC > bfBearESc
            tkBearESc := true
        if not na(bfBearYMc) and ymC > bfBearYMc
            tkBearYMc := true
    if tkBearNQw and tkBearESw
        bearType := 0            // שני החזקים לקחו את השיא — ביטול
    else
        [lbl, ty] = f_lbl(tkBearNQc, tkBearESc, tkBearYMc, tkBearNQw, tkBearESw, tkBearYMw, false)
        bearStr  := lbl
        bearType := ty
        bearSigB := bar_index    // התווית עוקבת אחרי הנר הנוכחי
        bearYPos := high + atr * offsetMlt
        bearLvl  := ty == 2 ? (isNQc ? bfBearNQc : isESc ? bfBearESc : bfBearYMc) : (isNQc ? bfBearNQw : isESc ? bfBearESw : bfBearYMw)

// ── יצירת שבירה דובית חדשה: קיצון חדש מעל ה-swing (הגבוה הכי גבוה במיכל) ──
if barstate.isconfirmed and tfClass != 0 and not friBlock and cycleOK and nLevels > 0 and bearType == 0 and bearOK
    pMaxWkNQ = array.max(nqHiA)
    pMaxWkES = array.max(esHiA)
    pMaxWkYM = array.max(ymHiA)
    pMaxClNQ = array.max(nqHiCA)
    pMaxClES = array.max(esHiCA)
    pMaxClYM = array.max(ymHiCA)
    nw = nqCH > pMaxWkNQ
    ew = esCH > pMaxWkES
    yw = ymCH > pMaxWkYM
    nc = nqCHC > pMaxClNQ
    ec = esCHC > pMaxClES
    yc = ymCHC > pMaxClYM
    if (nw or ew or yw) and not (nw and ew)
        seqCounter += 1
        bearSeq := seqCounter
        bfBearNQw := pMaxWkNQ
        bfBearESw := pMaxWkES
        bfBearYMw := pMaxWkYM
        bfBearNQc := pMaxClNQ
        bfBearESc := pMaxClES
        bfBearYMc := pMaxClYM
        tkBearNQw := nw
        tkBearESw := ew
        tkBearYMw := yw
        tkBearNQc := nc
        tkBearESc := ec
        tkBearYMc := yc
        [lbl, ty] = f_lbl(nc, ec, yc, nw, ew, yw, false)
        bearStr  := lbl
        bearType := ty
        bearSigB := bar_index
        bearYPos := high + atr * offsetMlt
        bearLvl  := ty == 2 ? (isNQc ? pMaxClNQ : isESc ? pMaxClES : pMaxClYM) : (isNQc ? pMaxWkNQ : isESc ? pMaxWkES : pMaxWkYM)
        bearRefB := ty == 2 ? (isNQc ? array.get(nqHiCBA, f_argmax(nqHiCA)) : isESc ? array.get(esHiCBA, f_argmax(esHiCA)) : array.get(ymHiCBA, f_argmax(ymHiCA))) : (isNQc ? array.get(nqHiBA, f_argmax(nqHiA)) : isESc ? array.get(esHiBA, f_argmax(esHiA)) : array.get(ymHiBA, f_argmax(ymHiA)))

// ═══════════════════════════════════════════════════════════════════
// שבירה שורית: מעקב לקיחה + תווית + ביטול (על שבירה פעילה)
// ═══════════════════════════════════════════════════════════════════
if bullType != 0
    if not na(bfBullNQw) and nqL < bfBullNQw
        tkBullNQw := true
    if not na(bfBullESw) and esL < bfBullESw
        tkBullESw := true
    if not na(bfBullYMw) and ymL < bfBullYMw
        tkBullYMw := true
    if barstate.isconfirmed
        if not na(bfBullNQc) and nqC < bfBullNQc
            tkBullNQc := true
        if not na(bfBullESc) and esC < bfBullESc
            tkBullESc := true
        if not na(bfBullYMc) and ymC < bfBullYMc
            tkBullYMc := true
    if tkBullNQw and tkBullESw and tkBullYMw
        bullType := 0            // כל השלושה לקחו את הנמוך — ביטול
    else
        [lbl, ty] = f_lbl(tkBullNQc, tkBullESc, tkBullYMc, tkBullNQw, tkBullESw, tkBullYMw, true)
        bullStr  := lbl
        bullType := ty
        bullSigB := bar_index
        bullYPos := low - atr * offsetMlt
        bullLvl  := ty == 2 ? (isNQc ? bfBullNQc : isESc ? bfBullESc : bfBullYMc) : (isNQc ? bfBullNQw : isESc ? bfBullESw : bfBullYMw)

// ── יצירת שבירה שורית חדשה: קיצון חדש מתחת ל-swing (הנמוך הכי נמוך במיכל) ──
if barstate.isconfirmed and tfClass != 0 and not friBlock and cycleOK and nLevels > 0 and bullType == 0 and bullOK
    pMinLoNQ  = array.min(nqLoA)
    pMinLoES  = array.min(esLoA)
    pMinLoYM  = array.min(ymLoA)
    pMinLoCNQ = array.min(nqLoCA)
    pMinLoCES = array.min(esLoCA)
    pMinLoCYM = array.min(ymLoCA)
    nw = nqCL < pMinLoNQ
    ew = esCL < pMinLoES
    yw = ymCL < pMinLoYM
    nc = nqCLC < pMinLoCNQ
    ec = esCLC < pMinLoCES
    yc = ymCLC < pMinLoCYM
    if (nw or ew) and not (nw and ew and yw)
        seqCounter += 1
        bullSeq := seqCounter
        bfBullNQw := pMinLoNQ
        bfBullESw := pMinLoES
        bfBullYMw := pMinLoYM
        bfBullNQc := pMinLoCNQ
        bfBullESc := pMinLoCES
        bfBullYMc := pMinLoCYM
        tkBullNQw := nw
        tkBullESw := ew
        tkBullYMw := yw
        tkBullNQc := nc
        tkBullESc := ec
        tkBullYMc := yc
        [lbl, ty] = f_lbl(nc, ec, yc, nw, ew, yw, true)
        bullStr  := lbl
        bullType := ty
        bullSigB := bar_index
        bullYPos := low - atr * offsetMlt
        bullLvl  := ty == 2 ? (isNQc ? pMinLoCNQ : isESc ? pMinLoCES : pMinLoCYM) : (isNQc ? pMinLoNQ : isESc ? pMinLoES : pMinLoYM)
        bullRefB := ty == 2 ? (isNQc ? array.get(nqLoCBA, f_argmin(nqLoCA)) : isESc ? array.get(esLoCBA, f_argmin(esLoCA)) : array.get(ymLoCBA, f_argmin(ymLoCA))) : (isNQc ? array.get(nqLoBA, f_argmin(nqLoA)) : isESc ? array.get(esLoBA, f_argmin(esLoA)) : array.get(ymLoBA, f_argmin(ymLoA)))

// ═══════════════════════════════════════════════════════════════════
// בחירת מה מוצג
// ═══════════════════════════════════════════════════════════════════

showDir = 0
if bearType != 0 and bullType != 0
    showDir := bearSeq > bullSeq ? -1 : 1
else if bearType != 0
    showDir := -1
else if bullType != 0
    showDir := 1

dispType = showDir == -1 ? bearType : showDir == 1 ? bullType : 0
dispStr  = showDir == -1 ? bearStr  : showDir == 1 ? bullStr  : ""
dispLvl  = showDir == -1 ? bearLvl  : showDir == 1 ? bullLvl  : na
dispRefB = showDir == -1 ? bearRefB : showDir == 1 ? bullRefB : 0
dispSigB = showDir == -1 ? bearSigB : showDir == 1 ? bullSigB : 0
dispYPos = showDir == -1 ? bearYPos : showDir == 1 ? bullYPos : na
curSeq   = showDir == -1 ? bearSeq  : showDir == 1 ? bullSeq  : -1

// ═══════════════════════════════════════════════════════════════════
// ציור
// ═══════════════════════════════════════════════════════════════════

var label aLbl  = na
var line  aLine = na
var int    drawnSeq  = -999
var int    drawnDir  = -999
var int    drawnType = -999
var string drawnStr  = ""
var float  drawnLvl  = na

needRedraw = curSeq != drawnSeq or showDir != drawnDir or dispType != drawnType or dispStr != drawnStr or dispLvl != drawnLvl

if needRedraw
    if not na(aLbl)
        label.delete(aLbl)
        aLbl := na
    if not na(aLine)
        line.delete(aLine)
        aLine := na
    if showDir != 0 and not na(dispYPos)
        col  = showDir == 1 ? colBull : colBear
        cFin = dispType == 2 ? col : color.new(col, 30)
        txt  = "W " + dispStr
        aLbl := label.new(dispSigB, dispYPos, txt, style = label.style_none, textcolor = cFin, size = labelSize, textalign = text.align_center)
        if showLine and not na(dispLvl) and dispRefB > 0
            aLine := line.new(dispRefB, dispLvl, bar_index, dispLvl, color = cFin, style = line.style_solid, width = lineWidth)
    drawnSeq  := curSeq
    drawnDir  := showDir
    drawnType := dispType
    drawnStr  := dispStr
    drawnLvl  := dispLvl

// התווית והקו עוקבים אחרי הנר הנוכחי
if not na(aLbl) and showDir != 0
    label.set_x(aLbl, dispSigB)
    label.set_y(aLbl, dispYPos)
if not na(aLine) and showDir != 0
    line.set_x2(aLine, bar_index)

// ═══════════════════════════════════════════════════════════════════
// טבלת בדיקה (אבחון — כבויה כברירת מחדל)
// ═══════════════════════════════════════════════════════════════════

f_num(x) => na(x) ? "-" : str.tostring(x, format.mintick)

var table dbg = table.new(position.top_right, 4, 12, border_width = 1)
if showDebug and barstate.islast
    // רמות ייחוס הכי נמוכות/גבוהות במיכל (סגירה) — "הכי נמוך/גבוה בחודש"
    float nqMinLoC = nLevels > 0 ? array.min(nqLoCA) : na
    float esMinLoC = nLevels > 0 ? array.min(esLoCA) : na
    float ymMinLoC = nLevels > 0 ? array.min(ymLoCA) : na
    float nqMaxHiC = nLevels > 0 ? array.max(nqHiCA) : na
    float esMaxHiC = nLevels > 0 ? array.max(esHiCA) : na
    float ymMaxHiC = nLevels > 0 ? array.max(ymHiCA) : na
    hc = color.gray
    wc = color.white
    // כותרת
    table.cell(dbg, 0, 0, "", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 0, "NQ", bgcolor = hc, text_color = wc)
    table.cell(dbg, 2, 0, "ES", bgcolor = hc, text_color = wc)
    table.cell(dbg, 3, 0, "YM", bgcolor = hc, text_color = wc)
    // מצב כללי
    table.cell(dbg, 0, 1, "tf/lvl/dir", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 1, str.tostring(tfClass), bgcolor = wc)
    table.cell(dbg, 2, 1, str.tostring(nLevels), bgcolor = wc)
    table.cell(dbg, 3, 1, str.tostring(showDir), bgcolor = wc)
    table.cell(dbg, 0, 2, "typ b/u", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 2, str.tostring(bearType) + "/" + str.tostring(bullType), bgcolor = wc)
    table.cell(dbg, 2, 2, "bear:", bgcolor = wc)
    table.cell(dbg, 3, 2, bearStr, bgcolor = wc)
    table.cell(dbg, 0, 3, "str bull", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 3, bullStr, bgcolor = wc)
    table.cell(dbg, 2, 3, "", bgcolor = wc)
    table.cell(dbg, 3, 3, "", bgcolor = wc)
    // פתיל נוכחי (מצטבר) מול "הכי גבוה/נמוך במיכל" (פתיל) — ל-SSMT
    float nqMaxHi = nLevels > 0 ? array.max(nqHiA) : na
    float esMaxHi = nLevels > 0 ? array.max(esHiA) : na
    float ymMaxHi = nLevels > 0 ? array.max(ymHiA) : na
    float nqMinLo = nLevels > 0 ? array.min(nqLoA) : na
    float esMinLo = nLevels > 0 ? array.min(esLoA) : na
    float ymMinLo = nLevels > 0 ? array.min(ymLoA) : na
    table.cell(dbg, 0, 4, "curHi w", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 4, f_num(nqCH), bgcolor = wc)
    table.cell(dbg, 2, 4, f_num(esCH), bgcolor = wc)
    table.cell(dbg, 3, 4, f_num(ymCH), bgcolor = wc)
    table.cell(dbg, 0, 5, "maxHi w", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 5, f_num(nqMaxHi), bgcolor = wc)
    table.cell(dbg, 2, 5, f_num(esMaxHi), bgcolor = wc)
    table.cell(dbg, 3, 5, f_num(ymMaxHi), bgcolor = wc)
    table.cell(dbg, 0, 6, "curLo w", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 6, f_num(nqCL), bgcolor = wc)
    table.cell(dbg, 2, 6, f_num(esCL), bgcolor = wc)
    table.cell(dbg, 3, 6, f_num(ymCL), bgcolor = wc)
    table.cell(dbg, 0, 7, "minLo w", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 7, f_num(nqMinLo), bgcolor = wc)
    table.cell(dbg, 2, 7, f_num(esMinLo), bgcolor = wc)
    table.cell(dbg, 3, 7, f_num(ymMinLo), bgcolor = wc)
    // סגירה נוכחית (מצטבר) מול "הכי נמוך/גבוה במיכל"
    table.cell(dbg, 0, 8, "curLoC", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 8, f_num(nqCLC), bgcolor = wc)
    table.cell(dbg, 2, 8, f_num(esCLC), bgcolor = wc)
    table.cell(dbg, 3, 8, f_num(ymCLC), bgcolor = wc)
    table.cell(dbg, 0, 9, "minLoC", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 9, f_num(nqMinLoC), bgcolor = wc)
    table.cell(dbg, 2, 9, f_num(esMinLoC), bgcolor = wc)
    table.cell(dbg, 3, 9, f_num(ymMinLoC), bgcolor = wc)
    table.cell(dbg, 0, 10, "curHiC", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 10, f_num(nqCHC), bgcolor = wc)
    table.cell(dbg, 2, 10, f_num(esCHC), bgcolor = wc)
    table.cell(dbg, 3, 10, f_num(ymCHC), bgcolor = wc)
    table.cell(dbg, 0, 11, "maxHiC", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 11, f_num(nqMaxHiC), bgcolor = wc)
    table.cell(dbg, 2, 11, f_num(esMaxHiC), bgcolor = wc)
    table.cell(dbg, 3, 11, f_num(ymMaxHiC), bgcolor = wc)
