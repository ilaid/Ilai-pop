//@version=5
indicator("SSMT + HSSMT | Quarterly Theory", overlay = true, max_labels_count = 20, max_lines_count = 20)

// ═══════════════════════════════════════════════════════════════════
// הגדרות משתמש
// ═══════════════════════════════════════════════════════════════════

grpSym = "סימבולים"
useMicro  = input.bool(false, "השתמש בחוזי מיקרו", group = grpSym)
symNQ_std = input.symbol("CME_MINI:NQ1!",  "NQ רגיל", group = grpSym)
symES_std = input.symbol("CME_MINI:ES1!",  "ES רגיל", group = grpSym)
symYM_std = input.symbol("CBOT_MINI:YM1!", "YM רגיל", group = grpSym)
symNQ_mic = input.symbol("CME_MINI:MNQ1!",  "NQ מיקרו", group = grpSym)
symES_mic = input.symbol("CME_MINI:MES1!",  "ES מיקרו", group = grpSym)
symYM_mic = input.symbol("CBOT_MINI:MYM1!", "YM מיקרו", group = grpSym)

grpVis = "תצוגה"
colBull    = input.color(#26a69a, "צבע שורי", group = grpVis)
colBear    = input.color(#ef5350, "צבע דובי", group = grpVis)
labelSize  = input.string("small", "גודל תווית", options = ["tiny", "small", "normal"], group = grpVis)
offsetMlt  = input.float(0.6, "מרחק התווית מהנר (ATR)", minval = 0.1, maxval = 3.0, step = 0.1, group = grpVis)
showLine   = input.bool(true, "הצג קו שבירה", group = grpVis)
lineWidth  = input.int(2, "עובי קו", minval = 1, maxval = 4, group = grpVis)
showDebug  = input.bool(false, "הצג טבלת בדיקה", group = grpVis)

grpLogic = "לוגיקה"
requireTrueOpen = input.bool(false, "סנן לפי True Open (פרימיום/דיסקאונט)", group = grpLogic)
blockDeadWeek   = input.bool(true, "חסום שבירות בשבוע מת (4H בלבד)", group = grpLogic)

// ═══════════════════════════════════════════════════════════════════
// בחירת סימבולים
// ═══════════════════════════════════════════════════════════════════

sNQ = useMicro ? symNQ_mic : symNQ_std
sES = useMicro ? symES_mic : symES_std
sYM = useMicro ? symYM_mic : symYM_std

// ═══════════════════════════════════════════════════════════════════
// זיהוי Timeframe
// ═══════════════════════════════════════════════════════════════════

tfMin   = timeframe.in_seconds() / 60
tfClass = tfMin <= 1 ? 1 : tfMin <= 5 ? 2 : tfMin <= 15 ? 3 : tfMin <= 60 ? 4 : tfMin <= 240 ? 5 : 0

// ═══════════════════════════════════════════════════════════════════
// חישובי זמן EST
// ═══════════════════════════════════════════════════════════════════

TZ = "America/New_York"
estHour = hour(time, TZ)
estMin  = minute(time, TZ)

minutesOfDay = estHour * 60 + estMin

isPostOpen       = minutesOfDay >= 1080
minsFromDayStart = isPostOpen ? minutesOfDay - 1080 : minutesOfDay + 360

tradeDayTime = isPostOpen ? time + 86400000 : time
tdYear = year(tradeDayTime, TZ)
tdMon  = month(tradeDayTime, TZ)
tdDom  = dayofmonth(tradeDayTime, TZ)
tdDow  = dayofweek(tradeDayTime, TZ)

sessionIdx    = math.floor(minsFromDayStart / 360)
minsInSession = minsFromDayStart % 360
microIdx      = math.floor(minsInSession / 90)
minsInMicro   = minsInSession % 90
quarterIdx    = math.floor(minsInMicro / 22.5)

// ═══════════════════════════════════════════════════════════════════
// מספור שבועות לפי QT
// ═══════════════════════════════════════════════════════════════════

daysSinceMonday = tdDow == dayofweek.sunday ? 6 : tdDow - 2
mondayTime      = tradeDayTime - daysSinceMonday * 86400000
fridayTime      = mondayTime + 4 * 86400000

monMonth = month(mondayTime, TZ)
monDom   = dayofmonth(mondayTime, TZ)
monYear  = year(mondayTime, TZ)
friMonth = month(fridayTime, TZ)

isDeadWeek = monMonth != friMonth
qtWeekNum  = isDeadWeek ? 0 : math.floor((monDom - 1) / 7) + 1

// ═══════════════════════════════════════════════════════════════════
// מזהי מחזורים
// ═══════════════════════════════════════════════════════════════════

tradeDayId = tdYear * 10000 + tdMon * 100 + tdDom
weekId     = monYear * 10000 + monMonth * 100 + monDom
monthId    = tdYear * 100 + tdMon
sessionId  = tradeDayId * 10 + sessionIdx
microId    = sessionId * 10 + microIdx
quarterId  = microId * 10 + quarterIdx

refCycleId = 0
if tfClass == 5
    refCycleId := weekId
else if tfClass == 4
    refCycleId := tradeDayId
else if tfClass == 3
    refCycleId := sessionId
else if tfClass == 2
    refCycleId := microId
else if tfClass == 1
    refCycleId := quarterId

lifeCycleId = 0
if tfClass == 5
    lifeCycleId := monthId
else if tfClass == 4
    lifeCycleId := weekId
else if tfClass == 3
    lifeCycleId := tradeDayId
else if tfClass == 2
    lifeCycleId := sessionId
else if tfClass == 1
    lifeCycleId := microId

newRefCycle  = ta.change(refCycleId)  != 0
newLifeCycle = ta.change(lifeCycleId) != 0

// ב-1H וב-4H תת-המחזור הראשון של המיכל מסתכל אחורה לתת-המחזור האחרון של המיכל
// הקודם (שני↔שישי ב-1H; שבוע-ראשון↔שבוע-אחרון ב-4H). באינטרה-דיי המיכל מתאפס לגמרי.
keepLast = tfClass == 4 or tfClass == 5

// ═══════════════════════════════════════════════════════════════════
// True Open
// ═══════════════════════════════════════════════════════════════════

inMonthlyQ2 = qtWeekNum == 2
inWeeklyQ2  = tdDow == dayofweek.tuesday
inDailyQ2   = minsFromDayStart >= 360 and minsFromDayStart < 720
inSessionQ2 = microIdx == 1
inMicroQ2   = quarterIdx == 1

var bool pMonQ2 = false
var bool pWkQ2  = false
var bool pDayQ2 = false
var bool pSesQ2 = false
var bool pMicQ2 = false

isTrueOpenBar = false
if tfClass == 5
    isTrueOpenBar := inMonthlyQ2 and not pMonQ2
else if tfClass == 4
    isTrueOpenBar := inWeeklyQ2 and not pWkQ2
else if tfClass == 3
    isTrueOpenBar := inDailyQ2 and not pDayQ2
else if tfClass == 2
    isTrueOpenBar := inSessionQ2 and not pSesQ2
else if tfClass == 1
    isTrueOpenBar := inMicroQ2 and not pMicQ2

pMonQ2 := inMonthlyQ2
pWkQ2  := inWeeklyQ2
pDayQ2 := inDailyQ2
pSesQ2 := inSessionQ2
pMicQ2 := inMicroQ2

var float trueOpenPrice = na
if isTrueOpenBar
    trueOpenPrice := open

// ═══════════════════════════════════════════════════════════════════
// משיכת נתוני שלושת הנכסים
// ═══════════════════════════════════════════════════════════════════

[nqH, nqL, nqC] = request.security(sNQ, timeframe.period, [high, low, close], lookahead = barmerge.lookahead_off)
[esH, esL, esC] = request.security(sES, timeframe.period, [high, low, close], lookahead = barmerge.lookahead_off)
[ymH, ymL, ymC] = request.security(sYM, timeframe.period, [high, low, close], lookahead = barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════
// צבירת מחזור + מערך רמות לכל תת-מחזור שהסתיים בתוך המיכל
// כל תת-מחזור שומר: גבוה/נמוך פתיל, גבוה/נמוך סגירה, והברים.
// המיכל מתאפס בתחילתו (newLifeCycle) — תת-המחזור הראשון רק קובע רמות.
// ═══════════════════════════════════════════════════════════════════

// NQ — מצבר תת-מחזור נוכחי
var float nqCH = na
var float nqCL = na
var float nqCHC = na
var float nqCLC = na
var int   nqCHb = 0
var int   nqCLb = 0
var int   nqCHCb = 0
var int   nqCLCb = 0
// NQ — מערכי רמות קודמות במיכל
var nqHiA  = array.new_float()
var nqLoA  = array.new_float()
var nqHiCA = array.new_float()
var nqLoCA = array.new_float()
var nqHiBA  = array.new_int()
var nqLoBA  = array.new_int()
var nqHiCBA = array.new_int()
var nqLoCBA = array.new_int()

// ES
var float esCH = na
var float esCL = na
var float esCHC = na
var float esCLC = na
var int   esCHb = 0
var int   esCLb = 0
var int   esCHCb = 0
var int   esCLCb = 0
var esHiA  = array.new_float()
var esLoA  = array.new_float()
var esHiCA = array.new_float()
var esLoCA = array.new_float()
var esHiBA  = array.new_int()
var esLoBA  = array.new_int()
var esHiCBA = array.new_int()
var esLoCBA = array.new_int()

// YM
var float ymCH = na
var float ymCL = na
var float ymCHC = na
var float ymCLC = na
var int   ymCHb = 0
var int   ymCLb = 0
var int   ymCHCb = 0
var int   ymCLCb = 0
var ymHiA  = array.new_float()
var ymLoA  = array.new_float()
var ymHiCA = array.new_float()
var ymLoCA = array.new_float()
var ymHiBA  = array.new_int()
var ymLoBA  = array.new_int()
var ymHiCBA = array.new_int()
var ymLoCBA = array.new_int()

// ── NQ צבירה ──
if newRefCycle
    if newLifeCycle
        array.clear(nqHiA)
        array.clear(nqLoA)
        array.clear(nqHiCA)
        array.clear(nqLoCA)
        array.clear(nqHiBA)
        array.clear(nqLoBA)
        array.clear(nqHiCBA)
        array.clear(nqLoCBA)
    if ((not newLifeCycle) or keepLast) and not na(nqCH)
        array.push(nqHiA,  nqCH)
        array.push(nqLoA,  nqCL)
        array.push(nqHiCA, nqCHC)
        array.push(nqLoCA, nqCLC)
        array.push(nqHiBA,  nqCHb)
        array.push(nqLoBA,  nqCLb)
        array.push(nqHiCBA, nqCHCb)
        array.push(nqLoCBA, nqCLCb)
    nqCH := nqH
    nqCL := nqL
    nqCHC := nqC
    nqCLC := nqC
    nqCHb := bar_index
    nqCLb := bar_index
    nqCHCb := bar_index
    nqCLCb := bar_index
else
    if na(nqCH) or nqH > nqCH
        nqCH := nqH
        nqCHb := bar_index
    if na(nqCL) or nqL < nqCL
        nqCL := nqL
        nqCLb := bar_index
    if na(nqCHC) or nqC > nqCHC
        nqCHC := nqC
        nqCHCb := bar_index
    if na(nqCLC) or nqC < nqCLC
        nqCLC := nqC
        nqCLCb := bar_index

// ── ES צבירה ──
if newRefCycle
    if newLifeCycle
        array.clear(esHiA)
        array.clear(esLoA)
        array.clear(esHiCA)
        array.clear(esLoCA)
        array.clear(esHiBA)
        array.clear(esLoBA)
        array.clear(esHiCBA)
        array.clear(esLoCBA)
    if ((not newLifeCycle) or keepLast) and not na(esCH)
        array.push(esHiA,  esCH)
        array.push(esLoA,  esCL)
        array.push(esHiCA, esCHC)
        array.push(esLoCA, esCLC)
        array.push(esHiBA,  esCHb)
        array.push(esLoBA,  esCLb)
        array.push(esHiCBA, esCHCb)
        array.push(esLoCBA, esCLCb)
    esCH := esH
    esCL := esL
    esCHC := esC
    esCLC := esC
    esCHb := bar_index
    esCLb := bar_index
    esCHCb := bar_index
    esCLCb := bar_index
else
    if na(esCH) or esH > esCH
        esCH := esH
        esCHb := bar_index
    if na(esCL) or esL < esCL
        esCL := esL
        esCLb := bar_index
    if na(esCHC) or esC > esCHC
        esCHC := esC
        esCHCb := bar_index
    if na(esCLC) or esC < esCLC
        esCLC := esC
        esCLCb := bar_index

// ── YM צבירה ──
if newRefCycle
    if newLifeCycle
        array.clear(ymHiA)
        array.clear(ymLoA)
        array.clear(ymHiCA)
        array.clear(ymLoCA)
        array.clear(ymHiBA)
        array.clear(ymLoBA)
        array.clear(ymHiCBA)
        array.clear(ymLoCBA)
    if ((not newLifeCycle) or keepLast) and not na(ymCH)
        array.push(ymHiA,  ymCH)
        array.push(ymLoA,  ymCL)
        array.push(ymHiCA, ymCHC)
        array.push(ymLoCA, ymCLC)
        array.push(ymHiBA,  ymCHb)
        array.push(ymLoBA,  ymCLb)
        array.push(ymHiCBA, ymCHCb)
        array.push(ymLoCBA, ymCLCb)
    ymCH := ymH
    ymCL := ymL
    ymCHC := ymC
    ymCLC := ymC
    ymCHb := bar_index
    ymCLb := bar_index
    ymCHCb := bar_index
    ymCLCb := bar_index
else
    if na(ymCH) or ymH > ymCH
        ymCH := ymH
        ymCHb := bar_index
    if na(ymCL) or ymL < ymCL
        ymCL := ymL
        ymCLb := bar_index
    if na(ymCHC) or ymC > ymCHC
        ymCHC := ymC
        ymCHCb := bar_index
    if na(ymCLC) or ymC < ymCLC
        ymCLC := ymC
        ymCLCb := bar_index

// ═══════════════════════════════════════════════════════════════════
// חסימות: שבוע מת (4H בלבד) + יום שישי (4H/1H)
// ═══════════════════════════════════════════════════════════════════

nLevels = array.size(nqHiA)
cycleOK   = not (tfClass == 5 and blockDeadWeek and isDeadWeek)
friBlock  = (tfClass == 5 or tfClass == 4) and tdDow == dayofweek.friday

bearOK = not requireTrueOpen or (not na(trueOpenPrice) and close > trueOpenPrice)
bullOK = not requireTrueOpen or (not na(trueOpenPrice) and close < trueOpenPrice)

// ═══════════════════════════════════════════════════════════════════
// מחרוזת נכסים — בשורי YM מושמט
// ═══════════════════════════════════════════════════════════════════

f_str(bNQ, bES, bYM, isBull) =>
    s = ""
    s := bNQ ? s + "NQ " : s
    s := bES ? s + "ES " : s
    s := (bYM and not isBull) ? s + "YM " : s
    str.trim(s)

// ═══════════════════════════════════════════════════════════════════
// זיהוי — לולאה מול כל רמה של כל תת-מחזור קודם במיכל
// דובי (גבוהים): מעדיף HSSMT; בכל רמה — anyTook and not(NQ&ES) [YM אסימטרי].
// בוחר את הרמה הגבוהה ביותר שבה יש סטייה.
// ═══════════════════════════════════════════════════════════════════

f_findBear(nqHiA, esHiA, ymHiA, nqHiCA, esHiCA, ymHiCA, isNQ, isES, nqCH, esCH, ymCH, nqCHC, esCHC, ymCHC) =>
    bT = 0
    bI = -1
    bS = ""
    bRef = na
    n = array.size(nqHiA)
    if n > 0
        for i = 0 to n - 1
            nc = nqCHC > array.get(nqHiCA, i)
            ec = esCHC > array.get(esHiCA, i)
            yc = ymCHC > array.get(ymHiCA, i)
            if (nc or ec or yc) and not (nc and ec)
                clvl = isNQ ? array.get(nqHiCA, i) : isES ? array.get(esHiCA, i) : array.get(ymHiCA, i)
                if bT < 2 or (bT == 2 and clvl > bRef)
                    bT := 2
                    bI := i
                    bS := f_str(nc, ec, yc, false)
                    bRef := clvl
            nw = nqCH > array.get(nqHiA, i)
            ew = esCH > array.get(esHiA, i)
            yw = ymCH > array.get(ymHiA, i)
            if bT < 2 and (nw or ew or yw) and not (nw and ew) and not (nc and ec)
                clvl = isNQ ? array.get(nqHiA, i) : isES ? array.get(esHiA, i) : array.get(ymHiA, i)
                if bT < 1 or (bT == 1 and clvl > bRef)
                    bT := 1
                    bI := i
                    bS := f_str(nw, ew, yw, false)
                    bRef := clvl
    [bT, bI, bS]

f_findBull(nqLoA, esLoA, ymLoA, nqLoCA, esLoCA, ymLoCA, isNQ, isES, nqCL, esCL, ymCL, nqCLC, esCLC, ymCLC) =>
    bT = 0
    bI = -1
    bS = ""
    bRef = na
    n = array.size(nqLoA)
    if n > 0
        for i = 0 to n - 1
            nc = nqCLC < array.get(nqLoCA, i)
            ec = esCLC < array.get(esLoCA, i)
            yc = ymCLC < array.get(ymLoCA, i)
            if (nc or ec) and not (nc and ec and yc)
                clvl = isNQ ? array.get(nqLoCA, i) : isES ? array.get(esLoCA, i) : array.get(ymLoCA, i)
                if bT < 2 or (bT == 2 and clvl < bRef)
                    bT := 2
                    bI := i
                    bS := f_str(nc, ec, yc, true)
                    bRef := clvl
            nw = nqCL < array.get(nqLoA, i)
            ew = esCL < array.get(esLoA, i)
            yw = ymCL < array.get(ymLoA, i)
            if bT < 2 and (nw or ew) and not (nw and ew and yw) and not (nc and ec and yc)
                clvl = isNQ ? array.get(nqLoA, i) : isES ? array.get(esLoA, i) : array.get(ymLoA, i)
                if bT < 1 or (bT == 1 and clvl < bRef)
                    bT := 1
                    bI := i
                    bS := f_str(nw, ew, yw, true)
                    bRef := clvl
    [bT, bI, bS]

// ═══════════════════════════════════════════════════════════════════
// נכס הגרף
// ═══════════════════════════════════════════════════════════════════

cs = syminfo.tickerid
isNQc = str.contains(cs, "NQ")
isESc = str.contains(cs, "ES")
isYMc = str.contains(cs, "YM")

// ═══════════════════════════════════════════════════════════════════
// מצב מבוסס אירוע
// ═══════════════════════════════════════════════════════════════════

atr = ta.atr(14)

var int    bearType = 0
var string bearStr  = ""
var float  bearLvl  = na
var int    bearRefB = 0
var int    bearSigB = 0
var float  bearYPos = na
var int    bearSeq  = 0
var float  bearWFrozNQ = na
var float  bearWFrozES = na
var float  bearCFrozNQ = na
var float  bearCFrozES = na
var bool   bearWTkNQ = false
var bool   bearWTkES = false
var bool   bearCTkNQ = false
var bool   bearCTkES = false

var int    bullType = 0
var string bullStr  = ""
var float  bullLvl  = na
var int    bullRefB = 0
var int    bullSigB = 0
var float  bullYPos = na
var int    bullSeq  = 0
var float  bullWFrozNQ = na
var float  bullWFrozES = na
var float  bullWFrozYM = na
var float  bullCFrozNQ = na
var float  bullCFrozES = na
var float  bullCFrozYM = na
var bool   bullWTkNQ = false
var bool   bullWTkES = false
var bool   bullWTkYM = false
var bool   bullCTkNQ = false
var bool   bullCTkES = false
var bool   bullCTkYM = false

var int seqCounter = 0

// ── פקיעת מחזור־על — מוחקת הכול ──
if newLifeCycle
    bearType := 0
    bullType := 0
    bearStr  := ""
    bullStr  := ""

// ── ביטול דובי: מת כששני החזקים (NQ+ES) לקחו את אותה רמה שהוקפאה ──
if bearType != 0
    if not na(bearWFrozNQ) and nqH > bearWFrozNQ
        bearWTkNQ := true
    if not na(bearWFrozES) and esH > bearWFrozES
        bearWTkES := true
    if barstate.isconfirmed
        if not na(bearCFrozNQ) and nqC > bearCFrozNQ
            bearCTkNQ := true
        if not na(bearCFrozES) and esC > bearCFrozES
            bearCTkES := true
    dieBear = bearType == 1 ? ((bearWTkNQ and bearWTkES) or (barstate.isconfirmed and bearCTkNQ and bearCTkES)) : (barstate.isconfirmed and bearCTkNQ and bearCTkES)
    if dieBear
        bearType := 0
        bearStr  := ""

// ── ביטול שורי: מת כשכל שלושת הנכסים לקחו את אותה רמה שהוקפאה ──
if bullType != 0
    if not na(bullWFrozNQ) and nqL < bullWFrozNQ
        bullWTkNQ := true
    if not na(bullWFrozES) and esL < bullWFrozES
        bullWTkES := true
    if not na(bullWFrozYM) and ymL < bullWFrozYM
        bullWTkYM := true
    if barstate.isconfirmed
        if not na(bullCFrozNQ) and nqC < bullCFrozNQ
            bullCTkNQ := true
        if not na(bullCFrozES) and esC < bullCFrozES
            bullCTkES := true
        if not na(bullCFrozYM) and ymC < bullCFrozYM
            bullCTkYM := true
    dieBull = bullType == 1 ? ((bullWTkNQ and bullWTkES and bullWTkYM) or (barstate.isconfirmed and bullCTkNQ and bullCTkES and bullCTkYM)) : (barstate.isconfirmed and bullCTkNQ and bullCTkES and bullCTkYM)
    if dieBull
        bullType := 0
        bullStr  := ""

// ── רישום שבירות חדשות בסגירת נר ──
if barstate.isconfirmed and tfClass != 0 and not friBlock and cycleOK and nLevels > 0

    [nbT, nbI, nbS] = f_findBear(nqHiA, esHiA, ymHiA, nqHiCA, esHiCA, ymHiCA, isNQc, isESc, nqCH, esCH, ymCH, nqCHC, esCHC, ymCHC)
    if nbT != 0 and bearOK
        if nbT != bearType or nbS != bearStr
            seqCounter += 1
            bearType := nbT
            bearStr  := nbS
            bearLvl  := nbT == 2 ? (isNQc ? array.get(nqHiCA, nbI) : isESc ? array.get(esHiCA, nbI) : array.get(ymHiCA, nbI)) : (isNQc ? array.get(nqHiA, nbI) : isESc ? array.get(esHiA, nbI) : array.get(ymHiA, nbI))
            bearRefB := nbT == 2 ? (isNQc ? array.get(nqHiCBA, nbI) : isESc ? array.get(esHiCBA, nbI) : array.get(ymHiCBA, nbI)) : (isNQc ? array.get(nqHiBA, nbI) : isESc ? array.get(esHiBA, nbI) : array.get(ymHiBA, nbI))
            bearSigB := bar_index
            bearYPos := high + atr * offsetMlt
            bearSeq  := seqCounter
            bearWFrozNQ := array.get(nqHiA, nbI)
            bearWFrozES := array.get(esHiA, nbI)
            bearCFrozNQ := array.get(nqHiCA, nbI)
            bearCFrozES := array.get(esHiCA, nbI)
            bearWTkNQ := nqCH > bearWFrozNQ
            bearWTkES := esCH > bearWFrozES
            bearCTkNQ := nqCHC > bearCFrozNQ
            bearCTkES := esCHC > bearCFrozES
            // שבירה נגדית מוחקת לגמרי את השורית הקיימת
            bullType := 0
            bullStr  := ""

    [nuT, nuI, nuS] = f_findBull(nqLoA, esLoA, ymLoA, nqLoCA, esLoCA, ymLoCA, isNQc, isESc, nqCL, esCL, ymCL, nqCLC, esCLC, ymCLC)
    if nuT != 0 and bullOK
        if nuT != bullType or nuS != bullStr
            seqCounter += 1
            bullType := nuT
            bullStr  := nuS
            bullLvl  := nuT == 2 ? (isNQc ? array.get(nqLoCA, nuI) : isESc ? array.get(esLoCA, nuI) : array.get(ymLoCA, nuI)) : (isNQc ? array.get(nqLoA, nuI) : isESc ? array.get(esLoA, nuI) : array.get(ymLoA, nuI))
            bullRefB := nuT == 2 ? (isNQc ? array.get(nqLoCBA, nuI) : isESc ? array.get(esLoCBA, nuI) : array.get(ymLoCBA, nuI)) : (isNQc ? array.get(nqLoBA, nuI) : isESc ? array.get(esLoBA, nuI) : array.get(ymLoBA, nuI))
            bullSigB := bar_index
            bullYPos := low - atr * offsetMlt
            bullSeq  := seqCounter
            bullWFrozNQ := array.get(nqLoA, nuI)
            bullWFrozES := array.get(esLoA, nuI)
            bullWFrozYM := array.get(ymLoA, nuI)
            bullCFrozNQ := array.get(nqLoCA, nuI)
            bullCFrozES := array.get(esLoCA, nuI)
            bullCFrozYM := array.get(ymLoCA, nuI)
            bullWTkNQ := nqCL < bullWFrozNQ
            bullWTkES := esCL < bullWFrozES
            bullWTkYM := ymCL < bullWFrozYM
            bullCTkNQ := nqCLC < bullCFrozNQ
            bullCTkES := esCLC < bullCFrozES
            bullCTkYM := ymCLC < bullCFrozYM
            // שבירה נגדית מוחקת לגמרי את הדובית הקיימת
            bearType := 0
            bearStr  := ""

// ═══════════════════════════════════════════════════════════════════
// בחירת מה מוצג
// ═══════════════════════════════════════════════════════════════════

showDir = 0
if bearType != 0 and bullType != 0
    showDir := bearSeq > bullSeq ? -1 : 1
else if bearType != 0
    showDir := -1
else if bullType != 0
    showDir := 1

dispType = showDir == -1 ? bearType : showDir == 1 ? bullType : 0
dispStr  = showDir == -1 ? bearStr  : showDir == 1 ? bullStr  : ""
dispLvl  = showDir == -1 ? bearLvl  : showDir == 1 ? bullLvl  : na
dispRefB = showDir == -1 ? bearRefB : showDir == 1 ? bullRefB : 0
dispSigB = showDir == -1 ? bearSigB : showDir == 1 ? bullSigB : 0
dispYPos = showDir == -1 ? bearYPos : showDir == 1 ? bullYPos : na
curSeq   = showDir == -1 ? bearSeq  : showDir == 1 ? bullSeq  : -1

// ═══════════════════════════════════════════════════════════════════
// ציור
// ═══════════════════════════════════════════════════════════════════

var label aLbl  = na
var line  aLine = na
var int   drawnSeq  = -999
var int   drawnDir  = -999
var int   drawnType = -999

needRedraw = curSeq != drawnSeq or showDir != drawnDir or dispType != drawnType

if needRedraw
    if not na(aLbl)
        label.delete(aLbl)
        aLbl := na
    if not na(aLine)
        line.delete(aLine)
        aLine := na
    if showDir != 0 and not na(dispYPos)
        col  = showDir == 1 ? colBull : colBear
        cFin = dispType == 2 ? col : color.new(col, 30)
        txt  = "W " + (dispType == 2 ? "H " : "S ") + dispStr
        aLbl := label.new(dispSigB, dispYPos, txt, style = label.style_none, textcolor = cFin, size = labelSize, textalign = text.align_center)
        if showLine and not na(dispLvl) and dispRefB > 0
            aLine := line.new(dispRefB, dispLvl, bar_index, dispLvl, color = cFin, style = line.style_solid, width = lineWidth)
    drawnSeq  := curSeq
    drawnDir  := showDir
    drawnType := dispType

if not na(aLine) and showDir != 0
    line.set_x2(aLine, bar_index)

// ═══════════════════════════════════════════════════════════════════
// טבלת בדיקה (אבחון — כבויה כברירת מחדל)
// ═══════════════════════════════════════════════════════════════════

var table dbg = table.new(position.top_right, 2, 9, border_width = 1)
if showDebug and barstate.islast
    table.cell(dbg, 0, 0, "tfClass", bgcolor = color.gray, text_color = color.white)
    table.cell(dbg, 1, 0, str.tostring(tfClass), bgcolor = color.white)
    table.cell(dbg, 0, 1, "רמות במיכל", bgcolor = color.gray, text_color = color.white)
    table.cell(dbg, 1, 1, str.tostring(nLevels), bgcolor = color.white)
    table.cell(dbg, 0, 2, "bear/bull", bgcolor = color.gray, text_color = color.white)
    table.cell(dbg, 1, 2, str.tostring(bearType) + " / " + str.tostring(bullType), bgcolor = color.white)
    table.cell(dbg, 0, 3, "showDir", bgcolor = color.gray, text_color = color.white)
    table.cell(dbg, 1, 3, str.tostring(showDir), bgcolor = color.white)
    table.cell(dbg, 0, 4, "bearStr", bgcolor = color.gray, text_color = color.white)
    table.cell(dbg, 1, 4, bearStr, bgcolor = color.white)
    table.cell(dbg, 0, 5, "bullStr", bgcolor = color.gray, text_color = color.white)
    table.cell(dbg, 1, 5, bullStr, bgcolor = color.white)
    table.cell(dbg, 0, 6, "NQ curHi/Lo", bgcolor = color.gray, text_color = color.white)
    table.cell(dbg, 1, 6, str.tostring(nqCH, format.mintick) + "/" + str.tostring(nqCL, format.mintick), bgcolor = color.white)
    table.cell(dbg, 0, 7, "ES curHi/Lo", bgcolor = color.gray, text_color = color.white)
    table.cell(dbg, 1, 7, str.tostring(esCH, format.mintick) + "/" + str.tostring(esCL, format.mintick), bgcolor = color.white)
    table.cell(dbg, 0, 8, "YM curHi/Lo", bgcolor = color.gray, text_color = color.white)
    table.cell(dbg, 1, 8, str.tostring(ymCH, format.mintick) + "/" + str.tostring(ymCL, format.mintick), bgcolor = color.white)
