//@version=5
indicator("SSMT + HSSMT | Quarterly Theory", overlay = true, max_labels_count = 20, max_lines_count = 20)

// ═══════════════════════════════════════════════════════════════════
// הגדרות משתמש
// ═══════════════════════════════════════════════════════════════════

// סימבול אחד לכל נכס. אין מתג מיקרו/רגיל: מתג כזה גורם ל-TradingView לטעון
// את שני הסטים במקביל (שישה סימבולים) ולפוצץ את מגבלת הזיכרון. להחליף ל-NQ1!/
// ES1!/YM1! פשוט ע"י הקלדה כאן — הסטייה יחסית ולא תלויה בגודל החוזה.
grpSym = "סימבולים"
symNQ = input.symbol("CME_MINI:MNQ1!",  "NQ", group = grpSym)
symES = input.symbol("CME_MINI:MES1!",  "ES", group = grpSym)
symYM = input.symbol("CBOT_MINI:MYM1!", "YM", group = grpSym)

grpVis = "תצוגה"
colBull    = input.color(#26a69a, "צבע שורי", group = grpVis)
colBear    = input.color(#ef5350, "צבע דובי", group = grpVis)
labelSize  = input.string("small", "גודל תווית", options = ["tiny", "small", "normal"], group = grpVis)
offsetMlt  = input.float(1.5, "מרחק התווית מהנר (ATR)", minval = 0.1, maxval = 6.0, step = 0.1, group = grpVis)
showLine   = input.bool(true, "הצג קו שבירה", group = grpVis)
lineWidth  = input.int(2, "עובי קו", minval = 1, maxval = 4, group = grpVis)
showDebug  = input.bool(false, "הצג טבלת בדיקה", group = grpVis)

grpLogic = "לוגיקה"
requireTrueOpen = input.bool(false, "סנן לפי True Open (פרימיום/דיסקאונט)", group = grpLogic)
blockDeadWeek   = input.bool(true, "חסום שבירות בשבוע מת (4H בלבד)", group = grpLogic)

grpMTF = "מסגרות זמן"
mtfOn      = input.bool(true,  "הצג מסגרות זמן אחרות", group = grpMTF)
mtfMark    = input.bool(true,  "הצג סימון זעיר משאר המסגרות", group = grpMTF)
mtfMarkPos = input.string("שמאל למטה", "מיקום הסימון", options = ["שמאל למטה", "שמאל למעלה", "אמצע למטה", "ימין למטה"], group = grpMTF)
mtfPanel   = input.bool(false, "הצג פאנל מסגרות זמן", group = grpMTF)
mtfPanPos  = input.string("ימין למטה", "מיקום הפאנל", options = ["ימין למטה", "ימין למעלה", "שמאל למטה", "שמאל למעלה"], group = grpMTF)
mtfColor   = input.color(color.white, "צבע הסימון והפאנל", group = grpMTF)
mtfAlert   = input.bool(true,  "כלול שבירות ממסגרות אחרות בהתראה", group = grpMTF)

// ═══════════════════════════════════════════════════════════════════
// בחירת סימבולים
// ═══════════════════════════════════════════════════════════════════

sNQ = symNQ
sES = symES
sYM = symYM

// ═══════════════════════════════════════════════════════════════════
// זיהוי Timeframe
// ═══════════════════════════════════════════════════════════════════

tfMin   = timeframe.in_seconds() / 60
// 6 = יומי (ייחוס חודש, מיכל רבעון), 7 = שבועי (ייחוס רבעון, מיכל שנה).
// רק 1D ו-1W בדיוק; כל טווח אחר מעל 4H כבוי.
isD1 = timeframe.isdaily  and timeframe.multiplier == 1
isW1 = timeframe.isweekly and timeframe.multiplier == 1
tfClass = isD1 ? 6 : isW1 ? 7 : tfMin <= 1 ? 1 : tfMin <= 5 ? 2 : tfMin <= 15 ? 3 : tfMin <= 60 ? 4 : tfMin <= 240 ? 5 : 0

// ═══════════════════════════════════════════════════════════════════
// חישובי זמן EST
// ═══════════════════════════════════════════════════════════════════

TZ = "America/New_York"
estHour = hour(time, TZ)
estMin  = minute(time, TZ)

minutesOfDay = estHour * 60 + estMin

isPostOpen       = minutesOfDay >= 1080
minsFromDayStart = isPostOpen ? minutesOfDay - 1080 : minutesOfDay + 360

tradeDayTime = isPostOpen ? time + 86400000 : time
tdYear = year(tradeDayTime, TZ)
tdMon  = month(tradeDayTime, TZ)
tdDom  = dayofmonth(tradeDayTime, TZ)
tdDow  = dayofweek(tradeDayTime, TZ)

sessionIdx    = math.floor(minsFromDayStart / 360)
minsInSession = minsFromDayStart % 360
microIdx      = math.floor(minsInSession / 90)
minsInMicro   = minsInSession % 90
quarterIdx    = math.floor(minsInMicro / 22.5)

// ═══════════════════════════════════════════════════════════════════
// מספור שבועות לפי QT
// ═══════════════════════════════════════════════════════════════════

daysSinceMonday = tdDow == dayofweek.sunday ? 6 : tdDow - 2
mondayTime      = tradeDayTime - daysSinceMonday * 86400000
tuesdayTime     = mondayTime + 86400000
thursdayTime    = mondayTime + 3 * 86400000

monMonth = month(mondayTime, TZ)
monDom   = dayofmonth(mondayTime, TZ)
monYear  = year(mondayTime, TZ)
// העוגן לשיוך שבוע לחודש הוא יום **שלישי**, לא יום שני. שבוע שרק יום שני שלו
// בחודש הקודם (למשל 31.8 שנופל בשני) הוא ארבעה ימים בחודש החדש, ולכן הוא
// השבוע הראשון של החודש החדש — לא שבוע מת ולא שבוע של החודש הקודם.
tueMonth = month(tuesdayTime, TZ)
tueDom   = dayofmonth(tuesdayTime, TZ)
tueYear  = year(tuesdayTime, TZ)
thuMonth = month(thursdayTime, TZ)

// שבוע מת = שלישי וחמישי בחודשים שונים, כלומר לאף חודש אין 4 מתוך 5 ימי המסחר
// (שני+שלישי בחודש הישן, או שני–רביעי בו). מספור השבוע נספר לפי יום שלישי,
// ולכן שלישי 1.9 = שבוע 1 ושלישי 8.9 = שבוע 2 (שבוע ה-CPI).
isDeadWeek = tueMonth != thuMonth
qtWeekNum  = isDeadWeek ? 0 : math.floor((tueDom - 1) / 7) + 1

// ═══════════════════════════════════════════════════════════════════
// שנת QT — מתחילה באפריל. Q1 = אפר/מאי/יונ, Q2 = יול/אוג/ספט,
// Q3 = אוק/נוב/דצמ, Q4 = ינו/פבר/מרץ (של שנת הלוח הבאה).
// מעל השנה: מחזור של 4 שנים, שנה שמתחלקת ב-4 (2024, 2028) היא שנה 1.
// ═══════════════════════════════════════════════════════════════════

qtMonIdx    = tdMon >= 4 ? tdMon - 4 : tdMon + 8   // 0 = אפריל ... 11 = מרץ
qtYearNum   = tdMon >= 4 ? tdYear : tdYear - 1     // תווית שנת QT (אפריל–מרץ)
qtQtrNum    = math.floor(qtMonIdx / 3) + 1         // 1..4 בתוך שנת QT
yearInCyc   = qtYearNum % 4                        // 0..3 — מקום השנה במחזור ה-4

// ═══════════════════════════════════════════════════════════════════
// מזהי מחזורים
// ═══════════════════════════════════════════════════════════════════

tradeDayId = tdYear * 10000 + tdMon * 100 + tdDom
weekId     = monYear * 10000 + monMonth * 100 + monDom   // מזהה ייחודי לשבוע — לפי יום שני
// חודש-מחזור ל-4H נקבע לפי חודש יום-**שלישי** של השבוע — כך הגבול נופל תמיד
// בתחילת שבוע, והשבוע נספר לחודש שבו נמצאים לפחות 4 מ-5 ימי המסחר שלו.
monthId    = tueYear * 100 + tueMonth
sessionId  = tradeDayId * 10 + sessionIdx
microId    = sessionId * 10 + microIdx
quarterId  = microId * 10 + quarterIdx
// ביומי הרבעון נקבע לפי חודש יום-המסחר; בשבועי הרבעון/שנה נקבעים לפי יום-שני
// של השבוע — אותו כלל שמשייך שבוע לחודש ב-4H, כך שהגבול נופל תמיד בתחילת שבוע.
qtrId      = qtYearNum * 10 + qtQtrNum
qtYearId   = qtYearNum
cyc4Id     = math.floor(qtYearNum / 4)

refCycleId = 0
if tfClass == 7
    refCycleId := qtYearId
else if tfClass == 6
    refCycleId := qtrId
else if tfClass == 5
    refCycleId := weekId
else if tfClass == 4
    refCycleId := tradeDayId
else if tfClass == 3
    refCycleId := sessionId
else if tfClass == 2
    refCycleId := microId
else if tfClass == 1
    refCycleId := quarterId

lifeCycleId = 0
if tfClass == 7
    lifeCycleId := cyc4Id
else if tfClass == 6
    lifeCycleId := qtYearId
else if tfClass == 5
    lifeCycleId := monthId
else if tfClass == 4
    lifeCycleId := weekId
else if tfClass == 3
    lifeCycleId := tradeDayId
else if tfClass == 2
    lifeCycleId := sessionId
else if tfClass == 1
    lifeCycleId := microId

newRefCycle  = ta.change(refCycleId)  != 0
newLifeCycle = ta.change(lifeCycleId) != 0

// ב-1H תת-המחזור הראשון (יום שני) משווה לתת-המחזור האחרון של השבוע הקודם (שישי),
// אבל אותו "זרע" נמחק אחרי היום הראשון — שישי משווה רק לשני, לא לשאר השבוע.
// ב-4H המחזור החודשי עומד בפני עצמו: השבועות משווים רק בתוך אותו חודש (בלי חודש קודם).
// ביומי ובשבועי אותו עיקרון כמו 1H: הרבעון/השנה הראשונים של המיכל משווים גם ליחידה
// האחרונה של המיכל הקודם (Q1 מול Q4 הקודם), והזרע הזה נמחק אחרי היחידה הראשונה.
keepLast = tfClass == 4 or tfClass == 6 or tfClass == 7

// ═══════════════════════════════════════════════════════════════════
// True Open
// ═══════════════════════════════════════════════════════════════════

inCyc4Q2    = yearInCyc == 1         // השנה השנייה במחזור ה-4 (2025, 2029)
inYearlyQ2  = qtQtrNum == 2          // Q2 של שנת QT = יול/אוג/ספט
inMonthlyQ2 = qtWeekNum == 2
inWeeklyQ2  = tdDow == dayofweek.tuesday
inDailyQ2   = minsFromDayStart >= 360 and minsFromDayStart < 720
inSessionQ2 = microIdx == 1
inMicroQ2   = quarterIdx == 1

var bool pCycQ2 = false
var bool pYrQ2  = false
var bool pMonQ2 = false
var bool pWkQ2  = false
var bool pDayQ2 = false
var bool pSesQ2 = false
var bool pMicQ2 = false

isTrueOpenBar = false
if tfClass == 7
    isTrueOpenBar := inCyc4Q2 and not pCycQ2
else if tfClass == 6
    isTrueOpenBar := inYearlyQ2 and not pYrQ2
else if tfClass == 5
    isTrueOpenBar := inMonthlyQ2 and not pMonQ2
else if tfClass == 4
    isTrueOpenBar := inWeeklyQ2 and not pWkQ2
else if tfClass == 3
    isTrueOpenBar := inDailyQ2 and not pDayQ2
else if tfClass == 2
    isTrueOpenBar := inSessionQ2 and not pSesQ2
else if tfClass == 1
    isTrueOpenBar := inMicroQ2 and not pMicQ2

pCycQ2 := inCyc4Q2
pYrQ2  := inYearlyQ2
pMonQ2 := inMonthlyQ2
pWkQ2  := inWeeklyQ2
pDayQ2 := inDailyQ2
pSesQ2 := inSessionQ2
pMicQ2 := inMicroQ2

var float trueOpenPrice = na
if isTrueOpenBar
    trueOpenPrice := open

// ═══════════════════════════════════════════════════════════════════
// משיכת נתוני שלושת הנכסים
// ═══════════════════════════════════════════════════════════════════

[nqH, nqL, nqC] = request.security(sNQ, timeframe.period, [high, low, close], lookahead = barmerge.lookahead_off)
[esH, esL, esC] = request.security(sES, timeframe.period, [high, low, close], lookahead = barmerge.lookahead_off)
[ymH, ymL, ymC] = request.security(sYM, timeframe.period, [high, low, close], lookahead = barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════
// צבירת מחזור + מערך רמות לכל תת-מחזור שהסתיים בתוך המיכל
// ═══════════════════════════════════════════════════════════════════

// NQ — מצבר תת-מחזור נוכחי
var float nqCH = na
var float nqCL = na
var float nqCHC = na
var float nqCLC = na
var int   nqCHb = 0
var int   nqCLb = 0
var int   nqCHCb = 0
var int   nqCLCb = 0
var nqHiA  = array.new_float()
var nqLoA  = array.new_float()
var nqHiCA = array.new_float()
var nqLoCA = array.new_float()
var nqHiBA  = array.new_int()
var nqLoBA  = array.new_int()
var nqHiCBA = array.new_int()
var nqLoCBA = array.new_int()

// ES
var float esCH = na
var float esCL = na
var float esCHC = na
var float esCLC = na
var int   esCHb = 0
var int   esCLb = 0
var int   esCHCb = 0
var int   esCLCb = 0
var esHiA  = array.new_float()
var esLoA  = array.new_float()
var esHiCA = array.new_float()
var esLoCA = array.new_float()
var esHiBA  = array.new_int()
var esLoBA  = array.new_int()
var esHiCBA = array.new_int()
var esLoCBA = array.new_int()

// YM
var float ymCH = na
var float ymCL = na
var float ymCHC = na
var float ymCLC = na
var int   ymCHb = 0
var int   ymCLb = 0
var int   ymCHCb = 0
var int   ymCLCb = 0
var ymHiA  = array.new_float()
var ymLoA  = array.new_float()
var ymHiCA = array.new_float()
var ymLoCA = array.new_float()
var ymHiBA  = array.new_int()
var ymLoBA  = array.new_int()
var ymHiCBA = array.new_int()
var ymLoCBA = array.new_int()

// דגלי ה"זרע" — מחושבים כאן, כשהמצברים עדיין מחזיקים את ערך התת-מחזור הקודם.
var bool seedActive = false
seedPushNow = newRefCycle and newLifeCycle and keepLast and not na(nqCH)
dropSeedNow = newRefCycle and (not newLifeCycle) and seedActive

// ── NQ צבירה ──
if newRefCycle
    if newLifeCycle
        array.clear(nqHiA)
        array.clear(nqLoA)
        array.clear(nqHiCA)
        array.clear(nqLoCA)
        array.clear(nqHiBA)
        array.clear(nqLoBA)
        array.clear(nqHiCBA)
        array.clear(nqLoCBA)
    if ((not newLifeCycle) or keepLast) and not na(nqCH)
        array.push(nqHiA,  nqCH)
        array.push(nqLoA,  nqCL)
        array.push(nqHiCA, nqCHC)
        array.push(nqLoCA, nqCLC)
        array.push(nqHiBA,  nqCHb)
        array.push(nqLoBA,  nqCLb)
        array.push(nqHiCBA, nqCHCb)
        array.push(nqLoCBA, nqCLCb)
    if dropSeedNow and array.size(nqHiA) > 0
        array.remove(nqHiA, 0)
        array.remove(nqLoA, 0)
        array.remove(nqHiCA, 0)
        array.remove(nqLoCA, 0)
        array.remove(nqHiBA, 0)
        array.remove(nqLoBA, 0)
        array.remove(nqHiCBA, 0)
        array.remove(nqLoCBA, 0)
    nqCH := nqH
    nqCL := nqL
    nqCHC := nqC
    nqCLC := nqC
    nqCHb := bar_index
    nqCLb := bar_index
    nqCHCb := bar_index
    nqCLCb := bar_index
else
    if na(nqCH) or nqH > nqCH
        nqCH := nqH
        nqCHb := bar_index
    if na(nqCL) or nqL < nqCL
        nqCL := nqL
        nqCLb := bar_index
    if na(nqCHC) or nqC > nqCHC
        nqCHC := nqC
        nqCHCb := bar_index
    if na(nqCLC) or nqC < nqCLC
        nqCLC := nqC
        nqCLCb := bar_index

// ── ES צבירה ──
if newRefCycle
    if newLifeCycle
        array.clear(esHiA)
        array.clear(esLoA)
        array.clear(esHiCA)
        array.clear(esLoCA)
        array.clear(esHiBA)
        array.clear(esLoBA)
        array.clear(esHiCBA)
        array.clear(esLoCBA)
    if ((not newLifeCycle) or keepLast) and not na(esCH)
        array.push(esHiA,  esCH)
        array.push(esLoA,  esCL)
        array.push(esHiCA, esCHC)
        array.push(esLoCA, esCLC)
        array.push(esHiBA,  esCHb)
        array.push(esLoBA,  esCLb)
        array.push(esHiCBA, esCHCb)
        array.push(esLoCBA, esCLCb)
    if dropSeedNow and array.size(esHiA) > 0
        array.remove(esHiA, 0)
        array.remove(esLoA, 0)
        array.remove(esHiCA, 0)
        array.remove(esLoCA, 0)
        array.remove(esHiBA, 0)
        array.remove(esLoBA, 0)
        array.remove(esHiCBA, 0)
        array.remove(esLoCBA, 0)
    esCH := esH
    esCL := esL
    esCHC := esC
    esCLC := esC
    esCHb := bar_index
    esCLb := bar_index
    esCHCb := bar_index
    esCLCb := bar_index
else
    if na(esCH) or esH > esCH
        esCH := esH
        esCHb := bar_index
    if na(esCL) or esL < esCL
        esCL := esL
        esCLb := bar_index
    if na(esCHC) or esC > esCHC
        esCHC := esC
        esCHCb := bar_index
    if na(esCLC) or esC < esCLC
        esCLC := esC
        esCLCb := bar_index

// ── YM צבירה ──
if newRefCycle
    if newLifeCycle
        array.clear(ymHiA)
        array.clear(ymLoA)
        array.clear(ymHiCA)
        array.clear(ymLoCA)
        array.clear(ymHiBA)
        array.clear(ymLoBA)
        array.clear(ymHiCBA)
        array.clear(ymLoCBA)
    if ((not newLifeCycle) or keepLast) and not na(ymCH)
        array.push(ymHiA,  ymCH)
        array.push(ymLoA,  ymCL)
        array.push(ymHiCA, ymCHC)
        array.push(ymLoCA, ymCLC)
        array.push(ymHiBA,  ymCHb)
        array.push(ymLoBA,  ymCLb)
        array.push(ymHiCBA, ymCHCb)
        array.push(ymLoCBA, ymCLCb)
    if dropSeedNow and array.size(ymHiA) > 0
        array.remove(ymHiA, 0)
        array.remove(ymLoA, 0)
        array.remove(ymHiCA, 0)
        array.remove(ymLoCA, 0)
        array.remove(ymHiBA, 0)
        array.remove(ymLoBA, 0)
        array.remove(ymHiCBA, 0)
        array.remove(ymLoCBA, 0)
    ymCH := ymH
    ymCL := ymL
    ymCHC := ymC
    ymCLC := ymC
    ymCHb := bar_index
    ymCLb := bar_index
    ymCHCb := bar_index
    ymCLCb := bar_index
else
    if na(ymCH) or ymH > ymCH
        ymCH := ymH
        ymCHb := bar_index
    if na(ymCL) or ymL < ymCL
        ymCL := ymL
        ymCLb := bar_index
    if na(ymCHC) or ymC > ymCHC
        ymCHC := ymC
        ymCHCb := bar_index
    if na(ymCLC) or ymC < ymCLC
        ymCLC := ymC
        ymCLCb := bar_index

// עדכון דגל ה"זרע" (המבט אחורה) — פעיל רק ליחידה הראשונה של המיכל
if newRefCycle and newLifeCycle
    seedActive := seedPushNow
else if newRefCycle
    seedActive := false

// ═══════════════════════════════════════════════════════════════════
// חסימות
// ═══════════════════════════════════════════════════════════════════

nLevels = array.size(nqHiA)
cycleOK   = not (tfClass == 5 and blockDeadWeek and isDeadWeek)
friBlock  = (tfClass == 5 or tfClass == 4) and tdDow == dayofweek.friday

bearOK = not requireTrueOpen or (not na(trueOpenPrice) and close > trueOpenPrice)
bullOK = not requireTrueOpen or (not na(trueOpenPrice) and close < trueOpenPrice)

// ═══════════════════════════════════════════════════════════════════
// מחרוזת נכסים — בשורי YM מושמט
// ═══════════════════════════════════════════════════════════════════

f_str(bNQ, bES, bYM, isBull) =>
    s = ""
    s := bNQ ? s + "NQ " : s
    s := bES ? s + "ES " : s
    s := (bYM and not isBull) ? s + "YM " : s
    str.trim(s)

// ═══════════════════════════════════════════════════════════════════
// זיהוי — השבירה הכי עדכנית, בלתי-תלוי בנכס הגרף. לקיחה מצטברת.
// HSSMT = סגר מעבר (ביטול כשכולם סגרו). SSMT = פתיל מעבר (ביטול כשכולם סחפו).
// מוחזר סטטוס-הלקיחה לפי סוג (סגירה ל-HSSMT / פתיל ל-SSMT) למעקב ביטול.
// ═══════════════════════════════════════════════════════════════════

// דובי: הסטייה הכי עדכנית (סשן קרוב-ביותר קודם). המחרוזת = כל מי שלקח את הגבוה
// בפתיל (כולל NQ). הסוג = H אם יש גם סגירה מעבר תקפה, אחרת S.
f_findBear(nqHiA, esHiA, ymHiA, nqHiCA, esHiCA, ymHiCA, nqCH, esCH, ymCH, nqCHC, esCHC, ymCHC) =>
    bT = 0
    bI = -1
    bS = ""
    n = array.size(nqHiA)
    if n > 0
        float nqMH  = nqCH
        float esMH  = esCH
        float ymMH  = ymCH
        float nqMHc = nqCHC
        float esMHc = esCHC
        float ymMHc = ymCHC
        // אין עצירה כשהגרעין הסכים על רבע מסוים: הגבוה של רבע ישן יותר (אסיה)
        // בדרך כלל גבוה מזה של הרבע שאחריו (לונדון), ולקיחת לונדון לא אומרת
        // שאסיה נלקחה. המקסימום המצטבר כבר מבטיח שרבע שכן נלקח לא ידווח.
        for i = n - 1 to 0
            if bT == 0
                nw = nqMH > array.get(nqHiA, i)    // פתיל מעל הפתיל-הגבוה של הייחוס (SSMT)
                ew = esMH > array.get(esHiA, i)
                yw = ymMH > array.get(ymHiA, i)
                nc = nqMHc > array.get(nqHiCA, i)  // סגירה מעל הסגירה-הגבוהה של הייחוס (HSSMT)
                ec = esMHc > array.get(esHiCA, i)
                yc = ymMHc > array.get(ymHiCA, i)
                hValid = (nc or ec or yc) and not (nc and ec)   // סטיית סגירה: מישהו סגר מעבר, לא שני החזקים
                wValid = (nw or ew or yw) and not (nw and ew)   // סטיית פתיל: מישהו סחף מעבר, לא שני החזקים
                if hValid or wValid
                    hN = hValid and nc
                    hE = hValid and ec
                    hY = hValid and yc
                    hs = f_str(hN, hE, hY, false)                                        // סגר מעל הסגירה-הגבוהה → H
                    ss = f_str(nw and not hN, ew and not hE, yw and not hY, false)       // סחף מעל הפתיל בלבד → S
                    ss := wValid ? ss : ""
                    lbl = hs != "" ? "H " + hs : ""
                    lbl := ss != "" ? (lbl != "" ? lbl + " S " + ss : "S " + ss) : lbl
                    // אין HSSMT כי הסגירות הסכימו, אבל ה-SSMT (פתיל) עדיין תקף — מסמנים זאת
                    if not hValid and nc and ec
                        lbl := lbl + (yc ? " (all closed)" : " (core closed)")
                    bT := hs != "" ? 2 : 1
                    bI := i
                    bS := lbl
            nqMH  := math.max(nqMH,  array.get(nqHiA, i))
            esMH  := math.max(esMH,  array.get(esHiA, i))
            ymMH  := math.max(ymMH,  array.get(ymHiA, i))
            nqMHc := math.max(nqMHc, array.get(nqHiCA, i))
            esMHc := math.max(esMHc, array.get(esHiCA, i))
            ymMHc := math.max(ymMHc, array.get(ymHiCA, i))
    [bT, bI, bS]

// שורי: המחרוזת = מי מהחזקים (NQ/ES) לקח את הנמוך בפתיל (YM מושמט מהתווית).
// הסוג = H אם יש סגירה מעבר תקפה. תקף עד שכל השלושה לקחו את הנמוך.
f_findBull(nqLoA, esLoA, ymLoA, nqLoCA, esLoCA, ymLoCA, nqCL, esCL, ymCL, nqCLC, esCLC, ymCLC) =>
    bT = 0
    bI = -1
    bS = ""
    n = array.size(nqLoA)
    if n > 0
        float nqML  = nqCL
        float esML  = esCL
        float ymML  = ymCL
        float nqMLc = nqCLC
        float esMLc = esCLC
        float ymMLc = ymCLC
        // אותו עיקרון כמו בדובי: לא עוצרים ברבע שהגרעין לקח, כי הנמוך של רבע
        // ישן יותר בדרך כלל נמוך יותר ועדיין לא נלקח. המינימום המצטבר מסנן.
        for i = n - 1 to 0
            if bT == 0
                nw = nqML < array.get(nqLoA, i)    // פתיל מתחת לפתיל-הנמוך של הייחוס (SSMT)
                ew = esML < array.get(esLoA, i)
                yw = ymML < array.get(ymLoA, i)
                nc = nqMLc < array.get(nqLoCA, i)  // סגירה מתחת לסגירה-הנמוכה של הייחוס (HSSMT)
                ec = esMLc < array.get(esLoCA, i)
                yc = ymMLc < array.get(ymLoCA, i)
                hValid = (nc or ec) and not (nc and ec and yc)   // סטיית סגירה: חזק אחד סגר מתחת, לא כל השלושה
                wValid = (nw or ew) and not (nw and ew and yw)   // סטיית פתיל: חזק אחד סחף מתחת, לא כל השלושה
                if hValid or wValid
                    hN = hValid and nc
                    hE = hValid and ec
                    hY = hValid and yc
                    hs = f_str(hN, hE, hY, true)                                         // סגר מתחת לסגירה-הנמוכה → H (YM מושמט)
                    ss = f_str(nw and not hN, ew and not hE, yw and not hY, true)        // סחף מתחת לפתיל בלבד → S (YM מושמט)
                    ss := wValid ? ss : ""
                    lbl = hs != "" ? "H " + hs : ""
                    lbl := ss != "" ? (lbl != "" ? lbl + " S " + ss : "S " + ss) : lbl
                    // כל השלושה סגרו מתחת — ה-HSSMT בטל, אבל ה-SSMT (פתיל) עדיין תקף
                    if not hValid and nc and ec and yc
                        lbl := lbl + " (all closed)"
                    bT := hs != "" ? 2 : 1
                    bI := i
                    bS := lbl
            nqML  := math.min(nqML,  array.get(nqLoA, i))
            esML  := math.min(esML,  array.get(esLoA, i))
            ymML  := math.min(ymML,  array.get(ymLoA, i))
            nqMLc := math.min(nqMLc, array.get(nqLoCA, i))
            esMLc := math.min(esMLc, array.get(esLoCA, i))
            ymMLc := math.min(ymMLc, array.get(ymLoCA, i))
    [bT, bI, bS]

// ═══════════════════════════════════════════════════════════════════
// נכס הגרף
// ═══════════════════════════════════════════════════════════════════

cs = syminfo.tickerid
isNQc = str.contains(cs, "NQ")
isESc = str.contains(cs, "ES")
isYMc = str.contains(cs, "YM")

// ═══════════════════════════════════════════════════════════════════
// מצב מבוסס אירוע
// ═══════════════════════════════════════════════════════════════════

atr = ta.atr(14)

var int    bearType = 0
var string bearStr  = ""
var float  bearLvl  = na
var int    bearRefB = 0
var int    bearSigB = 0
var float  bearYPos = na
var int    bearSeq  = 0
var int    bearRefI = -1

var int    bullType = 0
var string bullStr  = ""
var float  bullLvl  = na
var int    bullRefB = 0
var int    bullSigB = 0
var float  bullYPos = na
var int    bullSeq  = 0
var int    bullRefI = -1

var int seqCounter = 0

// ── פקיעת מחזור־על — מאפסת את מצב התצוגה ──
if newLifeCycle
    bearType := 0
    bullType := 0
    bearRefI := -1
    bullRefI := -1

// מחיקת ה"זרע" (1H / 1D / 1W) מזיזה את כל האינדקסים ב-1 — מיישרים כדי שלא ייחשב ייחוס חדש
if dropSeedNow
    bearRefI := bearRefI > 0 ? bearRefI - 1 : -1
    bullRefI := bullRefI > 0 ? bullRefI - 1 : -1

// ── עדכון חי בסגירת נר: מציגים את הסטייה התקפה הנוכחית לכל כיוון.
//    התווית גדלה (מוסיפה נכסים שלקחו) ומשדרגת S→H חי. סטייה שכבר לא תקפה
//    (הגרעין לקח את הרמה) נעלמת מעצמה; לקיחה מצטברת מונעת החייאה. ──
if barstate.isconfirmed and tfClass != 0 and not friBlock and cycleOK and nLevels > 0

    [nbT, nbI, nbS] = f_findBear(nqHiA, esHiA, ymHiA, nqHiCA, esHiCA, ymHiCA, nqCH, esCH, ymCH, nqCHC, esCHC, ymCHC)
    if nbT != 0 and bearOK
        // שבירה חדשה = כיוון שהיה כבוי, או התעגנות לתת-מחזור ייחוס אחר (גם אם הכיוון כבר היה חי)
        if bearType == 0 or nbI != bearRefI
            seqCounter += 1
            bearSeq  := seqCounter
        bearRefI := nbI
        bearSigB := bar_index                  // התווית עוקבת אחרי הנר הנוכחי
        bearYPos := high + atr * offsetMlt
        bearType := nbT
        bearStr  := nbS
        bearLvl  := nbT == 2 ? (isNQc ? array.get(nqHiCA, nbI) : isESc ? array.get(esHiCA, nbI) : array.get(ymHiCA, nbI)) : (isNQc ? array.get(nqHiA, nbI) : isESc ? array.get(esHiA, nbI) : array.get(ymHiA, nbI))
        bearRefB := nbT == 2 ? (isNQc ? array.get(nqHiCBA, nbI) : isESc ? array.get(esHiCBA, nbI) : array.get(ymHiCBA, nbI)) : (isNQc ? array.get(nqHiBA, nbI) : isESc ? array.get(esHiBA, nbI) : array.get(ymHiBA, nbI))
    else
        bearType := 0
        bearRefI := -1

    [nuT, nuI, nuS] = f_findBull(nqLoA, esLoA, ymLoA, nqLoCA, esLoCA, ymLoCA, nqCL, esCL, ymCL, nqCLC, esCLC, ymCLC)
    if nuT != 0 and bullOK
        // שבירה חדשה = כיוון שהיה כבוי, או התעגנות לתת-מחזור ייחוס אחר (גם אם הכיוון כבר היה חי)
        if bullType == 0 or nuI != bullRefI
            seqCounter += 1
            bullSeq  := seqCounter
        bullRefI := nuI
        bullSigB := bar_index                  // התווית עוקבת אחרי הנר הנוכחי
        bullYPos := low - atr * offsetMlt
        bullType := nuT
        bullStr  := nuS
        bullLvl  := nuT == 2 ? (isNQc ? array.get(nqLoCA, nuI) : isESc ? array.get(esLoCA, nuI) : array.get(ymLoCA, nuI)) : (isNQc ? array.get(nqLoA, nuI) : isESc ? array.get(esLoA, nuI) : array.get(ymLoA, nuI))
        bullRefB := nuT == 2 ? (isNQc ? array.get(nqLoCBA, nuI) : isESc ? array.get(esLoCBA, nuI) : array.get(ymLoCBA, nuI)) : (isNQc ? array.get(nqLoBA, nuI) : isESc ? array.get(esLoBA, nuI) : array.get(ymLoBA, nuI))
    else
        bullType := 0
        bullRefI := -1

// ═══════════════════════════════════════════════════════════════════
// בחירת מה מוצג
// ═══════════════════════════════════════════════════════════════════

showDir = 0
if bearType != 0 and bullType != 0
    showDir := bearSeq > bullSeq ? -1 : 1
else if bearType != 0
    showDir := -1
else if bullType != 0
    showDir := 1

// חידוד: שבירה שעתית מייצגת את השבוע (שני–חמישי) — ביום שישי היא כבר לא רלוונטית.
if tfClass == 4 and tdDow == dayofweek.friday
    showDir := 0

dispType = showDir == -1 ? bearType : showDir == 1 ? bullType : 0
dispStr  = showDir == -1 ? bearStr  : showDir == 1 ? bullStr  : ""
dispLvl  = showDir == -1 ? bearLvl  : showDir == 1 ? bullLvl  : na
dispRefB = showDir == -1 ? bearRefB : showDir == 1 ? bullRefB : 0
dispSigB = showDir == -1 ? bearSigB : showDir == 1 ? bullSigB : 0
dispYPos = showDir == -1 ? bearYPos : showDir == 1 ? bullYPos : na
curSeq   = showDir == -1 ? bearSeq  : showDir == 1 ? bullSeq  : -1

// ═══════════════════════════════════════════════════════════════════
// ציור
// ═══════════════════════════════════════════════════════════════════

var label aLbl  = na
var line  aLine = na
var int    drawnSeq  = -999
var int    drawnDir  = -999
var int    drawnType = -999
var string drawnStr  = ""
var float  drawnLvl  = na

needRedraw = curSeq != drawnSeq or showDir != drawnDir or dispType != drawnType or dispStr != drawnStr or dispLvl != drawnLvl

if needRedraw
    if not na(aLbl)
        label.delete(aLbl)
        aLbl := na
    if not na(aLine)
        line.delete(aLine)
        aLine := na
    if showDir != 0 and not na(dispYPos)
        col  = showDir == 1 ? colBull : colBear
        cFin = dispType == 2 ? col : color.new(col, 30)
        txt  = "W " + dispStr
        aLbl := label.new(dispSigB, dispYPos, txt, style = label.style_none, textcolor = cFin, size = labelSize, textalign = text.align_center)
        if showLine and not na(dispLvl) and dispRefB > 0
            aLine := line.new(dispRefB, dispLvl, bar_index, dispLvl, color = cFin, style = line.style_solid, width = lineWidth)
    drawnSeq  := curSeq
    drawnDir  := showDir
    drawnType := dispType
    drawnStr  := dispStr
    drawnLvl  := dispLvl

// התווית והקו עוקבים אחרי הנר הנוכחי
if not na(aLbl) and showDir != 0
    label.set_x(aLbl, dispSigB)
    label.set_y(aLbl, dispYPos)
if not na(aLine) and showDir != 0
    line.set_x2(aLine, bar_index)

// ═══════════════════════════════════════════════════════════════════
// סריקת מסגרות זמן אחרות
// ═══════════════════════════════════════════════════════════════════
// ה-request.security מושך רק מספרים גולמיים (זמן + high/low/close), והמנוע
// עצמו רץ על ציר הזמן של הגרף עם מצב ב-var — מוקצה פעם אחת ולא בכל נר.
// זה ההבדל שמונע Memory limits exceeded: החזרת אובייקט מלא מ-security
// נשמרת לכל נר בהיסטוריה ומפוצצת את הזיכרון.
//
// מעל הגרף — ההיסט נעשה בתוך הביטוי (high[1] וכו'), כלומר בזמן של אותה
// מסגרת, ולכן אין ריפיינט: נר נכנס לחישוב רק כשהוא נסגר.
// מתחת לגרף — אין נרות מוסטים, ולכן מושכים את כל תת-הנרות של נר הגרף
// (request.security_lower_tf) ומזינים אותם למנוע אחד-אחד.
//
// שים לב: לוגיקת המחזורים כאן משכפלת את החישוב הראשי שלמעלה. אם משנים
// את מודל הסייקלים — חייבים לשנות בשני המקומות.

f_cycT(int cls, int t) =>
    eH   = hour(t, TZ)
    eM   = minute(t, TZ)
    mOD  = eH * 60 + eM
    post = mOD >= 1080
    mFD  = post ? mOD - 1080 : mOD + 360
    tdt  = post ? t + 86400000 : t
    yy = year(tdt, TZ)
    mm = month(tdt, TZ)
    dd = dayofmonth(tdt, TZ)
    dw = dayofweek(tdt, TZ)
    sIdx  = math.floor(mFD / 360)
    mIS   = mFD % 360
    miIdx = math.floor(mIS / 90)
    mIM   = mIS % 90
    qIdx  = math.floor(mIM / 22.5)
    dsm = dw == dayofweek.sunday ? 6 : dw - 2
    mon = tdt - dsm * 86400000
    tue = mon + 86400000
    thu = mon + 3 * 86400000
    moM = month(mon, TZ)
    moD = dayofmonth(mon, TZ)
    moY = year(mon, TZ)
    // אותו עוגן כמו בחישוב הראשי: החודש של השבוע נקבע לפי יום שלישי
    tuM = month(tue, TZ)
    tuY = year(tue, TZ)
    dead = tuM != month(thu, TZ)
    qMonIdx = mm >= 4 ? mm - 4 : mm + 8
    qYear   = mm >= 4 ? yy : yy - 1
    qQtr    = math.floor(qMonIdx / 3) + 1
    tdId = yy * 10000 + mm * 100 + dd
    wkId = moY * 10000 + moM * 100 + moD
    moId = tuY * 100 + tuM
    seId = tdId * 10 + sIdx
    miId = seId * 10 + miIdx
    quId = miId * 10 + qIdx
    qrId = qYear * 10 + qQtr
    c4Id = math.floor(qYear / 4)
    rId = cls == 7 ? qYear : cls == 6 ? qrId : cls == 5 ? wkId : cls == 4 ? tdId : cls == 3 ? seId : cls == 2 ? miId : quId
    lId = cls == 7 ? c4Id  : cls == 6 ? qYear : cls == 5 ? moId : cls == 4 ? wkId : cls == 3 ? tdId : cls == 2 ? seId : miId
    kL  = cls == 4 or cls == 6 or cls == 7
    blk = ((cls == 5 or cls == 4) and dw == dayofweek.friday) or (cls == 5 and blockDeadWeek and dead)
    [rId, lId, kL, blk]

// מנוע שלם למסגרת זמן אחת — כל המצב שלו מוקצה פעם אחת ומתעדכן במקום
type Eng
    int    cls
    int    lastT
    int    refId
    int    lifeId
    bool   started
    bool   sAct
    string txt
    int    dir
    int    bTy
    int    uTy
    string bStr
    string uStr
    int    bSeq
    int    uSeq
    int    seqC
    int    bRefI
    int    uRefI
    float  nH
    float  nL
    float  nHC
    float  nLC
    float  eH
    float  eL
    float  eHC
    float  eLC
    float  yH
    float  yL
    float  yHC
    float  yLC
    array<float> nHiA
    array<float> nLoA
    array<float> nHcA
    array<float> nLcA
    array<float> eHiA
    array<float> eLoA
    array<float> eHcA
    array<float> eLcA
    array<float> yHiA
    array<float> yLoA
    array<float> yHcA
    array<float> yLcA

f_newEng(int cls) =>
    Eng.new(cls, 0, 0, 0, false, false, "", 0, 0, 0, "", "", 0, 0, 0, -1, -1, na, na, na, na, na, na, na, na, na, na, na, na, array.new_float(), array.new_float(), array.new_float(), array.new_float(), array.new_float(), array.new_float(), array.new_float(), array.new_float(), array.new_float(), array.new_float(), array.new_float(), array.new_float())

// צעד אחד: נר סגור אחד של המסגרת שהמנוע מייצג
f_engStep(Eng e, int t, float nh, float nl, float nc, float eh, float el, float ec, float yh, float yl, float yc) =>
    if not na(t) and t != e.lastT and not na(nc) and not na(ec) and not na(yc)
        e.lastT := t
        [rId, lId, kL, blk] = f_cycT(e.cls, t)
        newRef  = e.started and rId != e.refId
        newLife = e.started and lId != e.lifeId
        sPush = newRef and newLife and kL and not na(e.nH)
        sDrop = newRef and (not newLife) and e.sAct
        if newRef
            if newLife
                array.clear(e.nHiA)
                array.clear(e.nLoA)
                array.clear(e.nHcA)
                array.clear(e.nLcA)
                array.clear(e.eHiA)
                array.clear(e.eLoA)
                array.clear(e.eHcA)
                array.clear(e.eLcA)
                array.clear(e.yHiA)
                array.clear(e.yLoA)
                array.clear(e.yHcA)
                array.clear(e.yLcA)
            if ((not newLife) or kL) and not na(e.nH)
                array.push(e.nHiA, e.nH)
                array.push(e.nLoA, e.nL)
                array.push(e.nHcA, e.nHC)
                array.push(e.nLcA, e.nLC)
                array.push(e.eHiA, e.eH)
                array.push(e.eLoA, e.eL)
                array.push(e.eHcA, e.eHC)
                array.push(e.eLcA, e.eLC)
                array.push(e.yHiA, e.yH)
                array.push(e.yLoA, e.yL)
                array.push(e.yHcA, e.yHC)
                array.push(e.yLcA, e.yLC)
            if sDrop and array.size(e.nHiA) > 0
                array.remove(e.nHiA, 0)
                array.remove(e.nLoA, 0)
                array.remove(e.nHcA, 0)
                array.remove(e.nLcA, 0)
                array.remove(e.eHiA, 0)
                array.remove(e.eLoA, 0)
                array.remove(e.eHcA, 0)
                array.remove(e.eLcA, 0)
                array.remove(e.yHiA, 0)
                array.remove(e.yLoA, 0)
                array.remove(e.yHcA, 0)
                array.remove(e.yLcA, 0)
            e.nH := nh
            e.nL := nl
            e.nHC := nc
            e.nLC := nc
            e.eH := eh
            e.eL := el
            e.eHC := ec
            e.eLC := ec
            e.yH := yh
            e.yL := yl
            e.yHC := yc
            e.yLC := yc
        else
            e.nH  := na(e.nH)  or nh > e.nH  ? nh : e.nH
            e.nL  := na(e.nL)  or nl < e.nL  ? nl : e.nL
            e.nHC := na(e.nHC) or nc > e.nHC ? nc : e.nHC
            e.nLC := na(e.nLC) or nc < e.nLC ? nc : e.nLC
            e.eH  := na(e.eH)  or eh > e.eH  ? eh : e.eH
            e.eL  := na(e.eL)  or el < e.eL  ? el : e.eL
            e.eHC := na(e.eHC) or ec > e.eHC ? ec : e.eHC
            e.eLC := na(e.eLC) or ec < e.eLC ? ec : e.eLC
            e.yH  := na(e.yH)  or yh > e.yH  ? yh : e.yH
            e.yL  := na(e.yL)  or yl < e.yL  ? yl : e.yL
            e.yHC := na(e.yHC) or yc > e.yHC ? yc : e.yHC
            e.yLC := na(e.yLC) or yc < e.yLC ? yc : e.yLC
        if newRef and newLife
            e.sAct := sPush
        else if newRef
            e.sAct := false
        e.started := true
        e.refId   := rId
        e.lifeId  := lId
        // פקיעת מחזור־על מאפסת את מצב התצוגה, ומחיקת הזרע מזיזה את האינדקסים ב-1
        if newLife
            e.bTy   := 0
            e.uTy   := 0
            e.bRefI := -1
            e.uRefI := -1
        if sDrop
            e.bRefI := e.bRefI > 0 ? e.bRefI - 1 : -1
            e.uRefI := e.uRefI > 0 ? e.uRefI - 1 : -1

        // אותה לוגיקת סטייה בדיוק כמו הגרף הראשי
        int    nbT = 0
        int    nbI = -1
        string nbS = ""
        int    nuT = 0
        int    nuI = -1
        string nuS = ""
        if array.size(e.nHiA) > 0 and not blk
            [xbT, xbI, xbS] = f_findBear(e.nHiA, e.eHiA, e.yHiA, e.nHcA, e.eHcA, e.yHcA, e.nH, e.eH, e.yH, e.nHC, e.eHC, e.yHC)
            [xuT, xuI, xuS] = f_findBull(e.nLoA, e.eLoA, e.yLoA, e.nLcA, e.eLcA, e.yLcA, e.nL, e.eL, e.yL, e.nLC, e.eLC, e.yLC)
            nbT := xbT
            nbI := xbI
            nbS := xbS
            nuT := xuT
            nuI := xuI
            nuS := xuS

        // ── שני הכיוונים חיים במקביל, אבל מוצג רק אחד: הכי חדש. כשהוא מתבטל
        //    (הגרעין לקח את הרמה) הישן התקף חוזר להיצג מעצמו. ──
        if nbT != 0
            if e.bTy == 0 or nbI != e.bRefI      // כיוון שהיה כבוי, או התעגנות לייחוס אחר = שבירה חדשה
                e.seqC := e.seqC + 1
                e.bSeq := e.seqC
            e.bRefI := nbI
            e.bTy   := nbT
            e.bStr  := nbS
        else
            e.bTy   := 0
            e.bRefI := -1
        if nuT != 0
            if e.uTy == 0 or nuI != e.uRefI
                e.seqC := e.seqC + 1
                e.uSeq := e.seqC
            e.uRefI := nuI
            e.uTy   := nuT
            e.uStr  := nuS
        else
            e.uTy   := 0
            e.uRefI := -1

        d = e.bTy != 0 and e.uTy != 0 ? (e.bSeq > e.uSeq ? -1 : 1) : e.bTy != 0 ? -1 : e.uTy != 0 ? 1 : 0
        e.dir := d
        e.txt := d == -1 ? "▼" + e.bStr : d == 1 ? "▲" + e.uStr : ""
    e.txt

// סמן רץ: מחזיר את האינדקס האחרון במערך הזמנים שזמנו <= t, החל מ-from.
// המערכים ממוינים ולכן הסמן רק מתקדם — מעבר אחד על כל תת-הנרות.
// חשוב: ב-Pine האופרטור and לא מובטח כ-short-circuit, ולכן אסור לכתוב
// while k < n - 1 and array.get(ta, k + 1) <= t — ה-array.get יורץ גם
// כשהתנאי הראשון שקרי ויזרוק Index out of range. לכן שני if מקוננים.
f_cur(array<int> ta, int t, int from) =>
    n = array.size(ta)
    k = from < 0 ? 0 : from > n - 1 ? n - 1 : from
    if n > 0
        bool go = true
        while go
            if k < n - 1
                if array.get(ta, k + 1) <= t
                    k := k + 1
                else
                    go := false
            else
                go := false
    k

// שם המסגרת לתצוגה
f_tfName(int cls) => cls == 1 ? "1m" : cls == 2 ? "5m" : cls == 3 ? "15m" : cls == 4 ? "1H" : cls == 5 ? "4H" : cls == 6 ? "1D" : "1W"

// שלוש מסגרות מעל הגרף ושתיים מתחת, אבל **לא מעל 4H**: 1D ו-1W לא נסרקים
// ולא מוצגים בפינה. מסגרת הגרף עצמה תמיד מוצגת, גם אם היא יומית או שבועית.
cU1 = math.min(tfClass + 1, 5)
cU2 = math.min(tfClass + 2, 5)
cU3 = math.min(tfClass + 3, 5)
cD1 = math.max(tfClass - 1, 1)
cD2 = math.max(tfClass - 2, 1)

// המחרוזות חייבות להיות טרנרי ישיר ולא קריאה לפונקציה: פונקציה ב-Pine מחזירה
// תמיד series string, ו-request.security דורש simple string בפרמטר הזמן.
tU1 = cU1 == 1 ? "1" : cU1 == 2 ? "5" : cU1 == 3 ? "15" : cU1 == 4 ? "60" : cU1 == 5 ? "240" : cU1 == 6 ? "D" : "W"
tU2 = cU2 == 1 ? "1" : cU2 == 2 ? "5" : cU2 == 3 ? "15" : cU2 == 4 ? "60" : cU2 == 5 ? "240" : cU2 == 6 ? "D" : "W"
tU3 = cU3 == 1 ? "1" : cU3 == 2 ? "5" : cU3 == 3 ? "15" : cU3 == 4 ? "60" : cU3 == 5 ? "240" : cU3 == 6 ? "D" : "W"
tD1 = cD1 == 1 ? "1" : cD1 == 2 ? "5" : cD1 == 3 ? "15" : cD1 == 4 ? "60" : cD1 == 5 ? "240" : cD1 == 6 ? "D" : "W"
tD2 = cD2 == 1 ? "1" : cD2 == 2 ? "5" : cD2 == 3 ? "15" : cD2 == 4 ? "60" : cD2 == 5 ? "240" : cD2 == 6 ? "D" : "W"

lkh = barmerge.lookahead_off

[aT, aNh, aNl, aNc] = request.security(sNQ, tU1, [time[1], high[1], low[1], close[1]], lookahead = lkh)
[aEh, aEl, aEc]     = request.security(sES, tU1, [high[1], low[1], close[1]], lookahead = lkh)
[aYh, aYl, aYc]     = request.security(sYM, tU1, [high[1], low[1], close[1]], lookahead = lkh)
[bT_, bNh, bNl, bNc] = request.security(sNQ, tU2, [time[1], high[1], low[1], close[1]], lookahead = lkh)
[bEh, bEl, bEc]      = request.security(sES, tU2, [high[1], low[1], close[1]], lookahead = lkh)
[bYh, bYl, bYc]      = request.security(sYM, tU2, [high[1], low[1], close[1]], lookahead = lkh)
[cT_, cNh, cNl, cNc] = request.security(sNQ, tU3, [time[1], high[1], low[1], close[1]], lookahead = lkh)
[cEh, cEl, cEc]      = request.security(sES, tU3, [high[1], low[1], close[1]], lookahead = lkh)
[cYh, cYl, cYc]      = request.security(sYM, tU3, [high[1], low[1], close[1]], lookahead = lkh)

// ignore_invalid_timeframe מחזיר ריק במקום להפיל את הסקריפט כשהמדרגה הזאת
// לא באמת מתחת לגרף (למשל גרף דקה, שאין מתחתיו כלום).
// כל אחד משלושת הנכסים מוחזר כמערך משלו, ודקה בלי עסקאות פשוט לא מייצרת נר.
// לכן חובה למשוך גם time לכל נכס ולזווג לפי זמן — זיווג לפי אינדקס משווה
// דקה של NQ מול דקה אחרת של YM ומייצר סטיות שגויות.
[dNt, dNh, dNl, dNc] = request.security_lower_tf(sNQ, tD1, [time, high, low, close], ignore_invalid_timeframe = true)
[dEt, dEh, dEl, dEc] = request.security_lower_tf(sES, tD1, [time, high, low, close], ignore_invalid_timeframe = true)
[dYt, dYh, dYl, dYc] = request.security_lower_tf(sYM, tD1, [time, high, low, close], ignore_invalid_timeframe = true)
[fNt, fNh, fNl, fNc] = request.security_lower_tf(sNQ, tD2, [time, high, low, close], ignore_invalid_timeframe = true)
[fEt, fEh, fEl, fEc] = request.security_lower_tf(sES, tD2, [time, high, low, close], ignore_invalid_timeframe = true)
[fYt, fYh, fYl, fYc] = request.security_lower_tf(sYM, tD2, [time, high, low, close], ignore_invalid_timeframe = true)

var Eng egU1 = f_newEng(cU1)
var Eng egU2 = f_newEng(cU2)
var Eng egU3 = f_newEng(cU3)
var Eng egD1 = f_newEng(cD1)
var Eng egD2 = f_newEng(cD2)

useU1 = tfClass + 1 <= 5
useU2 = tfClass + 2 <= 5
useU3 = tfClass + 3 <= 5
useD1 = tfClass - 1 >= 1
useD2 = tfClass - 2 >= 1

// הצעד רץ גם בתוך נר הגרף החי, ולא רק בסגירתו — כך שבירה של 5 דקות מופיעה
// ברגע שנר ה-5 נסגר, בלי לחכות לסגירת נר ה-15. זה בטוח: בנר חי הסקריפט רץ
// מחדש בכל טיק ומצב ה-var מוחזר אחורה לסגירת הנר הקודם, ולכן הצעדים פשוט
// מחושבים מחדש מאותה נקודה ולא נספרים פעמיים.
if mtfOn and tfClass != 0
    if useU1
        f_engStep(egU1, aT,  aNh, aNl, aNc, aEh, aEl, aEc, aYh, aYl, aYc)
    if useU2
        f_engStep(egU2, bT_, bNh, bNl, bNc, bEh, bEl, bEc, bYh, bYl, bYc)
    if useU3
        f_engStep(egU3, cT_, cNh, cNl, cNc, cEh, cEl, cEc, cYh, cYl, cYc)
    // תת-הנרות מזווגים לפי זמן: הזמנים של NQ הם המפתח, וסמן רץ מוצא לכל נכס
    // את הנר שלו באותו זמן. נכס שחסרה לו הדקה הזאת נשאר על הנר הקודם שלו —
    // וזה בטוח, כי המצברים לוקחים מקסימום/מינימום וערך שכבר נכלל לא משנה כלום.
    if useD1 and array.size(dNc) > 0 and array.size(dEc) > 0 and array.size(dYc) > 0
        int ke = 0
        int ky = 0
        for j = 0 to array.size(dNc) - 1
            tj = array.get(dNt, j)
            ke := f_cur(dEt, tj, ke)
            ky := f_cur(dYt, tj, ky)
            if array.get(dEt, ke) <= tj and array.get(dYt, ky) <= tj
                f_engStep(egD1, tj, array.get(dNh, j), array.get(dNl, j), array.get(dNc, j), array.get(dEh, ke), array.get(dEl, ke), array.get(dEc, ke), array.get(dYh, ky), array.get(dYl, ky), array.get(dYc, ky))
    if useD2 and array.size(fNc) > 0 and array.size(fEc) > 0 and array.size(fYc) > 0
        int me = 0
        int my = 0
        for j = 0 to array.size(fNc) - 1
            tj = array.get(fNt, j)
            me := f_cur(fEt, tj, me)
            my := f_cur(fYt, tj, my)
            if array.get(fEt, me) <= tj and array.get(fYt, my) <= tj
                f_engStep(egD2, tj, array.get(fNh, j), array.get(fNl, j), array.get(fNc, j), array.get(fEh, me), array.get(fEl, me), array.get(fEc, me), array.get(fYh, my), array.get(fYl, my), array.get(fYc, my))

// ═══════════════════════════════════════════════════════════════════
// תצוגה — סימון זעיר בפינה + פאנל אופציונלי + התראה אחת
// ═══════════════════════════════════════════════════════════════════

panPos  = mtfPanPos == "ימין למטה" ? position.bottom_right : mtfPanPos == "ימין למעלה" ? position.top_right : mtfPanPos == "שמאל למטה" ? position.bottom_left : position.top_left
markPos = mtfMarkPos == "שמאל למטה" ? position.bottom_left : mtfMarkPos == "שמאל למעלה" ? position.top_left : mtfMarkPos == "אמצע למטה" ? position.bottom_center : position.bottom_right

var string mtfPrev = ""
var table mtfTbl  = table.new(panPos,  2, 8, border_width = 0)
// תא נפרד לכל מסגרת, כדי שכל אחת תיצבע בצבע הכיוון שלה
var table markTbl = table.new(markPos, 6, 1, border_width = 0)

if mtfOn and barstate.islast and tfClass != 0
    // מסגרת הגרף נלקחת מהמנוע המקומי — בדיוק אותה שבירה שמצוירת על הגרף,
    // כלומר רק אחת (העדכנית), לפי showDir. בלי זה נראו שני הכיוונים יחד.
    sC = showDir == -1 ? "▼" + bearStr : showDir == 1 ? "▲" + bullStr : ""

    clsArr = array.from(cU3, cU2, cU1, tfClass, cD1, cD2)
    stArr  = array.from(egU3.txt, egU2.txt, egU1.txt, sC, egD1.txt, egD2.txt)
    dirArr = array.from(egU3.dir, egU2.dir, egU1.dir, showDir, egD1.dir, egD2.dir)
    // מדרגה שלא נסרקת (מעל 4H, או מתחת לדקה) פשוט יוצאת מהרשימה
    useArr = array.from(useU3, useU2, useU1, true, useD1, useD2)

    bg = color.new(color.black, 100)
    mark = ""
    prevC = -1
    row = 0
    mcol = 1
    table.clear(mtfTbl,  0, 0, 1, 7)
    table.clear(markTbl, 0, 0, 5, 0)
    for i = 0 to 5
        c  = array.get(clsArr, i)
        st = array.get(stArr, i)
        d  = array.get(dirArr, i)
        if array.get(useArr, i) and c != prevC   // הרשימה יורדת, אז די בהשוואה לקודם כדי לנקות כפילויות בקצוות
            // צבע הכיוון של האינדיקטור עצמו — אדום לדובי, ירוק לשורי
            cl = d == -1 ? colBear : d == 1 ? colBull : mtfColor
            if st != ""
                mark := mark + f_tfName(c) + " " + st + "   "
                // את מסגרת הגרף עצמה לא כותבים בפינה — היא כבר מצוירת על הגרף.
                // בפאנל ובהתראה היא כן נשארת.
                if mtfMark and c != tfClass and mcol <= 5
                    table.cell(markTbl, mcol, 0, f_tfName(c) + " " + st, text_color = cl, text_size = size.small, bgcolor = bg)
                    mcol := mcol + 1
            if mtfPanel
                nm = (c == tfClass ? "▶ " : "   ") + f_tfName(c)
                table.cell(mtfTbl, 0, row, nm, text_color = cl, text_size = size.small, bgcolor = bg)
                table.cell(mtfTbl, 1, row, st == "" ? "—" : st, text_color = cl, text_size = size.small, bgcolor = bg)
            row := row + 1
            prevC := c
    mark := str.trim(mark)
    if mtfPanel
        table.cell(mtfTbl, 0, row, "QT", text_color = mtfColor, text_size = size.small, bgcolor = bg)
        table.cell(mtfTbl, 1, row, "", bgcolor = bg)
    if mtfMark and mcol > 1
        table.cell(markTbl, 0, 0, "QT", text_color = mtfColor, text_size = size.small, bgcolor = bg)

    if mtfAlert and mark != mtfPrev and mark != ""
        alert("QT SSMT: " + mark, alert.freq_once_per_bar)
    mtfPrev := mark

// ═══════════════════════════════════════════════════════════════════
// טבלת בדיקה (אבחון — כבויה כברירת מחדל)
// ═══════════════════════════════════════════════════════════════════

f_num(x) => na(x) ? "-" : str.tostring(x, format.mintick)

var table dbg = table.new(position.top_right, 4, 14, border_width = 1)
if showDebug and barstate.islast
    // רמות ייחוס הכי נמוכות/גבוהות במיכל (סגירה) — "הכי נמוך/גבוה בחודש"
    float nqMinLoC = nLevels > 0 ? array.min(nqLoCA) : na
    float esMinLoC = nLevels > 0 ? array.min(esLoCA) : na
    float ymMinLoC = nLevels > 0 ? array.min(ymLoCA) : na
    float nqMaxHiC = nLevels > 0 ? array.max(nqHiCA) : na
    float esMaxHiC = nLevels > 0 ? array.max(esHiCA) : na
    float ymMaxHiC = nLevels > 0 ? array.max(ymHiCA) : na
    hc = color.gray
    wc = color.white
    // כותרת
    table.cell(dbg, 0, 0, "", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 0, "NQ", bgcolor = hc, text_color = wc)
    table.cell(dbg, 2, 0, "ES", bgcolor = hc, text_color = wc)
    table.cell(dbg, 3, 0, "YM", bgcolor = hc, text_color = wc)
    // מצב כללי
    table.cell(dbg, 0, 1, "tf/lvl/dir", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 1, str.tostring(tfClass), bgcolor = wc)
    table.cell(dbg, 2, 1, str.tostring(nLevels), bgcolor = wc)
    table.cell(dbg, 3, 1, str.tostring(showDir), bgcolor = wc)
    table.cell(dbg, 0, 2, "typ b/u", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 2, str.tostring(bearType) + "/" + str.tostring(bullType), bgcolor = wc)
    table.cell(dbg, 2, 2, "bear:", bgcolor = wc)
    table.cell(dbg, 3, 2, bearStr, bgcolor = wc)
    table.cell(dbg, 0, 3, "str bull", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 3, bullStr, bgcolor = wc)
    table.cell(dbg, 2, 3, "", bgcolor = wc)
    table.cell(dbg, 3, 3, "", bgcolor = wc)
    // פתיל נוכחי (מצטבר) מול "הכי גבוה/נמוך במיכל" (פתיל) — ל-SSMT
    float nqMaxHi = nLevels > 0 ? array.max(nqHiA) : na
    float esMaxHi = nLevels > 0 ? array.max(esHiA) : na
    float ymMaxHi = nLevels > 0 ? array.max(ymHiA) : na
    float nqMinLo = nLevels > 0 ? array.min(nqLoA) : na
    float esMinLo = nLevels > 0 ? array.min(esLoA) : na
    float ymMinLo = nLevels > 0 ? array.min(ymLoA) : na
    table.cell(dbg, 0, 4, "curHi w", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 4, f_num(nqCH), bgcolor = wc)
    table.cell(dbg, 2, 4, f_num(esCH), bgcolor = wc)
    table.cell(dbg, 3, 4, f_num(ymCH), bgcolor = wc)
    table.cell(dbg, 0, 5, "maxHi w", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 5, f_num(nqMaxHi), bgcolor = wc)
    table.cell(dbg, 2, 5, f_num(esMaxHi), bgcolor = wc)
    table.cell(dbg, 3, 5, f_num(ymMaxHi), bgcolor = wc)
    table.cell(dbg, 0, 6, "curLo w", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 6, f_num(nqCL), bgcolor = wc)
    table.cell(dbg, 2, 6, f_num(esCL), bgcolor = wc)
    table.cell(dbg, 3, 6, f_num(ymCL), bgcolor = wc)
    table.cell(dbg, 0, 7, "minLo w", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 7, f_num(nqMinLo), bgcolor = wc)
    table.cell(dbg, 2, 7, f_num(esMinLo), bgcolor = wc)
    table.cell(dbg, 3, 7, f_num(ymMinLo), bgcolor = wc)
    // סגירה נוכחית (מצטבר) מול "הכי נמוך/גבוה במיכל"
    table.cell(dbg, 0, 8, "curLoC", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 8, f_num(nqCLC), bgcolor = wc)
    table.cell(dbg, 2, 8, f_num(esCLC), bgcolor = wc)
    table.cell(dbg, 3, 8, f_num(ymCLC), bgcolor = wc)
    table.cell(dbg, 0, 9, "minLoC", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 9, f_num(nqMinLoC), bgcolor = wc)
    table.cell(dbg, 2, 9, f_num(esMinLoC), bgcolor = wc)
    table.cell(dbg, 3, 9, f_num(ymMinLoC), bgcolor = wc)
    table.cell(dbg, 0, 10, "curHiC", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 10, f_num(nqCHC), bgcolor = wc)
    table.cell(dbg, 2, 10, f_num(esCHC), bgcolor = wc)
    table.cell(dbg, 3, 10, f_num(ymCHC), bgcolor = wc)
    table.cell(dbg, 0, 11, "maxHiC", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 11, f_num(nqMaxHiC), bgcolor = wc)
    table.cell(dbg, 2, 11, f_num(esMaxHiC), bgcolor = wc)
    table.cell(dbg, 3, 11, f_num(ymMaxHiC), bgcolor = wc)
    // אינדקס תת-מחזור הייחוס ומונה הסדר — מי נוצר אחרון (גבוה יותר = חדש יותר)
    table.cell(dbg, 0, 12, "refI b/u", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 12, str.tostring(bearRefI) + "/" + str.tostring(bullRefI), bgcolor = wc)
    table.cell(dbg, 2, 12, "", bgcolor = wc)
    table.cell(dbg, 3, 12, "", bgcolor = wc)
    table.cell(dbg, 0, 13, "seq b/u", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 13, str.tostring(bearSeq) + "/" + str.tostring(bullSeq), bgcolor = wc)
    table.cell(dbg, 2, 13, "", bgcolor = wc)
    table.cell(dbg, 3, 13, "", bgcolor = wc)
