//@version=5
indicator("SSMT + HSSMT | Quarterly Theory", overlay = true, max_labels_count = 20, max_lines_count = 20)

// ═══════════════════════════════════════════════════════════════════
// שינויים בגרסה הזו
// 1. גרף במסגרת לא נתמכת (8H, 12H, 2D...) כבר לא מבקש נתוני 15 שניות —
//    זה הפיל את הסקריפט (RE10063) למי שאין לו Premium.
// 2. המסגרות שמתחת לגרף מקבלות רק תת-נרות **סגורים**. קודם הנר החי נכנס
//    לחישוב, ושבירה יכלה להתריע ואז להיעלם.
// 3. הסינון לפי True Open חל עכשיו על כל המסגרות — הגרף, הפינה וההתראות —
//    כל מסגרת מול ה-True Open שלה, על הסימבול של הגרף. עד שנפתח ה-Q2 של
//    המחזור, נמדד מול ה-True Open הקודם (כמו בגרף).
// 4. תוקן RE10052 (array על na) — מסגרת נמוכה לא חוקית מחזירה na.
// 5. שבירה משנית (לא הראשית): צבע, שקיפות, סגנון קו וגודל תווית משלה,
//    נפרדים מהראשית.
// 6. פינה מינימלית (ברירת מחדל): בפינה רק מסגרת, חץ ו-H/S — בלי כוכבים
//    ובלי שמות נכסים, בטקסט קטן. התוויות על הגרף נשארות המלאות.
// ═══════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════
// הגדרות משתמש
// ═══════════════════════════════════════════════════════════════════

// ארבעה נכסים שבוחרים ידנית — כך אפשר להשוות כל קבוצה (מדדים, מתכות, קריפטו).
// התפקיד נקבע לפי המיקום: 1 ו-2 = הזוג החזק (NQ/ES), 3 = החלש (YM), 4 = בן הזוג
// של 3 (RTY). נכס 4 מושווה רק לנכס 3, בלי חזק וחלש, ואפשר לכבות אותו כשאין
// לקבוצה ארבעה נכסים. השם בתווית נלקח מהסימבול עצמו (MNQ1! → NQ).
grpSym = "נכסים"
sym1 = input.symbol("CME_MINI:MNQ1!",  "נכס 1 — חזק",          group = grpSym)
sym2 = input.symbol("CME_MINI:MES1!",  "נכס 2 — חזק",          group = grpSym)
sym3 = input.symbol("CBOT_MINI:MYM1!", "נכס 3 — חלש",          group = grpSym)
use4 = input.bool(true,                "השתמש בנכס 4",          group = grpSym)
sym4 = input.symbol("CME_MINI:M2K1!",  "נכס 4 — בן הזוג של 3", group = grpSym)
// בשבוע גלגול חוזים (ספטמבר→דצמבר וכו') החוזה הרציף "1!" קופץ במרווח שבין
// החוזים — כ-1% מהמחיר, כלומר כ-290 נקודות ב-NQ. בלי יישור, ההיסטוריה שלפני
// הגלגול נמדדת בחוזה הישן והמחירים של היום בחדש. היישור מסיר את הקפיצה.
adjMode  = input.string("בלי יישור", "נתוני חוזה רציף", options = ["בלי יישור", "מיושר לגלגול", "ברירת המחדל של הסימבול"], group = grpSym, tooltip = "ברירת המחדל לפי ספר החוקים: בלי יישור. בשבוע גלגול חוזים כדאי לעבור ל'מיושר לגלגול'.")
settleIn = input.string("כבוי — כמו הגרף", "Settlement כסגירה יומית", options = ["כבוי — כמו הגרף", "דלוק", "ברירת המחדל של הסימבול"], group = grpSym)

grpVis = "תצוגה"
colBull    = input.color(#26a69a, "צבע שורי", group = grpVis)
colBear    = input.color(#ef5350, "צבע דובי", group = grpVis)
// שבירות בין נכס 3 לנכס 4 בצבע אחד — הכיוון ידוע ממילא מהמיקום מעל/מתחת לנר
colPair    = input.color(#ff9800, "צבע שבירות נכס 3 מול נכס 4", group = grpVis)
minimal    = input.bool(true, "פינה מינימלית", group = grpVis, tooltip = "דלוק = בפינה רק מסגרת, חץ ו-H/S — בלי כוכבים ובלי שמות נכסים. התוויות על הגרף לא משתנות.")
labelSize  = input.string("small", "גודל תווית", options = ["tiny", "small", "normal"], group = grpVis)
showLine   = input.bool(true, "הצג קו שבירה", group = grpVis)
// "אופקי" = ברמת הייחוס, נמתח עד הנר הנוכחי.
// "אלכסוני" = קו בין נר הייחוס לנר שקבע את הקיצון הנוכחי, מוזז כך שלא יחצה נרות.
lineMode   = input.string("אלכסוני", "סוג הקו", options = ["אלכסוני", "אופקי", "שניהם"], group = grpVis)
linePad    = input.float(0.1, "מרווח הקו האלכסוני מהנרות (ATR)", minval = 0.0, maxval = 3.0, step = 0.05, group = grpVis)
// השבירות שאינן הראשית (כשיש יותר משבירה אחת חיה) — צבע, שקיפות, סגנון קו
// וגודל תווית משלהן, נפרדים לגמרי מהראשית. שינוי שלהן לא נוגע בראשית.
colBullW   = input.color(#80cbc4, "שבירה משנית — שורי", group = grpVis)
colBearW   = input.color(#ef9a9a, "שבירה משנית — דובי", group = grpVis)
colPairW   = input.color(#ffcc80, "שבירה משנית — נכס 3 מול 4", group = grpVis)
weakFade   = input.int(30, "שקיפות השבירות המשניות", minval = 0, maxval = 90, group = grpVis, tooltip = "חל רק על השבירות שאינן הראשית. הראשית נשארת כמו שהיא.")
weakStyle  = input.string("מקווקו", "סגנון קו — שבירה משנית", options = ["רציף", "מקווקו", "נקודות"], group = grpVis)
weakSmall  = input.bool(true, "תווית קטנה לשבירה משנית", group = grpVis)
// הקו דק כברירת מחדל — הדגשה נעשית בצבע ולא בעובי, כדי שהגרף יישאר נקי.
lineWidth  = input.int(1, "עובי קו", minval = 1, maxval = 4, group = grpVis)
closedMode = input.string("הצג", "שבירות שכולם סגרו (closed)", options = ["הצג", "האפר", "הסתר"], group = grpVis, tooltip = "(all closed) / (core closed) = SSMT שבה רק חלק מהנכסים לקחו את הרמה בפתיל, אבל כולם (או שני החזקים) כבר סגרו מעבר לסגירה הקיצונית.\n• הצג = מוצגת כמו כל שבירה, ומדורגת מתחת ל-SSMT רגילה.\n• האפר = מוצגת באפור.\n• הסתר = לא קיימת: לא על הגרף, לא בפינה ולא בהתראות, ולא נחשבת כראשית.")
hideC = closedMode == "הסתר"
greyC = closedMode == "האפר"
// אזהרה: השבירה עומדת להתבטל — הנכס שחסר כדי לבטל אותה קרוב לרמה שלו.
// השבירה לא נעלמת ולא משתנה; רק נוסף לתווית טקסט קצר עם שם הנכס.
nearOn  = input.bool(true, "סמן שבירה שעומדת להתבטל", group = grpVis, tooltip = "בתווית על הגרף נוסף  ! YM  (שם הנכס שאם ייקח את הרמה — השבירה תתבטל), כשהוא קרוב אליה.\nHSSMT נמדד לפי הסגירה מול הסגירה הקיצונית, SSMT לפי הפתיל.\nקרוב = במרחק של פחות מהמכפיל כפול ה-ATR(14) של אותו נכס. נבדק בזמן אמת, על הנר החי.\nרק במסגרת הגרף.")
nearATR = input.float(0.3, "קרוב = פחות מ-X פעמים ATR של הנכס", minval = 0.05, maxval = 3.0, step = 0.05, group = grpVis)
// שעת השבירה (שעון ניו יורק) — טקסט זעיר ודהוי צמוד לתווית, בצד שפונה לנר.
// ביומי ומעלה — תאריך במקום שעה.
showTime = input.bool(true, "הצג שעת השבירה", group = grpVis)

// QS = חלון זמן חם: שלוש רמות **רצופות** בסולם המחזורים יוצרות יחד רצף חם.
// הסולם: חודש (1–3 ברבעון QT) ← שבוע (1–4 בחודש) ← יום (שני 1 .. חמישי 4) ←
// סשן ← 90 דק' ← 22.5 דק' ← 5.625 דק'. למשל 09:45–10:07:30 = AM (3) ← מיקרו 3
// ← רבע 3 = חלון 3-3-3. בגרף היומי: שנה במחזור ה-4 ← רבעון QT ← רבע-רבעון.
// הסדר לא משנה — הרשימה סימטרית (114 ו-411, 144 ו-441). אי אפשר לדלג על רמה.
// לכל גרף יש רמה משלו (15s = 5.625, 1m = 22.5, 5m = 90, 15m = סשן, 1H = יום,
// 4H = שבוע). שבירה ב-QS אם הנר שעשה אותה נמצא בחלון של שלישייה חמה שהרמה של
// הגרף היא חלק ממנה — בכל מיקום: שתיים מעליה, אחת מעל ואחת מתחת, או שתיים מתחת.
// ליד השבירה נשאר כתוב מאיזה רצף עברנו לאיזה (למשל 321-333), ו-★ כשהיא ב-QS.
grpQS = "רצפי QS"
qsMode  = input.string("סמן ★ בשבירה ב-QS", "QS — חלונות זמן חמים", options = ["סמן ★ בשבירה ב-QS", "רק שבירות ב-QS", "כבוי"], group = grpQS, tooltip = "פעיל ב-15 שניות, דקה, 5 דקות, 15 דקות, שעה, 4 שעות ויומי.\n• לכל גרף רמה משלו: 15 שניות = 5.625 דק', דקה = 22.5 דק', 5 דק' = 90 דק', 15 דק' = סשן, שעה = יום, 4 שעות = שבוע. הסולם: חודש ברבעון QT ← שבוע ← יום ← סשן ← 90 ← 22.5 ← 5.625.\n• חלון QS = שלוש רמות רצופות שיוצרות רצף חם (בכל כיוון — 114 ו-411 שניהם חמים) ושהרמה של הגרף היא חלק מהן — שתיים מעליה, אחת מעל ואחת מתחת, או שתיים מתחת. למשל ב-5 דק': רביעי-AM-90 Q3 = 3-3-3.\n• יומי = שנה במחזור ה-4-רבעון-רבע רבעון.\n• השבירה ב-QS אם הנר שעשה אותה נכנס לחלון כזה. החלון מעוגל לנרות שלמים — למשל 3-3-3 של 09:45–10:07:30 בגרף 5 דק' = 09:45–10:10. שבירה מחוץ לחלון = שבירה רגילה.\n• ★ = ב-QS על הנכס הזה. ☆ = על הנכס הזה לא, אבל על נכס אחר כן. אם הרצף שתפס את ה-QS שונה מזה שכתוב בתווית, הוא נכתב ליד הכוכב (★333).\n• רק שבירות ב-QS: במדרגה עם QS, שבירה שלא ב-QS (על אף נכס) מוסתרת, גם על הגרף וגם בפינה.")
hotList = input.string("111,114,141,144,411,414,441,444,222,333", "רצפים חמים", group = grpQS, tooltip = "מופרדים בפסיקים. שלוש רמות רצופות שיוצרות אחד מהרצפים האלה = חלון QS.")

grpLogic = "לוגיקה"
requireTrueOpen = input.bool(false, "סנן לפי True Open (פרימיום/דיסקאונט)", group = grpLogic, tooltip = "חל על כל המסגרות — הגרף, הפינה וההתראות. כל מסגרת נמדדת מול ה-True Open שלה, על הסימבול של הגרף.\nעד שנפתח ה-Q2 של המחזור הנוכחי — נמדד מול ה-True Open של המחזור הקודם.")
blockDeadWeek   = input.bool(true, "חסום שבירות בשבוע מת (4H בלבד)", group = grpLogic)

grpMTF = "מסגרות זמן"
mtfOn      = input.bool(true,  "הצג מסגרות זמן אחרות", group = grpMTF)
mtfMark    = input.bool(true,  "הצג סימון זעיר משאר המסגרות", group = grpMTF)
mtfMarkPos = input.string("שמאל למטה", "מיקום הסימון", options = ["שמאל למטה", "שמאל למעלה", "אמצע למטה", "ימין למטה"], group = grpMTF)
mtfColor   = input.color(color.white, "צבע הסימון", group = grpMTF)
cornerSz   = input.string("tiny", "גודל טקסט בפינה", options = ["tiny", "small", "normal"], group = grpMTF)
mtfAlert   = input.bool(true,  "כלול שבירות ממסגרות אחרות בהתראה", group = grpMTF, tooltip = "ההתראה כותבת רק את המסגרת שבה קרתה שבירה חדשה וכיוונה, למשל QT SSMT: 5m ▼ (ושבירת נכס 3 מול 4: QT SSMT: 5m ▼ YM/RTY). שבירות 15 שניות לא מתריעות. כבוי = רק מסגרת הגרף.")
// נתוני שניות כבויים כברירת מחדל: TradingView זורק שגיאת ריצה RE10063
// ("seconds-based timeframes ... Premium and higher-tier plans") על עצם הבקשה
// למסגרת שניות, ו-ignore_invalid_timeframe לא מכסה את זה. כשהמתג כבוי, מדרגת
// 15 השניות (שבירה בין תת-רבעים של 5.625 דק') מחושבת מנרות **דקה** — בלי
// Premium ובלי שום בקשה במסגרת שניות. זה קירוב: נר דקה שחוצה גבול של תת-רבע
// משויך לתת-הרבע שבו הוא נפתח (וברצף ה-QS הוא נחשב לשניהם).
use15s     = input.bool(false, "15 שניות מנתוני שניות אמיתיים (דורש Premium)", group = grpMTF, tooltip = "כבוי = מדרגת 15 השניות מחושבת מנרות דקה, בלי צורך במנוי.")

// ═══════════════════════════════════════════════════════════════════
// הנכסים — סימבולים, שמות ונכס הגרף
// ═══════════════════════════════════════════════════════════════════

// ticker.modify מחזיר simple string, ולכן מותר להעביר אותו ל-request.security.
// היישור חל על כל הנכסים יחד — מרווח הגלגול שונה בנקודות לכל אחד מהם, ויישור
// חלקי היה מעוות את ההשוואה ביניהם יותר מאשר בלי יישור בכלל.
bAdj = adjMode == "מיושר לגלגול" ? backadjustment.on : adjMode == "בלי יישור" ? backadjustment.off : backadjustment.inherit
bSet = settleIn == "דלוק" ? settlement_as_close.on : settleIn == "ברירת המחדל של הסימבול" ? settlement_as_close.inherit : settlement_as_close.off

s1 = ticker.modify(sym1, backadjustment = bAdj, settlement_as_close = bSet)
s2 = ticker.modify(sym2, backadjustment = bAdj, settlement_as_close = bSet)
s3 = ticker.modify(sym3, backadjustment = bAdj, settlement_as_close = bSet)
// בלי נכס 4 הבקשות שלו זהות לאלה של נכס 3, ו-TradingView טוען אותן פעם אחת
s4 = use4 ? ticker.modify(sym4, backadjustment = bAdj, settlement_as_close = bSet) : s3

// השם של נכס לתווית: הסימבול בלי הבורסה ובלי סיומת החוזה הרציף (1!). חוזי
// מיקרו מתורגמים לשם המלא, כדי שהתווית תיראה אותו דבר בשני הסטים.
f_name(string s) =>
    p = str.split(s, ":")
    string t = array.get(p, array.size(p) - 1)
    if str.endswith(t, "!") and str.length(t) > 2
        t := str.substring(t, 0, str.length(t) - 2)
    t == "MNQ" ? "NQ" : t == "MES" ? "ES" : t == "MYM" ? "YM" : t == "M2K" ? "RTY" : t == "MGC" ? "GC" : t

nm1 = f_name(sym1)
nm2 = f_name(sym2)
nm3 = f_name(sym3)
nm4 = f_name(sym4)
nmP = nm3 + "/" + nm4
f_nm(int a) => a == 0 ? nm1 : a == 1 ? nm2 : a == 2 ? nm3 : nm4

// נכס הגרף: 0–3 לפי השם, או -1 כשהגרף הוא נכס אחר. כשנכס הגרף לא חלק משבירה,
// היא מוצגת בתווית בלי קו.
chN1 = f_name(syminfo.root)
chN2 = f_name(syminfo.ticker)
f_isChart(string nm) => nm == chN1 or nm == chN2
cA = f_isChart(nm1) ? 0 : f_isChart(nm2) ? 1 : f_isChart(nm3) ? 2 : use4 and f_isChart(nm4) ? 3 : -1

// ═══════════════════════════════════════════════════════════════════
// זיהוי Timeframe
// ═══════════════════════════════════════════════════════════════════

tfSec   = timeframe.in_seconds()
tfMin   = tfSec / 60
// סולם המדרגות (המספר עולה ככל שהמסגרת גדולה יותר — הסדר הזה חשוב, כי סריקת
// מסגרות הזמן מחשבת מדרגה אחת למעלה/למטה כ-tfClass±1):
//   1 = 15 שניות (ייחוס תת-רבע 5.625 דק', מיכל רבע 22.5 דק')
//   2 = דקה   (ייחוס רבע 22.5 דק', מיכל מיקרו 90 דק')
//   3 = 5 דק' (ייחוס מיקרו, מיכל סשן 6 שעות)
//   4 = 15 דק' (ייחוס סשן, מיכל יום-מסחר)
//   5 = שעה   (ייחוס יום-מסחר, מיכל שבוע)
//   6 = 4 שעות (ייחוס שבוע, מיכל חודש)
//   7 = יומי  (ייחוס רבע-רבעון ~23 יום, מיכל רבעון QT) — רק 1D בדיוק
//   8 = שבועי (ייחוס רבעון QT, מיכל שנת QT)            — רק 1W בדיוק
//   9 = חודשי (ייחוס שנה קלנדרית, מיכל מחזור 4 שנים)   — רק 1M בדיוק
//   0 = מסגרת לא נתמכת
isD1 = timeframe.isdaily   and timeframe.multiplier == 1
isW1 = timeframe.isweekly  and timeframe.multiplier == 1
isM1 = timeframe.ismonthly and timeframe.multiplier == 1
tfClass = isD1 ? 7 : isW1 ? 8 : isM1 ? 9 : tfSec <= 15 ? 1 : tfMin <= 1 ? 2 : tfMin <= 5 ? 3 : tfMin <= 15 ? 4 : tfMin <= 60 ? 5 : tfMin <= 240 ? 6 : 0

// ═══════════════════════════════════════════════════════════════════
// חישובי זמן EST
// ═══════════════════════════════════════════════════════════════════

TZ = "America/New_York"
estHour = hour(time, TZ)
estMin  = minute(time, TZ)
estSec  = second(time, TZ)

minutesOfDay = estHour * 60 + estMin

isPostOpen       = minutesOfDay >= 1080
minsFromDayStart = isPostOpen ? minutesOfDay - 1080 : minutesOfDay + 360
// תת-הרבע הוא 5.625 דקות = 337.5 שניות, כלומר גבול שנופל גם על חצאי דקות.
// לכן כל ההיררכיה התוך-יומית מחושבת בשניות. בנרות של דקה ומעלה השניות תמיד
// אפס, ולכן התוצאה זהה בדיוק לחישוב בדקות.
secsFromDayStart = minsFromDayStart * 60 + estSec

tradeDayTime = isPostOpen ? time + 86400000 : time
tdYear = year(tradeDayTime, TZ)
tdMon  = month(tradeDayTime, TZ)
tdDom  = dayofmonth(tradeDayTime, TZ)
tdDow  = dayofweek(tradeDayTime, TZ)

sessionIdx    = math.floor(secsFromDayStart / 21600)   // סשן = 6 שעות
secsInSession = secsFromDayStart % 21600
microIdx      = math.floor(secsInSession / 5400)       // מיקרו = 90 דקות
secsInMicro   = secsInSession % 5400
quarterIdx    = math.floor(secsInMicro / 1350)         // רבע = 22.5 דקות
secsInQuarter = secsInMicro % 1350
subQIdx       = math.floor(secsInQuarter / 337.5)      // תת-רבע = 5.625 דקות

// ═══════════════════════════════════════════════════════════════════
// מספור שבועות לפי QT
// ═══════════════════════════════════════════════════════════════════

daysSinceMonday = tdDow == dayofweek.sunday ? 6 : tdDow - 2
mondayTime      = tradeDayTime - daysSinceMonday * 86400000
tuesdayTime     = mondayTime + 86400000
thursdayTime    = mondayTime + 3 * 86400000

monMonth = month(mondayTime, TZ)
monDom   = dayofmonth(mondayTime, TZ)
monYear  = year(mondayTime, TZ)
// העוגן לשיוך שבוע לחודש הוא יום **שלישי**, לא יום שני. שבוע שרק יום שני שלו
// בחודש הקודם (למשל 31.8 שנופל בשני) הוא ארבעה ימים בחודש החדש, ולכן הוא
// השבוע הראשון של החודש החדש — לא שבוע מת ולא שבוע של החודש הקודם.
tueMonth = month(tuesdayTime, TZ)
tueDom   = dayofmonth(tuesdayTime, TZ)
tueYear  = year(tuesdayTime, TZ)
thuMonth = month(thursdayTime, TZ)

// שבוע מת = שלישי וחמישי בחודשים שונים, כלומר לאף חודש אין 4 מתוך 5 ימי המסחר
// (שני+שלישי בחודש הישן, או שני–רביעי בו). מספור השבוע נספר לפי יום שלישי,
// ולכן שלישי 1.9 = שבוע 1 ושלישי 8.9 = שבוע 2 (שבוע ה-CPI).
isDeadWeek = tueMonth != thuMonth
qtWeekNum  = isDeadWeek ? 0 : math.floor((tueDom - 1) / 7) + 1
// ספר החוקים §1–2: שבוע 5 (שלישי ב-29 בחודש של 31 יום) לא נכנס למחזור
// ה-4H — בדיוק כמו שבוע מת. שניהם מיכל נפרד משלהם, בלי שבירות.
isWeek5    = qtWeekNum == 5
isOwnWeek  = isDeadWeek or isWeek5

// ═══════════════════════════════════════════════════════════════════
// שנת QT — מתחילה באפריל. Q1 = אפר/מאי/יונ, Q2 = יול/אוג/ספט,
// Q3 = אוק/נוב/דצמ, Q4 = ינו/פבר/מרץ (של שנת הלוח הבאה).
// מעל השנה: מחזור של 4 שנים **קלנדריות** (ספר החוקים §4): 2023–2026,
// 2027–2030. 2023 היא שנה 1 במחזור.
// ═══════════════════════════════════════════════════════════════════

qtMonIdx    = tdMon >= 4 ? tdMon - 4 : tdMon + 8   // 0 = אפריל ... 11 = מרץ
qtYearNum   = tdMon >= 4 ? tdYear : tdYear - 1     // תווית שנת QT (אפריל–מרץ)
qtQtrNum    = math.floor(qtMonIdx / 3) + 1         // 1..4 בתוך שנת QT
yearInCyc   = ((tdYear - 2023) % 4 + 4) % 4        // 0..3 — מקום השנה הקלנדרית במחזור ה-4

// ── רבע-רבעון: הרבעון מחולק לארבעה חלקים שווים, כ-23 יום כל אחד. זה
//    תת-המחזור של הגרף היומי. לא עובדים עם 23 יום קבועים אלא מחלקים את
//    האורך האמיתי של הרבעון (90–92 יום) בארבע, כדי שהגבול האחרון ייפול
//    תמיד בדיוק על סוף הרבעון ולא ייגרר לרבעון הבא. ──
qStartMon  = qtQtrNum == 1 ? 4 : qtQtrNum == 2 ? 7 : qtQtrNum == 3 ? 10 : 1
qStartYear = qtQtrNum == 4 ? qtYearNum + 1 : qtYearNum
nStartMon  = qStartMon == 10 ? 1 : qStartMon + 3
nStartYear = qStartMon == 10 ? qStartYear + 1 : qStartYear
// שעה 12:00 בשני הקצוות — כך מעבר שעון קיץ לא מזיז את ספירת הימים
qStartT = timestamp(TZ, qStartYear, qStartMon, 1, 12, 0)
nStartT = timestamp(TZ, nStartYear, nStartMon, 1, 12, 0)
tdNoonT = timestamp(TZ, tdYear, tdMon, tdDom, 12, 0)
qLenDays = math.round((nStartT - qStartT) / 86400000)
dSinceQ  = math.round((tdNoonT - qStartT) / 86400000)
qSubIdx  = qLenDays > 0 ? math.min(3, math.max(0, math.floor(dSinceQ * 4 / qLenDays))) : 0

// ═══════════════════════════════════════════════════════════════════
// מזהי מחזורים
// ═══════════════════════════════════════════════════════════════════

tradeDayId = tdYear * 10000 + tdMon * 100 + tdDom
weekId     = monYear * 10000 + monMonth * 100 + monDom   // מזהה ייחודי לשבוע — לפי יום שני
// חודש-מחזור ל-4H נקבע לפי חודש יום-**שלישי** של השבוע — כך הגבול נופל תמיד
// בתחילת שבוע, והשבוע נספר לחודש שבו נמצאים לפחות 4 מ-5 ימי המסחר שלו.
// שבוע מת ושבוע 5 הם מיכל משלהם (weekId, שמונה ספרות — לא מתנגש בשש).
monthId    = isOwnWeek ? weekId : tueYear * 100 + tueMonth
sessionId  = tradeDayId * 10 + sessionIdx
microId    = sessionId * 10 + microIdx
quarterId  = microId * 10 + quarterIdx
subQId     = quarterId * 10 + subQIdx
qtrId      = qtYearNum * 10 + qtQtrNum
qSubId     = qtrId * 10 + qSubIdx
qtYearId   = qtYearNum
// החודשי: שנים קלנדריות בתוך מחזור 4 שנים קלנדרי שמתחיל ב-2023
cyc4Id     = math.floor((tdYear - 2023) / 4)

refCycleId = 0
if tfClass == 9
    refCycleId := tdYear
else if tfClass == 8
    refCycleId := qtrId
else if tfClass == 7
    refCycleId := qSubId
else if tfClass == 6
    refCycleId := weekId
else if tfClass == 5
    refCycleId := tradeDayId
else if tfClass == 4
    refCycleId := sessionId
else if tfClass == 3
    refCycleId := microId
else if tfClass == 2
    refCycleId := quarterId
else if tfClass == 1
    refCycleId := subQId

lifeCycleId = 0
if tfClass == 9
    lifeCycleId := cyc4Id
else if tfClass == 8
    lifeCycleId := qtYearId
else if tfClass == 7
    lifeCycleId := qtrId
else if tfClass == 6
    lifeCycleId := monthId
else if tfClass == 5
    lifeCycleId := weekId
else if tfClass == 4
    lifeCycleId := tradeDayId
else if tfClass == 3
    lifeCycleId := sessionId
else if tfClass == 2
    lifeCycleId := microId
else if tfClass == 1
    lifeCycleId := quarterId

newRefCycle  = ta.change(refCycleId)  != 0
newLifeCycle = ta.change(lifeCycleId) != 0

// "זרע" = תת-המחזור הראשון של מיכל חדש משווה גם לתת-המחזור האחרון של המיכל
// הקודם (Q4 → Q1), והזרע נמחק ברגע שתת-המחזור הראשון נסגר. כלומר ההשוואה
// החוצה-מיכל אפשרית **רק** בין האחרון לראשון, לא הלאה.
//   15S / 1M / 5M — תמיד. למשל ב-5M: המיקרו האחרון של לונדון מול המיקרו הראשון
//                   של ניו-יורק AM. חל בכל החלפת מיכל, כולל מעבר יום מסחר וסוף שבוע.
//   15M           — לא (ספר החוקים §5). כל יום מסחר מתחיל נקי.
//   1H            — תמיד: יום שני משווה גם ליום שישי שעבר, בלי תנאי רצף.
//                   הזרע נמחק בסוף יום שני — מיום שלישי הקשר לשבוע הקודם הוא של 4H.
//   4H            — לא. המחזור החודשי עומד בפני עצמו, בלי חודש קודם.
//   1D / 1W / 1Mo — לא.
keepLast = tfClass == 1 or tfClass == 2 or tfClass == 3 or tfClass == 5

// ═══════════════════════════════════════════════════════════════════
// True Open
// ═══════════════════════════════════════════════════════════════════

inCyc4Q2    = yearInCyc == 1         // השנה השנייה במחזור ה-4 הקלנדרי (2024, 2028)
// מחיר הפתיחה של השנה = תחילת האביב, 1 באפריל — תחילת שנת QT (ספר החוקים §9)
inYearlyQ2  = qtQtrNum == 1
inQtrQ2     = qSubIdx == 1           // רבע-הרבעון השני בתוך הרבעון — ה-True Open היומי
inMonthlyQ2 = qtWeekNum == 2
inWeeklyQ2  = tdDow == dayofweek.tuesday
inDailyQ2   = minsFromDayStart >= 360 and minsFromDayStart < 720
inSessionQ2 = microIdx == 1
inMicroQ2   = quarterIdx == 1
inQrtQ2     = subQIdx == 1           // תת-הרבע השני בתוך הרבע — ה-True Open של 15 שניות

var bool pCycQ2 = false
var bool pYrQ2  = false
var bool pQtrQ2 = false
var bool pMonQ2 = false
var bool pWkQ2  = false
var bool pDayQ2 = false
var bool pSesQ2 = false
var bool pMicQ2 = false
var bool pQrtQ2 = false

isTrueOpenBar = false
if tfClass == 9
    isTrueOpenBar := inCyc4Q2 and not pCycQ2
else if tfClass == 8
    isTrueOpenBar := inYearlyQ2 and not pYrQ2
else if tfClass == 7
    isTrueOpenBar := inQtrQ2 and not pQtrQ2
else if tfClass == 6
    isTrueOpenBar := inMonthlyQ2 and not pMonQ2
else if tfClass == 5
    isTrueOpenBar := inWeeklyQ2 and not pWkQ2
else if tfClass == 4
    isTrueOpenBar := inDailyQ2 and not pDayQ2
else if tfClass == 3
    isTrueOpenBar := inSessionQ2 and not pSesQ2
else if tfClass == 2
    isTrueOpenBar := inMicroQ2 and not pMicQ2
else if tfClass == 1
    isTrueOpenBar := inQrtQ2 and not pQrtQ2

pCycQ2 := inCyc4Q2
pYrQ2  := inYearlyQ2
pQtrQ2 := inQtrQ2
pMonQ2 := inMonthlyQ2
pWkQ2  := inWeeklyQ2
pDayQ2 := inDailyQ2
pSesQ2 := inSessionQ2
pMicQ2 := inMicroQ2
pQrtQ2 := inQrtQ2

var float trueOpenPrice = na
if isTrueOpenBar
    trueOpenPrice := open

// ═══════════════════════════════════════════════════════════════════
// משיכת נתוני ארבעת הנכסים
// ═══════════════════════════════════════════════════════════════════

[x1h, x1l, x1c, x1a] = request.security(s1, timeframe.period, [high, low, close, ta.atr(14)], lookahead = barmerge.lookahead_off)
[x2h, x2l, x2c, x2a] = request.security(s2, timeframe.period, [high, low, close, ta.atr(14)], lookahead = barmerge.lookahead_off)
[x3h, x3l, x3c, x3a] = request.security(s3, timeframe.period, [high, low, close, ta.atr(14)], lookahead = barmerge.lookahead_off)
[x4h, x4l, x4c, x4a] = request.security(s4, timeframe.period, [high, low, close, ta.atr(14)], lookahead = barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════
// מצבר לכל נכס: הקיצונים של תת-המחזור הנוכחי, ומערך של הקיצונים של כל
// תת-מחזור שנסגר בתוך המיכל. pos = מיקום הקיצון — בגרף bar_index, ובמנועי
// המסגרות האחרות הזמן של הנר. אותו מבנה משרת את שניהם.
// ═══════════════════════════════════════════════════════════════════

type Acc
    float hi
    float lo
    float hc
    float lc
    int   hiPos = 0
    int   loPos = 0
    int   hcPos = 0
    int   lcPos = 0
    array<float> hiA
    array<float> loA
    array<float> hcA
    array<float> lcA
    array<int>   hiPA
    array<int>   loPA
    array<int>   hcPA
    array<int>   lcPA

f_newAcc() => Acc.new(hiA = array.new_float(), loA = array.new_float(), hcA = array.new_float(), lcA = array.new_float(), hiPA = array.new_int(), loPA = array.new_int(), hcPA = array.new_int(), lcPA = array.new_int())

// הסדרה של מצבר לפי כיוון וסוג: isH = סגירה (HSSMT), אחרת פתיל (SSMT)
f_accA(Acc a, bool isBull, bool isH)  => isBull ? (isH ? a.lcA : a.loA) : (isH ? a.hcA : a.hiA)
f_accPA(Acc a, bool isBull, bool isH) => isBull ? (isH ? a.lcPA : a.loPA) : (isH ? a.hcPA : a.hiPA)
f_accV(Acc a, bool isBull, bool isH)  => isBull ? (isH ? a.lc : a.lo) : (isH ? a.hc : a.hi)
f_accP(Acc a, bool isBull, bool isH)  => isBull ? (isH ? a.lcPos : a.loPos) : (isH ? a.hcPos : a.hiPos)

// צעד של מצבר. בתת-מחזור חדש: clr = מיכל חדש (מנקה), push = שומרים את תת-המחזור
// שנסגר, drop = מחיקת הזרע. אחרת — מעדכנים את הקיצונים.
f_accStep(Acc a, bool newRef, bool clr, bool push, bool drop, float h, float l, float c, int pos) =>
    if newRef
        if clr
            array.clear(a.hiA)
            array.clear(a.loA)
            array.clear(a.hcA)
            array.clear(a.lcA)
            array.clear(a.hiPA)
            array.clear(a.loPA)
            array.clear(a.hcPA)
            array.clear(a.lcPA)
        if push
            array.push(a.hiA, a.hi)
            array.push(a.loA, a.lo)
            array.push(a.hcA, a.hc)
            array.push(a.lcA, a.lc)
            array.push(a.hiPA, a.hiPos)
            array.push(a.loPA, a.loPos)
            array.push(a.hcPA, a.hcPos)
            array.push(a.lcPA, a.lcPos)
        if drop and array.size(a.hiA) > 0
            array.remove(a.hiA, 0)
            array.remove(a.loA, 0)
            array.remove(a.hcA, 0)
            array.remove(a.lcA, 0)
            array.remove(a.hiPA, 0)
            array.remove(a.loPA, 0)
            array.remove(a.hcPA, 0)
            array.remove(a.lcPA, 0)
        a.hi    := h
        a.lo    := l
        a.hc    := c
        a.lc    := c
        a.hiPos := pos
        a.loPos := pos
        a.hcPos := pos
        a.lcPos := pos
    else
        if na(a.hi) or h > a.hi
            a.hi    := h
            a.hiPos := pos
        if na(a.lo) or l < a.lo
            a.lo    := l
            a.loPos := pos
        if na(a.hc) or c > a.hc
            a.hc    := c
            a.hcPos := pos
        if na(a.lc) or c < a.lc
            a.lc    := c
            a.lcPos := pos
    a

var Acc ac1 = f_newAcc()
var Acc ac2 = f_newAcc()
var Acc ac3 = f_newAcc()
var Acc ac4 = f_newAcc()
f_acc(int a) => a == 0 ? ac1 : a == 1 ? ac2 : a == 2 ? ac3 : ac4

// הזרע (המבט אחורה) — פעיל רק ליחידה הראשונה של המיכל. תת-מחזור נשמר רק כשיש
// נתונים לכל הנכסים, כדי שכל המערכים יישארו באותו אורך.
var bool seedActive = false
canPush     = not na(ac1.hi) and not na(ac2.hi) and not na(ac3.hi) and not na(ac4.hi)
pushNow     = newRefCycle and ((not newLifeCycle) or keepLast) and canPush
dropSeedNow = newRefCycle and (not newLifeCycle) and seedActive
f_accStep(ac1, newRefCycle, newLifeCycle, pushNow, dropSeedNow, x1h, x1l, x1c, bar_index)
f_accStep(ac2, newRefCycle, newLifeCycle, pushNow, dropSeedNow, x2h, x2l, x2c, bar_index)
f_accStep(ac3, newRefCycle, newLifeCycle, pushNow, dropSeedNow, x3h, x3l, x3c, bar_index)
f_accStep(ac4, newRefCycle, newLifeCycle, pushNow, dropSeedNow, x4h, x4l, x4c, bar_index)
if newRefCycle and newLifeCycle
    seedActive := keepLast and canPush
else if newRefCycle
    seedActive := false

// ═══════════════════════════════════════════════════════════════════
// חסימות
// ═══════════════════════════════════════════════════════════════════

nLevels = array.size(ac1.hiA)
// ספר החוקים §1–2:
//   1H — שישי לא רלוונטי בכלל.
//   4H — שישי משתתף בשבועות 1–3; בשבוע 4 אין לו משמעות. שבוע 5 ושבוע מת חסומים.
cycleOK   = not (tfClass == 6 and ((blockDeadWeek and isDeadWeek) or isWeek5))
friBlock  = tdDow == dayofweek.friday and (tfClass == 5 or (tfClass == 6 and qtWeekNum == 4))
blocked   = friBlock or not cycleOK

bearOK = not requireTrueOpen or (not na(trueOpenPrice) and close > trueOpenPrice)
bullOK = not requireTrueOpen or (not na(trueOpenPrice) and close < trueOpenPrice)

// ═══════════════════════════════════════════════════════════════════
// זיהוי — השבירה הכי עדכנית בכל כיוון. לקיחה מצטברת.
// HSSMT = סגר מעבר (ביטול כשכולם סגרו). SSMT = פתיל מעבר (ביטול כשכולם סחפו).
// ═══════════════════════════════════════════════════════════════════

// מחרוזת נכסים לשלישייה — בשורי נכס 3 מושמט
f_str(bool b1, bool b2, bool b3, bool isBull) =>
    s = ""
    s := b1 ? s + nm1 + " " : s
    s := b2 ? s + nm2 + " " : s
    s := (b3 and not isBull) ? s + nm3 + " " : s
    str.trim(s)

// מחרוזת נכסים לזוג 3–4
f_str2(bool b3, bool b4) => str.trim((b3 ? nm3 + " " : "") + (b4 ? nm4 : ""))

f_beyond(bool isBull, float v, float r) => isBull ? v < r : v > r
f_ext(bool isBull, float v, float r)    => isBull ? math.min(v, r) : math.max(v, r)
f_closed(string s) => str.contains(s, "closed)")

// חוזק השבירה, כשכמה חיות במקביל וצריך לבחור את הראשית. קודם הסוג:
//   HSSMT > SSMT > SSMT שהגרעין כבר סגר מעבר לו — (all/core closed).
// בתוך אותו סוג — שבירה ב-QS (★ או ☆) חזקה משבירה שלא ב-QS. ורק אם גם זה
// שווה — האחרונה שנעשתה.
f_rank(int typ, string s, bool inQS) => (typ == 2 ? 3 : f_closed(s) ? 1 : 2) * 2 + (inQS ? 1 : 0)

// השלישייה 1–2–3 (NQ/ES/YM). דובי: מישהו לקח את הגבוה ולא שני החזקים; המחרוזת =
// כל מי שלקח. שורי: חזק אחד לקח את הנמוך, לא כל השלושה; נכס 3 מושמט מהמחרוזת.
// הסוג = H אם יש גם סגירה מעבר תקפה, אחרת S. אין עצירה כשהגרעין הסכים על רבע
// מסוים: הקיצון של רבע ישן יותר בדרך כלל קיצוני יותר ועדיין לא נלקח, והקיצון
// המצטבר כבר מבטיח שרבע שכן נלקח לא ידווח.
f_findTri(bool isBull, Acc n, Acc e, Acc y) =>
    int    bT = 0
    int    bI = -1
    string bS = ""
    nA  = f_accA(n, isBull, false)
    eA  = f_accA(e, isBull, false)
    yA  = f_accA(y, isBull, false)
    nCA = f_accA(n, isBull, true)
    eCA = f_accA(e, isBull, true)
    yCA = f_accA(y, isBull, true)
    cnt = array.size(nA)
    if cnt > 0 and array.size(eA) == cnt and array.size(yA) == cnt
        float nM  = f_accV(n, isBull, false)
        float eM  = f_accV(e, isBull, false)
        float yM  = f_accV(y, isBull, false)
        float nMc = f_accV(n, isBull, true)
        float eMc = f_accV(e, isBull, true)
        float yMc = f_accV(y, isBull, true)
        for i = cnt - 1 to 0
            if bT == 0
                nw = f_beyond(isBull, nM,  array.get(nA, i))     // פתיל מעבר לפתיל של הייחוס (SSMT)
                ew = f_beyond(isBull, eM,  array.get(eA, i))
                yw = f_beyond(isBull, yM,  array.get(yA, i))
                nc = f_beyond(isBull, nMc, array.get(nCA, i))    // סגירה מעבר לסגירה של הייחוס (HSSMT)
                ec = f_beyond(isBull, eMc, array.get(eCA, i))
                yc = f_beyond(isBull, yMc, array.get(yCA, i))
                hValid = isBull ? (nc or ec) and not (nc and ec and yc) : (nc or ec or yc) and not (nc and ec)
                wValid = isBull ? (nw or ew) and not (nw and ew and yw) : (nw or ew or yw) and not (nw and ew)
                if hValid or wValid
                    hN = hValid and nc
                    hE = hValid and ec
                    hY = hValid and yc
                    hs = f_str(hN, hE, hY, isBull)
                    ss = wValid ? f_str(nw and not hN, ew and not hE, yw and not hY, isBull) : ""
                    lbl = hs != "" ? "H " + hs : ""
                    lbl := ss != "" ? (lbl != "" ? lbl + " S " + ss : "S " + ss) : lbl
                    // אין HSSMT כי הסגירות הסכימו, אבל ה-SSMT (פתיל) עדיין תקף — מסמנים זאת
                    if not hValid and nc and ec and (yc or not isBull)
                        lbl := lbl + (yc ? " (all closed)" : " (core closed)")
                    bT := hs != "" ? 2 : 1
                    bI := i
                    bS := lbl
            nM  := f_ext(isBull, nM,  array.get(nA, i))
            eM  := f_ext(isBull, eM,  array.get(eA, i))
            yM  := f_ext(isBull, yM,  array.get(yA, i))
            nMc := f_ext(isBull, nMc, array.get(nCA, i))
            eMc := f_ext(isBull, eMc, array.get(eCA, i))
            yMc := f_ext(isBull, yMc, array.get(yCA, i))
    [bT, bI, bS]

// הזוג 3–4 (YM/RTY): שני נכסים שווים, בלי חזק וחלש. שבירה = רק אחד מהם לקח את
// הרמה — פתיל = SSMT, סגירה = HSSMT. מתבטלת כששניהם לקחו. אותו כלל לעליות
// ולירידות, ושני הנכסים תמיד נכתבים.
f_findPair(bool isBull, Acc y, Acc r) =>
    int    bT = 0
    int    bI = -1
    string bS = ""
    yA  = f_accA(y, isBull, false)
    rA  = f_accA(r, isBull, false)
    yCA = f_accA(y, isBull, true)
    rCA = f_accA(r, isBull, true)
    cnt = array.size(yA)
    if cnt > 0 and array.size(rA) == cnt
        float yM  = f_accV(y, isBull, false)
        float rM  = f_accV(r, isBull, false)
        float yMc = f_accV(y, isBull, true)
        float rMc = f_accV(r, isBull, true)
        for i = cnt - 1 to 0
            if bT == 0
                yw = f_beyond(isBull, yM,  array.get(yA, i))
                rw = f_beyond(isBull, rM,  array.get(rA, i))
                yc = f_beyond(isBull, yMc, array.get(yCA, i))
                rc = f_beyond(isBull, rMc, array.get(rCA, i))
                hValid = yc != rc
                wValid = yw != rw
                if hValid or wValid
                    hY = hValid and yc
                    hR = hValid and rc
                    hs = f_str2(hY, hR)
                    ss = wValid ? f_str2(yw and not hY, rw and not hR) : ""
                    lbl = hs != "" ? "H " + hs : ""
                    lbl := ss != "" ? (lbl != "" ? lbl + " S " + ss : "S " + ss) : lbl
                    if not hValid and yc and rc
                        lbl := lbl + " (all closed)"
                    bT := hs != "" ? 2 : 1
                    bI := i
                    bS := lbl
            yM  := f_ext(isBull, yM,  array.get(yA, i))
            rM  := f_ext(isBull, rM,  array.get(rA, i))
            yMc := f_ext(isBull, yMc, array.get(yCA, i))
            rMc := f_ext(isBull, rMc, array.get(rCA, i))
    [bT, bI, bS]

// הנר שבאמת לקח את הרמה: הקיצון המצטבר מאז תת-מחזור הייחוס — הקצה הימני של
// הקו. הוא עוצר איפה שהשבירה קרתה, ולא נמתח עד הרגע הזה.
f_take(bool isBull, array<float> extA, array<int> posA, int refI, float curV, int curP) =>
    float bp = curV
    int   bb = curP
    n = array.size(extA)
    if n > 0 and refI + 1 <= n - 1
        for k = refI + 1 to n - 1
            v = array.get(extA, k)
            if isBull ? v < bp : v > bp
                bp := v
                bb := array.get(posA, k)
    [bp, bb]

// שתי הנקודות של שבירה על נכס אחד: הקיצון של תת-מחזור הייחוס (b1/p1) והנר שלקח
// אותו (b2/p2). HSSMT נמדד מסגירה לסגירה, SSMT מפתיל לפתיל.
f_pts(Acc acc, bool isBull, bool isH, int refI) =>
    int   b1 = -1
    float p1 = na
    int   b2 = -1
    float p2 = na
    bool  ok = false
    extA = f_accA(acc, isBull, isH)
    posA = f_accPA(acc, isBull, isH)
    if refI >= 0 and refI <= array.size(extA) - 1
        p1 := array.get(extA, refI)
        b1 := array.get(posA, refI)
        [tp, tb] = f_take(isBull, extA, posA, refI, f_accV(acc, isBull, isH), f_accP(acc, isBull, isH))
        p2 := tp
        b2 := tb
        ok := b2 > b1 and not na(p1) and not na(p2)
    [b1, p1, b2, p2, ok]

// ═══════════════════════════════════════════════════════════════════
// רצפי QS
// ═══════════════════════════════════════════════════════════════════
// הרצף שבתווית (מאיזה רצף עברנו לאיזה) נבנה ברמה אחת מתחת למחזור הייחוס של
// המדרגה, ומכיל אותה ואת שתי הרמות שמעליה:
//   15S / 1M — מיקרו-רבע-תת רבע   (מתחת לתת-רבע אין רמה, אז 15S משתמש באותו)
//   5M       — סשן-מיקרו-רבע
//   15M      — יום-סשן-מיקרו       (שני 1 .. חמישי 4, שישי = ·)
//   1H       — שבוע-יום-סשן        (שבוע מת = ·)
//   4H       — חודש-שבוע-יום       (חודש = מקומו ברבעון QT, 1–3)
//   1D       — שנה-רבעון-רבע רבעון (שנה במחזור ה-4, רבעון QT, רבע-רבעון ~23 יום)
// QS הוא חלון זמן שבו שלישייה חמה מכילה את הרמה של הגרף — ראה f_qsAt.
// בשבועי ובחודשי אין רצף. החישוב זהה לחישוב המחזורים הראשי.

qsUseCls(int cls) => qsMode != "כבוי" and cls >= 1 and cls <= 7
qsFilt = qsMode == "רק שבירות ב-QS"
hotKey = "," + str.replace_all(hotList, " ", "") + ","

// שבע הספרות של רגע t, מהגבוה לנמוך: חודש ברבעון QT, שבוע בחודש, יום, סשן,
// 90 דק', 22.5 דק', 5.625 דק'. רמה בלי מספר (שישי, שבוע מת) = ·
// החודש נקבע לפי יום שלישי של השבוע — אותו עוגן שמשייך את השבוע לחודש.
f_qsDigits(int t) =>
    mOD  = hour(t, TZ) * 60 + minute(t, TZ)
    post = mOD >= 1080
    mFD  = post ? mOD - 1080 : mOD + 360
    sFD  = mFD * 60 + second(t, TZ)
    tdt  = post ? t + 86400000 : t
    sI   = math.floor(sFD / 21600)
    sIS  = sFD % 21600
    mI   = math.floor(sIS / 5400)
    sIM  = sIS % 5400
    qI   = math.floor(sIM / 1350)
    sqI  = math.floor((sIM % 1350) / 337.5)
    dw   = dayofweek(tdt, TZ)
    dN   = dw == dayofweek.monday ? 1 : dw == dayofweek.tuesday ? 2 : dw == dayofweek.wednesday ? 3 : dw == dayofweek.thursday ? 4 : 0
    dsm  = dw == dayofweek.sunday ? 6 : dw - 2
    mon  = tdt - dsm * 86400000
    tue  = mon + 86400000
    thu  = mon + 3 * 86400000
    tM   = month(tue, TZ)
    dead = tM != month(thu, TZ)
    wk   = dead ? 0 : math.floor((dayofmonth(tue, TZ) - 1) / 7) + 1
    mQ   = (tM >= 4 ? tM - 4 : tM + 8) % 3 + 1
    str.tostring(mQ) + (wk == 0 ? "·" : str.tostring(wk)) + (dN == 0 ? "·" : str.tostring(dN)) + str.tostring(sI + 1) + str.tostring(mI + 1) + str.tostring(qI + 1) + str.tostring(sqI + 1)

// שלוש הספרות של הגרף היומי ביום של t: שנה במחזור ה-4 הקלנדרי (2023 = 1),
// רבעון QT, ורבע-הרבעון — אותה חלוקה כמו qSubIdx בחישוב הראשי.
f_qsDay(int t) =>
    post = hour(t, TZ) * 60 + minute(t, TZ) >= 1080
    tdt  = post ? t + 86400000 : t
    yy   = year(tdt, TZ)
    mm   = month(tdt, TZ)
    dd   = dayofmonth(tdt, TZ)
    qMI  = mm >= 4 ? mm - 4 : mm + 8
    qY   = mm >= 4 ? yy : yy - 1
    qQ   = math.floor(qMI / 3) + 1
    qsM  = qQ == 1 ? 4 : qQ == 2 ? 7 : qQ == 3 ? 10 : 1
    qsY  = qQ == 4 ? qY + 1 : qY
    nsM  = qsM == 10 ? 1 : qsM + 3
    nsY  = qsM == 10 ? qsY + 1 : qsY
    qsT  = timestamp(TZ, qsY, qsM, 1, 12, 0)
    nsT  = timestamp(TZ, nsY, nsM, 1, 12, 0)
    tdNT = timestamp(TZ, yy, mm, dd, 12, 0)
    qLn  = math.round((nsT - qsT) / 86400000)
    dSnc = math.round((tdNT - qsT) / 86400000)
    qq   = qLn > 0 ? math.min(3, math.max(0, math.floor(dSnc * 4 / qLn))) : 0
    str.tostring(((yy - 2023) % 4 + 4) % 4 + 1) + str.tostring(qQ) + str.tostring(qq + 1)

// איזו שלישייה (אינדקס ההתחלה בשבע הספרות) נכתבת בתווית של כל מדרגה (רמה
// אחת מתחת לייחוס): 0 = חודש-שבוע-יום (4H), 1 = שבוע-יום-סשן (1H),
// 2 = יום-סשן-מיקרו (15M), 3 = סשן-מיקרו-רבע (5M), 4 = מיקרו-רבע-תת רבע (1M
// ו-15S — מתחת לתת-רבע אין רמה)
f_qsK(int cls) => cls <= 2 ? 4 : cls == 3 ? 3 : cls == 4 ? 2 : cls == 5 ? 1 : 0

// הרמה של כל גרף בשבע הספרות (מחזור הייחוס שלו): 1 = שבוע (4H), 2 = יום (1H),
// 3 = סשן (15M), 4 = 90 דק' (5M), 5 = 22.5 דק' (1M), 6 = 5.625 דק' (15S)
f_qsLvl(int cls) => cls <= 1 ? 6 : cls == 2 ? 5 : cls == 3 ? 4 : cls == 4 ? 3 : cls == 5 ? 2 : 1

// הרצף שנכתב בתווית: שלוש הספרות של השלישייה של המדרגה
f_qsChain(int cls, int t) => cls == 7 ? f_qsDay(t) : cls >= 1 and cls <= 6 ? str.substring(f_qsDigits(t), f_qsK(cls), f_qsK(cls) + 3) : ""

f_qsHot(string s) => str.length(s) == 3 and str.contains(hotKey, "," + s + ",")

// האם נר [t, t+dur) נכנס לחלון QS — כל שלישייה רצופה שהרמה של הגרף (f_qsLvl)
// היא חלק ממנה: שתיים מעליה, אחת מעל ואחת מתחת, או שתיים מתחת. למשל ב-5M
// (רמה 90 דק'): יום-סשן-90, סשן-90-22.5 ו-90-22.5-5.625.
// החלון הוא התא שבו שלוש הספרות יוצרות רצף חם; נר שחלק ממנו בתוך החלון נחשב
// בתוכו — כלומר החלון מעוגל החוצה לנרות שלמים (3-3-3 של 09:45–10:07:30 בגרף
// 5 דק' = 09:45–10:10). כל חלון שנבדק ארוך מהנר, ולכן נר נוגע לכל היותר בשני
// תאים — בתחילתו ובסופו — ומספיק לבדוק את שני הרגעים. ביומי נבדק יום הנר.
// מוחזר גם הרצף החם; השלישייה שכתובה בתווית קודמת, ואחריה השאר מלמעלה למטה.
f_qsAt(int cls, int t, int durMs) =>
    bool   found = false
    string pat   = ""
    if cls == 7
        s = f_qsDay(t)
        if f_qsHot(s)
            found := true
            pat   := s
    else if cls >= 1 and cls <= 6
        d1   = f_qsDigits(t)
        d2   = f_qsDigits(t + durMs - 1)
        kOwn = f_qsK(cls)
        lvl  = f_qsLvl(cls)
        kLo  = math.max(lvl - 2, 0)
        kHi  = math.min(lvl, 4)
        for i = 0 to kHi - kLo + 1
            k = i == 0 ? kOwn : kLo + i - 1
            if not found
                s1 = str.substring(d1, k, k + 3)
                s2 = str.substring(d2, k, k + 3)
                h  = f_qsHot(s1) ? s1 : f_qsHot(s2) ? s2 : ""
                if h != ""
                    found := true
                    pat   := h
    [found, pat]

qsOn  = qsUseCls(tfClass)
durMs = tfSec * 1000

// הרצפים וה-QS של שבירה על נכס אחד. QS — לפי נר השבירה בלבד. ב-HSSMT נבדק קודם
// נר השבירה של הסגירה, ואם הוא לא ב-QS — גם זה של הפתיל. isBar = המיקומים הם
// bar_index (הגרף) ולא זמן (המנועים); הרצפים לתווית מחושבים רק לגרף.
f_qsAsset(Acc acc, int cls, bool isBull, int typ, int refI, bool isBar, int dur) =>
    string cR  = ""
    string cT  = ""
    bool   hot = false
    string pat = ""
    for ps = 0 to 1
        isH = typ == 2 and ps == 0
        if ps == 0 or (typ == 2 and not hot)
            [b1, p1, b2, p2, ok] = f_pts(acc, isBull, isH, refI)
            if ok
                int t1 = b1
                int t2 = b2
                if isBar
                    t1 := time[bar_index - b1]
                    t2 := time[bar_index - b2]
                [h, q] = f_qsAt(cls, t2, dur)
                if isBar and (ps == 0 or h)
                    cR := f_qsChain(cls, t1)
                    cT := f_qsChain(cls, t2)
                if h
                    hot := true
                    pat := q
    [cR, cT, hot, pat]

// שבירה בכיוון אחד בגרף, על הנכסים aLo..aHi: על נכס הגרף (o), ועל הנכס האחר
// הראשון שבו היא ב-QS (x). כשנכס הגרף לא חלק מהשבירה, הרצפים נלקחים מהראשון.
f_qsDir(int dir, int typ, int refI, int aLo, int aHi) =>
    string oR  = ""
    string oT  = ""
    bool   oH  = false
    string oP  = ""
    bool   xOn = false
    string xR  = ""
    string xT  = ""
    string xP  = ""
    if qsOn and dir != 0 and typ != 0 and refI >= 0
        inGrp = cA >= aLo and cA <= aHi
        for a = aLo to aHi
            [r, t, h, pt] = f_qsAsset(f_acc(a), tfClass, dir == 1, typ, refI, true, durMs)
            if a == cA
                oR := r
                oT := t
                oH := h
                oP := pt
            else
                if not inGrp and a == aLo
                    oR := r
                    oT := t
                if not xOn and h
                    xOn := true
                    xR  := r
                    xT  := t
                    xP  := pt
    [oR, oT, oH, oP, xOn, xR, xT, xP]

// שם המחזור שבין תת-המחזורים שלו קרתה השבירה
f_cycName(int cls) => cls == 1 ? "5.6m" : cls == 2 ? "22.5m" : cls == 3 ? "90m" : cls == 4 ? "Session" : cls == 5 ? "Day" : cls == 6 ? "Week" : cls == 7 ? "QQ" : cls == 8 ? "Qtr" : "Year"

// הנכסים שלקחו את הרמה, בלי סימוני H/S — לשורה התחתונה הקצרה של התווית.
// התג (all closed) / (core closed) נשמר גם כאן, כמו בפינה.
f_assets(string s) =>
    string out = ""
    for p in str.split(s, " ")
        if (p == nm1 or p == nm2 or p == nm3 or p == nm4) and not str.contains("/" + out + "/", "/" + p + "/")
            out := out == "" ? p : out + "/" + p
    tag = str.contains(s, "(all closed)") ? " (all closed)" : str.contains(s, "(core closed)") ? " (core closed)" : ""
    out + tag

// הקו והתווית נשענים על נרות בעבר (נר הייחוס ונר השבירה) — במרחק שיכול
// להגיע למאות נרות. מגדילים מראש את ההיסטוריה של הסדרות האלה.
max_bars_back(time, 2000)
max_bars_back(high, 2000)
max_bars_back(low, 2000)

atr = ta.atr(14)

// ═══════════════════════════════════════════════════════════════════
// מצב השבירות בגרף — ארבע: 0 = שלישייה דובית, 1 = שלישייה שורית,
// 2 = זוג 3–4 דובי, 3 = זוג 3–4 שורי. כל אחת חיה לפי הכללים שלה; הראשית
// נבחרת מכולן, והשאר שעדיין חיות "צפות" דהויות עד שיחזרו או יתבטלו.
// ═══════════════════════════════════════════════════════════════════

type Brk
    int    typ  = 0
    string lbl  = ""
    float  lvl  = na
    int    refB = 0
    int    seq  = 0
    int    refI = -1
    // QS — נלקח רק בסגירת נר ונשמר עד הנר הבא, אחרת על הנר החי הוא קופץ
    string qR = ""
    string qT = ""
    bool   qH = false
    string qP = ""
    bool   qX = false
    string xR = ""
    string xT = ""
    string xP = ""

var array<Brk> bk = array.from(Brk.new(), Brk.new(), Brk.new(), Brk.new())
var int seqCounter = 0

// עדכון שבירה. מחזיר true כשזו שבירה חדשה — כיוון שהיה כבוי, או התעגנות
// לתת-מחזור ייחוס אחר — ואז היא מקבלת את המונה הבא.
f_brkSet(Brk b, int nT, int nI, string nS, bool isBull, int seqNext) =>
    bool isNew = false
    if nT != 0
        isNew := b.typ == 0 or nI != b.refI
        if isNew
            b.seq := seqNext
        b.refI := nI
        b.typ  := nT
        b.lbl  := nS
        if cA >= 0
            acc = f_acc(cA)
            b.lvl  := array.get(f_accA(acc, isBull, nT == 2), nI)
            b.refB := array.get(f_accPA(acc, isBull, nT == 2), nI)
    else
        b.typ  := 0
        b.refI := -1
    isNew

// פקיעת מחזור־על מאפסת, ומחיקת הזרע מזיזה את כל האינדקסים ב-1
if newLifeCycle
    for k = 0 to 3
        b = array.get(bk, k)
        b.typ  := 0
        b.refI := -1
if dropSeedNow
    for k = 0 to 3
        b = array.get(bk, k)
        b.refI := b.refI > 0 ? b.refI - 1 : -1

// עדכון בסגירת נר: התווית גדלה (עוד נכסים) ומשדרגת S→H חי. שבירה שכבר לא תקפה
// נעלמת מעצמה; לקיחה מצטברת מונעת החייאה.
// בזמן חסום (שישי / שבוע 5 / שבוע מת) אין שבירות — בדיוק כמו במנועי המסגרות האחרות
if barstate.isconfirmed and blocked
    for k = 0 to 3
        b = array.get(bk, k)
        b.typ  := 0
        b.refI := -1
if barstate.isconfirmed and tfClass != 0 and not blocked and nLevels > 0
    [t0, i0, l0] = f_findTri(false, ac1, ac2, ac3)
    [t1, i1, l1] = f_findTri(true,  ac1, ac2, ac3)
    int    t2 = 0
    int    i2 = -1
    string l2 = ""
    int    t3 = 0
    int    i3 = -1
    string l3 = ""
    if use4
        [pt2, pi2, pl2] = f_findPair(false, ac3, ac4)
        [pt3, pi3, pl3] = f_findPair(true,  ac3, ac4)
        t2 := pt2
        i2 := pi2
        l2 := pl2
        t3 := pt3
        i3 := pi3
        l3 := pl3
    if f_brkSet(array.get(bk, 0), bearOK ? t0 : 0, i0, l0, false, seqCounter + 1)
        seqCounter += 1
    if f_brkSet(array.get(bk, 1), bullOK ? t1 : 0, i1, l1, true, seqCounter + 1)
        seqCounter += 1
    if f_brkSet(array.get(bk, 2), bearOK ? t2 : 0, i2, l2, false, seqCounter + 1)
        seqCounter += 1
    if f_brkSet(array.get(bk, 3), bullOK ? t3 : 0, i3, l3, true, seqCounter + 1)
        seqCounter += 1

// QS לארבע השבירות — רק בסגירת נר, ורק בסוף הגרף: ה-QS הוא תוצאה של המצב
// הנוכחי בלבד ומשפיע רק על הציור, ולכן אין טעם לחשב אותו בכל נר בהיסטוריה
if barstate.isconfirmed and bar_index >= last_bar_index - 1
    for k = 0 to 3
        b = array.get(bk, k)
        [r1, r2, r3, r4, r5, r6, r7, r8] = f_qsDir(k % 2 == 1 ? 1 : -1, b.typ, b.refI, k >= 2 ? 2 : 0, k >= 2 ? 3 : 2)
        b.qR := r1
        b.qT := r2
        b.qH := r3
        b.qP := r4
        b.qX := r5
        b.xR := r6
        b.xT := r7
        b.xP := r8

// ═══════════════════════════════════════════════════════════════════
// הראשית וציור
// ═══════════════════════════════════════════════════════════════════

f_inQS(Brk b) => qsOn and (b.qH or b.qX)

// שבירה מוצגת: חיה, לא בזמן חסום, לא "closed" מוסתרת, ולא מסוננת ע"י "רק ב-QS"
f_vis(Brk b) => b.typ != 0 and not blocked and not (hideC and f_closed(b.lbl)) and not (qsOn and qsFilt and not f_inQS(b))

// הראשית: הכי חזקה (f_rank), ובחוזק שווה — האחרונה שנעשתה
f_prim() =>
    int best = -1
    int bRk  = -1
    for k = 0 to 3
        b = array.get(bk, k)
        if f_vis(b)
            rk = f_rank(b.typ, b.lbl, f_inQS(b))
            if best < 0
                best := k
                bRk  := rk
            else if rk > bRk or (rk == bRk and b.seq > array.get(bk, best).seq)
                best := k
                bRk  := rk
    best

// כמה צריך להזיז את הקו כדי שלא יחצה נר. נבדקות רק נקודות ש**בתוך** הקטע.
f_clearShift(bool isBull, int b1, float p1, int b2, float p2, array<float> extA, array<int> posA, int fromI, float pad) =>
    float sh = 0.0
    if b2 > b1
        slope = (p2 - p1) / (b2 - b1)
        n = array.size(extA)
        // חובה לוודא fromI <= n-1: ב-Pine לולאת for עם התחלה גדולה מהסוף רצה אחורה
        if n > 0 and fromI >= 0 and fromI <= n - 1
            for k = fromI to n - 1
                xb = array.get(posA, k)
                if xb > b1 and xb < b2
                    ln = p1 + slope * (xb - b1)
                    ex = array.get(extA, k)
                    sh := math.max(sh, isBull ? ln - (ex - pad) : (ex + pad) - ln)
    sh

// צבע השבירה הראשית — רך כברירת מחדל: HSSMT מעט שקוף, SSMT שקוף יותר, ושבירה
// ב-QS (★ או ☆) בצבע מלא. שבירה משנית מקבלת את השקיפות שלה בלבד (weakFade),
// בלי קשר לראשית — כך שינוי שלה לא מעמעם את הכול.
f_col(color base, int typ, bool weak, bool hot) =>
    t = weak ? weakFade : (hot ? 0 : typ == 2 ? 25 : 45)
    color.new(base, math.min(t, 95))

wStyle = weakStyle == "מקווקו" ? line.style_dashed : weakStyle == "נקודות" ? line.style_dotted : line.style_solid

// הכוכב: ★ = השבירה ב-QS על נכס הגרף, ☆ = על נכס אחר. אם הרצף שתפס את ה-QS
// שונה מהרצף שכתוב בתווית, הוא נכתב צמוד לכוכב.
f_starTxt(string sym, string pat, string chT) => pat == "" or pat == chT ? sym : sym + pat

// הטקסט המלא של התווית: שורה עליונה — מאיזה רצף עברנו לאיזה, וכוכב אם ב-QS;
// שורה תחתונה — המחזור, הסוג והנכסים. לזוג 3–4 אותה תווית בדיוק — הצבע מבדיל.
f_lblFull(Brk b) =>
    star = b.qH ? f_starTxt("★", b.qP, b.qT) : b.qX ? f_starTxt("☆", b.xP, b.qT != "" ? b.qT : b.xT) : ""
    cR   = b.qR != "" ? b.qR : b.xR
    cT   = b.qT != "" ? b.qT : b.xT
    top  = cR != "" ? cR + "-" + cT + (star != "" ? " " + star : "") : ""
    bot  = f_cycName(tfClass) + " " + (b.typ == 2 ? "HSSMT" : "SSMT") + " · " + f_assets(b.lbl)
    top == "" ? bot : top + "\n" + bot

// התווית על הגרף — תמיד המלאה
f_lblTxt(Brk b) => f_lblFull(b)

// הנכס הראשון בקבוצה שלקח את הרמה — לעיגון התווית כשנכס הגרף לא חלק מהשבירה
f_taker(string s, int aLo, int aHi) =>
    int  r = aLo
    bool f = false
    sp = " " + s + " "
    for a = aLo to aHi
        if not f and str.contains(sp, " " + f_nm(a) + " ")
            r := a
            f := true
    r

// המחיר החי וה-ATR של כל נכס
f_hi(int a)  => a == 0 ? x1h : a == 1 ? x2h : a == 2 ? x3h : x4h
f_lo(int a)  => a == 0 ? x1l : a == 1 ? x2l : a == 2 ? x3l : x4l
f_cl(int a)  => a == 0 ? x1c : a == 1 ? x2c : a == 2 ? x3c : x4c
f_atr(int a) => a == 0 ? x1a : a == 1 ? x2a : a == 2 ? x3a : x4a

// שבירה שעומדת להתבטל: מחזיר את שמות הנכסים שחסרים כדי לבטל אותה — רק אם
// כולם כבר קרובים לרמה שלהם (פחות מ-nearATR × ATR של אותו נכס). אחרת "".
//   שלישייה דובית — מתבטלת כש-NQ ו-ES שניהם לקחו (YM לא משנה).
//   שלישייה שורית — מתבטלת כשכל השלושה לקחו.
//   זוג 3–4       — מתבטלת כששניהם לקחו.
// HSSMT נמדד בסגירה מול הסגירה הקיצונית, SSMT בפתיל מול הפתיל.
f_danger(int k, Brk b) =>
    string out = ""
    if nearOn and b.typ != 0 and b.refI >= 0
        isBull = k % 2 == 1
        isPair = k >= 2
        isH    = b.typ == 2
        aLo    = isPair ? 2 : 0
        aHi    = isPair ? 3 : 2
        bool   allNear = true
        int    nNeed   = 0
        string names   = ""
        for a = aLo to aHi
            if isPair or isBull or a != 2
                acc  = f_acc(a)
                extA = f_accA(acc, isBull, isH)
                posA = f_accPA(acc, isBull, isH)
                if b.refI <= array.size(extA) - 1
                    ref = array.get(extA, b.refI)
                    [ex, exB] = f_take(isBull, extA, posA, b.refI, f_accV(acc, isBull, isH), f_accP(acc, isBull, isH))
                    // הנכס עוד לא לקח את הרמה — הוא אחד מאלה שחסרים לביטול
                    if not f_beyond(isBull, ex, ref)
                        nNeed += 1
                        cur  = isH ? f_cl(a) : isBull ? f_lo(a) : f_hi(a)
                        dist = isBull ? cur - ref : ref - cur
                        if na(dist) or na(f_atr(a)) or dist > nearATR * f_atr(a)
                            allNear := false
                        names := names + (names == "" ? "" : " ") + f_nm(a)
        if nNeed > 0 and allNear
            out := names
    out

// ציור שבירה אחת. כשנכס הגרף חלק ממנה — קו (על נכס הגרף) ותווית בסוף הקו.
// אחרת — רק תווית, מעל/מתחת לנר שבו הנכס שלקח עשה את השבירה.
f_draw(int k, Brk b, bool weak, array<label> L, array<line> N) =>
    isBull = k % 2 == 1
    isPair = k >= 2
    isH    = b.typ == 2
    aLo    = isPair ? 2 : 0
    aHi    = isPair ? 3 : 2
    onCh   = cA >= aLo and cA <= aHi
    grey   = greyC and f_closed(b.lbl)
    base   = grey ? color.gray : weak ? (isPair ? colPairW : isBull ? colBullW : colBearW) : (isPair ? colPair : isBull ? colBull : colBear)
    lSty   = weak ? wStyle : line.style_solid
    lSize  = weak and weakSmall ? size.tiny : labelSize
    cFin   = f_col(base, b.typ, weak, f_inQS(b))
    aAnc   = onCh ? cA : f_taker(b.lbl, aLo, aHi)
    [b1, p1, b2, p2, ok] = f_pts(f_acc(aAnc), isBull, isH, b.refI)
    float y2 = na
    if onCh and showLine
        if lineMode != "אלכסוני" and not na(b.lvl) and b.refB > 0
            array.push(N, line.new(b.refB, b.lvl, bar_index, b.lvl, color = cFin, width = lineWidth, style = lSty))
        if lineMode != "אופקי" and ok
            acc = f_acc(cA)
            pad = atr * linePad
            sh  = f_clearShift(isBull, b1, p1, b2, p2, f_accA(acc, isBull, isH), f_accPA(acc, isBull, isH), b.refI, pad)
            y1  = isBull ? p1 - pad - sh : p1 + pad + sh
            y2 := isBull ? p2 - pad - sh : p2 + pad + sh
            array.push(N, line.new(b1, y1, b2, y2, color = cFin, width = lineWidth, style = lSty))
    // התווית מעל (או מתחת ל-) הנר שלקח את הרמה — מעל הפתיל, כדי שלא תעלה על הנר
    if ok
        hB = high[bar_index - b2]
        lB = low[bar_index - b2]
        pd = atr * 0.15
        yl = isBull ? math.min(lB, nz(y2, lB)) - pd : math.max(hB, nz(y2, hB)) + pd
        dz   = f_danger(k, b)
        mTxt = f_lblTxt(b) + (dz != "" ? "  ! " + dz : "")
        // השעה של הנר שלקח את הרמה. בתווית הראשית נשארת שורה ריקה בצד שפונה לנר,
        // ושם יושבת תווית זעירה עם השעה — כך היא קטנה מהטקסט הראשי ולא עולה עליו.
        tStr = showTime ? str.format_time(time[bar_index - b2], tfClass >= 7 ? "dd.MM" : "HH:mm", TZ) : ""
        lTxt = tStr == "" ? mTxt : isBull ? "\n" + mTxt : mTxt + "\n"
        lSty2 = isBull ? label.style_label_up : label.style_label_down
        array.push(L, label.new(b2, yl, lTxt, style = lSty2, color = color.new(color.black, 100), textcolor = cFin, size = lSize, textalign = text.align_center))
        if tStr != ""
            array.push(L, label.new(b2, yl, tStr, style = lSty2, color = color.new(color.black, 100), textcolor = color.new(cFin, math.min(color.t(cFin) + 30, 85)), size = size.tiny, textalign = text.align_center))
    ok

// רק המצב הנוכחי מצויר, ולכן מציירים רק בנר האחרון: מוחקים הכול ומציירים מחדש
prim = barstate.islast ? f_prim() : -1
var array<label> drL = array.new_label()
var array<line>  drN = array.new_line()
if barstate.islast
    while array.size(drL) > 0
        label.delete(array.pop(drL))
    while array.size(drN) > 0
        line.delete(array.pop(drN))
    for k = 0 to 3
        b = array.get(bk, k)
        if f_vis(b)
            f_draw(k, b, k != prim, drL, drN)

// ═══════════════════════════════════════════════════════════════════
// סריקת מסגרות זמן אחרות
// ═══════════════════════════════════════════════════════════════════
// ה-request.security מושך רק מספרים גולמיים (זמן + high/low/close), והמנוע
// עצמו רץ על ציר הזמן של הגרף עם מצב ב-var — מוקצה פעם אחת ולא בכל נר.
// זה ההבדל שמונע Memory limits exceeded: החזרת אובייקט מלא מ-security
// נשמרת לכל נר בהיסטוריה ומפוצצת את הזיכרון.
//
// מעל הגרף — ההיסט נעשה בתוך הביטוי (high[1] וכו'), כלומר בזמן של אותה
// מסגרת, ולכן אין ריפיינט: נר נכנס לחישוב רק כשהוא נסגר.
// מתחת לגרף — אין נרות מוסטים, ולכן מושכים את כל תת-הנרות של נר הגרף
// (request.security_lower_tf) ומזינים אותם למנוע אחד-אחד — רק תת-נרות שנסגרו.
//
// שים לב: לוגיקת המחזורים כאן משכפלת את החישוב הראשי שלמעלה. אם משנים
// את מודל הסייקלים — חייבים לשנות בשני המקומות.

f_cycT(int cls, int t) =>
    eH   = hour(t, TZ)
    eM   = minute(t, TZ)
    eS   = second(t, TZ)
    mOD  = eH * 60 + eM
    post = mOD >= 1080
    mFD  = post ? mOD - 1080 : mOD + 360
    tdt  = post ? t + 86400000 : t
    yy = year(tdt, TZ)
    mm = month(tdt, TZ)
    dd = dayofmonth(tdt, TZ)
    dw = dayofweek(tdt, TZ)
    // בשניות, בדיוק כמו בחישוב הראשי — בשביל תת-הרבע של 5.625 דקות
    sFD   = mFD * 60 + eS
    sIdx  = math.floor(sFD / 21600)
    sIS   = sFD % 21600
    miIdx = math.floor(sIS / 5400)
    sIM   = sIS % 5400
    qIdx  = math.floor(sIM / 1350)
    sIQ   = sIM % 1350
    sqIdx = math.floor(sIQ / 337.5)
    dsm = dw == dayofweek.sunday ? 6 : dw - 2
    mon = tdt - dsm * 86400000
    tue = mon + 86400000
    thu = mon + 3 * 86400000
    moM = month(mon, TZ)
    moD = dayofmonth(mon, TZ)
    moY = year(mon, TZ)
    // אותו עוגן כמו בחישוב הראשי: החודש של השבוע נקבע לפי יום שלישי
    tuM = month(tue, TZ)
    tuY = year(tue, TZ)
    dead = tuM != month(thu, TZ)
    wkN  = dead ? 0 : math.floor((dayofmonth(tue, TZ) - 1) / 7) + 1
    ownW = dead or wkN == 5
    qMonIdx = mm >= 4 ? mm - 4 : mm + 8
    qYear   = mm >= 4 ? yy : yy - 1
    qQtr    = math.floor(qMonIdx / 3) + 1
    tdId = yy * 10000 + mm * 100 + dd
    wkId = moY * 10000 + moM * 100 + moD
    // שבוע מת ושבוע 5 — מיכל משלהם, בדיוק כמו בחישוב הראשי
    moId = ownW ? wkId : tuY * 100 + tuM
    seId = tdId * 10 + sIdx
    miId = seId * 10 + miIdx
    quId = miId * 10 + qIdx
    sqId = quId * 10 + sqIdx
    qrId = qYear * 10 + qQtr
    c4Id = math.floor((yy - 2023) / 4)
    // רבע-הרבעון דרוש רק למחלקה 7. ה-if מונע שלוש קריאות timestamp מיותרות
    // בכל תת-נר — ב-Pine בלוק if באמת לא מורץ כשהתנאי שקרי.
    int qsIdx = 0
    if cls == 7
        qsMon  = qQtr == 1 ? 4 : qQtr == 2 ? 7 : qQtr == 3 ? 10 : 1
        qsYear = qQtr == 4 ? qYear + 1 : qYear
        nsMon  = qsMon == 10 ? 1 : qsMon + 3
        nsYear = qsMon == 10 ? qsYear + 1 : qsYear
        qsT  = timestamp(TZ, qsYear, qsMon, 1, 12, 0)
        nsT  = timestamp(TZ, nsYear, nsMon, 1, 12, 0)
        tdNT = timestamp(TZ, yy, mm, dd, 12, 0)
        qLn  = math.round((nsT - qsT) / 86400000)
        dSnc = math.round((tdNT - qsT) / 86400000)
        qsIdx := qLn > 0 ? math.min(3, math.max(0, math.floor(dSnc * 4 / qLn))) : 0
    qsId = qrId * 10 + qsIdx
    rId = cls == 9 ? yy : cls == 8 ? qrId : cls == 7 ? qsId : cls == 6 ? wkId : cls == 5 ? tdId : cls == 4 ? seId : cls == 3 ? miId : cls == 2 ? quId : sqId
    lId = cls == 9 ? c4Id  : cls == 8 ? qYear : cls == 7 ? qrId : cls == 6 ? moId : cls == 5 ? wkId : cls == 4 ? tdId : cls == 3 ? seId : cls == 2 ? miId : quId
    // זרע: 15s, 1m, 5m ו-1H בלבד — זהה ל-keepLast של הגרף
    kL  = cls == 1 or cls == 2 or cls == 3 or cls == 5
    // שישי: 1H תמיד חסום, 4H רק בשבוע 4. שבוע 5 ושבוע מת חסומים ב-4H.
    fri = dw == dayofweek.friday
    blk = (cls == 5 and fri) or (cls == 6 and ((fri and wkN == 4) or wkN == 5 or (blockDeadWeek and dead)))
    // ה-Q2 של המחזור — הנר הראשון בו הוא ה-True Open. זהה ל-inXxxQ2 של הגרף.
    q2  = cls == 9 ? ((yy - 2023) % 4 + 4) % 4 == 1 : cls == 8 ? qQtr == 1 : cls == 7 ? qsIdx == 1 : cls == 6 ? wkN == 2 : cls == 5 ? dw == dayofweek.tuesday : cls == 4 ? (mFD >= 360 and mFD < 720) : cls == 3 ? miIdx == 1 : cls == 2 ? qIdx == 1 : sqIdx == 1
    [rId, lId, kL, blk, q2]

// מנוע שלם למסגרת זמן אחת — כל המצב שלו מוקצה פעם אחת ומתעדכן במקום.
// ארבע השבירות שלו באותו סדר כמו בגרף (0/1 שלישייה, 2/3 זוג 3–4).
type Eng
    int    cls
    int    barMs            // אורך נר הקלט במילישניות (15 שניות מנרות דקה = 60000)
    Acc    a1
    Acc    a2
    Acc    a3
    Acc    a4
    array<int>    tyA
    array<int>    riA
    array<int>    sqA
    array<string> lbA
    array<bool>   qhA       // ★ — ב-QS על נכס הגרף
    array<bool>   qsA       // ★ או ☆
    int    lastT   = 0
    int    refId   = 0
    int    lifeId  = 0
    bool   started = false
    bool   sAct    = false
    int    seqC    = 0
    // True Open של המסגרת הזו, על הסימבול של הגרף
    bool   pQ2     = false
    float  toP     = na
    float  cRef    = na
    // הראשית — לפינה ולהתראה
    string txt   = ""
    int    pk    = -1
    int    pSeq  = 0
    bool   pGrey = false

f_newEng(int cls, int barMs) => Eng.new(cls = cls, barMs = barMs, a1 = f_newAcc(), a2 = f_newAcc(), a3 = f_newAcc(), a4 = f_newAcc(), tyA = array.new_int(4, 0), riA = array.new_int(4, -1), sqA = array.new_int(4, 0), lbA = array.new_string(4, ""), qhA = array.new_bool(4, false), qsA = array.new_bool(4, false))

f_engAcc(Eng e, int a) => a == 0 ? e.a1 : a == 1 ? e.a2 : a == 2 ? e.a3 : e.a4

// QS של שבירה k במנוע: על נכס הגרף (★), או רק על נכס אחר (☆)
f_engQS(Eng e, int k) =>
    aLo = k >= 2 ? 2 : 0
    aHi = k >= 2 ? 3 : 2
    bool oH  = false
    bool xOn = false
    for a = aLo to aHi
        [r, t, h, pt] = f_qsAsset(f_engAcc(e, a), e.cls, k % 2 == 1, array.get(e.tyA, k), array.get(e.riA, k), false, e.barMs)
        if a == cA
            oH := h
        else if h
            xOn := true
    [oH, xOn]

// צעד אחד: נר סגור אחד של המסגרת שהמנוע מייצג.
// oR / cR = הפתיחה והסגירה של אותו נר על הסימבול של הגרף — בשביל ה-True Open.
f_engStep(Eng e, int t, float oR, float cR, float h1, float l1, float c1, float h2, float l2, float c2, float h3, float l3, float c3, float h4, float l4, float c4) =>
    if not na(t) and t != e.lastT and not na(c1) and not na(c2) and not na(c3) and not na(c4)
        e.lastT := t
        [rId, lId, kL, blk, q2] = f_cycT(e.cls, t)
        // True Open: הפתיחה של הנר הראשון ב-Q2. אם חסר לו נתון — מנסים בנר הבא.
        // עד ה-Q2 של המחזור הזה נשאר ה-True Open של המחזור הקודם.
        if q2 and not e.pQ2
            if not na(oR)
                e.toP := oR
                e.pQ2 := true
        else
            e.pQ2 := q2
        if not na(cR)
            e.cRef := cR
        eBear = not requireTrueOpen or (not na(e.toP) and not na(e.cRef) and e.cRef > e.toP)
        eBull = not requireTrueOpen or (not na(e.toP) and not na(e.cRef) and e.cRef < e.toP)
        newRef  = e.started and rId != e.refId
        newLife = e.started and lId != e.lifeId
        canP    = not na(e.a1.hi) and not na(e.a2.hi) and not na(e.a3.hi) and not na(e.a4.hi)
        push    = newRef and ((not newLife) or kL) and canP
        sDrop   = newRef and (not newLife) and e.sAct
        f_accStep(e.a1, newRef, newLife, push, sDrop, h1, l1, c1, t)
        f_accStep(e.a2, newRef, newLife, push, sDrop, h2, l2, c2, t)
        f_accStep(e.a3, newRef, newLife, push, sDrop, h3, l3, c3, t)
        f_accStep(e.a4, newRef, newLife, push, sDrop, h4, l4, c4, t)
        if newRef and newLife
            e.sAct := kL and canP
        else if newRef
            e.sAct := false
        e.started := true
        e.refId   := rId
        e.lifeId  := lId
        // פקיעת מחזור־על מאפסת, ומחיקת הזרע מזיזה את האינדקסים ב-1
        if newLife
            for k = 0 to 3
                array.set(e.tyA, k, 0)
                array.set(e.riA, k, -1)
        if sDrop
            for k = 0 to 3
                ri = array.get(e.riA, k)
                array.set(e.riA, k, ri > 0 ? ri - 1 : -1)

        // אותה לוגיקת שבירה בדיוק כמו בגרף, כולל הסינון לפי True Open
        for k = 0 to 3
            isBull = k % 2 == 1
            int    nT = 0
            int    nI = -1
            string nS = ""
            if array.size(e.a1.hiA) > 0 and not blk
                if k < 2
                    [ft, fi, fs] = f_findTri(isBull, e.a1, e.a2, e.a3)
                    nT := ft
                    nI := fi
                    nS := fs
                else if use4
                    [gt, gi, gs] = f_findPair(isBull, e.a3, e.a4)
                    nT := gt
                    nI := gi
                    nS := gs
            if nT != 0 and not (isBull ? eBull : eBear)
                nT := 0
            if nT != 0
                if array.get(e.tyA, k) == 0 or nI != array.get(e.riA, k)
                    e.seqC := e.seqC + 1
                    array.set(e.sqA, k, e.seqC)
                array.set(e.riA, k, nI)
                array.set(e.tyA, k, nT)
                array.set(e.lbA, k, nS)
            else
                array.set(e.tyA, k, 0)
                array.set(e.riA, k, -1)
    e.started

// מתי השבירה נוצרה, לפינה: ה-Q של תת-המחזור שבו הנר שלקח את הרמה נמצא, והשעה
// שלו (שעון ניו יורק). למשל 1H ביום שלישי = Q2. ה-Q הוא הספרה של רמת הייחוס של
// המסגרת: 15s = תת-רבע, 1m = רבע, 5m = 90 דק', 15m = סשן, 1H = יום, 4H = שבוע.
// בלי מספר (שישי, שבוע מת) — רק השעה.
f_when(Acc acc, int cls, bool isBull, int typ, int refI) =>
    string s = ""
    [b1, p1, b2, p2, ok] = f_pts(acc, isBull, typ == 2, refI)
    if ok
        qc = cls == 7 ? str.substring(f_qsDay(b2), 2, 3) : cls >= 1 and cls <= 6 ? str.substring(f_qsDigits(b2), f_qsLvl(cls), f_qsLvl(cls) + 1) : ""
        s := (qc != "" and qc != "·" ? "Q" + qc + " " : "") + str.format_time(b2, cls >= 7 ? "dd.MM" : "HH:mm", TZ)
    s

// QS ובחירת הראשית של מנוע — כמו בגרף. רץ רק בנר האחרון (בשביל הפינה
// וההתראה), ולא בכל תת-נר בהיסטוריה: התוצאה תלויה רק במצב הנוכחי של המנוע.
f_engPick(Eng e) =>
    qsE = qsUseCls(e.cls)
    int best = -1
    int bRk  = -1
    for k = 0 to 3
        ty = array.get(e.tyA, k)
        bool oH = false
        bool q  = false
        if qsE and ty != 0
            [x1, x2] = f_engQS(e, k)
            oH := x1
            q  := x1 or x2
        array.set(e.qhA, k, oH)
        array.set(e.qsA, k, q)
        lb = array.get(e.lbA, k)
        if ty != 0 and not (hideC and f_closed(lb)) and not (qsE and qsFilt and not q)
            rk = f_rank(ty, lb, q)
            if best < 0
                best := k
                bRk  := rk
            else if rk > bRk or (rk == bRk and array.get(e.sqA, k) > array.get(e.sqA, best))
                best := k
                bRk  := rk
    e.pk := best
    if best >= 0
        pl  = array.get(e.lbA, best)
        tag = array.get(e.qhA, best) ? " ★" : array.get(e.qsA, best) ? " ☆" : ""
        // הנכס שלפיו נמדד הזמן: נכס הגרף אם הוא לקח, אחרת הראשון שלקח
        bLo  = best >= 2 ? 2 : 0
        bHi  = best >= 2 ? 3 : 2
        aW   = cA >= bLo and cA <= bHi and str.contains(" " + pl + " ", " " + f_nm(cA) + " ") ? cA : f_taker(pl, bLo, bHi)
        when = f_when(f_engAcc(e, aW), e.cls, best % 2 == 1, array.get(e.tyA, best), array.get(e.riA, best))
        e.txt   := (best % 2 == 1 ? "▲" : "▼") + (minimal ? (array.get(e.tyA, best) == 2 ? "H" : "S") : pl + tag) + (when != "" ? " " + when : "")
        e.pSeq  := array.get(e.sqA, best)
        e.pGrey := greyC and f_closed(pl)
    else
        e.txt := ""
    e.txt

// סמן רץ: מחזיר את האינדקס האחרון במערך הזמנים שזמנו <= t, החל מ-from.
// המערכים ממוינים ולכן הסמן רק מתקדם — מעבר אחד על כל תת-הנרות.
// חשוב: ב-Pine האופרטור and לא מובטח כ-short-circuit, ולכן אסור לכתוב
// while k < n - 1 and array.get(ta, k + 1) <= t — ה-array.get יורץ גם
// כשהתנאי הראשון שקרי ויזרוק Index out of range. לכן שני if מקוננים.
// הקורא חייב לוודא שהמערך לא ריק.
f_cur(array<int> ta, int t, int from) =>
    n = array.size(ta)
    k = from < 0 ? 0 : from > n - 1 ? n - 1 : from
    if n > 0
        bool go = true
        while go
            if k < n - 1
                if array.get(ta, k + 1) <= t
                    k := k + 1
                else
                    go := false
            else
                go := false
    k

// שם המסגרת לתצוגה
f_tfName(int cls) => cls == 1 ? "15s" : cls == 2 ? "1m" : cls == 3 ? "5m" : cls == 4 ? "15m" : cls == 5 ? "1H" : cls == 6 ? "4H" : cls == 7 ? "1D" : cls == 8 ? "1W" : "1Mo"

// אורך נר של מדרגה, במילישניות
f_clsMs(int cls) => (cls == 1 ? 15 : cls == 2 ? 60 : cls == 3 ? 300 : cls == 4 ? 900 : cls == 5 ? 3600 : 14400) * 1000

// שלוש מסגרות מעל הגרף ושתיים מתחת, אבל **לא מעל 4H**: 1D ו-1W לא נסרקים
// ולא מוצגים בפינה. המדרגה התחתונה היא 15 שניות; מתחתיה אין כלום.
cU1 = math.min(tfClass + 1, 6)
cU2 = math.min(tfClass + 2, 6)
cU3 = math.min(tfClass + 3, 6)
// המדרגה הנמוכה ביותר היא תמיד 15 שניות — עם Premium מנתוני שניות, ובלי
// Premium מנרות דקה (ראה use15s)
minCls = 1
cD1 = math.max(tfClass - 1, minCls)
cD2 = math.max(tfClass - 2, minCls)

// המחרוזות חייבות להיות טרנרי ישיר ולא קריאה לפונקציה: פונקציה ב-Pine מחזירה
// תמיד series string, ו-request.security דורש simple string בפרמטר הזמן.
// במסגרת לא נתמכת (tfClass = 0) — שום מסגרת אחרת לא נסרקת: למעלה מסגרת הגרף
// (כבר טעונה), למטה "12M" (לא חוקי מתחת לגרף, ונזרק בלי למשוך נתונים).
// בלי זה, גרף 8H / 2D היה מבקש נתוני 15 שניות ונופל בלי Premium.
tU1 = tfClass == 0 ? timeframe.period : cU1 == 1 ? "15S" : cU1 == 2 ? "1" : cU1 == 3 ? "5" : cU1 == 4 ? "15" : cU1 == 5 ? "60" : cU1 == 6 ? "240" : cU1 == 7 ? "D" : cU1 == 8 ? "W" : "M"
tU2 = tfClass == 0 ? timeframe.period : cU2 == 1 ? "15S" : cU2 == 2 ? "1" : cU2 == 3 ? "5" : cU2 == 4 ? "15" : cU2 == 5 ? "60" : cU2 == 6 ? "240" : cU2 == 7 ? "D" : cU2 == 8 ? "W" : "M"
tU3 = tfClass == 0 ? timeframe.period : cU3 == 1 ? "15S" : cU3 == 2 ? "1" : cU3 == 3 ? "5" : cU3 == 4 ? "15" : cU3 == 5 ? "60" : cU3 == 6 ? "240" : cU3 == 7 ? "D" : cU3 == 8 ? "W" : "M"
tD1 = tfClass == 0 ? "12M" : cD1 == 1 ? (use15s ? "15S" : "1") : cD1 == 2 ? "1" : cD1 == 3 ? "5" : cD1 == 4 ? "15" : cD1 == 5 ? "60" : cD1 == 6 ? "240" : cD1 == 7 ? "D" : cD1 == 8 ? "W" : "M"
tD2 = tfClass == 0 ? "12M" : cD2 == 1 ? (use15s ? "15S" : "1") : cD2 == 2 ? "1" : cD2 == 3 ? "5" : cD2 == 4 ? "15" : cD2 == 5 ? "60" : cD2 == 6 ? "240" : cD2 == 7 ? "D" : cD2 == 8 ? "W" : "M"

lkh = barmerge.lookahead_off

[aT,  aH1, aL1, aC1] = request.security(s1, tU1, [time[1], high[1], low[1], close[1]], lookahead = lkh)
[aH2, aL2, aC2]      = request.security(s2, tU1, [high[1], low[1], close[1]], lookahead = lkh)
[aH3, aL3, aC3]      = request.security(s3, tU1, [high[1], low[1], close[1]], lookahead = lkh)
[aH4, aL4, aC4]      = request.security(s4, tU1, [high[1], low[1], close[1]], lookahead = lkh)
[bT_, bH1, bL1, bC1] = request.security(s1, tU2, [time[1], high[1], low[1], close[1]], lookahead = lkh)
[bH2, bL2, bC2]      = request.security(s2, tU2, [high[1], low[1], close[1]], lookahead = lkh)
[bH3, bL3, bC3]      = request.security(s3, tU2, [high[1], low[1], close[1]], lookahead = lkh)
[bH4, bL4, bC4]      = request.security(s4, tU2, [high[1], low[1], close[1]], lookahead = lkh)
[cT_, cH1, cL1, cC1] = request.security(s1, tU3, [time[1], high[1], low[1], close[1]], lookahead = lkh)
[cH2, cL2, cC2]      = request.security(s2, tU3, [high[1], low[1], close[1]], lookahead = lkh)
[cH3, cL3, cC3]      = request.security(s3, tU3, [high[1], low[1], close[1]], lookahead = lkh)
[cH4, cL4, cC4]      = request.security(s4, tU3, [high[1], low[1], close[1]], lookahead = lkh)

// ignore_invalid_timeframe מחזיר na במקום להפיל את הסקריפט כשהמדרגה הזאת
// לא באמת מתחת לגרף (למשל גרף דקה, שאין מתחתיו כלום).
// כל נכס מוחזר כמערך משלו, ודקה בלי עסקאות פשוט לא מייצרת נר. לכן חובה למשוך
// גם time לכל נכס ולזווג לפי זמן — זיווג לפי אינדקס משווה דקות שונות.
[dT1, dH1, dL1, dC1] = request.security_lower_tf(s1, tD1, [time, high, low, close], ignore_invalid_timeframe = true)
[dT2, dH2, dL2, dC2] = request.security_lower_tf(s2, tD1, [time, high, low, close], ignore_invalid_timeframe = true)
[dT3, dH3, dL3, dC3] = request.security_lower_tf(s3, tD1, [time, high, low, close], ignore_invalid_timeframe = true)
[dT4, dH4, dL4, dC4] = request.security_lower_tf(s4, tD1, [time, high, low, close], ignore_invalid_timeframe = true)
[fT1, fH1, fL1, fC1] = request.security_lower_tf(s1, tD2, [time, high, low, close], ignore_invalid_timeframe = true)
[fT2, fH2, fL2, fC2] = request.security_lower_tf(s2, tD2, [time, high, low, close], ignore_invalid_timeframe = true)
[fT3, fH3, fL3, fC3] = request.security_lower_tf(s3, tD2, [time, high, low, close], ignore_invalid_timeframe = true)
[fT4, fH4, fL4, fC4] = request.security_lower_tf(s4, tD2, [time, high, low, close], ignore_invalid_timeframe = true)

// ── True Open של המסגרות האחרות: הפתיחה והסגירה על הסימבול של הגרף עצמו,
//    בדיוק כמו ה-True Open של הגרף. כשהסינון כבוי, הבקשות העליונות מצביעות
//    על מסגרת הגרף (כבר טעונה) והתחתונות על "12M" (לא חוקי — לא נמשך כלום).
tUo1 = requireTrueOpen ? tU1 : timeframe.period
tUo2 = requireTrueOpen ? tU2 : timeframe.period
tUo3 = requireTrueOpen ? tU3 : timeframe.period
tDo1 = requireTrueOpen ? tD1 : "12M"
tDo2 = requireTrueOpen ? tD2 : "12M"
[aOc, aCc] = request.security(syminfo.tickerid, tUo1, [open[1], close[1]], lookahead = lkh)
[bOc, bCc] = request.security(syminfo.tickerid, tUo2, [open[1], close[1]], lookahead = lkh)
[cOc, cCc] = request.security(syminfo.tickerid, tUo3, [open[1], close[1]], lookahead = lkh)
[dTc, dOc, dCc] = request.security_lower_tf(syminfo.tickerid, tDo1, [time, open, close], ignore_invalid_timeframe = true)
[fTc, fOc, fCc] = request.security_lower_tf(syminfo.tickerid, tDo2, [time, open, close], ignore_invalid_timeframe = true)

// מדרגת 15 שניות בלי Premium מוזנת בנרות דקה, ולכן אורך הנר שלה הוא דקה
f_inMs(int cls) => cls == 1 and not use15s ? 60000 : f_clsMs(cls)

var Eng egU1 = f_newEng(cU1, f_clsMs(cU1))
var Eng egU2 = f_newEng(cU2, f_clsMs(cU2))
var Eng egU3 = f_newEng(cU3, f_clsMs(cU3))
var Eng egD1 = f_newEng(cD1, f_inMs(cD1))
var Eng egD2 = f_newEng(cD2, f_inMs(cD2))

useU1 = tfClass + 1 <= 6
useU2 = tfClass + 2 <= 6
useU3 = tfClass + 3 <= 6
useD1 = tfClass - 1 >= minCls
useD2 = tfClass - 2 >= minCls

// גודל של מערך שעלול להיות na: מסגרת לא חוקית (ignore_invalid_timeframe)
// מחזירה na ולא מערך ריק, ו-array.size על na מפיל את הסקריפט (RE10052).
f_szF(array<float> a) =>
    int n = 0
    if not na(a)
        n := array.size(a)
    n

f_szI(array<int> a) =>
    int n = 0
    if not na(a)
        n := array.size(a)
    n

// כמה תת-נרות להזין: בזמן אמת, כל עוד נר הגרף לא נסגר, תת-הנר האחרון עדיין
// נבנה — ולכן הוא לא נכנס. ברגע שהבא אחריו נפתח הוא כבר סגור ונכנס, כך
// שהעיכוב הוא טיק אחד בלבד. בהיסטוריה כל הנרות סגורים ושום דבר לא משתנה.
nD1 = barstate.isconfirmed ? f_szF(dC1) : f_szF(dC1) - 1
nD2 = barstate.isconfirmed ? f_szF(fC1) : f_szF(fC1) - 1

// הצעד רץ גם בתוך נר הגרף החי, ולא רק בסגירתו — כך שבירה של 5 דקות מופיעה
// ברגע שנר ה-5 נסגר, בלי לחכות לסגירת נר ה-15. זה בטוח: בנר חי הסקריפט רץ
// מחדש בכל טיק ומצב ה-var מוחזר אחורה לסגירת הנר הקודם, ולכן הצעדים פשוט
// מחושבים מחדש מאותה נקודה ולא נספרים פעמיים.
if mtfOn and tfClass != 0
    if useU1
        f_engStep(egU1, aT,  aOc, aCc, aH1, aL1, aC1, aH2, aL2, aC2, aH3, aL3, aC3, aH4, aL4, aC4)
    if useU2
        f_engStep(egU2, bT_, bOc, bCc, bH1, bL1, bC1, bH2, bL2, bC2, bH3, bL3, bC3, bH4, bL4, bC4)
    if useU3
        f_engStep(egU3, cT_, cOc, cCc, cH1, cL1, cC1, cH2, cL2, cC2, cH3, cL3, cC3, cH4, cL4, cC4)
    // תת-הנרות מזווגים לפי זמן: הזמנים של נכס 1 הם המפתח, וסמן רץ מוצא לכל נכס
    // את הנר שלו באותו זמן. נכס שחסרה לו הדקה הזאת נשאר על הנר הקודם שלו —
    // וזה בטוח, כי המצברים לוקחים מקסימום/מינימום וערך שכבר נכלל לא משנה כלום.
    // בגרף דקה בלי Premium, מדרגת 15 השניות מוזנת ישירות בנרות הגרף עצמו —
    // רק בסגירת נר, כדי שנר דקה חי לא ייכנס.
    d1Direct = tfClass == 2 and cD1 == 1 and not use15s
    if useD1 and d1Direct and barstate.isconfirmed and not na(x1c) and not na(x2c) and not na(x3c) and not na(x4c)
        f_engStep(egD1, time, open, close, x1h, x1l, x1c, x2h, x2l, x2c, x3h, x3l, x3c, x4h, x4l, x4c)
    if useD1 and not d1Direct and nD1 > 0 and f_szF(dC2) > 0 and f_szF(dC3) > 0 and f_szF(dC4) > 0
        int k2 = 0
        int k3 = 0
        int k4 = 0
        int kc = 0
        nDc = f_szI(dTc)
        for j = 0 to nD1 - 1
            tj = array.get(dT1, j)
            k2 := f_cur(dT2, tj, k2)
            k3 := f_cur(dT3, tj, k3)
            k4 := f_cur(dT4, tj, k4)
            float oR = na
            float cR = na
            if nDc > 0
                kc := f_cur(dTc, tj, kc)
                if array.get(dTc, kc) == tj
                    oR := array.get(dOc, kc)
                    cR := array.get(dCc, kc)
            if array.get(dT2, k2) <= tj and array.get(dT3, k3) <= tj and array.get(dT4, k4) <= tj
                f_engStep(egD1, tj, oR, cR, array.get(dH1, j), array.get(dL1, j), array.get(dC1, j), array.get(dH2, k2), array.get(dL2, k2), array.get(dC2, k2), array.get(dH3, k3), array.get(dL3, k3), array.get(dC3, k3), array.get(dH4, k4), array.get(dL4, k4), array.get(dC4, k4))
    if useD2 and nD2 > 0 and f_szF(fC2) > 0 and f_szF(fC3) > 0 and f_szF(fC4) > 0
        int m2 = 0
        int m3 = 0
        int m4 = 0
        int mc = 0
        nFc = f_szI(fTc)
        for j = 0 to nD2 - 1
            tj = array.get(fT1, j)
            m2 := f_cur(fT2, tj, m2)
            m3 := f_cur(fT3, tj, m3)
            m4 := f_cur(fT4, tj, m4)
            float oR = na
            float cR = na
            if nFc > 0
                mc := f_cur(fTc, tj, mc)
                if array.get(fTc, mc) == tj
                    oR := array.get(fOc, mc)
                    cR := array.get(fCc, mc)
            if array.get(fT2, m2) <= tj and array.get(fT3, m3) <= tj and array.get(fT4, m4) <= tj
                f_engStep(egD2, tj, oR, cR, array.get(fH1, j), array.get(fL1, j), array.get(fC1, j), array.get(fH2, m2), array.get(fL2, m2), array.get(fC2, m2), array.get(fH3, m3), array.get(fL3, m3), array.get(fC3, m3), array.get(fH4, m4), array.get(fL4, m4), array.get(fC4, m4))

// ═══════════════════════════════════════════════════════════════════
// הפינה + התראה
// ═══════════════════════════════════════════════════════════════════

markPos = mtfMarkPos == "שמאל למטה" ? position.bottom_left : mtfMarkPos == "שמאל למעלה" ? position.top_left : mtfMarkPos == "אמצע למטה" ? position.bottom_center : position.bottom_right
var table markTbl = table.new(markPos, 12, 1, border_width = 0)

// צבע שורה בפינה: אדום/ירוק לשלישייה, הצבע של הזוג לזוג 3–4 (בלי שם הזוג — הצבע
// מבדיל, בדיוק כמו בתווית), אפור ל-closed מואפר
f_rowCol(int k, bool grey) => k < 0 ? mtfColor : grey ? color.gray : k >= 2 ? colPair : k % 2 == 1 ? colBull : colBear

// המונה של הראשית האחרונה שהתריעה בכל אחת משש השורות. התראה יוצאת רק כשהראשית
// חדשה יותר — כלומר שבירה חדשה. עדכון של שבירה קיימת (עוד נכס, S→H), או חזרה
// לשבירה ישנה שצפה, לא מתריעים שוב. בטעינה לא מתריעים על מה שכבר קיים.
var array<int> alSeq = array.new_int(6, 0)
var bool alReady = false

if barstate.islast and tfClass != 0
    // הראשית של כל מנוע. מנוע שלא רץ (או כשהמסגרות האחרות כבויות) נשאר ריק.
    f_engPick(egU1)
    f_engPick(egU2)
    f_engPick(egU3)
    f_engPick(egD1)
    f_engPick(egD2)
    // מסגרת הגרף נלקחת מהמצב של הגרף עצמו — בדיוק הראשית שמצוירת
    string sC    = ""
    int    cSeq  = 0
    bool   cGrey = false
    if prim >= 0
        pb  = array.get(bk, prim)
        tag = pb.qH ? " ★" : pb.qX ? " ☆" : ""
        sC    := (prim % 2 == 1 ? "▲" : "▼") + (minimal ? (pb.typ == 2 ? "H" : "S") : pb.lbl + tag)
        cSeq  := pb.seq
        cGrey := greyC and f_closed(pb.lbl)

    clsArr = array.from(cU3, cU2, cU1, tfClass, cD1, cD2)
    stArr  = array.from(egU3.txt, egU2.txt, egU1.txt, sC, egD1.txt, egD2.txt)
    kArr   = array.from(egU3.pk, egU2.pk, egU1.pk, prim, egD1.pk, egD2.pk)
    gArr   = array.from(egU3.pGrey, egU2.pGrey, egU1.pGrey, cGrey, egD1.pGrey, egD2.pGrey)
    sqArr  = array.from(egU3.pSeq, egU2.pSeq, egU1.pSeq, cSeq, egD1.pSeq, egD2.pSeq)
    // מדרגה שלא נסרקת (מעל 4H, או מתחת ל-15 שניות) פשוט יוצאת מהרשימה
    useArr = array.from(useU3, useU2, useU1, true, useD1, useD2)

    bg = color.new(color.black, 100)
    prevC = -1
    mcol = 1
    string alTxt = ""
    table.clear(markTbl, 0, 0, 11, 0)
    for i = 0 to 5
        c  = array.get(clsArr, i)
        st = array.get(stArr, i)
        k  = array.get(kArr, i)
        sq = array.get(sqArr, i)
        if array.get(useArr, i) and c != prevC   // הרשימה יורדת, אז די בהשוואה לקודם כדי לנקות כפילויות בקצוות
            // את מסגרת הגרף עצמה לא כותבים בפינה — היא כבר מצוירת על הגרף
            if st != "" and mtfOn and mtfMark and c != tfClass and mcol <= 11
                table.cell(markTbl, mcol, 0, f_tfName(c) + " " + st, text_color = f_rowCol(k, array.get(gArr, i)), text_size = cornerSz, bgcolor = bg)
                mcol := mcol + 1
            // התראה: רק המסגרת והכיוון (וזוג 3–4 בשמו). 15 שניות לא מתריעות — בשום גרף.
            if st != "" and sq > array.get(alSeq, i) and c != 1 and ((mtfOn and mtfAlert) or c == tfClass)
                alTxt := alTxt + (alTxt == "" ? "" : " · ") + f_tfName(c) + " " + (k % 2 == 1 ? "▲" : "▼") + (k >= 2 ? " " + nmP : "")
            prevC := c
        if sq > array.get(alSeq, i)
            array.set(alSeq, i, sq)
    if mcol > 1
        table.cell(markTbl, 0, 0, "QT", text_color = mtfColor, text_size = cornerSz, bgcolor = bg)
    if alReady and alTxt != ""
        alert("QT SSMT: " + alTxt, alert.freq_once_per_bar)
    alReady := true
