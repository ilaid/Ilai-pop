//@version=5
indicator("QS Levels | Quarterly Theory", overlay = true, max_lines_count = 200, max_labels_count = 200, max_bars_back = 2000)

// ═══════════════════════════════════════════════════════════════════
// רמות QS חיות
// גבוה / נמוך של חלון QS שהייתה בו שבירה (SSMT / HSSMT) ושעדיין לא נלקח בפתיל.
//
// • השבירות מזוהות בדיוק כמו באינדיקטור הראשי (SSMT + HSSMT): השלישייה 1–2–3
//   והזוג 3–4, כל הסוגים — HSSMT, SSMT ו-closed. שבירה "ב-QS" = הנר שלקח את
//   הרמה (על אחד מנכסי השבירה) נמצא בחלון של רצף חם שהרמה של הגרף חלק ממנו.
// • הרמה: הקיצון של הנכס שבגרף, מהנר שעשה את השבירה ועד סוף אותו חלון QS —
//   רק כל עוד השבירה פתוחה. שבירה דובית = גבוה (H), שורית = נמוך (L).
// • כשהחלון נסגר, הרמה קפואה וחיה עד שהמחיר עובר אותה בפתיל — ואז נמחקת.
//   אם המחיר עובר אותה עוד בתוך החלון כשאין שם שבירה פתוחה — היא נמחקת מיד.
// • הרמות נמדדות על הסימבול של הגרף: ב-NQ רואים את הרמות של NQ, ב-ES של ES.
// • אופציונלי: גם הרמות החיות של שתי המסגרות שמעל הגרף (עד 4H), בקו עבה יותר.
// ═══════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════
// הגדרות משתמש
// ═══════════════════════════════════════════════════════════════════

// אותם ארבעה נכסים כמו באינדיקטור הראשי — דרושים כדי לזהות את השבירות.
// 1 ו-2 = הזוג החזק, 3 = החלש, 4 = בן הזוג של 3 (אופציונלי).
grpSym = "נכסים"
sym1 = input.symbol("CME_MINI:MNQ1!",  "נכס 1 — חזק",          group = grpSym)
sym2 = input.symbol("CME_MINI:MES1!",  "נכס 2 — חזק",          group = grpSym)
sym3 = input.symbol("CBOT_MINI:MYM1!", "נכס 3 — חלש",          group = grpSym)
use4 = input.bool(true,                "השתמש בנכס 4",          group = grpSym)
sym4 = input.symbol("CME_MINI:M2K1!",  "נכס 4 — בן הזוג של 3", group = grpSym)
adjMode  = input.string("בלי יישור", "נתוני חוזה רציף", options = ["בלי יישור", "מיושר לגלגול", "ברירת המחדל של הסימבול"], group = grpSym)
settleIn = input.string("כבוי — כמו הגרף", "Settlement כסגירה יומית", options = ["כבוי — כמו הגרף", "דלוק", "ברירת המחדל של הסימבול"], group = grpSym)

grpVis = "תצוגה"
colH      = input.color(#ef5350, "צבע גבוה (H) — משבירה דובית", group = grpVis)
colL      = input.color(#26a69a, "צבע נמוך (L) — משבירה שורית", group = grpVis)
lblSize   = input.string("tiny", "גודל תווית", options = ["tiny", "small", "normal"], group = grpVis)
lineWidth = input.int(1, "עובי קו — מסגרת הגרף", minval = 1, maxval = 4, group = grpVis)
maxLvl    = input.int(50, "מקסימום רמות לכל מסגרת", minval = 1, maxval = 60, group = grpVis, tooltip = "כשיש יותר רמות חיות מזה — הישנות ביותר יוצאות ראשונות.")

grpQS = "רצפי QS"
hotList = input.string("111,114,141,144,411,414,441,444,222,333", "רצפים חמים", group = grpQS, tooltip = "מופרדים בפסיקים. שלוש רמות רצופות שיוצרות אחד מהרצפים האלה = חלון QS.")

grpLogic = "לוגיקה"
blockDeadWeek = input.bool(true, "חסום שבירות בשבוע מת (4H בלבד)", group = grpLogic)

grpMTF = "מסגרות גבוהות"
showHTF  = input.bool(true, "הצג גם רמות QS חיות משתי המסגרות שמעל הגרף", group = grpMTF, tooltip = "למשל בגרף 5m — גם הרמות של 15m ו-1H. עד 4H לכל היותר. בתווית כתוב שם המסגרת.")
htfWidth = input.int(2, "עובי קו — מסגרות גבוהות", minval = 1, maxval = 4, group = grpMTF)

// ═══════════════════════════════════════════════════════════════════
// הנכסים
// ═══════════════════════════════════════════════════════════════════

bAdj = adjMode == "מיושר לגלגול" ? backadjustment.on : adjMode == "בלי יישור" ? backadjustment.off : backadjustment.inherit
bSet = settleIn == "דלוק" ? settlement_as_close.on : settleIn == "ברירת המחדל של הסימבול" ? settlement_as_close.inherit : settlement_as_close.off

s1 = ticker.modify(sym1, backadjustment = bAdj, settlement_as_close = bSet)
s2 = ticker.modify(sym2, backadjustment = bAdj, settlement_as_close = bSet)
s3 = ticker.modify(sym3, backadjustment = bAdj, settlement_as_close = bSet)
s4 = use4 ? ticker.modify(sym4, backadjustment = bAdj, settlement_as_close = bSet) : s3

f_name(string s) =>
    p = str.split(s, ":")
    string t = array.get(p, array.size(p) - 1)
    if str.endswith(t, "!") and str.length(t) > 2
        t := str.substring(t, 0, str.length(t) - 2)
    t == "MNQ" ? "NQ" : t == "MES" ? "ES" : t == "MYM" ? "YM" : t == "M2K" ? "RTY" : t == "MGC" ? "GC" : t

nm1 = f_name(sym1)
nm2 = f_name(sym2)
nm3 = f_name(sym3)
nm4 = f_name(sym4)

// ═══════════════════════════════════════════════════════════════════
// זיהוי Timeframe — אותו סולם כמו באינדיקטור הראשי
// 1 = 15s, 2 = 1m, 3 = 5m, 4 = 15m, 5 = 1H, 6 = 4H, 7 = 1D, 8 = 1W, 9 = 1Mo, 0 = לא נתמך
// ═══════════════════════════════════════════════════════════════════

tfSec   = timeframe.in_seconds()
tfMin   = tfSec / 60
isD1 = timeframe.isdaily   and timeframe.multiplier == 1
isW1 = timeframe.isweekly  and timeframe.multiplier == 1
isM1 = timeframe.ismonthly and timeframe.multiplier == 1
tfClass = isD1 ? 7 : isW1 ? 8 : isM1 ? 9 : tfSec <= 15 ? 1 : tfMin <= 1 ? 2 : tfMin <= 5 ? 3 : tfMin <= 15 ? 4 : tfMin <= 60 ? 5 : tfMin <= 240 ? 6 : 0

// ═══════════════════════════════════════════════════════════════════
// מחזורים — זהה לחישוב באינדיקטור הראשי
// ═══════════════════════════════════════════════════════════════════

TZ = "America/New_York"
estHour = hour(time, TZ)
estMin  = minute(time, TZ)
estSec  = second(time, TZ)

minutesOfDay     = estHour * 60 + estMin
isPostOpen       = minutesOfDay >= 1080
minsFromDayStart = isPostOpen ? minutesOfDay - 1080 : minutesOfDay + 360
secsFromDayStart = minsFromDayStart * 60 + estSec

tradeDayTime = isPostOpen ? time + 86400000 : time
tdYear = year(tradeDayTime, TZ)
tdMon  = month(tradeDayTime, TZ)
tdDom  = dayofmonth(tradeDayTime, TZ)
tdDow  = dayofweek(tradeDayTime, TZ)

sessionIdx    = math.floor(secsFromDayStart / 21600)
secsInSession = secsFromDayStart % 21600
microIdx      = math.floor(secsInSession / 5400)
secsInMicro   = secsInSession % 5400
quarterIdx    = math.floor(secsInMicro / 1350)
secsInQuarter = secsInMicro % 1350
subQIdx       = math.floor(secsInQuarter / 337.5)

daysSinceMonday = tdDow == dayofweek.sunday ? 6 : tdDow - 2
mondayTime      = tradeDayTime - daysSinceMonday * 86400000
tuesdayTime     = mondayTime + 86400000
thursdayTime    = mondayTime + 3 * 86400000

monMonth = month(mondayTime, TZ)
monDom   = dayofmonth(mondayTime, TZ)
monYear  = year(mondayTime, TZ)
tueMonth = month(tuesdayTime, TZ)
tueDom   = dayofmonth(tuesdayTime, TZ)
tueYear  = year(tuesdayTime, TZ)
thuMonth = month(thursdayTime, TZ)

isDeadWeek = tueMonth != thuMonth
qtWeekNum  = isDeadWeek ? 0 : math.floor((tueDom - 1) / 7) + 1
isWeek5    = qtWeekNum == 5
isOwnWeek  = isDeadWeek or isWeek5

qtMonIdx  = tdMon >= 4 ? tdMon - 4 : tdMon + 8
qtYearNum = tdMon >= 4 ? tdYear : tdYear - 1
qtQtrNum  = math.floor(qtMonIdx / 3) + 1

qStartMon  = qtQtrNum == 1 ? 4 : qtQtrNum == 2 ? 7 : qtQtrNum == 3 ? 10 : 1
qStartYear = qtQtrNum == 4 ? qtYearNum + 1 : qtYearNum
nStartMon  = qStartMon == 10 ? 1 : qStartMon + 3
nStartYear = qStartMon == 10 ? qStartYear + 1 : qStartYear
qStartT  = timestamp(TZ, qStartYear, qStartMon, 1, 12, 0)
nStartT  = timestamp(TZ, nStartYear, nStartMon, 1, 12, 0)
tdNoonT  = timestamp(TZ, tdYear, tdMon, tdDom, 12, 0)
qLenDays = math.round((nStartT - qStartT) / 86400000)
dSinceQ  = math.round((tdNoonT - qStartT) / 86400000)
qSubIdx  = qLenDays > 0 ? math.min(3, math.max(0, math.floor(dSinceQ * 4 / qLenDays))) : 0

tradeDayId = tdYear * 10000 + tdMon * 100 + tdDom
weekId     = monYear * 10000 + monMonth * 100 + monDom
monthId    = isOwnWeek ? weekId : tueYear * 100 + tueMonth
sessionId  = tradeDayId * 10 + sessionIdx
microId    = sessionId * 10 + microIdx
quarterId  = microId * 10 + quarterIdx
subQId     = quarterId * 10 + subQIdx
qtrId      = qtYearNum * 10 + qtQtrNum
qSubId     = qtrId * 10 + qSubIdx
cyc4Id     = math.floor((tdYear - 2023) / 4)

refCycleId = tfClass == 9 ? tdYear : tfClass == 8 ? qtrId : tfClass == 7 ? qSubId : tfClass == 6 ? weekId : tfClass == 5 ? tradeDayId : tfClass == 4 ? sessionId : tfClass == 3 ? microId : tfClass == 2 ? quarterId : tfClass == 1 ? subQId : 0
lifeCycleId = tfClass == 9 ? cyc4Id : tfClass == 8 ? qtYearNum : tfClass == 7 ? qtrId : tfClass == 6 ? monthId : tfClass == 5 ? weekId : tfClass == 4 ? tradeDayId : tfClass == 3 ? sessionId : tfClass == 2 ? microId : tfClass == 1 ? quarterId : 0

newRefCycle  = ta.change(refCycleId)  != 0
newLifeCycle = ta.change(lifeCycleId) != 0

// זרע: 15s, 1m, 5m ו-1H בלבד — כמו באינדיקטור הראשי
keepLast = tfClass == 1 or tfClass == 2 or tfClass == 3 or tfClass == 5

// ═══════════════════════════════════════════════════════════════════
// נתוני ארבעת הנכסים במסגרת הגרף
// ═══════════════════════════════════════════════════════════════════

[x1h, x1l, x1c] = request.security(s1, timeframe.period, [high, low, close], lookahead = barmerge.lookahead_off)
[x2h, x2l, x2c] = request.security(s2, timeframe.period, [high, low, close], lookahead = barmerge.lookahead_off)
[x3h, x3l, x3c] = request.security(s3, timeframe.period, [high, low, close], lookahead = barmerge.lookahead_off)
[x4h, x4l, x4c] = request.security(s4, timeframe.period, [high, low, close], lookahead = barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════
// מצבר לכל נכס — זהה לאינדיקטור הראשי. pos = bar_index בגרף, זמן במנועים.
// ═══════════════════════════════════════════════════════════════════

type Acc
    float hi
    float lo
    float hc
    float lc
    int   hiPos = 0
    int   loPos = 0
    int   hcPos = 0
    int   lcPos = 0
    array<float> hiA
    array<float> loA
    array<float> hcA
    array<float> lcA
    array<int>   hiPA
    array<int>   loPA
    array<int>   hcPA
    array<int>   lcPA

f_newAcc() => Acc.new(hiA = array.new_float(), loA = array.new_float(), hcA = array.new_float(), lcA = array.new_float(), hiPA = array.new_int(), loPA = array.new_int(), hcPA = array.new_int(), lcPA = array.new_int())

f_accA(Acc a, bool isBull, bool isH)  => isBull ? (isH ? a.lcA : a.loA) : (isH ? a.hcA : a.hiA)
f_accPA(Acc a, bool isBull, bool isH) => isBull ? (isH ? a.lcPA : a.loPA) : (isH ? a.hcPA : a.hiPA)
f_accV(Acc a, bool isBull, bool isH)  => isBull ? (isH ? a.lc : a.lo) : (isH ? a.hc : a.hi)
f_accP(Acc a, bool isBull, bool isH)  => isBull ? (isH ? a.lcPos : a.loPos) : (isH ? a.hcPos : a.hiPos)

f_accStep(Acc a, bool newRef, bool clr, bool push, bool drop, float h, float l, float c, int pos) =>
    if newRef
        if clr
            array.clear(a.hiA)
            array.clear(a.loA)
            array.clear(a.hcA)
            array.clear(a.lcA)
            array.clear(a.hiPA)
            array.clear(a.loPA)
            array.clear(a.hcPA)
            array.clear(a.lcPA)
        if push
            array.push(a.hiA, a.hi)
            array.push(a.loA, a.lo)
            array.push(a.hcA, a.hc)
            array.push(a.lcA, a.lc)
            array.push(a.hiPA, a.hiPos)
            array.push(a.loPA, a.loPos)
            array.push(a.hcPA, a.hcPos)
            array.push(a.lcPA, a.lcPos)
        if drop and array.size(a.hiA) > 0
            array.remove(a.hiA, 0)
            array.remove(a.loA, 0)
            array.remove(a.hcA, 0)
            array.remove(a.lcA, 0)
            array.remove(a.hiPA, 0)
            array.remove(a.loPA, 0)
            array.remove(a.hcPA, 0)
            array.remove(a.lcPA, 0)
        a.hi    := h
        a.lo    := l
        a.hc    := c
        a.lc    := c
        a.hiPos := pos
        a.loPos := pos
        a.hcPos := pos
        a.lcPos := pos
    else
        if na(a.hi) or h > a.hi
            a.hi    := h
            a.hiPos := pos
        if na(a.lo) or l < a.lo
            a.lo    := l
            a.loPos := pos
        if na(a.hc) or c > a.hc
            a.hc    := c
            a.hcPos := pos
        if na(a.lc) or c < a.lc
            a.lc    := c
            a.lcPos := pos
    a

var Acc ac1 = f_newAcc()
var Acc ac2 = f_newAcc()
var Acc ac3 = f_newAcc()
var Acc ac4 = f_newAcc()
f_acc(int a) => a == 0 ? ac1 : a == 1 ? ac2 : a == 2 ? ac3 : ac4

var bool seedActive = false
canPush     = not na(ac1.hi) and not na(ac2.hi) and not na(ac3.hi) and not na(ac4.hi)
pushNow     = newRefCycle and ((not newLifeCycle) or keepLast) and canPush
dropSeedNow = newRefCycle and (not newLifeCycle) and seedActive
f_accStep(ac1, newRefCycle, newLifeCycle, pushNow, dropSeedNow, x1h, x1l, x1c, bar_index)
f_accStep(ac2, newRefCycle, newLifeCycle, pushNow, dropSeedNow, x2h, x2l, x2c, bar_index)
f_accStep(ac3, newRefCycle, newLifeCycle, pushNow, dropSeedNow, x3h, x3l, x3c, bar_index)
f_accStep(ac4, newRefCycle, newLifeCycle, pushNow, dropSeedNow, x4h, x4l, x4c, bar_index)
if newRefCycle and newLifeCycle
    seedActive := keepLast and canPush
else if newRefCycle
    seedActive := false

nLevels  = array.size(ac1.hiA)
cycleOK  = not (tfClass == 6 and ((blockDeadWeek and isDeadWeek) or isWeek5))
friBlock = tdDow == dayofweek.friday and (tfClass == 5 or (tfClass == 6 and qtWeekNum == 4))
blocked  = friBlock or not cycleOK

// ═══════════════════════════════════════════════════════════════════
// זיהוי שבירות — זהה לאינדיקטור הראשי
// ═══════════════════════════════════════════════════════════════════

f_str(bool b1, bool b2, bool b3, bool isBull) =>
    s = ""
    s := b1 ? s + nm1 + " " : s
    s := b2 ? s + nm2 + " " : s
    s := (b3 and not isBull) ? s + nm3 + " " : s
    str.trim(s)

f_str2(bool b3, bool b4) => str.trim((b3 ? nm3 + " " : "") + (b4 ? nm4 : ""))

f_beyond(bool isBull, float v, float r) => isBull ? v < r : v > r
f_ext(bool isBull, float v, float r)    => isBull ? math.min(v, r) : math.max(v, r)

f_findTri(bool isBull, Acc n, Acc e, Acc y) =>
    int    bT = 0
    int    bI = -1
    string bS = ""
    nA  = f_accA(n, isBull, false)
    eA  = f_accA(e, isBull, false)
    yA  = f_accA(y, isBull, false)
    nCA = f_accA(n, isBull, true)
    eCA = f_accA(e, isBull, true)
    yCA = f_accA(y, isBull, true)
    cnt = array.size(nA)
    if cnt > 0 and array.size(eA) == cnt and array.size(yA) == cnt
        float nM  = f_accV(n, isBull, false)
        float eM  = f_accV(e, isBull, false)
        float yM  = f_accV(y, isBull, false)
        float nMc = f_accV(n, isBull, true)
        float eMc = f_accV(e, isBull, true)
        float yMc = f_accV(y, isBull, true)
        for i = cnt - 1 to 0
            if bT == 0
                nw = f_beyond(isBull, nM,  array.get(nA, i))
                ew = f_beyond(isBull, eM,  array.get(eA, i))
                yw = f_beyond(isBull, yM,  array.get(yA, i))
                nc = f_beyond(isBull, nMc, array.get(nCA, i))
                ec = f_beyond(isBull, eMc, array.get(eCA, i))
                yc = f_beyond(isBull, yMc, array.get(yCA, i))
                hValid = isBull ? (nc or ec) and not (nc and ec and yc) : (nc or ec or yc) and not (nc and ec)
                wValid = isBull ? (nw or ew) and not (nw and ew and yw) : (nw or ew or yw) and not (nw and ew)
                if hValid or wValid
                    hN = hValid and nc
                    hE = hValid and ec
                    hY = hValid and yc
                    hs = f_str(hN, hE, hY, isBull)
                    ss = wValid ? f_str(nw and not hN, ew and not hE, yw and not hY, isBull) : ""
                    lbl = hs != "" ? "H " + hs : ""
                    lbl := ss != "" ? (lbl != "" ? lbl + " S " + ss : "S " + ss) : lbl
                    if not hValid and nc and ec and (yc or not isBull)
                        lbl := lbl + (yc ? " (all closed)" : " (core closed)")
                    bT := hs != "" ? 2 : 1
                    bI := i
                    bS := lbl
            nM  := f_ext(isBull, nM,  array.get(nA, i))
            eM  := f_ext(isBull, eM,  array.get(eA, i))
            yM  := f_ext(isBull, yM,  array.get(yA, i))
            nMc := f_ext(isBull, nMc, array.get(nCA, i))
            eMc := f_ext(isBull, eMc, array.get(eCA, i))
            yMc := f_ext(isBull, yMc, array.get(yCA, i))
    [bT, bI, bS]

f_findPair(bool isBull, Acc y, Acc r) =>
    int    bT = 0
    int    bI = -1
    string bS = ""
    yA  = f_accA(y, isBull, false)
    rA  = f_accA(r, isBull, false)
    yCA = f_accA(y, isBull, true)
    rCA = f_accA(r, isBull, true)
    cnt = array.size(yA)
    if cnt > 0 and array.size(rA) == cnt
        float yM  = f_accV(y, isBull, false)
        float rM  = f_accV(r, isBull, false)
        float yMc = f_accV(y, isBull, true)
        float rMc = f_accV(r, isBull, true)
        for i = cnt - 1 to 0
            if bT == 0
                yw = f_beyond(isBull, yM,  array.get(yA, i))
                rw = f_beyond(isBull, rM,  array.get(rA, i))
                yc = f_beyond(isBull, yMc, array.get(yCA, i))
                rc = f_beyond(isBull, rMc, array.get(rCA, i))
                hValid = yc != rc
                wValid = yw != rw
                if hValid or wValid
                    hY = hValid and yc
                    hR = hValid and rc
                    hs = f_str2(hY, hR)
                    ss = wValid ? f_str2(yw and not hY, rw and not hR) : ""
                    lbl = hs != "" ? "H " + hs : ""
                    lbl := ss != "" ? (lbl != "" ? lbl + " S " + ss : "S " + ss) : lbl
                    if not hValid and yc and rc
                        lbl := lbl + " (all closed)"
                    bT := hs != "" ? 2 : 1
                    bI := i
                    bS := lbl
            yM  := f_ext(isBull, yM,  array.get(yA, i))
            rM  := f_ext(isBull, rM,  array.get(rA, i))
            yMc := f_ext(isBull, yMc, array.get(yCA, i))
            rMc := f_ext(isBull, rMc, array.get(rCA, i))
    [bT, bI, bS]

f_take(bool isBull, array<float> extA, array<int> posA, int refI, float curV, int curP) =>
    float bp = curV
    int   bb = curP
    n = array.size(extA)
    if n > 0 and refI + 1 <= n - 1
        for k = refI + 1 to n - 1
            v = array.get(extA, k)
            if isBull ? v < bp : v > bp
                bp := v
                bb := array.get(posA, k)
    [bp, bb]

f_pts(Acc acc, bool isBull, bool isH, int refI) =>
    int   b1 = -1
    float p1 = na
    int   b2 = -1
    float p2 = na
    bool  ok = false
    extA = f_accA(acc, isBull, isH)
    posA = f_accPA(acc, isBull, isH)
    if refI >= 0 and refI <= array.size(extA) - 1
        p1 := array.get(extA, refI)
        b1 := array.get(posA, refI)
        [tp, tb] = f_take(isBull, extA, posA, refI, f_accV(acc, isBull, isH), f_accP(acc, isBull, isH))
        p2 := tp
        b2 := tb
        ok := b2 > b1 and not na(p1) and not na(p2)
    [b1, p1, b2, p2, ok]

// ═══════════════════════════════════════════════════════════════════
// QS — זהה לאינדיקטור הראשי, ובנוסף "מזהה חלון": כדי לדעת אם נר נמצא באותו
// חלון QS של השבירה. המזהה = יום המסחר + הספרות עד הרמה הנמוכה של השלישייה
// החמה (ביומי: השנה + שלוש ספרות היומי).
// ═══════════════════════════════════════════════════════════════════

qsUseCls(int cls) => cls >= 1 and cls <= 7
hotKey = "," + str.replace_all(hotList, " ", "") + ","

f_qsDigits(int t) =>
    mOD  = hour(t, TZ) * 60 + minute(t, TZ)
    post = mOD >= 1080
    mFD  = post ? mOD - 1080 : mOD + 360
    sFD  = mFD * 60 + second(t, TZ)
    tdt  = post ? t + 86400000 : t
    sI   = math.floor(sFD / 21600)
    sIS  = sFD % 21600
    mI   = math.floor(sIS / 5400)
    sIM  = sIS % 5400
    qI   = math.floor(sIM / 1350)
    sqI  = math.floor((sIM % 1350) / 337.5)
    dw   = dayofweek(tdt, TZ)
    dN   = dw == dayofweek.monday ? 1 : dw == dayofweek.tuesday ? 2 : dw == dayofweek.wednesday ? 3 : dw == dayofweek.thursday ? 4 : 0
    dsm  = dw == dayofweek.sunday ? 6 : dw - 2
    mon  = tdt - dsm * 86400000
    tue  = mon + 86400000
    thu  = mon + 3 * 86400000
    tM   = month(tue, TZ)
    dead = tM != month(thu, TZ)
    wk   = dead ? 0 : math.floor((dayofmonth(tue, TZ) - 1) / 7) + 1
    mQ   = (tM >= 4 ? tM - 4 : tM + 8) % 3 + 1
    str.tostring(mQ) + (wk == 0 ? "·" : str.tostring(wk)) + (dN == 0 ? "·" : str.tostring(dN)) + str.tostring(sI + 1) + str.tostring(mI + 1) + str.tostring(qI + 1) + str.tostring(sqI + 1)

f_qsDay(int t) =>
    post = hour(t, TZ) * 60 + minute(t, TZ) >= 1080
    tdt  = post ? t + 86400000 : t
    yy   = year(tdt, TZ)
    mm   = month(tdt, TZ)
    dd   = dayofmonth(tdt, TZ)
    qMI  = mm >= 4 ? mm - 4 : mm + 8
    qY   = mm >= 4 ? yy : yy - 1
    qQ   = math.floor(qMI / 3) + 1
    qsM  = qQ == 1 ? 4 : qQ == 2 ? 7 : qQ == 3 ? 10 : 1
    qsY  = qQ == 4 ? qY + 1 : qY
    nsM  = qsM == 10 ? 1 : qsM + 3
    nsY  = qsM == 10 ? qsY + 1 : qsY
    qsT  = timestamp(TZ, qsY, qsM, 1, 12, 0)
    nsT  = timestamp(TZ, nsY, nsM, 1, 12, 0)
    tdNT = timestamp(TZ, yy, mm, dd, 12, 0)
    qLn  = math.round((nsT - qsT) / 86400000)
    dSnc = math.round((tdNT - qsT) / 86400000)
    qq   = qLn > 0 ? math.min(3, math.max(0, math.floor(dSnc * 4 / qLn))) : 0
    str.tostring(((yy - 2023) % 4 + 4) % 4 + 1) + str.tostring(qQ) + str.tostring(qq + 1)

f_qsK(int cls)   => cls <= 2 ? 4 : cls == 3 ? 3 : cls == 4 ? 2 : cls == 5 ? 1 : 0
f_qsLvl(int cls) => cls <= 1 ? 6 : cls == 2 ? 5 : cls == 3 ? 4 : cls == 4 ? 3 : cls == 5 ? 2 : 1
f_qsHot(string s) => str.length(s) == 3 and str.contains(hotKey, "," + s + ",")

// יום המסחר (18:00 ומעלה = היום הבא) ושנת הלוח שלו, לרגע t
f_tdT(int t)  => hour(t, TZ) * 60 + minute(t, TZ) >= 1080 ? t + 86400000 : t
f_tdId(int t) => year(f_tdT(t), TZ) * 10000 + month(f_tdT(t), TZ) * 100 + dayofmonth(f_tdT(t), TZ)

// מזהה החלון שרגע t נמצא בו, עבור שלישייה שמתחילה באינדקס k
f_winKey(int cls, int t, int k) => cls == 7 ? str.tostring(year(f_tdT(t), TZ)) + "|" + f_qsDay(t) : str.tostring(f_tdId(t)) + "|" + str.substring(f_qsDigits(t), 0, k + 3)

// האם נר [t, t+dur) נכנס לחלון QS — אותו כלל כמו באינדיקטור הראשי (f_qsAt),
// ובנוסף מחזיר את מזהה החלון ואת אינדקס השלישייה שתפסה.
f_qsWin(int cls, int t, int durMs) =>
    bool   found = false
    string pat   = ""
    string key   = ""
    int    kk    = 0
    if cls == 7
        s = f_qsDay(t)
        if f_qsHot(s)
            found := true
            pat   := s
            key   := f_winKey(7, t, 0)
    else if cls >= 1 and cls <= 6
        t2   = t + durMs - 1
        d1   = f_qsDigits(t)
        d2   = f_qsDigits(t2)
        kOwn = f_qsK(cls)
        lvl  = f_qsLvl(cls)
        kLo  = math.max(lvl - 2, 0)
        kHi  = math.min(lvl, 4)
        for i = 0 to kHi - kLo + 1
            k = i == 0 ? kOwn : kLo + i - 1
            if not found
                s1 = str.substring(d1, k, k + 3)
                s2 = str.substring(d2, k, k + 3)
                if f_qsHot(s1)
                    found := true
                    pat   := s1
                    kk    := k
                    key   := str.tostring(f_tdId(t)) + "|" + str.substring(d1, 0, k + 3)
                else if f_qsHot(s2)
                    found := true
                    pat   := s2
                    kk    := k
                    key   := str.tostring(f_tdId(t2)) + "|" + str.substring(d2, 0, k + 3)
    [found, pat, key, kk]

// האם נר [t, t+dur) נוגע בחלון key — בתחילתו או בסופו (החלון מעוגל לנרות שלמים)
f_inWin(int cls, int t, int dur, int k, string key) => f_winKey(cls, t, k) == key or f_winKey(cls, t + dur - 1, k) == key

qsOn  = qsUseCls(tfClass)
durMs = tfSec * 1000

// ═══════════════════════════════════════════════════════════════════
// רמות QS
// ═══════════════════════════════════════════════════════════════════

// רמה אחת. done = החלון נגמר והרמה קפואה; עד אז היא עדיין מתעדכנת.
// x = bar_index בגרף, זמן במסגרות הגבוהות.
type Lvl
    float  p
    int    x
    bool   bull
    string pat
    string key
    int    k
    bool   done = false
    int    tf   = 0

// אינדקס הרמה הפתוחה (pend) בכיוון הזה, או הרמה של החלון key
f_idx(array<Lvl> A, bool isBull, bool pend, string key) =>
    int r = -1
    n = array.size(A)
    if n > 0
        for i = 0 to n - 1
            L = array.get(A, i)
            if r < 0 and L.bull == isBull and (pend ? not L.done : L.key == key)
                r := i
    r

// מחיקת רמות קפואות שהמחיר עבר בפתיל
f_chk(array<Lvl> A, float h, float l) =>
    n = array.size(A)
    if n > 0
        for i = n - 1 to 0
            L = array.get(A, i)
            if L.done and (L.bull ? l < L.p : h > L.p)
                array.remove(A, i)
    n

// לא יותר מ-mx רמות קפואות — הישנות יוצאות ראשונות
f_trim(array<Lvl> A, int mx) =>
    int cnt = 0
    n = array.size(A)
    if n > 0
        for i = 0 to n - 1
            if array.get(A, i).done
                cnt += 1
    while cnt > mx
        int fi = -1
        for i = 0 to array.size(A) - 1
            if fi < 0 and array.get(A, i).done
                fi := i
        array.remove(A, fi)
        cnt -= 1
    cnt

// צעד של רמות בכיוון אחד, בנר סגור אחד.
//   act / aKey = יש שבירה פתוחה ב-QS, והנר הנוכחי בתוך החלון שלה (aKey).
//   iP / iX    = ערך ההתחלה של רמה חדשה (הקיצון מנר השבירה עד עכשיו).
//   h / l / x  = הנר הנוכחי. cls / t / dur = המסגרת והזמן, לבדיקת החלון.
f_lvlStep(array<Lvl> A, bool isBull, bool act, string aKey, string aPat, int aK, float iP, int iX, int cls, int t, int dur, float h, float l, int x, int tfc) =>
    ext = isBull ? l : h
    pi = f_idx(A, isBull, true, "")
    if pi >= 0
        P = array.get(A, pi)
        if not act or P.key != aKey
            inP = f_inWin(cls, t, dur, P.k, P.key)
            // עדיין בחלון בלי שבירה פתוחה, והמחיר עבר את הרמה — היא נלקחה
            if inP and f_beyond(isBull, ext, P.p)
                array.remove(A, pi)
            // החלון נגמר, או שהתחיל חלון חדש — הרמה קפואה מעכשיו
            else if not inP or act
                P.done := true
    if act
        si = f_idx(A, isBull, false, aKey)
        if si >= 0
            S = array.get(A, si)
            S.done := false
            if f_beyond(isBull, ext, S.p)
                S.p := ext
                S.x := x
        else if not na(iP)
            array.push(A, Lvl.new(iP, iX, isBull, aPat, aKey, aK, false, tfc))
    act

// ═══════════════════════════════════════════════════════════════════
// מסגרת הגרף
// ═══════════════════════════════════════════════════════════════════

// השבירות: 0 = שלישייה דובית, 1 = שלישייה שורית, 2 = זוג דובי, 3 = זוג שורי
var array<int> cTy = array.new_int(4, 0)
var array<int> cRi = array.new_int(4, -1)
var array<Lvl> lvC = array.new<Lvl>()

if newLifeCycle
    for k = 0 to 3
        array.set(cTy, k, 0)
        array.set(cRi, k, -1)
if dropSeedNow
    for k = 0 to 3
        ri = array.get(cRi, k)
        array.set(cRi, k, ri > 0 ? ri - 1 : -1)
if barstate.isconfirmed and blocked
    for k = 0 to 3
        array.set(cTy, k, 0)
        array.set(cRi, k, -1)
if barstate.isconfirmed and tfClass != 0 and not blocked and nLevels > 0
    for k = 0 to 3
        isBull = k % 2 == 1
        int nT = 0
        int nI = -1
        if k < 2
            [ft, fi, fs] = f_findTri(isBull, ac1, ac2, ac3)
            nT := ft
            nI := fi
        else if use4
            [gt, gi, gs] = f_findPair(isBull, ac3, ac4)
            nT := gt
            nI := gi
        array.set(cTy, k, nT)
        array.set(cRi, k, nT != 0 ? nI : -1)

if barstate.isconfirmed and qsOn
    for d = 0 to 1
        isBull = d == 1
        bool   act  = false
        string aKey = ""
        string aPat = ""
        int    aK   = 0
        int    aB2  = bar_index
        // שבירה פתוחה בכיוון הזה (שלישייה או זוג) שהנר שלקח בה — על אחד מנכסי
        // השבירה — בחלון QS, והנר הנוכחי עדיין באותו חלון
        for j = 0 to 1
            idx = d + j * 2
            ty  = array.get(cTy, idx)
            if not act and ty != 0 and (j == 0 or use4)
                ri  = array.get(cRi, idx)
                aLo = j == 0 ? 0 : 2
                aHi = j == 0 ? 2 : 3
                for a = aLo to aHi
                    for ps = 0 to 1
                        if not act and (ps == 0 or ty == 2)
                            [b1, p1, b2, p2, ok] = f_pts(f_acc(a), isBull, ty == 2 and ps == 0, ri)
                            if ok
                                [hF, pt, ky, kk] = f_qsWin(tfClass, time[bar_index - b2], durMs)
                                if hF and f_inWin(tfClass, time, durMs, kk, ky)
                                    act  := true
                                    aKey := ky
                                    aPat := pt
                                    aK   := kk
                                    aB2  := b2
        // ערך ההתחלה של רמה חדשה: הקיצון של הגרף מנר השבירה ועד עכשיו
        float iP = na
        int   iX = bar_index
        if act and f_idx(lvC, isBull, false, aKey) < 0
            n0 = math.min(bar_index - aB2, 500)
            for o = 0 to n0
                v = isBull ? low[o] : high[o]
                if na(iP) or f_beyond(isBull, v, iP)
                    iP := v
                    iX := bar_index - o
        f_lvlStep(lvC, isBull, act, aKey, aPat, aK, iP, iX, tfClass, time, durMs, high, low, bar_index, tfClass)
    f_chk(lvC, high, low)
    f_trim(lvC, maxLvl)

// ═══════════════════════════════════════════════════════════════════
// מסגרות גבוהות — מנוע לכל מסגרת, כמו באינדיקטור הראשי
// ═══════════════════════════════════════════════════════════════════

f_cycT(int cls, int t) =>
    mOD  = hour(t, TZ) * 60 + minute(t, TZ)
    post = mOD >= 1080
    mFD  = post ? mOD - 1080 : mOD + 360
    tdt  = post ? t + 86400000 : t
    yy = year(tdt, TZ)
    mm = month(tdt, TZ)
    dd = dayofmonth(tdt, TZ)
    dw = dayofweek(tdt, TZ)
    sFD   = mFD * 60 + second(t, TZ)
    sIdx  = math.floor(sFD / 21600)
    sIS   = sFD % 21600
    miIdx = math.floor(sIS / 5400)
    sIM   = sIS % 5400
    qIdx  = math.floor(sIM / 1350)
    sqIdx = math.floor((sIM % 1350) / 337.5)
    dsm = dw == dayofweek.sunday ? 6 : dw - 2
    mon = tdt - dsm * 86400000
    tue = mon + 86400000
    thu = mon + 3 * 86400000
    tuM  = month(tue, TZ)
    tuY  = year(tue, TZ)
    dead = tuM != month(thu, TZ)
    wkN  = dead ? 0 : math.floor((dayofmonth(tue, TZ) - 1) / 7) + 1
    ownW = dead or wkN == 5
    tdId = yy * 10000 + mm * 100 + dd
    wkId = year(mon, TZ) * 10000 + month(mon, TZ) * 100 + dayofmonth(mon, TZ)
    moId = ownW ? wkId : tuY * 100 + tuM
    seId = tdId * 10 + sIdx
    miId = seId * 10 + miIdx
    quId = miId * 10 + qIdx
    sqId = quId * 10 + sqIdx
    rId = cls == 6 ? wkId : cls == 5 ? tdId : cls == 4 ? seId : cls == 3 ? miId : cls == 2 ? quId : sqId
    lId = cls == 6 ? moId : cls == 5 ? wkId : cls == 4 ? tdId : cls == 3 ? seId : cls == 2 ? miId : quId
    kL  = cls == 1 or cls == 2 or cls == 3 or cls == 5
    fri = dw == dayofweek.friday
    blk = (cls == 5 and fri) or (cls == 6 and ((fri and wkN == 4) or wkN == 5 or (blockDeadWeek and dead)))
    [rId, lId, kL, blk]

type Eng
    int  cls
    int  ms
    Acc  a1
    Acc  a2
    Acc  a3
    Acc  a4
    array<int> tyA
    array<int> riA
    array<Lvl> lv
    int  lastT   = 0
    int  refId   = 0
    int  lifeId  = 0
    bool started = false
    bool sAct    = false

f_newEng(int cls, int ms) => Eng.new(cls = cls, ms = ms, a1 = f_newAcc(), a2 = f_newAcc(), a3 = f_newAcc(), a4 = f_newAcc(), tyA = array.new_int(4, 0), riA = array.new_int(4, -1), lv = array.new<Lvl>())

f_engAcc(Eng e, int a) => a == 0 ? e.a1 : a == 1 ? e.a2 : a == 2 ? e.a3 : e.a4

// נר סגור אחד של המסגרת. ch / cl = הגבוה והנמוך של אותו נר על הסימבול של הגרף.
f_engStep(Eng e, int t, float ch, float cl, float h1, float l1, float c1, float h2, float l2, float c2, float h3, float l3, float c3, float h4, float l4, float c4) =>
    if not na(t) and t != e.lastT and not na(c1) and not na(c2) and not na(c3) and not na(c4)
        e.lastT := t
        [rId, lId, kL, blk] = f_cycT(e.cls, t)
        newRef  = e.started and rId != e.refId
        newLife = e.started and lId != e.lifeId
        canP    = not na(e.a1.hi) and not na(e.a2.hi) and not na(e.a3.hi) and not na(e.a4.hi)
        push    = newRef and ((not newLife) or kL) and canP
        sDrop   = newRef and (not newLife) and e.sAct
        f_accStep(e.a1, newRef, newLife, push, sDrop, h1, l1, c1, t)
        f_accStep(e.a2, newRef, newLife, push, sDrop, h2, l2, c2, t)
        f_accStep(e.a3, newRef, newLife, push, sDrop, h3, l3, c3, t)
        f_accStep(e.a4, newRef, newLife, push, sDrop, h4, l4, c4, t)
        if newRef and newLife
            e.sAct := kL and canP
        else if newRef
            e.sAct := false
        e.started := true
        e.refId   := rId
        e.lifeId  := lId
        if newLife
            for k = 0 to 3
                array.set(e.tyA, k, 0)
                array.set(e.riA, k, -1)
        if sDrop
            for k = 0 to 3
                ri = array.get(e.riA, k)
                array.set(e.riA, k, ri > 0 ? ri - 1 : -1)
        for k = 0 to 3
            isBull = k % 2 == 1
            int nT = 0
            int nI = -1
            if array.size(e.a1.hiA) > 0 and not blk
                if k < 2
                    [ft, fi, fs] = f_findTri(isBull, e.a1, e.a2, e.a3)
                    nT := ft
                    nI := fi
                else if use4
                    [gt, gi, gs] = f_findPair(isBull, e.a3, e.a4)
                    nT := gt
                    nI := gi
            array.set(e.tyA, k, nT)
            array.set(e.riA, k, nT != 0 ? nI : -1)
        // רמות QS — אותו כלל כמו בגרף, על נרות המסגרת הזו
        if qsUseCls(e.cls) and not na(ch) and not na(cl)
            for d = 0 to 1
                isBull = d == 1
                bool   act  = false
                string aKey = ""
                string aPat = ""
                int    aK   = 0
                for j = 0 to 1
                    idx = d + j * 2
                    ty  = array.get(e.tyA, idx)
                    if not act and ty != 0 and (j == 0 or use4)
                        ri  = array.get(e.riA, idx)
                        aLo = j == 0 ? 0 : 2
                        aHi = j == 0 ? 2 : 3
                        for a = aLo to aHi
                            for ps = 0 to 1
                                if not act and (ps == 0 or ty == 2)
                                    [b1, p1, b2, p2, ok] = f_pts(f_engAcc(e, a), isBull, ty == 2 and ps == 0, ri)
                                    if ok
                                        [hF, pt, ky, kk] = f_qsWin(e.cls, b2, e.ms)
                                        if hF and f_inWin(e.cls, t, e.ms, kk, ky)
                                            act  := true
                                            aKey := ky
                                            aPat := pt
                                            aK   := kk
                f_lvlStep(e.lv, isBull, act, aKey, aPat, aK, isBull ? cl : ch, t, e.cls, t, e.ms, ch, cl, t, e.cls)
            f_chk(e.lv, ch, cl)
            f_trim(e.lv, maxLvl)
    e.started

f_tfName(int cls) => cls == 1 ? "15s" : cls == 2 ? "1m" : cls == 3 ? "5m" : cls == 4 ? "15m" : cls == 5 ? "1H" : cls == 6 ? "4H" : "1D"
f_clsMs(int cls)  => (cls == 1 ? 15 : cls == 2 ? 60 : cls == 3 ? 300 : cls == 4 ? 900 : cls == 5 ? 3600 : 14400) * 1000

// שתי המסגרות שמעל הגרף, עד 4H
cU1 = math.min(tfClass + 1, 6)
cU2 = math.min(tfClass + 2, 6)
tU1 = tfClass == 0 ? timeframe.period : cU1 == 2 ? "1" : cU1 == 3 ? "5" : cU1 == 4 ? "15" : cU1 == 5 ? "60" : "240"
tU2 = tfClass == 0 ? timeframe.period : cU2 == 2 ? "1" : cU2 == 3 ? "5" : cU2 == 4 ? "15" : cU2 == 5 ? "60" : "240"

lkh = barmerge.lookahead_off
// [1] — רק נרות סגורים של המסגרת, בלי ריפיינט
[aT,  aH1, aL1, aC1] = request.security(s1, tU1, [time[1], high[1], low[1], close[1]], lookahead = lkh)
[aH2, aL2, aC2]      = request.security(s2, tU1, [high[1], low[1], close[1]], lookahead = lkh)
[aH3, aL3, aC3]      = request.security(s3, tU1, [high[1], low[1], close[1]], lookahead = lkh)
[aH4, aL4, aC4]      = request.security(s4, tU1, [high[1], low[1], close[1]], lookahead = lkh)
[aCH, aCL]           = request.security(syminfo.tickerid, tU1, [high[1], low[1]], lookahead = lkh)
[bT_, bH1, bL1, bC1] = request.security(s1, tU2, [time[1], high[1], low[1], close[1]], lookahead = lkh)
[bH2, bL2, bC2]      = request.security(s2, tU2, [high[1], low[1], close[1]], lookahead = lkh)
[bH3, bL3, bC3]      = request.security(s3, tU2, [high[1], low[1], close[1]], lookahead = lkh)
[bH4, bL4, bC4]      = request.security(s4, tU2, [high[1], low[1], close[1]], lookahead = lkh)
[bCH, bCL]           = request.security(syminfo.tickerid, tU2, [high[1], low[1]], lookahead = lkh)

var Eng eU1 = f_newEng(cU1, f_clsMs(cU1))
var Eng eU2 = f_newEng(cU2, f_clsMs(cU2))

useU1 = showHTF and tfClass >= 1 and tfClass + 1 <= 6
useU2 = showHTF and tfClass >= 1 and tfClass + 2 <= 6

if useU1
    f_engStep(eU1, aT,  aCH, aCL, aH1, aL1, aC1, aH2, aL2, aC2, aH3, aL3, aC3, aH4, aL4, aC4)
if useU2
    f_engStep(eU2, bT_, bCH, bCL, bH1, bL1, bC1, bH2, bL2, bC2, bH3, bL3, bC3, bH4, bL4, bC4)
// רמה קפואה של מסגרת גבוהה נמחקת ברגע שנר של הגרף עובר אותה
if barstate.isconfirmed
    if useU1
        f_chk(eU1.lv, high, low)
    if useU2
        f_chk(eU2.lv, high, low)

// ═══════════════════════════════════════════════════════════════════
// ציור — רק בנר האחרון: מוחקים הכול ומציירים את הרמות החיות
// ═══════════════════════════════════════════════════════════════════

var array<line>  drN = array.new_line()
var array<label> drL = array.new_label()

f_draw(Lvl L, bool htf, array<line> N, array<label> B) =>
    // רמה קפואה שהנר החי כבר עבר — לא מציירים (היא תימחק בסגירת הנר)
    taken = L.done and (L.bull ? low < L.p : high > L.p)
    if not taken
        c   = L.bull ? colL : colH
        txt = (htf ? f_tfName(L.tf) + " " : "") + L.pat + (L.bull ? " L" : " H")
        if htf
            array.push(N, line.new(L.x, L.p, time, L.p, xloc = xloc.bar_time, color = c, width = htfWidth))
            array.push(B, label.new(time, L.p, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = c, size = lblSize))
        else
            array.push(N, line.new(L.x, L.p, bar_index, L.p, color = c, width = lineWidth))
            array.push(B, label.new(bar_index, L.p, txt, style = label.style_label_left, color = color.new(color.black, 100), textcolor = c, size = lblSize))
    taken

if barstate.islast
    while array.size(drN) > 0
        line.delete(array.pop(drN))
    while array.size(drL) > 0
        label.delete(array.pop(drL))
    if array.size(lvC) > 0
        for i = 0 to array.size(lvC) - 1
            f_draw(array.get(lvC, i), false, drN, drL)
    if useU1 and array.size(eU1.lv) > 0
        for i = 0 to array.size(eU1.lv) - 1
            f_draw(array.get(eU1.lv, i), true, drN, drL)
    if useU2 and array.size(eU2.lv) > 0
        for i = 0 to array.size(eU2.lv) - 1
            f_draw(array.get(eU2.lv, i), true, drN, drL)
