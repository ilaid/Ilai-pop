//@version=5
indicator("SSMT Fill | Quarterly Theory", overlay = true, max_labels_count = 20, max_lines_count = 20, max_boxes_count = 30)

// ═══════════════════════════════════════════════════════════════════
// SSMT Fill — סטיית קורלציה לפי מילוי גאפים
//
// גאפ קולקטיבי = FVG באותו כיוון, באותו נר, בשני הנכסים (NQ + ES).
// שבירה = נכס אחד נכנס לגאפ עמוק יותר מהשני. שלוש דרגות:
//   דרגה 1 — נכס אחד נגע, השני לא נגע בכלל.
//   דרגה 2 — נכס אחד הגיע ל-CE (50%), השני לא.
//   דרגה 3 — נכס אחד הגיע לקצה הרחוק (או מעבר בפתיל, בלי סגירה), השני לא.
// כשכמה דרגות מתקיימות יחד — מוצגת הגבוהה ביותר.
//
// הצנרת (זמן, סייקלים, תת-מחזור/מיכל, מחזור חיים) זהה ל-SSMT+HSSMT.
// ═══════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════
// הגדרות משתמש
// ═══════════════════════════════════════════════════════════════════

grpSym = "סימבולים"
useMicro  = input.bool(false, "השתמש בחוזי מיקרו", group = grpSym)
symNQ_std = input.symbol("CME_MINI:NQ1!", "NQ רגיל",  group = grpSym)
symES_std = input.symbol("CME_MINI:ES1!", "ES רגיל",  group = grpSym)
symNQ_mic = input.symbol("CME_MINI:MNQ1!", "NQ מיקרו", group = grpSym)
symES_mic = input.symbol("CME_MINI:MES1!", "ES מיקרו", group = grpSym)

grpGap = "הגדרת גאפ"
extendBodies = input.bool(true,  "הרחב גאפ לגופי הנרות (רווח סגירה/פתיחה)", group = grpGap)
// מינימום יחסי למחיר הנכס — כך אותו סף תופס גם על NQ (~28,500) וגם על ES (~7,500)
// ומסנן גאפים זעירים שנותנים דרגה 3 מיידית ומזויפת.
minGapPct    = input.float(0.0, "גודל גאפ מינימלי (% מהמחיר)", minval = 0.0, maxval = 1.0, step = 0.01, group = grpGap)

grpVis = "תצוגה"
colBull   = input.color(#26a69a, "צבע שורי", group = grpVis)
colBear   = input.color(#ef5350, "צבע דובי", group = grpVis)
labelSize = input.string("small", "גודל תווית", options = ["tiny", "small", "normal"], group = grpVis)
offsetMlt = input.float(1.5, "מרחק התווית מהנר (ATR)", minval = 0.1, maxval = 6.0, step = 0.1, group = grpVis)
showBox   = input.bool(true, "הצג קופסת גאפ", group = grpVis)
boxTransp = input.int(88, "שקיפות הקופסה", minval = 60, maxval = 98, group = grpVis)
showCE    = input.bool(false, "הצג קו CE (חצי גאפ)", group = grpVis)
showDebug = input.bool(false, "הצג טבלת בדיקה", group = grpVis)

grpLogic = "לוגיקה"
blockDeadWeek = input.bool(true, "חסום שבירות בשבוע מת (4H בלבד)", group = grpLogic)
maxGaps       = input.int(60, "מקסימום גאפים במיכל", minval = 5, maxval = 200, group = grpLogic)

// ═══════════════════════════════════════════════════════════════════
// בחירת סימבולים
// ═══════════════════════════════════════════════════════════════════

sNQ = useMicro ? symNQ_mic : symNQ_std
sES = useMicro ? symES_mic : symES_std

// ═══════════════════════════════════════════════════════════════════
// זיהוי Timeframe
// ═══════════════════════════════════════════════════════════════════

tfMin   = timeframe.in_seconds() / 60
tfClass = tfMin <= 1 ? 1 : tfMin <= 5 ? 2 : tfMin <= 15 ? 3 : tfMin <= 60 ? 4 : tfMin <= 240 ? 5 : 0

// ═══════════════════════════════════════════════════════════════════
// חישובי זמן EST — יום המסחר מתחיל ב-18:00 ניו-יורק
// ═══════════════════════════════════════════════════════════════════

TZ = "America/New_York"
estHour = hour(time, TZ)
estMin  = minute(time, TZ)

minutesOfDay = estHour * 60 + estMin

isPostOpen       = minutesOfDay >= 1080
minsFromDayStart = isPostOpen ? minutesOfDay - 1080 : minutesOfDay + 360

tradeDayTime = isPostOpen ? time + 86400000 : time
tdYear = year(tradeDayTime, TZ)
tdMon  = month(tradeDayTime, TZ)
tdDom  = dayofmonth(tradeDayTime, TZ)
tdDow  = dayofweek(tradeDayTime, TZ)

sessionIdx    = math.floor(minsFromDayStart / 360)
minsInSession = minsFromDayStart % 360
microIdx      = math.floor(minsInSession / 90)
minsInMicro   = minsInSession % 90
quarterIdx    = math.floor(minsInMicro / 22.5)

// ═══════════════════════════════════════════════════════════════════
// מספור שבועות לפי QT
// ═══════════════════════════════════════════════════════════════════

daysSinceMonday = tdDow == dayofweek.sunday ? 6 : tdDow - 2
mondayTime      = tradeDayTime - daysSinceMonday * 86400000
fridayTime      = mondayTime + 4 * 86400000

monMonth = month(mondayTime, TZ)
monDom   = dayofmonth(mondayTime, TZ)
monYear  = year(mondayTime, TZ)
friMonth = month(fridayTime, TZ)

isDeadWeek = monMonth != friMonth
qtWeekNum  = isDeadWeek ? 0 : math.floor((monDom - 1) / 7) + 1

// ═══════════════════════════════════════════════════════════════════
// מזהי מחזורים
// ═══════════════════════════════════════════════════════════════════

tradeDayId = tdYear * 10000 + tdMon * 100 + tdDom
weekId     = monYear * 10000 + monMonth * 100 + monDom
// חודש-מחזור ל-4H נקבע לפי חודש יום-שני של השבוע — כך הגבול תמיד נופל
// בתחילת שבוע (ולא באמצע שבוע מת) והמיכל מתאפס נכון.
monthId    = monYear * 100 + monMonth
sessionId  = tradeDayId * 10 + sessionIdx
microId    = sessionId * 10 + microIdx
quarterId  = microId * 10 + quarterIdx

refCycleId = 0
if tfClass == 5
    refCycleId := weekId
else if tfClass == 4
    refCycleId := tradeDayId
else if tfClass == 3
    refCycleId := sessionId
else if tfClass == 2
    refCycleId := microId
else if tfClass == 1
    refCycleId := quarterId

lifeCycleId = 0
if tfClass == 5
    lifeCycleId := monthId
else if tfClass == 4
    lifeCycleId := weekId
else if tfClass == 3
    lifeCycleId := tradeDayId
else if tfClass == 2
    lifeCycleId := sessionId
else if tfClass == 1
    lifeCycleId := microId

newRefCycle  = ta.change(refCycleId)  != 0
newLifeCycle = ta.change(lifeCycleId) != 0

// ב-1H התת-מחזור הראשון (יום שני) משווה גם לגאפים של התת-מחזור האחרון
// של השבוע הקודם (שישי) — אותו "זרע" נמחק אחרי היום הראשון.
keepLast = tfClass == 4

// ═══════════════════════════════════════════════════════════════════
// משיכת נתוני שני הנכסים
// ═══════════════════════════════════════════════════════════════════

[nqO, nqH, nqL, nqC] = request.security(sNQ, timeframe.period, [open, high, low, close], lookahead = barmerge.lookahead_off)
[esO, esH, esL, esC] = request.security(sES, timeframe.period, [open, high, low, close], lookahead = barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════
// טיפוס הגאפ הקולקטיבי
// ═══════════════════════════════════════════════════════════════════

type Gap
    int   id
    int   dir      // 1 = שורי (יושב מתחת למחיר), -1 = דובי
    float nqBot
    float nqTop
    float esBot
    float esTop
    int   refId
    int   birth
    float nqExt    // הקיצוניות המתגלגלת של NQ מאז הדריכה (min ל-bull, max ל-bear)
    float esExt
    bool  dead     // הפך ל-IFVG — הרעיון מתבטל
    bool  armed    // תת-המחזור שבו נולד הגאפ הסתיים — רק עכשיו הוא יכול לייצר שבירה

// הגאפ עצמו נשאר גאפ תקף כל עוד הוא לא הפך ל-IFVG. שבירה שמתה עליו (למשל
// כשפתיל של הנכס המפגר סתם את הפער) הורגת את השבירה בלבד — לא את הגאפ.
// אם מאוחר יותר המוביל מעמיק שוב ונוצרת דרגה גבוהה יותר, הגאפ מייצר שבירה חדשה.
var array<Gap> gaps = array.new<Gap>()
var int gapCounter  = 0

// עומק החדירה של נכס לתוך הגאפ שלו, ביחידות של אחוז מהגאפ (פתיל)
// 0 = לא נגע · 0.5 = CE · 1.0 = הקצה הרחוק · >1 = מעבר לגאפ בפתיל
method depth(Gap g, bool isNQ) =>
    float top = isNQ ? g.nqTop : g.esTop
    float bot = isNQ ? g.nqBot : g.esBot
    float ext = isNQ ? g.nqExt : g.esExt
    float rng = top - bot
    float d = 0.0
    if rng > 0 and not na(ext)
        d := g.dir == 1 ? (top - ext) / rng : (ext - bot) / rng
    math.max(d, 0.0)

// דרגת השבירה — הגבוהה ביותר שמתקיימת. 0 = אין שבירה.
f_degree(float dLead, float dLag) =>
    int deg = 0
    if dLead >= 1.0 and dLag < 1.0
        deg := 3
    else if dLead >= 0.5 and dLag < 0.5
        deg := 2
    else if dLead > 0.0 and dLag <= 0.0
        deg := 1
    deg

// ═══════════════════════════════════════════════════════════════════
// איפוס מיכל + מנגנון הזרע (שני/שישי ב-1H)
// ═══════════════════════════════════════════════════════════════════

var bool seedActive = false
var int  seedRefId  = 0

if newLifeCycle
    int prevRef = nz(refCycleId[1], 0)
    if keepLast
        if array.size(gaps) > 0
            for i = array.size(gaps) - 1 to 0
                if array.get(gaps, i).refId != prevRef
                    array.remove(gaps, i)
        seedRefId  := prevRef
        seedActive := array.size(gaps) > 0
    else
        array.clear(gaps)
        seedActive := false
else if newRefCycle and seedActive
    if array.size(gaps) > 0
        for i = array.size(gaps) - 1 to 0
            if array.get(gaps, i).refId == seedRefId
                array.remove(gaps, i)
    seedActive := false

// ═══════════════════════════════════════════════════════════════════
// דריכה + עדכון עומק החדירה + מוות ב-IFVG
//
// גאפ נהיה זמין לשבירה רק אחרי שתת-המחזור שבו נולד הסתיים — בדיוק כמו
// שרמת ייחוס באינדיקטור הישן נדחפה למערך רק בסוף תת-המחזור שלה.
// חזרה לגאפ באותו תת-מחזור שבו נוצר אינה שבירה, ולא נספרת בכלל.
// (1H: תת-מחזור = יום מסחר · 4H: שבוע · 15M: סשן · 5M: מיקרו-סשן · 1M: רבע)
// ═══════════════════════════════════════════════════════════════════

if array.size(gaps) > 0
    for i = 0 to array.size(gaps) - 1
        Gap gu = array.get(gaps, i)
        if not gu.dead
            if not gu.armed and gu.refId != refCycleId
                gu.armed := true
            if gu.dir == 1
                if gu.armed
                    gu.nqExt := math.min(gu.nqExt, nqL)
                    gu.esExt := math.min(gu.esExt, esL)
                // IFVG: סגירה מתחת לגאפ הופכת אותו — הרעיון מתבטל (גם לפני הדריכה)
                if barstate.isconfirmed and bar_index > gu.birth and (nqC < gu.nqBot or esC < gu.esBot)
                    gu.dead := true
            else
                if gu.armed
                    gu.nqExt := math.max(gu.nqExt, nqH)
                    gu.esExt := math.max(gu.esExt, esH)
                if barstate.isconfirmed and bar_index > gu.birth and (nqC > gu.nqTop or esC > gu.esTop)
                    gu.dead := true

// ═══════════════════════════════════════════════════════════════════
// זיהוי גאפ קולקטיבי — FVG באותו כיוון, באותו נר, בשני הנכסים
//
// נרות: 1 = [2] · 2 = [1] · 3 = [0]
//
// הגבול נמדד בפתיל. הוא מורחב לגוף רק כשיש באותו צד רווח אמיתי שלא נסחר —
// כלומר הנר הבא נפתח מעבר לפתיל של הנר הקודם, ולא רק מעבר לסגירה שלו.
// (סגירה ופתיחה שנבדלות בטיק אחד בתוך הפתיל אינן רווח ולא מרחיבות כלום.)
//   שורי  — תחתון: high[2] → close[2] אם open[1] > high[2]
//            עליון:  low[0]  → open[0]  אם low[0]  > close[1]
//   דובי  — עליון:  low[2]   → close[2] אם open[1] < low[2]
//            תחתון: high[0]  → open[0]  אם high[0] < close[1]
// ═══════════════════════════════════════════════════════════════════

minNQSize = minGapPct / 100 * nqC
minESSize = minGapPct / 100 * esC

if barstate.isconfirmed and tfClass != 0 and bar_index > 2
    bool bullNQ = nqL > nqH[2]
    bool bullES = esL > esH[2]
    bool bearNQ = nqH < nqL[2]
    bool bearES = esH < esL[2]

    int  newDir = (bullNQ and bullES) ? 1 : (bearNQ and bearES) ? -1 : 0

    if newDir != 0
        float nb = na
        float nt = na
        float eb = na
        float et = na

        if newDir == 1
            nb := (extendBodies and nqO[1] > nqH[2]) ? nqC[2] : nqH[2]
            nt := (extendBodies and nqL    > nqC[1]) ? nqO    : nqL
            eb := (extendBodies and esO[1] > esH[2]) ? esC[2] : esH[2]
            et := (extendBodies and esL    > esC[1]) ? esO    : esL
        else
            nt := (extendBodies and nqO[1] < nqL[2]) ? nqC[2] : nqL[2]
            nb := (extendBodies and nqH    < nqC[1]) ? nqO    : nqH
            et := (extendBodies and esO[1] < esL[2]) ? esC[2] : esL[2]
            eb := (extendBodies and esH    < esC[1]) ? esO    : esH

        if nt - nb > minNQSize and et - eb > minESSize
            gapCounter += 1
            Gap gn = Gap.new(gapCounter, newDir, nb, nt, eb, et, refCycleId, bar_index, newDir == 1 ? nt : nb, newDir == 1 ? et : eb, false, false)
            array.push(gaps, gn)
            if array.size(gaps) > maxGaps
                array.shift(gaps)

// ═══════════════════════════════════════════════════════════════════
// חסימות
// ═══════════════════════════════════════════════════════════════════

cycleOK  = not (tfClass == 5 and blockDeadWeek and isDeadWeek)
friBlock = (tfClass == 5 or tfClass == 4) and tdDow == dayofweek.friday

// ═══════════════════════════════════════════════════════════════════
// מצב השבירה
// ═══════════════════════════════════════════════════════════════════

atr = ta.atr(14)

var int    frDir   = 0     // 0 = אין שבירה
var int    frDeg   = 0
var string frLead  = ""
var int    frGapId = -1
var int    frSigB  = 0
var int    frSeq   = 0
var float  frYPos  = na
var int    seqCounter = 0

// אינדקס הגאפ הפעיל במערך (האינדקסים זזים כשגאפים נמחקים — נמצא מחדש בכל נר)
f_findGapIdx(int id) =>
    int found = -1
    if array.size(gaps) > 0
        for i = array.size(gaps) - 1 to 0
            if found == -1 and array.get(gaps, i).id == id
                found := i
    found

// סורק את הגאפים מהחדש לישן ומחזיר את השבירה הראשונה שנמצאה.
// dirFilter: 0 = כל כיוון · אחרת רק הכיוון הזה.
f_scan(int dirFilter, int skipId) =>
    int    rId  = -1
    int    rDir = 0
    int    rDeg = 0
    string rLd  = ""
    if array.size(gaps) > 0
        for i = array.size(gaps) - 1 to 0
            if rDeg == 0
                Gap gs = array.get(gaps, i)
                bool skip = gs.dead or not gs.armed or gs.id == skipId or (dirFilter != 0 and gs.dir != dirFilter)
                if not skip
                    float dN = gs.depth(true)
                    float dE = gs.depth(false)
                    int   deg = f_degree(math.max(dN, dE), math.min(dN, dE))
                    if deg > 0
                        rId  := gs.id
                        rDir := gs.dir
                        rDeg := deg
                        rLd  := dN > dE ? "NQ" : "ES"
    [rId, rDir, rDeg, rLd]

// ── פקיעת מיכל — מוחקת את השבירה ──
if newLifeCycle
    frDir   := 0
    frDeg   := 0
    frGapId := -1

// ── עדכון השבירה הפעילה ──
//
// שבירה היא אירוע שקרה. אחרי שנרשמה היא נשארת על המסך כל עוד הגאפ לא הפך
// ל-IFVG — פתיל של הנכס המפגר שמשלים את הפער אינו מבטל אותה. הדרגה יכולה
// רק לעלות (עדכון תווית), אף פעם לא לרדת.
// מה שכן מבטל: IFVG · שבירה נגדית באותה מסגרת זמן · החלפת מיכל.
if frDir != 0
    int idx = f_findGapIdx(frGapId)
    if idx == -1
        frDir := 0
    else
        Gap ga = array.get(gaps, idx)
        if ga.dead
            // IFVG — הרעיון מתבטל, והגאפ עצמו יוצא מהמשחק
            frDir := 0
        else
            float aN = ga.depth(true)
            float aE = ga.depth(false)
            int   aDeg = f_degree(math.max(aN, aE), math.min(aN, aE))
            if aDeg > frDeg
                frDeg  := aDeg
                frLead := aN > aE ? "NQ" : "ES"

// ── רישום שבירות בסגירת נר ──
if barstate.isconfirmed and tfClass != 0 and not friBlock and cycleOK

    // שבירה נגדית מבטלת את הנוכחית — נסרקת גם כשיש שבירה פעילה
    if frDir != 0
        [oId, oDir, oDeg, oLd] = f_scan(-frDir, frGapId)
        if oDeg > 0
            seqCounter += 1
            frDir   := oDir
            frDeg   := oDeg
            frLead  := oLd
            frGapId := oId
            frSigB  := bar_index
            frSeq   := seqCounter
            frYPos  := oDir == 1 ? low - atr * offsetMlt : high + atr * offsetMlt

    // אין שבירה פעילה — מחפשים חדשה בכל כיוון
    if frDir == 0
        [nId, nDir, nDeg, nLd] = f_scan(0, -1)
        if nDeg > 0
            seqCounter += 1
            frDir   := nDir
            frDeg   := nDeg
            frLead  := nLd
            frGapId := nId
            frSigB  := bar_index
            frSeq   := seqCounter
            frYPos  := nDir == 1 ? low - atr * offsetMlt : high + atr * offsetMlt

// ═══════════════════════════════════════════════════════════════════
// ציור — תווית + קופסת הגאפ של נכס הגרף (רק השבירה הפעילה)
// ═══════════════════════════════════════════════════════════════════

cs    = syminfo.tickerid
isESc = str.contains(cs, "ES")

var label aLbl  = na
var box   aBox  = na
var line  aCE   = na
var int   drawnSeq = -999
var int   drawnDeg = -999

curIdx = frDir != 0 ? f_findGapIdx(frGapId) : -1

needRedraw = frSeq != drawnSeq or frDeg != drawnDeg or (frDir == 0 and drawnSeq != -999)

if needRedraw
    if not na(aLbl)
        label.delete(aLbl)
        aLbl := na
    if not na(aBox)
        box.delete(aBox)
        aBox := na
    if not na(aCE)
        line.delete(aCE)
        aCE := na
    if frDir != 0 and curIdx != -1 and not na(frYPos)
        Gap   gd   = array.get(gaps, curIdx)
        color col  = frDir == 1 ? colBull : colBear
        // דרגה גבוהה = צבע חזק יותר
        color cFin = frDeg == 3 ? col : frDeg == 2 ? color.new(col, 25) : color.new(col, 45)
        float gTop = isESc ? gd.esTop : gd.nqTop
        float gBot = isESc ? gd.esBot : gd.nqBot
        aLbl := label.new(frSigB, frYPos, "F" + str.tostring(frDeg) + " " + frLead, style = label.style_none, textcolor = cFin, size = labelSize, textalign = text.align_center)
        if showBox
            aBox := box.new(gd.birth, gTop, bar_index, gBot, border_color = cFin, border_width = 1, bgcolor = color.new(col, boxTransp))
        if showCE
            float ce = (gTop + gBot) / 2
            aCE := line.new(gd.birth, ce, bar_index, ce, color = cFin, style = line.style_dashed, width = 1)
    drawnSeq := frDir != 0 ? frSeq : -999
    drawnDeg := frDir != 0 ? frDeg : -999

// הרחבת הציור לנר הנוכחי
if frDir != 0 and curIdx != -1
    if not na(aBox)
        box.set_right(aBox, bar_index)
    if not na(aCE)
        line.set_x2(aCE, bar_index)

// ═══════════════════════════════════════════════════════════════════
// טבלת בדיקה (אבחון — כבויה כברירת מחדל)
// ═══════════════════════════════════════════════════════════════════

f_num(float x) => na(x) ? "-" : str.tostring(x, format.mintick)
f_pct(float x) => na(x) ? "-" : str.tostring(math.round(x * 100)) + "%"

var table dbg = table.new(position.top_right, 3, 12, border_width = 1)
if showDebug and barstate.islast
    hc = color.gray
    wc = color.white

    // כמה גאפים חיים ודרוכים
    int tLive  = 0
    int tArmed = 0
    if array.size(gaps) > 0
        for i = 0 to array.size(gaps) - 1
            if not array.get(gaps, i).dead
                tLive += 1
                if array.get(gaps, i).armed
                    tArmed += 1

    // הגאפ שמוצג בטבלה: זה של השבירה הפעילה, ואם אין — הגאפ החי האחרון.
    // כך רואים למה גאפ קיים לא ייצר שבירה (לא דרוך? עומק? גודל?).
    int dIdx = curIdx
    if dIdx == -1 and array.size(gaps) > 0
        for i = array.size(gaps) - 1 to 0
            if dIdx == -1 and not array.get(gaps, i).dead
                dIdx := i

    float tN     = na
    float tE     = na
    int   tDir   = 0
    bool  tArm   = false
    int   tId    = -1
    int   tDeg   = 0
    float tNqTop = na
    float tNqBot = na
    float tEsTop = na
    float tEsBot = na
    if dIdx != -1
        Gap gt = array.get(gaps, dIdx)
        tN     := gt.depth(true)
        tE     := gt.depth(false)
        tDir   := gt.dir
        tArm   := gt.armed
        tId    := gt.id
        tDeg   := f_degree(math.max(tN, tE), math.min(tN, tE))
        tNqTop := gt.nqTop
        tNqBot := gt.nqBot
        tEsTop := gt.esTop
        tEsBot := gt.esBot

    table.cell(dbg, 0, 0, "SSMT Fill", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 0, "NQ", bgcolor = hc, text_color = wc)
    table.cell(dbg, 2, 0, "ES", bgcolor = hc, text_color = wc)

    table.cell(dbg, 0, 1, "tf/gaps", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 1, "tf " + str.tostring(tfClass), bgcolor = wc)
    table.cell(dbg, 2, 1, str.tostring(tArmed) + " arm/" + str.tostring(tLive) + " live", bgcolor = wc)

    table.cell(dbg, 0, 2, "שבירה", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 2, frDir == 0 ? "אין" : (frDir == 1 ? "שורית" : "דובית"), bgcolor = wc)
    table.cell(dbg, 2, 2, frDir == 0 ? "-" : "F" + str.tostring(frDeg) + " " + frLead, bgcolor = wc)

    table.cell(dbg, 0, 3, "── הגאפ האחרון ──", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 3, "id " + str.tostring(tId), bgcolor = wc)
    table.cell(dbg, 2, 3, tDir == 0 ? "-" : (tDir == 1 ? "שורי" : "דובי"), bgcolor = wc)

    // אם armed = X — הגאפ עדיין בתת-המחזור שבו נולד, ולכן לא יכול לייצר שבירה
    table.cell(dbg, 0, 4, "דרוך?", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 4, tArm ? "V" : "X", bgcolor = wc)
    table.cell(dbg, 2, 4, "deg " + str.tostring(tDeg), bgcolor = wc)

    table.cell(dbg, 0, 5, "עומק", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 5, f_pct(tN), bgcolor = wc)
    table.cell(dbg, 2, 5, f_pct(tE), bgcolor = wc)

    table.cell(dbg, 0, 6, "gapTop", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 6, f_num(tNqTop), bgcolor = wc)
    table.cell(dbg, 2, 6, f_num(tEsTop), bgcolor = wc)

    table.cell(dbg, 0, 7, "gapBot", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 7, f_num(tNqBot), bgcolor = wc)
    table.cell(dbg, 2, 7, f_num(tEsBot), bgcolor = wc)

    // גודל הגאפ כאחוז מהמחיר — מול "גודל גאפ מינימלי" שבהגדרות
    table.cell(dbg, 0, 8, "גודל %", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 8, na(tNqTop) ? "-" : str.tostring((tNqTop - tNqBot) / nqC * 100, "#.###"), bgcolor = wc)
    table.cell(dbg, 2, 8, na(tEsTop) ? "-" : str.tostring((tEsTop - tEsBot) / esC * 100, "#.###"), bgcolor = wc)

    table.cell(dbg, 0, 9, "סף מינימום", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 9, str.tostring(minGapPct, "#.###"), bgcolor = wc)
    table.cell(dbg, 2, 9, "seq " + str.tostring(frSeq), bgcolor = wc)

    table.cell(dbg, 0, 10, "שבוע", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 10, "Q" + str.tostring(qtWeekNum), bgcolor = wc)
    table.cell(dbg, 2, 10, isDeadWeek ? "DEAD" : "-", bgcolor = wc)

    table.cell(dbg, 0, 11, "זרע/שישי", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 11, seedActive ? "V" : "X", bgcolor = wc)
    table.cell(dbg, 2, 11, friBlock ? "FRI" : "-", bgcolor = wc)
