//@version=5
indicator("SSMT Fill | Quarterly Theory", overlay = true, max_labels_count = 20, max_lines_count = 20, max_boxes_count = 250)

// ═══════════════════════════════════════════════════════════════════
// SSMT Fill — סטיית קורלציה לפי מילוי גאפים
//
// שינויים בגרסה הזו:
// 1. שלושה מתגים נפרדים: FVG · VI כגאפ בפני עצמו · הרחבה לגופי הנרות.
//    הרחבה כבויה = אין שום הרחבה, גם לא VI שמתאחד עם FVG.
// 2. המסגרות שמתחת לגרף: תת-הנרות מזווגים לפי זמן. נכס שחסרה לו דקה
//    מדלג עליה (כמו בגרף שלו) — קודם כל נר הגרף נזרק.
// 3. מיכל חדש בלי זרע (15m · 4H · 1D · 1W · Mo) מתחיל נקי — FVG שהנר
//    האמצעי שלו במיכל הקודם לא נכנס אליו.
// 4. פינה מינימלית: טקסט קטן, בלי שמות הזוג (הצבע מבדיל).
// 5. השבירה של השלישייה ושל הזוג 3·4 מוצגות יחד. החזקה היא הראשית; השנייה
//    משנית — צבע, שקיפות, מסגרת וגודל טקסט משלה, כמו ב-SSMT.
// 6. סימון הנר שרשם את שבירת הזוג 3·4 (YM/RTY) — לכניסה אחרי ה-fill:
//    קו אנכי דק ושקוף (ברירת מחדל, לא יושב על הנר), חץ, או כבוי.
// 7. בפינה — השלישייה והזוג בנפרד: שבירת זוג מוצגת גם כשיש שבירת שלישייה
//    באותה מסגרת, וגם כש-NQ/ES הפכו את הגאפ של השלישייה ל-IFVG.
// 8. סדר התצוגה לבחירה: החזקה ראשונה · החדשה ראשונה · שלישייה ואז זוג —
//    על הגרף (מי ראשית).
// 9. בפינה: במקום שעה — ה-Q של השבירה בתוך המיכל (שלישי ב-1H = Q2), ולכל
//    מסגרת רק השבירה האחרונה (שלישייה או זוג — לא שתיהן).
//
// ארבעה נכסים, התפקיד לפי המיקום: 1 ו-2 = חזקים · 3 = חלש · 4 = בן הזוג של 3.
// שתי קבוצות נפרדות, וכל אחת יוצרת שבירות משלה באותם חוקים:
//   שלישייה (1·2·3) — גאפ קולקטיבי = גאפ באותו כיוון, באותו נר, בלפחות שניים
//     מהשלושה. נכס 3 הוא החלש:
//       גאפ שורי — הוא יכול להיות רק ה**מפגר** (רדוד מהאחרים → סיגנל לעליות).
//       גאפ דובי — הוא יכול להיות רק ה**מוביל** (עמוק מהאחרים → סיגנל לירידות).
//     רק 1 ו-2 הורגים את הגאפ (IFVG). סגירה של 3 מעבר לגאפ רק מוציאה אותו.
//   זוג (3·4) — גאפ קולקטיבי = לשניהם גאפ באותו כיוון ובאותו נר. הם שווים:
//     אין חזק וחלש, וסגירה של כל אחד מהם מעבר לגאפ הורגת אותו.
// כשלכל הארבעה יש גאפ באותו נר — נוצרים שני גאפים, אחד לכל קבוצה.
//
// שבירה = הנכס המוביל נכנס עמוק יותר מהמפגר. שלוש דרגות:
//   F1 — המוביל נגע, המפגר לא נגע בכלל.
//   F2 — המוביל הגיע ל-CE (50%), המפגר לא.
//   F3 — המוביל הגיע לקצה הרחוק (או מעבר בפתיל), המפגר לא לקח הכול.
//
// כל ביקור בגאפ נמדד מאפס. אם כולם מילאו את הגאפ יחד — אין שבירה, אבל
// הגאפ נשאר תקף וכניסה חוזרת אליו נמדדת מחדש ויכולה לייצר שבירה.
//
// שבירה היא אירוע שקרה — אחרי שנרשמה היא נשארת, והדרגה יכולה רק לעלות.
// חריג אחד: אם המפגר משלים את המילוי באותו ביקור, השבירה מתבטלת.
// מה שמוציא אותה מהמשחק: IFVG על הגאפ שלה, או החלפת מיכל.
//
// סוגי גאפ: FVG של שלושה נרות, ו-VI — רווח סגירה/פתיחה בין שני נרות, ברצף,
// מסף טיקים. רווח של פתיחת יום/שבוע/סשן נספר בלי דרישת רצף ושייך לסייקל
// שהוא פותח. ההרחבה לגופי הנרות היא מתג נפרד משניהם.
//
// מיפוי תת-מחזור/מיכל לכל מסגרת זמן:
//   1M  — רבע 22.5m   → מיקרו-סשן    5M  — מיקרו-סשן → סשן
//   15M — סשן          → יום מסחר      1H  — יום מסחר  → שבוע
//   4H  — שבוע         → חודש          1D  — רבע-רבעון → רבעון
//   1W  — רבעון        → שנת QT        Mo  — שנה       → מחזור 4 שנים
// ═══════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════
// הגדרות משתמש
// ═══════════════════════════════════════════════════════════════════

grpSym = "סימבולים"
// התפקיד נקבע לפי המיקום. נכס 4 אופציונלי — לזהב ולקריפטו יש רק שלושה.
sym1 = input.symbol("CME_MINI:MNQ1!",  "נכס 1 (חזק)", group = grpSym)
sym2 = input.symbol("CME_MINI:MES1!",  "נכס 2 (חזק)", group = grpSym)
sym3 = input.symbol("CBOT_MINI:MYM1!", "נכס 3 (חלש)", group = grpSym)
use4 = input.bool(true, "נכס 4 — בן הזוג של נכס 3", group = grpSym)
sym4 = input.symbol("CME_MINI:M2K1!",  "נכס 4", group = grpSym)
// ספר החוקים §6 — אותה מדיניות נתונים בשלושת האינדיקטורים: בלי יישור לגלגול
// כברירת מחדל (עם אפשרות לבחור), ו-Settlement כמו בגרף.
adjMode   = input.string("בלי יישור", "נתוני חוזה רציף", options = ["בלי יישור", "מיושר לגלגול", "ברירת המחדל של הסימבול"], group = grpSym, tooltip = "בשבוע גלגול חוזים כדאי לעבור ל'מיושר לגלגול'.")
settleIn  = input.string("כבוי — כמו הגרף", "Settlement כסגירה יומית", options = ["כבוי — כמו הגרף", "דלוק", "ברירת המחדל של הסימבול"], group = grpSym)

grpGap = "הגדרת גאפ"
// שלושה מתגים נפרדים לגמרי: איזה גאפים מזהים (FVG / VI), והאם מרחיבים אותם.
fvgOn        = input.bool(true, "זהה FVG (שלושה נרות)", tooltip = "כבוי = רק VI (אם הוא דלוק).", group = grpGap)
volImbOn     = input.bool(true, "זהה VI — גאפ סגירה/פתיחה בין שני נרות", tooltip = "Volume Imbalance — הרווח בין הסגירה של נר לפתיחה של הנר שאחריו, כגאפ בפני עצמו. נספר יחד עם FVG לאותו גאפ קולקטיבי, ומסומן V בהצצה כשכל הרגליים הן VI.\nלא מרחיב FVG — זה תפקיד ההרחבה.", group = grpGap)
extendBodies = input.bool(true, "הרחב גאפים לגופי הנרות", tooltip = "דלוק = FVG מורחב לגופי הנרות כשיש באותו צד רווח סגירה/פתיחה (מסף 'הרחבה — מינימום טיקים'), משני הצדדים, ו-VI שבאותו נכס מתאחד איתו.\nכבוי = אין שום הרחבה: FVG נשאר בגבולות הפתילים, ו-VI לא מתאחד איתו.", group = grpGap)
viMinTicks   = input.int(4, "VI לבד — מינימום טיקים", minval = 1, maxval = 100, tooltip = "רווח סגירה/פתיחה שנספר כגאפ בפני עצמו.", group = grpGap)
viMergeTicks = input.int(1, "הרחבה — מינימום טיקים", minval = 1, maxval = 100, tooltip = "חל רק כשההרחבה דלוקה. רווח סגירה/פתיחה מהגודל הזה מרחיב FVG של אותו נכס — בין נר 1 לנר 2 ובין נר 2 לנר 3. רווח קטן מהסף לא מרחיב בכלל.", group = grpGap)
// כיבוי = השלישייה היא רק 1 מול 2. הזוג 3·4 לא מושפע.
use3         = input.bool(true, "כלול את נכס 3 בשלישייה כנכס חלש", group = grpGap)
maxGaps      = input.int(60, "מקסימום גאפים במיכל", minval = 5, maxval = 200, group = grpGap)

grpVis = "תצוגה"
colBull   = input.color(#26a69a, "צבע שורי", group = grpVis)
colBear   = input.color(#ef5350, "צבע דובי", group = grpVis)
// הזוג 3·4 בצבע אחד — הכיוון ידוע ממילא מהמיקום מעל או מתחת לנר.
colPair   = input.color(#ab47bc, "צבע הזוג 3·4", group = grpVis)
// השבירה המשנית (כששתי הקבוצות שבורות — החלשה מביניהן): צבע, שקיפות, מסגרת
// וגודל טקסט משלה, נפרדים לגמרי מהראשית.
colBullW  = input.color(#80cbc4, "שבירה משנית — שורי", group = grpVis)
colBearW  = input.color(#ef9a9a, "שבירה משנית — דובי", group = grpVis)
colPairW  = input.color(#ce93d8, "שבירה משנית — זוג 3·4", group = grpVis)
weakFade  = input.int(30, "שקיפות השבירה המשנית", minval = 0, maxval = 90, group = grpVis, tooltip = "חל רק על השבירה המשנית. הראשית נשארת כמו שהיא.")
weakStyle = input.string("מקווקו", "מסגרת — שבירה משנית", options = ["רציף", "מקווקו", "נקודות"], group = grpVis)
weakSmall = input.bool(true, "טקסט קטן לשבירה משנית", group = grpVis)
// כששבורות גם השלישייה וגם הזוג — מי ראשית על הגרף ומי קודם בפינה
orderMode = input.string("החזקה ראשונה", "סדר: שלישייה מול זוג", options = ["החזקה ראשונה", "החדשה ראשונה", "שלישייה ואז זוג"], group = grpVis, tooltip = "החזקה = דרגה גבוהה יותר (בשוויון — החדשה). החדשה = זו שנרשמה אחרונה. שלישייה ואז זוג = השלישייה תמיד ראשונה.")
capSize   = input.string("tiny", "גודל הכיתוב", options = ["tiny", "small", "normal"], group = grpVis)
offsetMlt = input.float(1.5, "מרחק התווית מהנר (ATR)", minval = 0.1, maxval = 6.0, step = 0.1, group = grpVis)
// סימון הנר שרשם את שבירת הזוג 3·4 — כדי לדעת בדיוק איזה נר עשה את ה-fill.
// קו אנכי לא יושב על הפתיל ולא מסתיר סימונים של אינדיקטורים אחרים ליד הנר.
pairMark  = input.string("קו אנכי", "סימון נר השבירה של הזוג 3·4", options = ["קו אנכי", "חץ", "כבוי"], group = grpVis, tooltip = "קו אנכי = קו דק ושקוף לכל גובה הגרף דרך הנר. חץ = מתחת לנר בשורי, מעליו בדובי. אם הדרגה עלתה — הסימון עובר לנר של העלייה.")
markTransp = input.int(65, "שקיפות הקו האנכי", minval = 0, maxval = 95, group = grpVis)
markStyle = input.string("נקודות", "סגנון הקו האנכי", options = ["נקודות", "מקווקו", "רציף"], group = grpVis)
arrowSize = input.string("small", "גודל החץ", options = ["tiny", "small", "normal"], group = grpVis)
showBox   = input.bool(true, "הצג קופסת גאפ", group = grpVis)
boxTransp = input.int(90, "שקיפות המילוי", minval = 50, maxval = 98, group = grpVis)
boxBorder = input.int(45, "שקיפות המסגרת", minval = 0, maxval = 95, group = grpVis)
boxLen    = input.string("עד הנר הנוכחי", "אורך הקופסה", options = ["עד הנר הנוכחי", "עד נר השבירה", "קצר (12 נרות)"], group = grpVis)
showCE    = input.bool(false, "הצג קו CE (חצי גאפ)", group = grpVis)
// הגאפים הקולקטיביים ה**דרוכים** — אלה שיכולה להיווצר עליהם שבירה עכשיו.
showAllGaps = input.bool(false, "הצג את הגאפים הדרוכים (תמיד)", group = grpVis)
// הצצה: ב-4H ומטה הגאפים הדרוכים נצבעים לכמה שניות בכל טעינה של הסקריפט
// (החלפת מסגרת / פתיחת גרף), ואז נעלמים.
autoAllGaps = input.bool(true, "הצצה: הגאפים הדרוכים בהחלפת מסגרת (4H ומטה)", group = grpVis)
autoAllSec  = input.int(20, "כמה שניות להשאיר את ההצצה", minval = 1, maxval = 600, group = grpVis)
peekFill    = input.int(85, "הצצה — שקיפות המילוי", minval = 0, maxval = 98, tooltip = "נמוך = צבע חזק יותר. חל על כל קופסאות ההצצה, קולקטיביות ולא קורלטיביות.", group = grpVis)
peekEdge    = input.int(85, "הצצה — שקיפות המסגרת", minval = 0, maxval = 100, tooltip = "אותו ערך כמו המילוי = מסגרת חלקה, חלק מהקופסה. נמוך יותר = מסגרת בולטת.", group = grpVis)

// ── גאפים של הגרף עצמו — לא קורלטיביים ──
// כל הגאפים של הנכס שהגרף מציג, בלי קשר לשאר. רק תצוגה: אין עליהם שבירה
// ואין התראה. אותם חוקים כמו הגאפים הקולקטיביים. גאפ שהוא גם קולקטיבי ומצויר
// כבר בהצצה — לא מצויר פעמיים, ואם ההצצה שלו נגמרה הוא מוצג כקולקטיבי.
grpOwn    = "גאפים של הגרף (לא קורלטיביים)"
ownMode   = input.string("הצצה", "הצגה", options = ["כבוי", "הצצה", "תמיד"], tooltip = "הצצה = בכל טעינה של הסקריפט (החלפת מסגרת / פתיחת גרף) למשך מספר השניות שבחרת, ואז נעלמים.", group = grpOwn)
ownSec    = input.int(20, "כמה שניות בהצצה", minval = 1, maxval = 600, group = grpOwn)
ownMaxTf  = input.string("Mo", "הצג במסגרות עד", options = ["1m", "5m", "15m", "1H", "4H", "1D", "1W", "Mo"], group = grpOwn)
ownBull   = input.color(#42a5f5, "צבע שורי", group = grpOwn)
ownBear   = input.color(#ffa726, "צבע דובי", group = grpOwn)
ownAlwTf  = input.string("כבוי", "תמיד במסגרות עד", options = ["כבוי", "1m", "5m", "15m", "1H", "4H", "1D", "1W", "Mo"], tooltip = "כשההצגה היא הצצה: במסגרות האלה ומטה הגאפים מוצגים תמיד, ומעליהן רק בהצצה. למשל 5m = תמיד ב-1m וב-5m, הצצה בשאר.", group = grpOwn)
ownAlwCls = ownAlwTf == "1m" ? 1 : ownAlwTf == "5m" ? 2 : ownAlwTf == "15m" ? 3 : ownAlwTf == "1H" ? 4 : ownAlwTf == "4H" ? 5 : ownAlwTf == "1D" ? 6 : ownAlwTf == "1W" ? 7 : ownAlwTf == "Mo" ? 8 : 0
ownMaxCls = ownMaxTf == "1m" ? 1 : ownMaxTf == "5m" ? 2 : ownMaxTf == "15m" ? 3 : ownMaxTf == "1H" ? 4 : ownMaxTf == "4H" ? 5 : ownMaxTf == "1D" ? 6 : ownMaxTf == "1W" ? 7 : 8

grpLogic = "לוגיקה"
blockDeadWeek = input.bool(true, "חסום שבירות בשבוע מת (4H בלבד)", group = grpLogic)

grpAlert = "התראות"
// ההתראה רצה בשרתי TradingView — היא קופצת גם כשהגרף סגור.
alertOn     = input.bool(true, "שלח התראה על שבירה חדשה", group = grpAlert)
alertMinDeg = input.int(1, "דרגה מינימלית להתראה", minval = 1, maxval = 3, group = grpAlert)

grpMtf = "מסגרות זמן"
// המנוע רץ שוב, בנפרד לגמרי, על כל מסגרת זמן אחרת — עם אותם חוקים בדיוק.
// מסגרות נמוכות נמשכות כתת-נרות; טריידינגויו מגביל את כמותם, ולכן ככל
// שיורדים יותר מדרגות ההיסטוריה מתקצרת. 2 זו נקודת האיזון; 0 מכבה.
lowerLevels  = input.int(2, "כמה מדרגות מתחת לגרף", minval = 0, maxval = 3, group = grpMtf)
// שורת טקסט זעירה בפינה שאומרת שנסגרה שבירה במסגרת אחרת.
mtfFlash     = input.bool(true, "הצג סימון זעיר משאר המסגרות", group = grpMtf)
flashMode    = input.string("רק כששבירה נולדת", "מתי להציג", options = ["רק כששבירה נולדת", "כל עוד יש שבירה חיה"], group = grpMtf)
// 15–30 שניות זה הטווח שעובד: הסימון מתעדכן רק כשמגיע טיק.
mtfFlashSec  = input.int(20, "כמה שניות להשאיר את הסימון", minval = 5, maxval = 300, tooltip = "מומלץ 15–30. הסימון נעלם בטיק הראשון אחרי שהחלון נגמר, ולכן בשוק שקט הוא יכול להישאר עוד כמה שניות.", group = grpMtf)
flashPos     = input.string("שמאל למטה", "מיקום הסימון", options = ["שמאל למטה", "שמאל למעלה", "ימין למטה", "ימין למעלה", "אמצע למטה"], group = grpMtf)
// שורות ריקות שמרימות את השורה שלנו מעל הטבלה של אינדיקטור אחר באותה פינה.
flashLift    = input.int(1, "הרם את הסימון (שורות)", minval = 0, maxval = 6, group = grpMtf)
flashTag     = input.string("SF", "תווית פתיחה לשורה", group = grpMtf)
flashTagCol  = input.color(color.gray, "צבע התווית", group = grpMtf)
flashSz      = input.string("tiny", "גודל טקסט בפינה", options = ["tiny", "small", "normal"], group = grpMtf)
flashHour    = input.bool(true, "Q של השבירה בפינה", tooltip = "איזה רבע של המיכל עשה את השבירה. 1m — רבע במיקרו · 5m — מיקרו בסשן · 15m — סשן ביום (אסיה Q1 … PM Q4) · 1H — יום בשבוע (שני Q1 … חמישי Q4, שישי Q5) · 4H — שבוע בחודש · 1D — רבע-רבעון ברבעון · 1W — רבעון בשנת QT (אפריל = Q1) · Mo — שנה במחזור.", group = grpMtf)
flashMin     = input.bool(true, "פינה מינימלית", tooltip = "דלוק = בפינה רק מסגרת, חץ ודרגה — בלי שמות הזוג (הצבע מבדיל).", group = grpMtf)
mtfAlert     = input.bool(true, "כלול שבירות ממסגרות אחרות בהתראה", group = grpMtf)
// המסגרות האחרות מחושבות רק על הנרות האחרונים שלהן. 2000 מכסה בכל מסגרת יותר
// מהמיכל הנוכחי והקודם (הארוך ביותר: 4H — חודש ≈ 140 נרות, 1W — שנת QT ≈ 52),
// ולכן השבירות בזמן אמת זהות לגמרי. חוסך זיכרון, בעיקר בנרות הקטנים שמתחת לגרף.
calcBars     = input.int(2000, "נרות לחישוב המסגרות האחרות", minval = 500, maxval = 20000, step = 500, group = grpMtf, tooltip = "לא משנה את השבירות של היום — רק כמה רחוק אחורה שורת הפינה וההתראות מחושבות. נמוך יותר = פחות זיכרון.")
// כל מסגרת עליונה = הרבה סדרות נתונים, והתקציב משותף לכל האינדיקטורים בגרף.
// בגרף 4H ומעלה הסריקה ממשיכה עד החודשי.
maxHtf       = input.string("4H", "מסגרת עליונה לסריקה (בגרף מתחת ל-4H)", options = ["4H", "1D", "1W", "Mo"], group = grpMtf, tooltip = "גבוה יותר = יותר זיכרון. אם מופיעה שגיאת Memory limits — להשאיר על 4H.")

// ═══════════════════════════════════════════════════════════════════
// נכסים — שמות, נכס הגרף, סימבולים לבקשות
// ═══════════════════════════════════════════════════════════════════

// השם הקצר של סימבול: בלי הבורסה ובלי "1!", ובלי ה-M של מיקרו.
// MNQ→NQ · MES→ES · MYM→YM · M2K→RTY · MGC→GC
f_short(string s) =>
    string x = s
    int p = str.pos(x, ":")
    if not na(p)
        x := str.substring(x, p + 1)
    x := str.replace_all(x, "1!", "")
    if str.length(x) == 3 and str.startswith(x, "M")
        x := str.substring(x, 1)
    x == "2K" ? "RTY" : x

nm1 = f_short(sym1)
nm2 = f_short(sym2)
nm3 = f_short(sym3)
nm4 = f_short(sym4)

// איזה מהנכסים הגרף מציג: 0..3, ו--1 אם אף אחד מהם
cName    = f_short(syminfo.ticker)
chartIdx = cName == nm1 ? 0 : cName == nm2 ? 1 : cName == nm3 ? 2 : (use4 and cName == nm4) ? 3 : -1
ownName  = chartIdx == 0 ? nm1 : chartIdx == 1 ? nm2 : chartIdx == 2 ? nm3 : chartIdx == 3 ? nm4 : syminfo.ticker

bAdj = adjMode == "מיושר לגלגול" ? backadjustment.on : adjMode == "בלי יישור" ? backadjustment.off : backadjustment.inherit
bSet = settleIn == "דלוק" ? settlement_as_close.on : settleIn == "ברירת המחדל של הסימבול" ? settlement_as_close.inherit : settlement_as_close.off

s1 = ticker.modify(sym1, backadjustment = bAdj, settlement_as_close = bSet)
s2 = ticker.modify(sym2, backadjustment = bAdj, settlement_as_close = bSet)
s3 = ticker.modify(sym3, backadjustment = bAdj, settlement_as_close = bSet)
// נכס 4 כבוי = הבקשות שלו זהות לנכס 3, ולכן לא עולות כלום
s4 = ticker.modify(use4 ? sym4 : sym3, backadjustment = bAdj, settlement_as_close = bSet)

// ═══════════════════════════════════════════════════════════════════
// זיהוי Timeframe
// ═══════════════════════════════════════════════════════════════════

// 1 = 1m · 2 = 5m · 3 = 15m · 4 = 1H · 5 = 4H · 6 = יומי · 7 = שבועי · 8 = חודשי
tfMin   = timeframe.in_seconds() / 60
tfClass = tfMin <= 1 ? 1 : tfMin <= 5 ? 2 : tfMin <= 15 ? 3 : tfMin <= 60 ? 4 : tfMin <= 240 ? 5 : tfMin <= 1440 ? 6 : tfMin <= 10080 ? 7 : tfMin <= 44640 ? 8 : 0

// ═══════════════════════════════════════════════════════════════════
// חישובי זמן EST
// ═══════════════════════════════════════════════════════════════════

TZ = "America/New_York"
estHour = hour(time, TZ)
estMin  = minute(time, TZ)

minutesOfDay = estHour * 60 + estMin

isPostOpen       = minutesOfDay >= 1080
minsFromDayStart = isPostOpen ? minutesOfDay - 1080 : minutesOfDay + 360

tradeDayTime = isPostOpen ? time + 86400000 : time
tdYear = year(tradeDayTime, TZ)
tdMon  = month(tradeDayTime, TZ)
tdDom  = dayofmonth(tradeDayTime, TZ)
tdDow  = dayofweek(tradeDayTime, TZ)

sessionIdx    = math.floor(minsFromDayStart / 360)
minsInSession = minsFromDayStart % 360
microIdx      = math.floor(minsInSession / 90)
minsInMicro   = minsInSession % 90
quarterIdx    = math.floor(minsInMicro / 22.5)

// ═══════════════════════════════════════════════════════════════════
// מספור שבועות לפי QT
// ═══════════════════════════════════════════════════════════════════

daysSinceMonday = tdDow == dayofweek.sunday ? 6 : tdDow - 2
mondayTime      = tradeDayTime - daysSinceMonday * 86400000
tuesdayTime     = mondayTime + 86400000
thursdayTime    = mondayTime + 3 * 86400000

monMonth = month(mondayTime, TZ)
monDom   = dayofmonth(mondayTime, TZ)
monYear  = year(mondayTime, TZ)
tueMonth = month(tuesdayTime, TZ)
tueDom   = dayofmonth(tuesdayTime, TZ)
tueYear  = year(tuesdayTime, TZ)
thuMonth = month(thursdayTime, TZ)

// שבוע שייך לחודש שבו נמצאים לפחות 4 מתוך 5 ימי המסחר שלו — העוגן הוא יום
// שלישי. שלישי וחמישי בחודשים שונים = שבוע מת.
isDeadWeek = tueMonth != thuMonth
qtWeekNum  = isDeadWeek ? 0 : math.floor((tueDom - 1) / 7) + 1
// ספר החוקים §1–2: שבוע 5 לא נכנס למחזור ה-4H, בדיוק כמו שבוע מת
isWeek5    = qtWeekNum == 5
isOwnWeek  = isDeadWeek or isWeek5

// ═══════════════════════════════════════════════════════════════════
// מזהי מחזורים
// ═══════════════════════════════════════════════════════════════════

tradeDayId = tdYear * 10000 + tdMon * 100 + tdDom
// weekId הוא רק מזהה ייחודי לשבוע, ולכן יום שני מספיק לו.
weekId     = monYear * 10000 + monMonth * 100 + monDom
// המיכל החודשי — לפי יום שלישי. שבוע מת ושבוע 5 הם מיכל בפני עצמם.
monthId    = isOwnWeek ? weekId : tueYear * 100 + tueMonth
sessionId  = tradeDayId * 10 + sessionIdx
microId    = sessionId * 10 + microIdx
quarterId  = microId * 10 + quarterIdx

// כמה ימים יש בחודש — כולל שנה מעוברת לפי הכלל המלא
f_dim(int y, int m) =>
    m == 2 ? (((y % 4 == 0 and y % 100 != 0) or y % 400 == 0) ? 29 : 28) : (m == 4 or m == 6 or m == 9 or m == 11 ? 30 : 31)

// רבעון = שלושה חודשים קלנדריים. שנת QT מתחילה באפריל — המיכל של הגרף
// השבועי (§3). מחזור 4 שנים = שנים קלנדריות, 2023–2026, 2027–2030 (§4).
qOfYear  = int(math.ceil(tdMon / 3.0))
qtrId    = tdYear * 10 + qOfYear
yearId   = tdYear
qtYearId = tdMon >= 4 ? tdYear : tdYear - 1
quadId   = int(math.floor((tdYear - 2023) / 4.0))

// ── רבע-רבעון — תת-המחזור של הגרף היומי ──
// אורך הרבעון בפועל (90–92 יום) חלקי ארבע, בימי לוח שלמים מתוך התאריך.
qStartMon = (qOfYear - 1) * 3 + 1
qLenD     = f_dim(tdYear, qStartMon) + f_dim(tdYear, qStartMon + 1) + f_dim(tdYear, qStartMon + 2)
qDayInQ   = (tdDom - 1) + (tdMon > qStartMon ? f_dim(tdYear, qStartMon) : 0) + (tdMon > qStartMon + 1 ? f_dim(tdYear, qStartMon + 1) : 0)
qqIdx     = math.min(3, math.max(0, int(math.floor(qDayInQ * 4.0 / qLenD))))
qqId      = qtrId * 10 + qqIdx

refCycleId  = tfClass == 8 ? yearId : tfClass == 7 ? qtrId : tfClass == 6 ? qqId : tfClass == 5 ? weekId : tfClass == 4 ? tradeDayId : tfClass == 3 ? sessionId : tfClass == 2 ? microId : tfClass == 1 ? quarterId : 0
lifeCycleId = tfClass == 8 ? quadId : tfClass == 7 ? qtYearId : tfClass == 6 ? qtrId : tfClass == 5 ? monthId : tfClass == 4 ? weekId : tfClass == 3 ? tradeDayId : tfClass == 2 ? sessionId : tfClass == 1 ? microId : 0

newRefCycle  = ta.change(refCycleId)  != 0
newLifeCycle = ta.change(lifeCycleId) != 0

// "זרע": התת-מחזור הראשון של מיכל חדש משווה גם לגאפים של התת-מחזור האחרון
// של המיכל הקודם, והזרע נמחק כשהתת-מחזור הראשון נגמר.
// **רק ב-1M, 5M ו-1H** (שני מול שישי).
keepLast = tfClass <= 2 or tfClass == 4

// ═══════════════════════════════════════════════════════════════════
// נתוני ארבעת הנכסים במסגרת הגרף — כל המדידות מכאן, אף פעם לא מהגרף
// ═══════════════════════════════════════════════════════════════════

[a1O, a1H, a1L, a1C, tk1] = request.security(s1, timeframe.period, [open, high, low, close, syminfo.mintick], lookahead = barmerge.lookahead_off)
[a2O, a2H, a2L, a2C, tk2] = request.security(s2, timeframe.period, [open, high, low, close, syminfo.mintick], lookahead = barmerge.lookahead_off)
[a3O, a3H, a3L, a3C, tk3] = request.security(s3, timeframe.period, [open, high, low, close, syminfo.mintick], lookahead = barmerge.lookahead_off)
[a4O, a4H, a4L, a4C, tk4] = request.security(s4, timeframe.period, [open, high, low, close, syminfo.mintick], lookahead = barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════
// טיפוס הגאפ הקולקטיבי
//
// שלוש משבצות a·b·c. בשלישייה: a = נכס 1, b = נכס 2, c = נכס 3.
// בזוג: a = נכס 3, b = נכס 4, ו-c ריק. גבול na = לנכס הזה אין את הגאפ.
// a ו-b תמיד הורגים את הגאפ ב-IFVG; c (החלש) רק יוצא ממנו.
// ═══════════════════════════════════════════════════════════════════

type Gap
    int    id
    int    kind     // 0 = שלישייה · 1 = זוג 3·4
    int    dir      // 1 = שורי (יושב מתחת למחיר), -1 = דובי
    float  aBot
    float  aTop
    float  bBot
    float  bTop
    float  cBot
    float  cTop
    // תת-המחזור של **הנר האמצעי** — הנר שיצר את חוסר האיזון
    int    refId
    int    birth    // הנר השלישי — מונע IFVG על נר הלידה
    int    birthT   // זמן הפתיחה של הנר האמצעי
    int    origin   // הנר הראשון של ה-FVG — משם מתחילה הקופסה
    float  aExt     // הקיצוניות בביקור הנוכחי (min ל-bull, max ל-bear)
    float  bExt
    float  cExt
    int    visits   = 0
    bool   inVisit  = false
    bool   dead     = false   // הפך ל-IFVG
    bool   armed    = false   // תת-המחזור שבו נולד הסתיים
    int    fDeg     = 0       // 0 = אין שבירה. 1..3
    string fLead    = ""      // המשתתפים לפי סדר עומק
    int    fSigB    = 0       // הנר שבו נרשמה
    int    fSeq     = 0       // מונה רץ — הגבוה ביותר הוא העדכני
    float  fYPos              // גובה התווית
    float  drwBot             // גבולות לציור בלבד, בסקאלה של הגרף
    float  drwTop
    bool   volImb   = false   // כל הרגליים הן VI
    // תיקון באותו ביקור: fVis = הביקור שבו נרשמה/עלתה, fPrev = הדרגה מקודם
    int    fVis     = 0
    int    fPrev    = 0
    int    fTime    = 0       // זמן הפתיחה של הנר שרשם את השבירה

var array<Gap> gaps = array.new<Gap>()
var int gapCounter  = 0

// גאפ של הגרף עצמו (לא קורלטיבי) — לתצוגה בלבד
type OwnGap
    int    dir
    float  bot
    float  top
    int    refId
    int    birthT
    int    origin
    bool   armed
    bool   volImb
    int    collId   // הגאפ הקולקטיבי שנולד איתו באותו נר, 0 = אין

var array<OwnGap> owns = array.new<OwnGap>()

f_newGap(int id, int kind, int d, float ab, float at, float bb, float bt, float cb, float ct, int ref, int birth, int birthT, int origin, float dB, float dT, bool vi) =>
    Gap.new(id = id, kind = kind, dir = d, aBot = ab, aTop = at, bBot = bb, bTop = bt, cBot = cb, cTop = ct, refId = ref, birth = birth, birthT = birthT, origin = origin, aExt = d == 1 ? at : ab, bExt = d == 1 ? bt : bb, cExt = d == 1 ? ct : cb, drwBot = dB, drwTop = dT, volImb = vi)

// ── הרשימה מלאה: מי יוצא ──
// לפי ערך, לא לפי גיל: הישן ביותר שמת ב-IFVG, אחר כך הישן ביותר בלי שבירה,
// ורק אם לכולם יש שבירה חיה — הישן ביותר.
f_trim(array<Gap> a) =>
    if array.size(a) > maxGaps
        int kDead = -1
        int kFree = -1
        for i = 0 to array.size(a) - 1
            Gap gx = array.get(a, i)
            if kDead == -1 and gx.dead
                kDead := i
            if kFree == -1 and not gx.dead and gx.fDeg == 0
                kFree := i
        array.remove(a, kDead != -1 ? kDead : kFree != -1 ? kFree : 0)

// שם הנכס שיושב במשבצת
f_slotName(int kind, int a) =>
    kind == 0 ? (a == 0 ? nm1 : a == 1 ? nm2 : nm3) : (a == 0 ? nm3 : nm4)

// עומק החדירה של משבצת לתוך הגאפ שלה, כאחוז מהגאפ שלה (פתיל).
// 0 = לא נגע · 0.5 = CE · 1.0 = הקצה הרחוק · na = לא משתתף.
method depthOf(Gap g, int a) =>
    float top = a == 0 ? g.aTop : a == 1 ? g.bTop : g.cTop
    float bot = a == 0 ? g.aBot : a == 1 ? g.bBot : g.cBot
    float ext = a == 0 ? g.aExt : a == 1 ? g.bExt : g.cExt
    float d = na
    if not na(top) and not na(ext) and top - bot > 0
        d := g.dir == 1 ? (top - ext) / (top - bot) : (ext - bot) / (top - bot)
        d := math.max(d, 0.0)
    d

// המוביל — העמוק ביותר. בשלישייה, בגאפ שורי, נכס 3 פסול לתפקיד.
method leadIdx(Gap g) =>
    int   best = -1
    float bd   = -1.0
    for a = 0 to 2
        if not (g.kind == 0 and g.dir == 1 and a == 2)
            float d = g.depthOf(a)
            if not na(d) and d > bd
                bd   := d
                best := a
    best

// המפגר — הרדוד ביותר. בשלישייה, בגאפ דובי, נכס 3 פסול לתפקיד.
method lagIdx(Gap g) =>
    int   worst = -1
    float wd    = 1e12
    for a = 0 to 2
        if not (g.kind == 0 and g.dir == -1 and a == 2)
            float d = g.depthOf(a)
            if not na(d) and d < wd
                wd    := d
                worst := a
    worst

// דרגת השבירה — הגבוהה ביותר שמתקיימת. 0 = אין שבירה.
f_degree(float dLead, float dLag) =>
    int deg = 0
    if dLead >= 1.0 and dLag < 1.0
        deg := 3
    else if dLead >= 0.5 and dLag < 0.5
        deg := 2
    else if dLead > 0.0 and dLag <= 0.0
        deg := 1
    deg

f_degTxt(int d) =>
    "F" + str.tostring(d)

method fracDeg(Gap g) =>
    int li = g.leadIdx()
    int gi = g.lagIdx()
    int deg = 0
    if li != -1 and gi != -1 and li != gi
        deg := f_degree(g.depthOf(li), g.depthOf(gi))
    deg

// "NQ+ES" / "NQ+ES+YM" / "YM+RTY" — המוביל ראשון, המפגר אחרון
method fracTxt(Gap g) =>
    int li = g.leadIdx()
    int gi = g.lagIdx()
    string t = ""
    if li != -1 and gi != -1 and li != gi
        t := f_slotName(g.kind, li)
        for a = 0 to 2
            if a != li and a != gi and not na(g.depthOf(a))
                t := t + "+" + f_slotName(g.kind, a)
        t := t + "+" + f_slotName(g.kind, gi)
    t

// מי משתתף — "ALL" כשכל שלושת נכסי השלישייה, אחרת השמות
f_legsTxt(Gap g) =>
    bool a = not na(g.aTop)
    bool b = not na(g.bTop)
    bool c = not na(g.cTop)
    string na1 = f_slotName(g.kind, 0)
    string na2 = f_slotName(g.kind, 1)
    string na3 = f_slotName(g.kind, 2)
    a and b and c ? "ALL" : (a ? na1 : "") + (a and (b or c) ? "+" : "") + (b ? na2 : "") + (b and c ? "+" : "") + (c ? na3 : "")

// שם המסגרת. החודשי הוא "Mo" כדי שלא יתבלבל עם "1m".
f_clsName(int c) =>
    c == 8 ? "Mo" : c == 7 ? "1W" : c == 6 ? "1D" : c == 5 ? "4H" : c == 4 ? "1H" : c == 3 ? "15m" : c == 2 ? "5m" : c == 1 ? "1m" : "?"

// שם קצר לתת-המחזור שבו נולד הגאפ — באנגלית בכוונה, כי עברית בתוך קופסה
// יוצאת הפוכה.
f_subName(int c, int t) =>
    int  eh   = hour(t, TZ)
    int  mnd  = eh * 60 + minute(t, TZ)
    bool post = mnd >= 1080
    int  tdt  = post ? t + 86400000 : t
    int  mfd  = post ? mnd - 1080 : mnd + 360
    int  sIdx = math.floor(mfd / 360)
    int  mInS = mfd % 360
    int  uIdx = math.floor(mInS / 90)
    int  qIdx = math.floor((mInS % 90) / 22.5)
    int  dw   = dayofweek(tdt, TZ)
    int  yy   = year(tdt, TZ)
    int  mm   = month(tdt, TZ)
    int  dd   = dayofmonth(tdt, TZ)
    string ss = sIdx == 0 ? "Asia" : sIdx == 1 ? "London" : sIdx == 2 ? "AM" : "PM"
    string dn = dw == dayofweek.monday ? "Mon" : dw == dayofweek.tuesday ? "Tue" : dw == dayofweek.wednesday ? "Wed" : dw == dayofweek.thursday ? "Thu" : dw == dayofweek.friday ? "Fri" : "WE"
    string r  = ""
    if c == 1
        r := ss + " " + str.tostring(uIdx + 1) + "." + str.tostring(qIdx + 1)
    else if c == 2
        r := ss + " " + str.tostring(uIdx + 1)
    else if c == 3
        r := ss
    else if c == 4
        r := dn
    else if c == 5
        int dsm  = dw == dayofweek.sunday ? 6 : dw - 2
        int tueT = tdt - dsm * 86400000 + 86400000
        r := "W" + str.tostring(math.floor((dayofmonth(tueT, TZ) - 1) / 7) + 1)
    else if c == 6
        int qOf  = int(math.ceil(mm / 3.0))
        int qsM  = (qOf - 1) * 3 + 1
        int qLn  = f_dim(yy, qsM) + f_dim(yy, qsM + 1) + f_dim(yy, qsM + 2)
        int qDiQ = (dd - 1) + (mm > qsM ? f_dim(yy, qsM) : 0) + (mm > qsM + 1 ? f_dim(yy, qsM + 1) : 0)
        r := "QQ" + str.tostring(math.min(3, math.max(0, int(math.floor(qDiQ * 4.0 / qLn)))) + 1)
    else if c == 7
        r := "Q" + str.tostring(int(math.ceil(mm / 3.0)))
    else if c == 8
        r := str.tostring(yy)
    r

// מתי הגאפ נוצר, בשעון ניו יורק
f_bornTxt(int c, int t) =>
    c <= 4 ? str.format_time(t, "HH:mm", TZ) : c == 5 ? str.format_time(t, "dd/MM HH:mm", TZ) : str.format_time(t, "dd/MM", TZ)

// ═══════════════════════════════════════════════════════════════════
// רגל אחת — הגאפ של נכס אחד בכיוון אחד, בנר הנוכחי
//
// נרות: 1 = (o2,h2,l2,c2) · 2 = (o1,c1) · 3 = (o0,h0,l0,c0)
// שלושה מתגים נפרדים:
//   fvgOn        — FVG של שלושה נרות, בגבולות הפתילים.
//   volImbOn     — VI בין נר 2 לנר 3 כגאפ בפני עצמו (מ-viMinTicks). **רצף**:
//                  שני הנרות לכיוון הרווח, אלא אם הנר פותח תת-מחזור (edge).
//   extendBodies — הרחבת FVG: לגוף בשני הצדדים (מ-viMergeTicks), VI בין נר 1
//                  לנר 2, ו-VI בין נר 2 לנר 3 שמתאחד איתו. כבוי = אין הרחבה.
// מחזיר [תחתון, עליון, FVG?, הרחבת-VI?, VI-לבד?]. עליון na = אין רגל.
// אותה פונקציה לגרף, למנועים, לגבולות הציור ולגאפים של הגרף — כך הם זהים.
// ═══════════════════════════════════════════════════════════════════

f_leg(int d, bool ok, float o0, float h0, float l0, float c0, float o1, float c1, float h2, float l2, float c2, float o2, float tk, bool edge) =>
    float b  = na
    float t  = na
    int   ti = math.round(math.abs(o0 - c1) / tk)
    int   pi = math.round(math.abs(o1 - c2) / tk)
    bool  f  = fvgOn and ok and (d == 1 ? l0 > h2 : h0 < l2)
    // רווח סגירה/פתיחה בין נר 2 לנר 3, ברצף (או בנר שפותח תת-מחזור)
    bool  r  = ok and (d == 1 ? (o0 > c1 and (edge or (c1 > o1 and c0 > o0))) : (o0 < c1 and (edge or (c1 < o1 and c0 < o0))))
    // הרחבות — רק כשההרחבה דלוקה
    bool  m  = extendBodies and r and ti >= viMergeTicks
    bool  p  = extendBodies and pi >= viMergeTicks and (d == 1 ? (o1 > c2 and c2 > o2 and c1 > o1) : (o1 < c2 and c2 < o2 and c1 < o1))
    // VI כגאפ בפני עצמו — רק כש-VI דלוק
    bool  v  = volImbOn and r and ti >= viMinTicks
    if f
        if d == 1
            b := (extendBodies and o1 > h2 and pi >= viMergeTicks) ? c2 : h2
            t := (extendBodies and l0 > c1 and ti >= viMergeTicks) ? o0 : l0
            if p
                b := math.min(b, c2)
        else
            t := (extendBodies and o1 < l2 and pi >= viMergeTicks) ? c2 : l2
            b := (extendBodies and h0 < c1 and ti >= viMergeTicks) ? o0 : h0
            if p
                t := math.max(t, c2)
    // VI מתאחד עם FVG רק כשההרחבה דלוקה. בלי הרחבה — FVG נשאר בגבולות
    // הפתילים, ו-VI נספר רק כשאין FVG באותו נכס.
    if (f and m) or (v and (not f or extendBodies))
        if d == 1
            b := na(b) ? c1 : math.min(b, c1)
            t := na(t) ? o0 : math.max(t, o0)
        else
            t := na(t) ? c1 : math.max(t, c1)
            b := na(b) ? o0 : math.min(b, o0)
    [b, t, f, m, v]

// הרגליים של ארבעת הנכסים בשני הכיוונים יושבות במערכים, אינדקס = נכס*2 +
// (0 שורי / 1 דובי). מכאן נבנה הגאפ של קבוצה: שלישייה (kind 0) או זוג (1).
// מחזיר [כיוון, aBot, aTop, bBot, bTop, cBot, cTop, anyFvg, anyVi].
f_group(int kind, array<float> LB, array<float> LT, array<bool> LF, array<bool> LM) =>
    int  sa   = kind == 0 ? 0 : 2
    int  sb   = kind == 0 ? 1 : 3
    bool hasC = kind == 0 and use3
    bool act  = kind == 0 or use4
    int  cU   = (na(array.get(LT, sa * 2)) ? 0 : 1) + (na(array.get(LT, sb * 2)) ? 0 : 1) + ((hasC and not na(array.get(LT, 4))) ? 1 : 0)
    int  cD   = (na(array.get(LT, sa * 2 + 1)) ? 0 : 1) + (na(array.get(LT, sb * 2 + 1)) ? 0 : 1) + ((hasC and not na(array.get(LT, 5))) ? 1 : 0)
    int  d    = not act ? 0 : cU >= 2 ? 1 : cD >= 2 ? -1 : 0
    int  di   = d == 1 ? 0 : 1
    float ab  = array.get(LB, sa * 2 + di)
    float at  = array.get(LT, sa * 2 + di)
    float bb  = array.get(LB, sb * 2 + di)
    float bt  = array.get(LT, sb * 2 + di)
    float cb  = hasC ? array.get(LB, 4 + di) : na
    float ct  = hasC ? array.get(LT, 4 + di) : na
    bool anyF = (not na(at) and array.get(LF, sa * 2 + di)) or (not na(bt) and array.get(LF, sb * 2 + di)) or (not na(ct) and array.get(LF, 4 + di))
    bool anyV = (not na(at) and array.get(LM, sa * 2 + di)) or (not na(bt) and array.get(LM, sb * 2 + di)) or (not na(ct) and array.get(LM, 4 + di))
    [d, ab, at, bb, bt, cb, ct, anyF, anyV]

// ── דריכה · מדידת ביקור · IFVG — אותו דבר בגרף ובמנועים ──
// דריכה: גאפ זמין לשבירה רק אחרי שתת-המחזור שבו נולד הסתיים.
// ביקור: כשאף משבצת לא נוגעת בגאפ — הביקור נגמר והעומקים מתאפסים.
// IFVG: סגירה של a או b מעבר לגאפ הורגת אותו. c (החלש בשלישייה) רק יוצא.
// נכס בלי נתון בנר הזה (דקה בלי עסקאות) — לא משנה כלום: לא נכנס, לא מזיז
// את הקיצון ולא הורג.
// מחזיר true כשהמשבצת c יצאה עכשיו מהגאפ.
method track(Gap g, int rf, float hA, float lA, float cA, float hB, float lB, float cB, float hC, float lC, float cC, bool canKill) =>
    bool cOut = false
    if not g.dead
        if not g.armed and g.refId != rf
            g.armed := true
        if g.armed
            bool pA = not na(hA) and not na(lA)
            bool pB = not na(hB) and not na(lB)
            bool pC = not na(hC) and not na(lC)
            bool outA = na(g.aTop) or not pA or (g.dir == 1 ? lA > g.aTop : hA < g.aBot)
            bool outB = na(g.bTop) or not pB or (g.dir == 1 ? lB > g.bTop : hB < g.bBot)
            bool outC = na(g.cTop) or not pC or (g.dir == 1 ? lC > g.cTop : hC < g.cBot)
            if outA and outB and outC
                g.inVisit := false
                g.aExt    := g.dir == 1 ? g.aTop : g.aBot
                g.bExt    := g.dir == 1 ? g.bTop : g.bBot
                g.cExt    := g.dir == 1 ? g.cTop : g.cBot
            else
                if not g.inVisit
                    g.inVisit := true
                    g.visits  := g.visits + 1
                if g.dir == 1
                    if not na(g.aTop) and pA
                        g.aExt := math.min(g.aExt, lA)
                    if not na(g.bTop) and pB
                        g.bExt := math.min(g.bExt, lB)
                    if not na(g.cTop) and pC
                        g.cExt := math.min(g.cExt, lC)
                else
                    if not na(g.aTop) and pA
                        g.aExt := math.max(g.aExt, hA)
                    if not na(g.bTop) and pB
                        g.bExt := math.max(g.bExt, hB)
                    if not na(g.cTop) and pC
                        g.cExt := math.max(g.cExt, hC)
        if canKill
            if g.dir == 1
                if (not na(g.aBot) and not na(cA) and cA < g.aBot) or (not na(g.bBot) and not na(cB) and cB < g.bBot)
                    g.dead := true
            else
                if (not na(g.aTop) and not na(cA) and cA > g.aTop) or (not na(g.bTop) and not na(cB) and cB > g.bTop)
                    g.dead := true
            if not g.dead and not na(g.cTop) and not na(cC) and (g.dir == 1 ? cC < g.cBot : cC > g.cTop)
                g.cBot := na
                g.cTop := na
                g.cExt := na
                cOut   := true
    cOut

// ── רישום שבירה ──
// נרשמת כשהדרגה עולה. **תיקון באותו ביקור**: אם המפגר משלים לפני שהביקור
// נגמר, השבירה של הביקור הזה מתבטלת וחוזרים לדרגה שהייתה לפניו (fPrev).
// התיקון רץ גם כשהרישום חסום. מחזיר true כשנרשמה שבירה או עלתה דרגה.
method register(Gap g, bool canReg) =>
    bool fired = false
    if not g.dead and g.armed
        int deg = g.fracDeg()
        if canReg and deg > g.fDeg
            if g.fVis != g.visits
                g.fPrev := g.fDeg
                g.fVis  := g.visits
            g.fSigB := bar_index
            g.fDeg  := deg
            g.fLead := g.fracTxt()
            fired   := true
        else if g.inVisit and g.fVis == g.visits and deg < g.fDeg
            g.fDeg := math.max(deg, g.fPrev)
            if deg > 0 and deg >= g.fPrev
                g.fLead := g.fracTxt()
    fired

// השבירה העדכנית של כל קבוצה בנפרד — [שלישייה, זוג], -1 = אין
f_sel2(array<Gap> a) =>
    int iT = -1
    int sT = -1
    int iP = -1
    int sP = -1
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            Gap g = array.get(a, i)
            if not g.dead and g.fDeg > 0
                if g.kind == 0 and g.fSeq > sT
                    sT := g.fSeq
                    iT := i
                if g.kind == 1 and g.fSeq > sP
                    sP := g.fSeq
                    iP := i
    [iT, iP]

// ═══════════════════════════════════════════════════════════════════
// מנוע עצמאי למסגרת זמן אחרת — אותם חוקים בדיוק כמו הגרף הראשי
//
// כל נר שנסגר במסגרת שלו מוזן אחד-אחד (f_pushLtf), והמנוע מחזיק בעצמו את
// שני הנרות הקודמים. לצעד כל נכס מגיע כמערך של עשרה מספרים:
//   [0]=open0 [1]=high0 [2]=low0 [3]=close0 [4]=open1 [5]=close1
//   [6]=high2 [7]=low2  [8]=close2 [9]=open2
// ═══════════════════════════════════════════════════════════════════

type Engine
    int          cls                // מחלקת מסגרת הזמן (1..8)
    array<Gap>   gaps
    array<float> h1                 // שני הנרות הקודמים של כל נכס — רק למסלול הנמוך
    array<float> h2
    array<float> h3
    array<float> h4
    int          gapCounter = 0
    int          seqCounter = 0
    bool         seedActive = false
    int          seedRefId  = 0
    int          refId      = 0
    int          lifeId     = 0
    bool         started    = false
    int          lastT      = 0
    int          curRef     = 0     // המחזורים של הנר הנוכחי, נכתבים ע"י f_setCycles
    int          curLife    = 0
    bool         curDead    = false
    int          curDow     = 0
    int          curWk      = 0
    int          fDir       = 0     // השבירה המוצגת — שלישייה
    int          fDeg       = 0
    string       fLead      = ""
    int          fT         = 0     // שעת השבירה ומספר הרישום שלה — לפינה
    int          fSq        = 0
    int          pDir       = 0     // השבירה המוצגת — זוג 3·4, בנפרד
    int          pDeg       = 0
    string       pLead      = ""
    int          pT         = 0
    int          pSq        = 0
    bool         justFired  = false // נרשמה שבירת שלישייה בנר הגרף הזה
    int          jDir       = 0
    int          jDeg       = 0
    string       jLead      = ""
    int          jT         = 0
    int          jSq        = 0
    bool         pFired     = false // נרשמה שבירת זוג בנר הגרף הזה
    int          pjDir      = 0
    int          pjDeg      = 0
    string       pjLead     = ""
    int          pjT        = 0
    int          pjSq       = 0

// כל מזהי המחזורים מתוך חותמת זמן, נכתבים לתוך המנוע. זהה לחישוב של הגרף.
f_setCycles(Engine e, int t) =>
    int  c    = e.cls
    int  eh   = hour(t, TZ)
    int  em   = minute(t, TZ)
    int  mnd  = eh * 60 + em
    bool post = mnd >= 1080
    int  tdt  = post ? t + 86400000 : t
    int  yy   = year(tdt, TZ)
    int  mm   = month(tdt, TZ)
    int  dd   = dayofmonth(tdt, TZ)
    int  dw   = dayofweek(tdt, TZ)
    int  mfd  = post ? mnd - 1080 : mnd + 360
    int  sIdx = math.floor(mfd / 360)
    int  mInS = mfd % 360
    int  uIdx = math.floor(mInS / 90)
    int  mInU = mInS % 90
    int  qIdx = math.floor(mInU / 22.5)
    int  dsm  = dw == dayofweek.sunday ? 6 : dw - 2
    int  monT = tdt - dsm * 86400000
    int  tueT = monT + 86400000
    int  thuT = monT + 3 * 86400000
    int  moM  = month(monT, TZ)
    int  moD  = dayofmonth(monT, TZ)
    int  moY  = year(monT, TZ)
    int  tuM  = month(tueT, TZ)
    int  tuY  = year(tueT, TZ)
    bool dead = tuM != month(thuT, TZ)
    int  wkN  = dead ? 0 : int(math.floor((dayofmonth(tueT, TZ) - 1) / 7)) + 1
    int  tdId = yy * 10000 + mm * 100 + dd
    int  wkId = moY * 10000 + moM * 100 + moD
    int  mnId = dead or wkN == 5 ? wkId : tuY * 100 + tuM
    int  ssId = tdId * 10 + sIdx
    int  ucId = ssId * 10 + uIdx
    int  qrId = ucId * 10 + qIdx
    int  qOf  = int(math.ceil(mm / 3.0))
    int  qtId = yy * 10 + qOf
    int  qtYr = mm >= 4 ? yy : yy - 1
    int  qdId = int(math.floor((yy - 2023) / 4.0))
    int  qsM  = (qOf - 1) * 3 + 1
    int  qLn  = f_dim(yy, qsM) + f_dim(yy, qsM + 1) + f_dim(yy, qsM + 2)
    int  qDiQ = (dd - 1) + (mm > qsM ? f_dim(yy, qsM) : 0) + (mm > qsM + 1 ? f_dim(yy, qsM + 1) : 0)
    int  qqIx = math.min(3, math.max(0, int(math.floor(qDiQ * 4.0 / qLn))))
    int  qqId = qtId * 10 + qqIx
    int  rf   = c == 8 ? yy   : c == 7 ? qtId : c == 6 ? qqId : c == 5 ? wkId : c == 4 ? tdId : c == 3 ? ssId : c == 2 ? ucId : qrId
    int  lf   = c == 8 ? qdId : c == 7 ? qtYr : c == 6 ? qtId : c == 5 ? mnId : c == 4 ? wkId : c == 3 ? tdId : c == 2 ? ssId : ucId
    e.curRef  := rf
    e.curLife := lf
    e.curDead := dead
    e.curDow  := dw
    e.curWk   := wkN
    rf

// המיכל בלבד, בלי לגעת במנוע — לבדיקת פג-תוקף מול השעון של הגרף.
// **חייב להיות זהה ל-lf של f_setCycles.**
f_lifeId(int c, int t) =>
    int  eh   = hour(t, TZ)
    int  em   = minute(t, TZ)
    int  mnd  = eh * 60 + em
    bool post = mnd >= 1080
    int  tdt  = post ? t + 86400000 : t
    int  yy   = year(tdt, TZ)
    int  mm   = month(tdt, TZ)
    int  dd   = dayofmonth(tdt, TZ)
    int  dw   = dayofweek(tdt, TZ)
    int  mfd  = post ? mnd - 1080 : mnd + 360
    int  sIdx = math.floor(mfd / 360)
    int  uIdx = math.floor((mfd % 360) / 90)
    int  dsm  = dw == dayofweek.sunday ? 6 : dw - 2
    int  monT = tdt - dsm * 86400000
    int  tueT = monT + 86400000
    int  thuT = monT + 3 * 86400000
    int  tdId = yy * 10000 + mm * 100 + dd
    int  wkId = year(monT, TZ) * 10000 + month(monT, TZ) * 100 + dayofmonth(monT, TZ)
    bool dead = month(tueT, TZ) != month(thuT, TZ)
    bool wk5  = not dead and dayofmonth(tueT, TZ) >= 29
    int  mnId = dead or wk5 ? wkId : year(tueT, TZ) * 100 + month(tueT, TZ)
    int  ssId = tdId * 10 + sIdx
    int  ucId = ssId * 10 + uIdx
    int  qdId = int(math.floor((yy - 2023) / 4.0))
    int  qtYr = mm >= 4 ? yy : yy - 1
    c == 8 ? qdId : c == 7 ? qtYr : c == 6 ? yy * 10 + int(math.ceil(mm / 3.0)) : c == 5 ? mnId : c == 4 ? wkId : c == 3 ? tdId : c == 2 ? ssId : ucId

// רגל של נכס מתוך המערך שלו
f_legA(int d, array<float> q, float tk, bool edge, bool use) =>
    bool ok = use and not na(array.get(q, 6)) and not na(array.get(q, 4)) and not na(array.get(q, 3))
    [lb, lt, lf, lm, lv] = f_leg(d, ok, array.get(q, 0), array.get(q, 1), array.get(q, 2), array.get(q, 3), array.get(q, 4), array.get(q, 5), array.get(q, 6), array.get(q, 7), array.get(q, 8), array.get(q, 9), tk, edge)
    [lb, lt, lf, lm, lv]

// צעד אחד של המנוע
f_step(Engine e, int tOpen, array<float> q1, array<float> q2, array<float> q3, array<float> q4) =>
    float x1 = array.get(q1, 3)
    float x2 = array.get(q2, 3)
    if not na(tOpen) and tOpen != e.lastT and (not na(x1) or not na(x2))
        // הצעד הקודם עיבד את הנר שהוא כאן הנר האמצעי — ממנו נקבע תת-המחזור
        int  tMid  = e.lastT
        int  rfMid = tMid == 0 ? 0 : f_setCycles(e, tMid)
        e.lastT := tOpen
        f_setCycles(e, tOpen)
        int  rf    = e.curRef
        int  lf    = e.curLife
        bool deadW = e.curDead
        int  dow   = e.curDow

        // ── החלפת מיכל + זרע — זהה לגרף ──
        bool keepL   = e.cls <= 2 or e.cls == 4
        bool newLife = e.started and lf != e.lifeId
        bool newRef  = e.started and rf != e.refId
        int  prevRef = e.refId
        if newLife
            if keepL
                if array.size(e.gaps) > 0
                    for i = array.size(e.gaps) - 1 to 0
                        if array.get(e.gaps, i).refId != prevRef
                            array.remove(e.gaps, i)
                if array.size(e.gaps) > 0
                    for i = 0 to array.size(e.gaps) - 1
                        Gap gc = array.get(e.gaps, i)
                        gc.fDeg  := 0
                        gc.fPrev := 0
                e.seedRefId  := prevRef
                e.seedActive := array.size(e.gaps) > 0
            else
                array.clear(e.gaps)
                e.seedActive := false
        else if newRef and e.seedActive
            if array.size(e.gaps) > 0
                for i = array.size(e.gaps) - 1 to 0
                    if array.get(e.gaps, i).refId == e.seedRefId
                        array.remove(e.gaps, i)
            e.seedActive := false
        e.refId   := rf
        e.lifeId  := lf
        e.started := true

        // ── דריכה · ביקור · IFVG ──
        if array.size(e.gaps) > 0
            for i = 0 to array.size(e.gaps) - 1
                Gap gu = array.get(e.gaps, i)
                array<float> qa = gu.kind == 0 ? q1 : q3
                array<float> qb = gu.kind == 0 ? q2 : q4
                gu.track(rf, array.get(qa, 1), array.get(qa, 2), array.get(qa, 3), array.get(qb, 1), array.get(qb, 2), array.get(qb, 3), array.get(q3, 1), array.get(q3, 2), array.get(q3, 3), true)

        // ── זיהוי: שלישייה וזוג ──
        bool cycEdge = newRef
        [b1u, t1u, f1u, m1u, v1u] = f_legA(1, q1, tk1, cycEdge, true)
        [b1d, t1d, f1d, m1d, v1d] = f_legA(-1, q1, tk1, cycEdge, true)
        [b2u, t2u, f2u, m2u, v2u] = f_legA(1, q2, tk2, cycEdge, true)
        [b2d, t2d, f2d, m2d, v2d] = f_legA(-1, q2, tk2, cycEdge, true)
        [b3u, t3u, f3u, m3u, v3u] = f_legA(1, q3, tk3, cycEdge, true)
        [b3d, t3d, f3d, m3d, v3d] = f_legA(-1, q3, tk3, cycEdge, true)
        [b4u, t4u, f4u, m4u, v4u] = f_legA(1, q4, tk4, cycEdge, use4)
        [b4d, t4d, f4d, m4d, v4d] = f_legA(-1, q4, tk4, cycEdge, use4)
        array<float> LB = array.from(b1u, b1d, b2u, b2d, b3u, b3d, b4u, b4d)
        array<float> LT = array.from(t1u, t1d, t2u, t2d, t3u, t3d, t4u, t4d)
        array<bool>  LF = array.from(f1u, f1d, f2u, f2d, f3u, f3d, f4u, f4d)
        array<bool>  LM = array.from(m1u, m1d, m2u, m2d, m3u, m3d, m4u, m4d)
        for k = 0 to 1
            [d, ab, at, bb, bt, xb, xt, anyF, anyV] = f_group(k, LB, LT, LF, LM)
            if d != 0
                // FVG — לפי הנר האמצעי. גאפ שכולו VI, או גאפ מעבר — לפי הנר הנוכחי.
                bool tagNow = (cycEdge and anyV) or not anyF
                // מיכל חדש בלי זרע מתחיל נקי: FVG שהנר האמצעי שלו במיכל הקודם לא נכנס
                if not (newLife and not keepL and not tagNow)
                    e.gapCounter := e.gapCounter + 1
                    int  gRef   = tagNow ? rf : (rfMid == 0 ? rf : rfMid)
                    int  gWhen  = tagNow ? tOpen : (tMid == 0 ? tOpen : tMid)
                    array.push(e.gaps, f_newGap(e.gapCounter, k, d, ab, at, bb, bt, xb, xt, gRef, bar_index, gWhen, bar_index, na, na, not anyF))
                    f_trim(e.gaps)

        // ── רישום שבירות ──
        // 1H — שישי חסום תמיד. 4H — שישי חסום רק בשבוע 4; שבוע 5 ושבוע מת חסומים.
        bool blockDW  = e.cls == 5 and ((blockDeadWeek and deadW) or e.curWk == 5)
        bool blockFri = dow == dayofweek.friday and (e.cls == 4 or (e.cls == 5 and e.curWk == 4))
        bool canReg   = not blockDW and not blockFri
        if array.size(e.gaps) > 0
            for i = 0 to array.size(e.gaps) - 1
                Gap gr = array.get(e.gaps, i)
                if gr.register(canReg)
                    e.seqCounter := e.seqCounter + 1
                    gr.fSeq      := e.seqCounter
                    gr.fTime     := tOpen
                    if gr.kind == 0
                        e.justFired := true
                        e.jDir      := gr.dir
                        e.jDeg      := gr.fDeg
                        e.jLead     := gr.fLead
                        e.jT        := tOpen
                        e.jSq       := e.seqCounter
                    else
                        e.pFired    := true
                        e.pjDir     := gr.dir
                        e.pjDeg     := gr.fDeg
                        e.pjLead    := gr.fLead
                        e.pjT       := tOpen
                        e.pjSq      := e.seqCounter

        // ── השבירה המוצגת — שלישייה וזוג כל אחד בנפרד ──
        // שבירת הזוג חיה כל עוד YM/RTY לא הפכו את הגאפ שלהם ל-IFVG, בלי קשר
        // למה ש-NQ/ES עשו לגאפ של השלישייה.
        [sT, sP] = f_sel2(e.gaps)
        e.fDir  := 0
        e.fDeg  := 0
        e.fLead := ""
        e.pDir  := 0
        e.pDeg  := 0
        e.pLead := ""
        if sT != -1
            Gap gd = array.get(e.gaps, sT)
            e.fDir  := gd.dir
            e.fDeg  := gd.fDeg
            e.fLead := gd.fLead
            e.fT    := gd.fTime
            e.fSq   := gd.fSeq
        if sP != -1
            Gap gp = array.get(e.gaps, sP)
            e.pDir  := gp.dir
            e.pDeg  := gp.fDeg
            e.pLead := gp.fLead
            e.pT    := gp.fTime
            e.pSq   := gp.fSeq
    e.fDeg

// המנוע מחזיק בעצמו את שני הנרות הקודמים של כל נכס — מעל הגרף ומתחתיו.
f_hist(array<float> h, float o, float hi, float lo, float c) =>
    array.from(o, hi, lo, c, array.get(h, 0), array.get(h, 3), array.get(h, 5), array.get(h, 6), array.get(h, 7), array.get(h, 4))

f_shift(array<float> h, float o, float hi, float lo, float c) =>
    for q = 0 to 3
        array.set(h, q + 4, array.get(h, q))
    array.set(h, 0, o)
    array.set(h, 1, hi)
    array.set(h, 2, lo)
    array.set(h, 3, c)

// נכס שאין לו נר בצעד הזה — מערך ריק, וההיסטוריה שלו לא זזה
f_naQ() =>
    array.new_float(10, na)

// p1..p4 = לנכס יש נר בצעד הזה. נכס בלי נר מדלג עליו — ההיסטוריה שלו לא זזה,
// בדיוק כמו בגרף שלו, שבו דקה בלי עסקאות פשוט לא קיימת.
f_pushLtf(Engine e, int t, bool p1, bool p2, bool p3, bool p4, float xo1, float xh1, float xl1, float xc1, float xo2, float xh2, float xl2, float xc2, float xo3, float xh3, float xl3, float xc3, float xo4, float xh4, float xl4, float xc4) =>
    if not na(t) and t != e.lastT and (p1 or p2)
        array<float> q1 = p1 ? f_hist(e.h1, xo1, xh1, xl1, xc1) : f_naQ()
        array<float> q2 = p2 ? f_hist(e.h2, xo2, xh2, xl2, xc2) : f_naQ()
        array<float> q3 = p3 ? f_hist(e.h3, xo3, xh3, xl3, xc3) : f_naQ()
        array<float> q4 = p4 ? f_hist(e.h4, xo4, xh4, xl4, xc4) : f_naQ()
        f_step(e, t, q1, q2, q3, q4)
        if p1
            f_shift(e.h1, xo1, xh1, xl1, xc1)
        if p2
            f_shift(e.h2, xo2, xh2, xl2, xc2)
        if p3
            f_shift(e.h3, xo3, xh3, xl3, xc3)
        if p4
            f_shift(e.h4, xo4, xh4, xl4, xc4)
    e.fDeg

// ═══════════════════════════════════════════════════════════════════
// איפוס מיכל + מנגנון הזרע (1M · 5M · 1H)
// ═══════════════════════════════════════════════════════════════════

var bool seedActive = false
var int  seedRefId  = 0
var bool ownSeed    = false

if newLifeCycle
    int prevRef = nz(refCycleId[1], 0)
    if keepLast
        if array.size(owns) > 0
            for i = array.size(owns) - 1 to 0
                if array.get(owns, i).refId != prevRef
                    array.remove(owns, i)
        ownSeed := array.size(owns) > 0
        if array.size(gaps) > 0
            for i = array.size(gaps) - 1 to 0
                if array.get(gaps, i).refId != prevRef
                    array.remove(gaps, i)
        // גאפי הזרע עוברים למיכל החדש, אבל השבירות שנרשמו עליהם לא
        if array.size(gaps) > 0
            for i = 0 to array.size(gaps) - 1
                Gap gc = array.get(gaps, i)
                gc.fDeg  := 0
                gc.fPrev := 0
        seedRefId  := prevRef
        seedActive := array.size(gaps) > 0
    else
        array.clear(owns)
        ownSeed := false
        array.clear(gaps)
        seedActive := false
else if newRefCycle and seedActive
    if array.size(gaps) > 0
        for i = array.size(gaps) - 1 to 0
            if array.get(gaps, i).refId == seedRefId
                array.remove(gaps, i)
    seedActive := false
if not newLifeCycle and newRefCycle and ownSeed
    if array.size(owns) > 0
        for i = array.size(owns) - 1 to 0
            if array.get(owns, i).refId == seedRefId
                array.remove(owns, i)
    ownSeed := false

// ═══════════════════════════════════════════════════════════════════
// דריכה · מדידת ביקור · מוות ב-IFVG — בגרף
// ═══════════════════════════════════════════════════════════════════

if array.size(gaps) > 0
    for i = 0 to array.size(gaps) - 1
        Gap  gu   = array.get(gaps, i)
        bool k0   = gu.kind == 0
        bool cOut = gu.track(refCycleId, k0 ? a1H : a3H, k0 ? a1L : a3L, k0 ? a1C : a3C, k0 ? a2H : a4H, k0 ? a2L : a4L, k0 ? a2C : a4C, a3H, a3L, a3C, barstate.isconfirmed and bar_index > gu.birth)
        // בגרף של נכס 3 — הנכס של הגרף יצא מהגאפ, ולכן אין לו קופסה
        if cOut and k0 and chartIdx == 2
            gu.drwBot := na
            gu.drwTop := na

// ═══════════════════════════════════════════════════════════════════
// זיהוי גאפ קולקטיבי — שלישייה וזוג, באותו נר
// ═══════════════════════════════════════════════════════════════════

ok1 = not na(a1H[2]) and not na(a1O[1]) and not na(a1C)
ok2 = not na(a2H[2]) and not na(a2O[1]) and not na(a2C)
ok3 = not na(a3H[2]) and not na(a3O[1]) and not na(a3C)
ok4 = use4 and not na(a4H[2]) and not na(a4O[1]) and not na(a4C)

[b1u, t1u, f1u, m1u, v1u] = f_leg(1, ok1, a1O, a1H, a1L, a1C, a1O[1], a1C[1], a1H[2], a1L[2], a1C[2], a1O[2], tk1, newRefCycle)
[b1d, t1d, f1d, m1d, v1d] = f_leg(-1, ok1, a1O, a1H, a1L, a1C, a1O[1], a1C[1], a1H[2], a1L[2], a1C[2], a1O[2], tk1, newRefCycle)
[b2u, t2u, f2u, m2u, v2u] = f_leg(1, ok2, a2O, a2H, a2L, a2C, a2O[1], a2C[1], a2H[2], a2L[2], a2C[2], a2O[2], tk2, newRefCycle)
[b2d, t2d, f2d, m2d, v2d] = f_leg(-1, ok2, a2O, a2H, a2L, a2C, a2O[1], a2C[1], a2H[2], a2L[2], a2C[2], a2O[2], tk2, newRefCycle)
[b3u, t3u, f3u, m3u, v3u] = f_leg(1, ok3, a3O, a3H, a3L, a3C, a3O[1], a3C[1], a3H[2], a3L[2], a3C[2], a3O[2], tk3, newRefCycle)
[b3d, t3d, f3d, m3d, v3d] = f_leg(-1, ok3, a3O, a3H, a3L, a3C, a3O[1], a3C[1], a3H[2], a3L[2], a3C[2], a3O[2], tk3, newRefCycle)
[b4u, t4u, f4u, m4u, v4u] = f_leg(1, ok4, a4O, a4H, a4L, a4C, a4O[1], a4C[1], a4H[2], a4L[2], a4C[2], a4O[2], tk4, newRefCycle)
[b4d, t4d, f4d, m4d, v4d] = f_leg(-1, ok4, a4O, a4H, a4L, a4C, a4O[1], a4C[1], a4H[2], a4L[2], a4C[2], a4O[2], tk4, newRefCycle)

// הגאפ של הגרף עצמו — לגבולות הציור ולגאפים הלא קורלטיביים
[cBu, cTu, cFu, cMu, cVu] = f_leg(1, true, open, high, low, close, open[1], close[1], high[2], low[2], close[2], open[2], syminfo.mintick, newRefCycle)
[cBd, cTd, cFd, cMd, cVd] = f_leg(-1, true, open, high, low, close, open[1], close[1], high[2], low[2], close[2], open[2], syminfo.mintick, newRefCycle)

// הגאפ הקולקטיבי שנוצר בנר הזה ויש לו קופסה — כדי שהגאפ של הגרף מאותו נר
// לא יצויר פעמיים
var int collBar = -1
var int collDir = 0
var int collId  = 0

if barstate.isconfirmed and tfClass != 0 and bar_index > 2
    array<float> LB = array.from(b1u, b1d, b2u, b2d, b3u, b3d, b4u, b4d)
    array<float> LT = array.from(t1u, t1d, t2u, t2d, t3u, t3d, t4u, t4d)
    array<bool>  LF = array.from(f1u, f1d, f2u, f2d, f3u, f3d, f4u, f4d)
    array<bool>  LM = array.from(m1u, m1d, m2u, m2d, m3u, m3d, m4u, m4d)
    for k = 0 to 1
        [d, ab, at, bb, bt, xb, xt, anyF, anyV] = f_group(k, LB, LT, LF, LM)
        // FVG — לפי הנר האמצעי. גאפ מעבר או כולו VI — שייך לסייקל שהוא פותח.
        bool tagNow = (newRefCycle and anyV) or not anyF
        // מיכל חדש בלי זרע מתחיל נקי: FVG שהנר האמצעי שלו במיכל הקודם לא נכנס
        if d != 0 and not (newLifeCycle and not keepLast and not tagNow)
            // קופסה רק אם לנכס של הגרף יש רגל בגאפ הזה
            bool  onCh = k == 0 ? ((chartIdx == 0 and not na(at)) or (chartIdx == 1 and not na(bt)) or (chartIdx == 2 and not na(xt))) : ((chartIdx == 2 and not na(at)) or (chartIdx == 3 and not na(bt)))
            float dB   = onCh ? (d == 1 ? cBu : cBd) : na
            float dT   = onCh ? (d == 1 ? cTu : cTd) : na
            gapCounter += 1
            array.push(gaps, f_newGap(gapCounter, k, d, ab, at, bb, bt, xb, xt, tagNow ? refCycleId : refCycleId[1], bar_index, tagNow ? time : time[1], anyF ? bar_index - 2 : bar_index - 1, dB, dT, not anyF))
            f_trim(gaps)
            if not na(dT)
                collBar := bar_index
                collDir := d
                collId  := gapCounter

// ═══════════════════════════════════════════════════════════════════
// גאפים של הגרף עצמו — לא קורלטיביים, לתצוגה בלבד
// ═══════════════════════════════════════════════════════════════════

if barstate.isconfirmed and tfClass != 0 and array.size(owns) > 0
    for i = array.size(owns) - 1 to 0
        OwnGap og = array.get(owns, i)
        if og.dir == 1 ? close < og.bot : close > og.top
            array.remove(owns, i)
        else if not og.armed and og.refId != refCycleId
            og.armed := true

if ownMode != "כבוי" and barstate.isconfirmed and tfClass != 0 and bar_index > 2
    int oDir = cFu ? 1 : cFd ? -1 : not na(cTu) ? 1 : not na(cTd) ? -1 : 0
    if oDir != 0
        bool oF   = oDir == 1 ? cFu : cFd
        bool oV   = oDir == 1 ? (cVu or (cFu and cMu)) : (cVd or (cFd and cMd))
        bool oNow = (newRefCycle and oV) or not oF
        // אותו כלל כמו בגאפים הקולקטיביים: מיכל חדש בלי זרע מתחיל נקי
        if not (newLifeCycle and not keepLast and not oNow)
            array.push(owns, OwnGap.new(oDir, oDir == 1 ? cBu : cBd, oDir == 1 ? cTu : cTd, oNow ? refCycleId : refCycleId[1], oNow ? time : time[1], oF ? bar_index - 2 : bar_index - 1, false, not oF, collBar == bar_index and collDir == oDir ? collId : 0))
            if array.size(owns) > maxGaps
                array.remove(owns, 0)

// ═══════════════════════════════════════════════════════════════════
// חסימות — 1H: שישי חסום. 4H: שישי רק בשבוע 4; שבוע 5 ושבוע מת חסומים.
// ═══════════════════════════════════════════════════════════════════

cycleOK  = not (tfClass == 5 and ((blockDeadWeek and isDeadWeek) or isWeek5))
friBlock = tdDow == dayofweek.friday and (tfClass == 4 or (tfClass == 5 and qtWeekNum == 4))

// ═══════════════════════════════════════════════════════════════════
// רישום שבירות — לכל גאפ השבירה שלו
// ═══════════════════════════════════════════════════════════════════

atr = ta.atr(14)

var int seqCounter = 0

// נאסף במהלך הנר ונשלח פעם אחת בסוף הקובץ
string alertMsg = ""

if barstate.isconfirmed and tfClass != 0 and array.size(gaps) > 0
    bool canReg = not friBlock and cycleOK
    for i = 0 to array.size(gaps) - 1
        Gap gr = array.get(gaps, i)
        if gr.register(canReg)
            seqCounter += 1
            gr.fSeq  := seqCounter
            gr.fTime := time
            gr.fYPos := gr.dir == 1 ? low - atr * offsetMlt : high + atr * offsetMlt
            if alertOn and gr.fDeg >= alertMinDeg
                string one = "[" + f_clsName(tfClass) + "] " + syminfo.ticker + " · שבירה " + (gr.dir == 1 ? "שורית" : "דובית") + " " + f_degTxt(gr.fDeg) + " · " + gr.fLead
                alertMsg := alertMsg == "" ? one : alertMsg + "\n" + one

// ═══════════════════════════════════════════════════════════════════
// מסגרות זמן אחרות — מנוע נפרד לכל אחת
//
// מעל הגרף: הנר האחרון שנסגר, עם היסט בתוך request.security — בלי ריפיינט.
// מתחת לגרף: כל תת-הנרות של נר הגרף, מזווגים לפי זמן ומוזנים אחד-אחד.
// ═══════════════════════════════════════════════════════════════════

mtfOn = (mtfAlert or mtfFlash) and tfClass != 0

c1 = math.min(tfClass + 1, 8)
c2 = math.min(tfClass + 2, 8)
c3 = math.min(tfClass + 3, 8)
c4 = math.min(tfClass + 4, 8)
c5 = math.min(tfClass + 5, 8)
c6 = math.min(tfClass + 6, 8)

cL1 = math.max(tfClass - 1, 1)
cL2 = math.max(tfClass - 2, 1)
cL3 = math.max(tfClass - 3, 1)

hiCap = tfClass >= 5 ? 8 : maxHtf == "Mo" ? 8 : maxHtf == "1W" ? 7 : maxHtf == "1D" ? 6 : 5
useH1 = tfClass + 1 <= hiCap
useH2 = tfClass + 2 <= hiCap
useH3 = tfClass + 3 <= hiCap
useH4 = tfClass + 4 <= hiCap
useH5 = tfClass + 5 <= hiCap
useH6 = tfClass + 6 <= hiCap
useL1 = lowerLevels >= 1 and tfClass >= 2
useL2 = lowerLevels >= 2 and tfClass >= 3
useL3 = lowerLevels >= 3 and tfClass >= 4

// מדרגה שלא תיצעד מקבלת את מסגרת הגרף (כבר טעונה) למעלה, ו-"12M" (לא חוקי,
// נזרק בלי למשוך נתון) למטה.
tfs1 = not useH1 ? timeframe.period : c1 == 2 ? "5" : c1 == 3 ? "15" : c1 == 4 ? "60" : c1 == 5 ? "240" : c1 == 6 ? "D" : c1 == 7 ? "W" : "M"
tfs2 = not useH2 ? timeframe.period : c2 == 2 ? "5" : c2 == 3 ? "15" : c2 == 4 ? "60" : c2 == 5 ? "240" : c2 == 6 ? "D" : c2 == 7 ? "W" : "M"
tfs3 = not useH3 ? timeframe.period : c3 == 2 ? "5" : c3 == 3 ? "15" : c3 == 4 ? "60" : c3 == 5 ? "240" : c3 == 6 ? "D" : c3 == 7 ? "W" : "M"
tfs4 = not useH4 ? timeframe.period : c4 == 2 ? "5" : c4 == 3 ? "15" : c4 == 4 ? "60" : c4 == 5 ? "240" : c4 == 6 ? "D" : c4 == 7 ? "W" : "M"
tfs5 = not useH5 ? timeframe.period : c5 == 2 ? "5" : c5 == 3 ? "15" : c5 == 4 ? "60" : c5 == 5 ? "240" : c5 == 6 ? "D" : c5 == 7 ? "W" : "M"
tfs6 = not useH6 ? timeframe.period : c6 == 2 ? "5" : c6 == 3 ? "15" : c6 == 4 ? "60" : c6 == 5 ? "240" : c6 == 6 ? "D" : c6 == 7 ? "W" : "M"
tfl1 = not useL1 ? "12M" : cL1 == 1 ? "1" : cL1 == 2 ? "5" : cL1 == 3 ? "15" : cL1 == 4 ? "60" : cL1 == 5 ? "240" : cL1 == 6 ? "D" : "W"
tfl2 = not useL2 ? "12M" : cL2 == 1 ? "1" : cL2 == 2 ? "5" : cL2 == 3 ? "15" : cL2 == 4 ? "60" : cL2 == 5 ? "240" : cL2 == 6 ? "D" : "W"
tfl3 = not useL3 ? "12M" : cL3 == 1 ? "1" : cL3 == 2 ? "5" : cL3 == 3 ? "15" : cL3 == 4 ? "60" : cL3 == 5 ? "240" : cL3 == 6 ? "D" : "W"

// רק הנר האחרון שנסגר בכל מסגרת — ארבעה ערכים במקום עשרה. שני הנרות הקודמים
// נשמרים בתוך המנוע (h1..h4), בדיוק כמו במסגרות שמתחת לגרף, ולכן התוצאה זהה
// ובזיכרון יש פחות מחצי מהסדרות. הזמן נלקח רק מנכס 1.

[t1, n1o, n1h, n1l, n1c] = request.security(s1, tfs1, [time[1], open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[t2, n2o, n2h, n2l, n2c] = request.security(s1, tfs2, [time[1], open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[t3, n3o, n3h, n3l, n3c] = request.security(s1, tfs3, [time[1], open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[t4, n4o, n4h, n4l, n4c] = request.security(s1, tfs4, [time[1], open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[t5, n5o, n5h, n5l, n5c] = request.security(s1, tfs5, [time[1], open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[t6, n6o, n6h, n6l, n6c] = request.security(s1, tfs6, [time[1], open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)

[s1o, s1h, s1l, s1c] = request.security(s2, tfs1, [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[s2o, s2h, s2l, s2c] = request.security(s2, tfs2, [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[s3o, s3h, s3l, s3c] = request.security(s2, tfs3, [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[s4o, s4h, s4l, s4c] = request.security(s2, tfs4, [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[s5o, s5h, s5l, s5c] = request.security(s2, tfs5, [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[s6o, s6h, s6l, s6c] = request.security(s2, tfs6, [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)

[y1o, y1h, y1l, y1c] = request.security(s3, tfs1, [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[y2o, y2h, y2l, y2c] = request.security(s3, tfs2, [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[y3o, y3h, y3l, y3c] = request.security(s3, tfs3, [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[y4o, y4h, y4l, y4c] = request.security(s3, tfs4, [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[y5o, y5h, y5l, y5c] = request.security(s3, tfs5, [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[y6o, y6h, y6l, y6c] = request.security(s3, tfs6, [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)

[r1o, r1h, r1l, r1c] = request.security(s4, tfs1, [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[r2o, r2h, r2l, r2c] = request.security(s4, tfs2, [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[r3o, r3h, r3l, r3c] = request.security(s4, tfs3, [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[r4o, r4h, r4l, r4c] = request.security(s4, tfs4, [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[r5o, r5h, r5l, r5c] = request.security(s4, tfs5, [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)
[r6o, r6h, r6l, r6c] = request.security(s4, tfs6, [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off, calc_bars_count = calcBars)

// ignore_invalid_timeframe מחזיר na כשהמדרגה לא באמת מתחת לגרף.
// לכל נכס גם time — כדי לזווג לפי זמן ולא לפי אינדקס: דקה בלי עסקאות פשוט
// לא מייצרת נר, וזיווג לפי אינדקס היה משווה דקות שונות.
[q1t, q1ao, q1ah, q1al, q1ac] = request.security_lower_tf(s1, tfl1, [time, open, high, low, close], ignore_invalid_timeframe = true, calc_bars_count = calcBars)
[q2t, q2ao, q2ah, q2al, q2ac] = request.security_lower_tf(s1, tfl2, [time, open, high, low, close], ignore_invalid_timeframe = true, calc_bars_count = calcBars)
[q3t, q3ao, q3ah, q3al, q3ac] = request.security_lower_tf(s1, tfl3, [time, open, high, low, close], ignore_invalid_timeframe = true, calc_bars_count = calcBars)
[q1bt, q1bo, q1bh, q1bl, q1bc] = request.security_lower_tf(s2, tfl1, [time, open, high, low, close], ignore_invalid_timeframe = true, calc_bars_count = calcBars)
[q2bt, q2bo, q2bh, q2bl, q2bc] = request.security_lower_tf(s2, tfl2, [time, open, high, low, close], ignore_invalid_timeframe = true, calc_bars_count = calcBars)
[q3bt, q3bo, q3bh, q3bl, q3bc] = request.security_lower_tf(s2, tfl3, [time, open, high, low, close], ignore_invalid_timeframe = true, calc_bars_count = calcBars)
[q1ct, q1co, q1ch, q1cl, q1cc] = request.security_lower_tf(s3, tfl1, [time, open, high, low, close], ignore_invalid_timeframe = true, calc_bars_count = calcBars)
[q2ct, q2co, q2ch, q2cl, q2cc] = request.security_lower_tf(s3, tfl2, [time, open, high, low, close], ignore_invalid_timeframe = true, calc_bars_count = calcBars)
[q3ct, q3co, q3ch, q3cl, q3cc] = request.security_lower_tf(s3, tfl3, [time, open, high, low, close], ignore_invalid_timeframe = true, calc_bars_count = calcBars)
[q1dt, q1do, q1dh, q1dl, q1dc] = request.security_lower_tf(s4, tfl1, [time, open, high, low, close], ignore_invalid_timeframe = true, calc_bars_count = calcBars)
[q2dt, q2do, q2dh, q2dl, q2dc] = request.security_lower_tf(s4, tfl2, [time, open, high, low, close], ignore_invalid_timeframe = true, calc_bars_count = calcBars)
[q3dt, q3do, q3dh, q3dl, q3dc] = request.security_lower_tf(s4, tfl3, [time, open, high, low, close], ignore_invalid_timeframe = true, calc_bars_count = calcBars)

f_newEng(int c) =>
    Engine.new(cls = c, gaps = array.new<Gap>(), h1 = array.new_float(8, na), h2 = array.new_float(8, na), h3 = array.new_float(8, na), h4 = array.new_float(8, na))

var Engine eg1 = f_newEng(c1)
var Engine eg2 = f_newEng(c2)
var Engine eg3 = f_newEng(c3)
var Engine eg4 = f_newEng(c4)
var Engine eg5 = f_newEng(c5)
var Engine eg6 = f_newEng(c6)
var Engine el1 = f_newEng(cL1)
var Engine el2 = f_newEng(cL2)
var Engine el3 = f_newEng(cL3)

// כל המנועים ברשימה אחת, באותו סדר של useH1..useL3
var array<Engine> allEng = array.new<Engine>()
if barstate.isfirst
    array.push(allEng, eg1)
    array.push(allEng, eg2)
    array.push(allEng, eg3)
    array.push(allEng, eg4)
    array.push(allEng, eg5)
    array.push(allEng, eg6)
    array.push(allEng, el1)
    array.push(allEng, el2)
    array.push(allEng, el3)

f_useSlot(int k) =>
    k == 0 ? useH1 : k == 1 ? useH2 : k == 2 ? useH3 : k == 3 ? useH4 : k == 4 ? useH5 : k == 5 ? useH6 : k == 6 ? useL1 : k == 7 ? useL2 : useL3

// גודל של מערך שעלול להיות na. ב-Pine `and` לא עוצר באמצע, ולכן הבדיקה
// חייבת להיות `if`. -1 = אין מערך.
f_aszF(array<float> a) =>
    int n = -1
    if not na(a)
        n := array.size(a)
    n

f_aszI(array<int> a) =>
    int n = -1
    if not na(a)
        n := array.size(a)
    n

// ערך מתת-נר של נכס, רק כשיש לו נר באותו זמן
f_ltfGet(array<float> a, int j, bool ok) =>
    float v = na
    if ok
        v := array.get(a, j)
    v

// סמן רץ: האינדקס האחרון במערך הזמנים שזמנו <= t, החל מ-from. המערכים
// ממוינים ולכן הסמן רק מתקדם. שני if מקוננים — `and` ב-Pine לא עוצר באמצע.
// הקורא חייב לוודא שהמערך לא ריק.
f_cur(array<int> ta, int t, int from) =>
    n = array.size(ta)
    k = from < 0 ? 0 : from > n - 1 ? n - 1 : from
    if n > 0
        bool go = true
        while go
            if k < n - 1
                if array.get(ta, k + 1) <= t
                    k := k + 1
                else
                    go := false
            else
                go := false
    k

// הזנת המסגרת הנמוכה: כל תת-נר בנפרד, לפי הסדר. הזמנים של נכס 1 הם המפתח,
// ולכל נכס אחר נמצא הנר שלו **באותו זמן בדיוק** — אין לו נר כזה, הוא מדלג.
f_feedLtf(Engine e, array<int> at, array<float> ao, array<float> ah, array<float> al, array<float> ac, array<int> bt, array<float> bo, array<float> bh, array<float> bl, array<float> bc, array<int> ct, array<float> co, array<float> ch, array<float> cl, array<float> cc, array<int> dt, array<float> dO, array<float> dh, array<float> dl, array<float> dc) =>
    int szA = f_aszF(ac)
    int szT = f_aszI(at)
    int szB = f_aszI(bt)
    int szC = f_aszI(ct)
    int szD = f_aszI(dt)
    if szA > 0 and szT == szA
        int kb = 0
        int kc = 0
        int kd = 0
        for j = 0 to szA - 1
            int  tj = array.get(at, j)
            bool pb = false
            bool pc = false
            bool pd = false
            if szB > 0
                kb := f_cur(bt, tj, kb)
                pb := array.get(bt, kb) == tj
            if szC > 0
                kc := f_cur(ct, tj, kc)
                pc := array.get(ct, kc) == tj
            if szD > 0
                kd := f_cur(dt, tj, kd)
                pd := array.get(dt, kd) == tj
            f_pushLtf(e, tj, true, pb, pc, pd, array.get(ao, j), array.get(ah, j), array.get(al, j), array.get(ac, j), f_ltfGet(bo, kb, pb), f_ltfGet(bh, kb, pb), f_ltfGet(bl, kb, pb), f_ltfGet(bc, kb, pb), f_ltfGet(co, kc, pc), f_ltfGet(ch, kc, pc), f_ltfGet(cl, kc, pc), f_ltfGet(cc, kc, pc), f_ltfGet(dO, kd, pd), f_ltfGet(dh, kd, pd), f_ltfGet(dl, kd, pd), f_ltfGet(dc, kd, pd))
    szA

// הצעד נעשה רק בסגירת נר של הגרף — בנר חי הסקריפט רץ בכל טיק.
if mtfOn and barstate.isconfirmed
    // איפוס "נשברה עכשיו" פעם אחת לנר גרף, לא בתוך f_step
    for k = 0 to array.size(allEng) - 1
        Engine er = array.get(allEng, k)
        er.justFired := false
        er.pFired    := false
    if useH1
        f_pushLtf(eg1, t1, not na(n1c), not na(s1c), not na(y1c), not na(r1c), n1o, n1h, n1l, n1c, s1o, s1h, s1l, s1c, y1o, y1h, y1l, y1c, r1o, r1h, r1l, r1c)
    if useH2
        f_pushLtf(eg2, t2, not na(n2c), not na(s2c), not na(y2c), not na(r2c), n2o, n2h, n2l, n2c, s2o, s2h, s2l, s2c, y2o, y2h, y2l, y2c, r2o, r2h, r2l, r2c)
    if useH3
        f_pushLtf(eg3, t3, not na(n3c), not na(s3c), not na(y3c), not na(r3c), n3o, n3h, n3l, n3c, s3o, s3h, s3l, s3c, y3o, y3h, y3l, y3c, r3o, r3h, r3l, r3c)
    if useH4
        f_pushLtf(eg4, t4, not na(n4c), not na(s4c), not na(y4c), not na(r4c), n4o, n4h, n4l, n4c, s4o, s4h, s4l, s4c, y4o, y4h, y4l, y4c, r4o, r4h, r4l, r4c)
    if useH5
        f_pushLtf(eg5, t5, not na(n5c), not na(s5c), not na(y5c), not na(r5c), n5o, n5h, n5l, n5c, s5o, s5h, s5l, s5c, y5o, y5h, y5l, y5c, r5o, r5h, r5l, r5c)
    if useH6
        f_pushLtf(eg6, t6, not na(n6c), not na(s6c), not na(y6c), not na(r6c), n6o, n6h, n6l, n6c, s6o, s6h, s6l, s6c, y6o, y6h, y6l, y6c, r6o, r6h, r6l, r6c)
    if useL1
        f_feedLtf(el1, q1t, q1ao, q1ah, q1al, q1ac, q1bt, q1bo, q1bh, q1bl, q1bc, q1ct, q1co, q1ch, q1cl, q1cc, q1dt, q1do, q1dh, q1dl, q1dc)
    if useL2
        f_feedLtf(el2, q2t, q2ao, q2ah, q2al, q2ac, q2bt, q2bo, q2bh, q2bl, q2bc, q2ct, q2co, q2ch, q2cl, q2cc, q2dt, q2do, q2dh, q2dl, q2dc)
    if useL3
        f_feedLtf(el3, q3t, q3ao, q3ah, q3al, q3ac, q3bt, q3bo, q3bh, q3bl, q3bc, q3ct, q3co, q3ch, q3cl, q3cc, q3dt, q3do, q3dh, q3dl, q3dc)

// ═══════════════════════════════════════════════════════════════════
// פג-תוקף של מיכל — שבירה מתה ברגע שהמיכל שלה נגמר, מול השעון של הגרף.
// רק בנר האחרון: זה מה שמוצג.
// ═══════════════════════════════════════════════════════════════════

if mtfOn and barstate.islast
    for k = 0 to array.size(allEng) - 1
        Engine ex = array.get(allEng, k)
        if f_useSlot(k) and ex.started and (ex.fDeg > 0 or ex.pDeg > 0) and ex.lifeId != f_lifeId(ex.cls, time)
            ex.fDir  := 0
            ex.fDeg  := 0
            ex.fLead := ""
            ex.pDir  := 0
            ex.pDeg  := 0
            ex.pLead := ""

// ═══════════════════════════════════════════════════════════════════
// שבירה במסגרת אחרת: סימון זעיר בפינה + שורה בהתראה
// ═══════════════════════════════════════════════════════════════════

// " · YM/RTY" כשהשבירה של הזוג — רק כשהפינה לא מינימלית (אחרת הצבע מבדיל)
f_pairTag(int kind) =>
    kind == 1 and not flashMin ? " · " + nm3 + "/" + nm4 : ""

// איזה רבע של המיכל — המיקום של תת-המחזור שבו נרשמה השבירה בתוך המיכל שלו.
// 1H: שני Q1 · שלישי Q2 · רביעי Q3 · חמישי Q4 · שישי Q5.
f_qTxt(int c, int t) =>
    int  eh   = hour(t, TZ)
    int  mnd  = eh * 60 + minute(t, TZ)
    bool post = mnd >= 1080
    int  tdt  = post ? t + 86400000 : t
    int  mfd  = post ? mnd - 1080 : mnd + 360
    int  sIdx = math.floor(mfd / 360)
    int  mInS = mfd % 360
    int  uIdx = math.floor(mInS / 90)
    int  qIdx = math.floor((mInS % 90) / 22.5)
    int  dw   = dayofweek(tdt, TZ)
    int  yy   = year(tdt, TZ)
    int  mm   = month(tdt, TZ)
    int  dd   = dayofmonth(tdt, TZ)
    int  n    = 0
    if c == 1
        n := qIdx + 1
    else if c == 2
        n := uIdx + 1
    else if c == 3
        n := sIdx + 1
    else if c == 4
        n := dw == dayofweek.monday ? 1 : dw == dayofweek.tuesday ? 2 : dw == dayofweek.wednesday ? 3 : dw == dayofweek.thursday ? 4 : dw == dayofweek.friday ? 5 : 0
    else if c == 5
        int dsm  = dw == dayofweek.sunday ? 6 : dw - 2
        int tueT = tdt - dsm * 86400000 + 86400000
        n := month(tueT, TZ) != month(tueT + 2 * 86400000, TZ) ? 0 : int(math.floor((dayofmonth(tueT, TZ) - 1) / 7)) + 1
    else if c == 6
        int qOf  = int(math.ceil(mm / 3.0))
        int qsM  = (qOf - 1) * 3 + 1
        int qLn  = f_dim(yy, qsM) + f_dim(yy, qsM + 1) + f_dim(yy, qsM + 2)
        int qDiQ = (dd - 1) + (mm > qsM ? f_dim(yy, qsM) : 0) + (mm > qsM + 1 ? f_dim(yy, qsM + 1) : 0)
        n := math.min(3, math.max(0, int(math.floor(qDiQ * 4.0 / qLn)))) + 1
    else if c == 7
        int q = int(math.ceil(mm / 3.0))
        n := q >= 2 ? q - 1 : 4
    else if c == 8
        n := (yy - 2023) % 4 + 1
    n > 0 ? "Q" + str.tostring(n) : ""

// הטקסט של תא אחד: מסגרת · כיוון ודרגה · (זוג) · Q של השבירה
f_cellTxt(int cls, int dir, int deg, int kind, int t) =>
    string q = flashHour and t > 0 ? f_qTxt(cls, t) : ""
    f_clsName(cls) + (dir == 1 ? " ▲" : " ▼") + str.tostring(deg) + f_pairTag(kind) + (q != "" ? " " + q : "")

// האם הזוג מוצג לפני השלישייה — לפי מצב הסדר
f_pairFirst(int degT, int seqT, int degP, int seqP) =>
    orderMode == "שלישייה ואז זוג" ? false : orderMode == "החדשה ראשונה" ? seqP > seqT : (degP > degT or (degP == degT and seqP > seqT))

// סימון "נולדה" נפרד לשלישייה ולזוג — שבירת זוג לא נדרסת ע"י שבירת שלישייה
var string flashTxt  = ""
var int    flashDir  = 0
var int    flashTime = 0
var int    flashCls  = 0
var int    flashLife = 0
var int    flashDeg  = 0
var int    flashSq   = 0
var string flashTxtP  = ""
var int    flashDirP  = 0
var int    flashTimeP = 0
var int    flashClsP  = 0
var int    flashLifeP = 0
var int    flashDegP  = 0
var int    flashSqP   = 0

if mtfOn and barstate.isconfirmed
    for k = 0 to array.size(allEng) - 1
        Engine ek = array.get(allEng, k)
        // שעון הסימון: timenow בזמן אמת, time_close בהיסטוריה
        int fNow = barstate.isrealtime ? timenow : time_close
        if f_useSlot(k) and ek.justFired
            flashTxt  := f_cellTxt(ek.cls, ek.jDir, ek.jDeg, 0, ek.jT)
            flashDir  := ek.jDir
            flashDeg  := ek.jDeg
            flashSq   := ek.jSq
            flashTime := fNow
            flashCls  := ek.cls
            flashLife := ek.lifeId
            if mtfAlert and alertOn and ek.jDeg >= alertMinDeg
                string one = "[" + f_clsName(ek.cls) + "] " + syminfo.ticker + " · שבירה " + (ek.jDir == 1 ? "שורית" : "דובית") + " " + f_degTxt(ek.jDeg) + " · " + ek.jLead
                alertMsg := alertMsg == "" ? one : alertMsg + "\n" + one
        if f_useSlot(k) and ek.pFired
            flashTxtP  := f_cellTxt(ek.cls, ek.pjDir, ek.pjDeg, 1, ek.pjT)
            flashDirP  := ek.pjDir
            flashDegP  := ek.pjDeg
            flashSqP   := ek.pjSq
            flashTimeP := fNow
            flashClsP  := ek.cls
            flashLifeP := ek.lifeId
            if mtfAlert and alertOn and ek.pjDeg >= alertMinDeg
                string one = "[" + f_clsName(ek.cls) + "] " + syminfo.ticker + " · שבירה " + (ek.pjDir == 1 ? "שורית" : "דובית") + " " + f_degTxt(ek.pjDeg) + " · " + ek.pjLead
                alertMsg := alertMsg == "" ? one : alertMsg + "\n" + one

flashPosition = flashPos == "שמאל למעלה" ? position.top_left : flashPos == "ימין למטה" ? position.bottom_right : flashPos == "ימין למעלה" ? position.top_right : flashPos == "אמצע למטה" ? position.bottom_center : position.bottom_left
flashTop = flashPos == "שמאל למעלה" or flashPos == "ימין למעלה"
flashRow = flashTop ? flashLift : 0

// תא נפרד לכל מסגרת — כל אחת בצבע של הכיוון שלה, הזוג בצבע שלו
var table flashT = table.new(flashPosition, 17, flashLift + 1)

f_flashCol(int dir, int kind) =>
    kind == 1 ? colPair : dir == 1 ? colBull : colBear

if barstate.islast
    for rr = 0 to flashLift
        for cx = 0 to 16
            table.cell(flashT, cx, rr, "", bgcolor = color.new(color.black, 100))
        // מרווח בלתי נראה ששומר על גובה השורה
        if rr != flashRow
            table.cell(flashT, 0, rr, "·", bgcolor = color.new(color.black, 100), text_color = color.new(color.white, 100), text_size = flashSz)
    if mtfFlash and mtfOn
        int cx = 1
        if flashMode == "כל עוד יש שבירה חיה"
            // כל המסגרות האחרות שיש עליהן שבירה חיה, מהגבוהה לנמוכה. תא אחד
            // לכל מסגרת: השבירה האחרונה מבין השלישייה והזוג.
            for cc = 8 to 1
                if cc != tfClass
                    for k = 0 to array.size(allEng) - 1
                        Engine ep = array.get(allEng, k)
                        if f_useSlot(k) and ep.cls == cc and (ep.fDir != 0 or ep.pDir != 0) and cx <= 16
                            bool isP = ep.pDir != 0 and (ep.fDir == 0 or ep.pSq > ep.fSq)
                            int  dD  = isP ? ep.pDir : ep.fDir
                            table.cell(flashT, cx, flashRow, f_cellTxt(cc, dD, isP ? ep.pDeg : ep.fDeg, isP ? 1 : 0, isP ? ep.pT : ep.fT) + "  ", bgcolor = color.new(color.black, 100), text_color = f_flashCol(dD, isP ? 1 : 0), text_size = flashSz)
                            cx := cx + 1
        else
            bool showT = flashTxt != "" and timenow - flashTime <= mtfFlashSec * 1000 and flashLife == f_lifeId(flashCls, time)
            bool showP = flashTxtP != "" and timenow - flashTimeP <= mtfFlashSec * 1000 and flashLifeP == f_lifeId(flashClsP, time)
            // אותה מסגרת — רק האחרונה
            if showT and showP and flashCls == flashClsP
                bool pLast = flashTimeP > flashTime or (flashTimeP == flashTime and flashSqP > flashSq)
                showT := not pLast
                showP := pLast
            bool pF = showT and showP and f_pairFirst(flashDeg, flashTime, flashDegP, flashTimeP)
            for r = 0 to 1
                bool isP = (r == 0) == pF
                if isP ? showP : showT
                    table.cell(flashT, cx, flashRow, (isP ? flashTxtP : flashTxt) + "  ", bgcolor = color.new(color.black, 100), text_color = f_flashCol(isP ? flashDirP : flashDir, isP ? 1 : 0), text_size = flashSz)
                    cx := cx + 1
        // תווית הפתיחה מופיעה רק כשיש מה להגיד
        if cx > 1
            table.cell(flashT, 0, flashRow, flashTag + "  ", bgcolor = color.new(color.black, 100), text_color = flashTagCol, text_size = flashSz)

// ═══════════════════════════════════════════════════════════════════
// ציור — השבירה של השלישייה ושל הזוג 3·4, יחד
//
// הראשית לפי "סדר: שלישייה מול זוג" (ברירת מחדל: החזקה — דרגה גבוהה יותר,
// ובשוויון החדשה), ומצוירת בצבע המלא. השנייה היא משנית: צבע, שקיפות, מסגרת וגודל טקסט משלה.
// לנכס של הגרף יש רגל בגאפ → קופסה, והכיתוב בתוכה. אין → רק תווית ליד הנר.
// ═══════════════════════════════════════════════════════════════════

wStyle = weakStyle == "מקווקו" ? line.style_dashed : weakStyle == "נקודות" ? line.style_dotted : line.style_solid

var array<box>   gBx = array.new_box()
var array<label> gLb = array.new_label()
var array<line>  gLn = array.new_line()

f_drawGap(Gap gd, bool weak) =>
    color  colM  = gd.kind == 1 ? colPair : gd.dir == 1 ? colBull : colBear
    color  colW  = gd.kind == 1 ? colPairW : gd.dir == 1 ? colBullW : colBearW
    color  col   = weak ? colW : colM
    // הדרגה משנה רק את עוצמת המסגרת; הטקסט נשאר קריא גם ב-F1
    color  cEdge = weak ? color.new(col, weakFade) : color.new(col, gd.fDeg == 3 ? boxBorder : gd.fDeg == 2 ? math.min(boxBorder + 20, 95) : math.min(boxBorder + 35, 95))
    color  cTxt  = weak ? color.new(col, weakFade) : color.new(col, gd.fDeg == 3 ? 0 : gd.fDeg == 2 ? 15 : 30)
    string tSz   = weak and weakSmall ? size.tiny : capSize
    float  gTop  = gd.drwTop
    float  gBot  = gd.drwBot
    bool   inBox = showBox and not na(gTop)
    string txt   = (gd.kind == 1 ? f_clsName(tfClass) + " " : "") + f_degTxt(gd.fDeg) + " " + gd.fLead
    int    xEnd  = boxLen == "עד נר השבירה" ? gd.fSigB : boxLen == "קצר (12 נרות)" ? gd.fSigB + 12 : bar_index
    xEnd := math.max(xEnd, gd.origin + 1)
    if inBox
        array.push(gBx, box.new(gd.origin, gTop, xEnd, gBot, border_color = cEdge, border_width = 1, border_style = weak ? wStyle : line.style_solid, bgcolor = color.new(col, weak ? math.min(boxTransp + 4, 98) : boxTransp), text = txt, text_color = cTxt, text_size = tSz, text_halign = text.align_right, text_valign = text.align_center))
        if showCE
            array.push(gLn, line.new(gd.origin, (gTop + gBot) / 2, xEnd, (gTop + gBot) / 2, color = color.new(col, 40), style = line.style_dashed, width = 1))
    else
        array.push(gLb, label.new(gd.fSigB, gd.fYPos, txt, style = label.style_none, textcolor = cTxt, size = tSz, textalign = text.align_center))
    // סימון נר ה-fill של הזוג — בצבע של השבירה (ראשית/משנית)
    if gd.kind == 1 and pairMark == "קו אנכי"
        array.push(gLn, line.new(gd.fSigB, low, gd.fSigB, high, xloc = xloc.bar_index, extend = extend.both, color = color.new(col, markTransp), style = markStyle == "רציף" ? line.style_solid : markStyle == "מקווקו" ? line.style_dashed : line.style_dotted, width = 1))
    else if gd.kind == 1 and pairMark == "חץ"
        bool up = gd.dir == 1
        array.push(gLb, label.new(gd.fSigB, up ? low : high, "", xloc = xloc.bar_index, yloc = up ? yloc.belowbar : yloc.abovebar, style = up ? label.style_arrowup : label.style_arrowdown, color = col, textcolor = col, size = arrowSize))
    0

[selT, selP] = f_sel2(gaps)

// רק המצב הנוכחי מצויר: בנר האחרון מוחקים הכול ומציירים מחדש
if barstate.islast
    while array.size(gBx) > 0
        box.delete(array.pop(gBx))
    while array.size(gLb) > 0
        label.delete(array.pop(gLb))
    while array.size(gLn) > 0
        line.delete(array.pop(gLn))
    if selT != -1 and selP != -1
        Gap gT = array.get(gaps, selT)
        Gap gP = array.get(gaps, selP)
        bool tPrim = not f_pairFirst(gT.fDeg, gT.fSeq, gP.fDeg, gP.fSeq)
        f_drawGap(gT, not tPrim)
        f_drawGap(gP, tPrim)
    else if selT != -1
        f_drawGap(array.get(gaps, selT), false)
    else if selP != -1
        f_drawGap(array.get(gaps, selP), false)

// ═══════════════════════════════════════════════════════════════════
// הצצה — הגאפים הקולקטיביים הדרוכים (אלה שיכולה להיווצר עליהם שבירה עכשיו)
// כיתוב: אזור · שעת יצירה · משתתפים (V = כולו VI)
// ═══════════════════════════════════════════════════════════════════

var array<box> peekBoxes = array.new<box>()

// הרגע שבו הסקריפט התחיל לרוץ — החלפת מסגרת מריצה אותו מאפס
var int bootT = timenow
drawAllGaps = showAllGaps or (autoAllGaps and tfClass != 0 and tfClass <= 5 and timenow - bootT <= autoAllSec * 1000)

f_gapCol(int kind, int dir) =>
    kind == 1 ? colPair : dir == 1 ? colBull : colBear

// המחיקה רצה תמיד, גם כשלא מציירים — אחרת ההצצה לא הייתה נעלמת
if barstate.islast
    for bx in peekBoxes
        box.delete(bx)
    array.clear(peekBoxes)
    if drawAllGaps and array.size(gaps) > 0
        for i = 0 to array.size(gaps) - 1
            Gap gz = array.get(gaps, i)
            if not gz.dead and gz.armed and not na(gz.drwTop)
                color  zCol = f_gapCol(gz.kind, gz.dir)
                string zTxt = f_subName(tfClass, gz.birthT) + " " + f_bornTxt(tfClass, gz.birthT) + " " + f_legsTxt(gz) + (gz.volImb ? " V" : "")
                array.push(peekBoxes, box.new(gz.origin, gz.drwTop, bar_index, gz.drwBot, border_color = color.new(zCol, peekEdge), border_width = 1, bgcolor = color.new(zCol, peekFill), text = zTxt, text_color = color.new(zCol, 20), text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_top))

// ── הגאפים של הגרף עצמו ──
var array<box> ownBoxes = array.new<box>()
drawOwn = tfClass != 0 and tfClass <= ownMaxCls and (ownMode == "תמיד" or (ownMode == "הצצה" and (tfClass <= ownAlwCls or timenow - bootT <= ownSec * 1000)))

if barstate.islast
    for bx in ownBoxes
        box.delete(bx)
    array.clear(ownBoxes)
    if drawOwn and array.size(owns) > 0
        for i = 0 to array.size(owns) - 1
            OwnGap og = array.get(owns, i)
            if og.armed
                // קולקטיבי שכבר מצויר בהצצה — לא שוב. קולקטיבי חי שלא מצויר —
                // מוצג כקולקטיבי, בצבעים שלו ועם המשתתפים.
                bool   dup  = false
                string legs = ""
                int    kOf  = 0
                if og.collId != 0 and array.size(gaps) > 0
                    for j = 0 to array.size(gaps) - 1
                        Gap gk = array.get(gaps, j)
                        if gk.id == og.collId and not gk.dead
                            legs := f_legsTxt(gk)
                            kOf  := gk.kind
                            if drawAllGaps and gk.armed and not na(gk.drwTop)
                                dup := true
                if not dup
                    bool   isColl = legs != ""
                    color  oCol   = isColl ? f_gapCol(kOf, og.dir) : og.dir == 1 ? ownBull : ownBear
                    string oTxt   = f_subName(tfClass, og.birthT) + " " + f_bornTxt(tfClass, og.birthT) + " " + (isColl ? legs : ownName) + (og.volImb ? " V" : "")
                    array.push(ownBoxes, box.new(og.origin, og.top, bar_index, og.bot, border_color = color.new(oCol, peekEdge), border_width = 1, bgcolor = color.new(oCol, peekFill), text = oTxt, text_color = color.new(oCol, 25), text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_top))

// ═══════════════════════════════════════════════════════════════════
// שליחת ההתראה — פעם אחת בסוף הנר, כל המסגרות באותה הודעה
// ═══════════════════════════════════════════════════════════════════

if alertMsg != ""
    alert(alertMsg, alert.freq_once_per_bar_close)

// ═══════════════════════════════════════════════════════════════════
// ייצוא למרכז (QT Hub) — רק השלישייה
//
// לכל מסגרת בסולם 4H · 1H · 15m · 5m · 1m — ארבע ספרות: שתיים לשבירה הדובית
// החיה העדכנית ושתיים לשורית (דרגה + ספרת זהות של הגאפ). 9999 = לא נסרקת.
// בסוף החצי השני — Fill שנבנה עכשיו בנר החי: כיוון (1 שורי / 2 דובי) ודרגה.
// המבנה המלא ב-qt-system/docs/HUB.md — חייב להיות זהה במרכז.
// ═══════════════════════════════════════════════════════════════════

f_fxDir(array<Gap> a, int d) =>
    int bestI = -1
    int bestS = -1
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            Gap g = array.get(a, i)
            if g.kind == 0 and not g.dead and g.fDeg > 0 and g.dir == d and g.fSeq > bestS
                bestS := g.fSeq
                bestI := i
    int v = 0
    if bestI != -1
        Gap gb = array.get(a, bestI)
        v := gb.fDeg * 10 + gb.id % 10
    v

f_fxGaps(array<Gap> a) => f_fxDir(a, -1) * 100 + f_fxDir(a, 1)

f_fxTf(int cls) =>
    int v = 9999
    if cls == tfClass
        v := f_fxGaps(gaps)
    else if mtfOn
        for k = 0 to array.size(allEng) - 1
            Engine ee = array.get(allEng, k)
            if v == 9999 and f_useSlot(k) and ee.cls == cls
                bool stale = ee.cls > tfClass and ee.started and ee.lifeId != f_lifeId(ee.cls, time)
                v := stale ? 0 : f_fxGaps(ee.gaps)
    v

// Fill בתהליך: על הנר החי, גאפ דרוך שהעומקים שלו כבר נותנים דרגה גבוהה מזו
// שנרשמה. בסגירת הנר הוא נרשם בעצמו, ולכן בהיסטוריה זה תמיד 0.
int fxPot = 0
if tfClass != 0 and not friBlock and cycleOK and array.size(gaps) > 0
    int fpDeg = 0
    int fpDir = 0
    for i = 0 to array.size(gaps) - 1
        Gap g = array.get(gaps, i)
        if g.kind == 0 and not g.dead and g.armed
            int dg = g.fracDeg()
            if dg > g.fDeg and dg > fpDeg
                fpDeg := dg
                fpDir := g.dir
    fxPot := fpDeg == 0 ? 0 : (fpDir == 1 ? 10 : 20) + fpDeg

hubA = 210000000000000.0 + f_fxTf(5) * 100000000.0 + f_fxTf(4) * 10000.0 + f_fxTf(3)
hubB = 220000000000000.0 + f_fxTf(2) * 100000000.0 + f_fxTf(1) * 10000.0 + fxPot
plot(hubA, "HUB · Fill · A", color = color.new(color.gray, 100), display = display.data_window, editable = false)
plot(hubB, "HUB · Fill · B", color = color.new(color.gray, 100), display = display.data_window, editable = false)