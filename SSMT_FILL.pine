//@version=5
indicator("SSMT Fill | Quarterly Theory", overlay = true, max_labels_count = 20, max_lines_count = 20, max_boxes_count = 250)

// ═══════════════════════════════════════════════════════════════════
// SSMT Fill — סטיית קורלציה לפי מילוי גאפים
//
// גאפ קולקטיבי = FVG באותו כיוון, באותו נר, ב**לפחות שניים** מתוך שלושת
// הנכסים: NQ · ES · YM. גאפ בנכס בודד — מתעלמים ממנו לגמרי.
//
// YM הוא הנכס החלש, ולכן הוא מעניין רק כשהוא מתנהג בניגוד לחולשה שלו:
//   גאפ שורי (מתחת למחיר) — YM אמור ליפול הכי עמוק, אין בזה מידע. הוא
//     יכול לשחק רק את תפקיד ה**מפגר**: אם הוא רדוד מהאחרים — סיגנל לעליות.
//   גאפ דובי (מעל המחיר) — הוא יכול לשחק רק את תפקיד ה**מוביל**: אם הוא
//     נכנס עמוק מהאחרים — סיגנל לירידות.
//   בכל מקרה אחר פשוט מתעלמים ממנו. הוא לא מחזק ולא מחליף — הוא משתתף.
//
// שבירה = הנכס המוביל נכנס עמוק יותר מהמפגר. שלוש דרגות:
//   F1 — המוביל נגע, המפגר לא נגע בכלל.
//   F2 — המוביל הגיע ל-CE (50%), המפגר לא.
//   F3 — המוביל הגיע לקצה הרחוק (או מעבר בפתיל), המפגר לא לקח הכול.
//
// כל ביקור בגאפ נמדד מאפס. אם כולם מילאו את הגאפ יחד — אין שבירה, אבל
// הגאפ נשאר תקף וכניסה חוזרת אליו נמדדת מחדש ויכולה לייצר שבירה.
//
// שבירה היא אירוע שקרה — אחרי שנרשמה היא נשארת, והדרגה יכולה רק לעלות.
// מה שמוציא אותה מהמשחק: IFVG על הגאפ שלה, או החלפת מיכל.
// שבירה נגדית רק דוחקת אותה מהתצוגה — מוצגת תמיד החיה העדכנית ביותר.
// אם הגאפ של הנגדית הופך ל-IFVG, הקודמת בכיוון ההפוך חוזרת להיות המוצגת,
// כל עוד המיכל לא התחלף.
//
// IFVG: סגירה של NQ או ES מעבר לגאפ הורגת אותו בשני הכיוונים. סגירה של YM
// הורגת רק גאפ דובי — סגירה שלו מתחת לגאפ שורי היא החולשה הצפויה שלו.
//
// מיפוי תת-מחזור/מיכל לכל מסגרת זמן:
//   1M  — רבע 22.5m   → מיקרו-סשן    5M  — מיקרו-סשן → סשן
//   15M — סשן          → יום מסחר      1H  — יום מסחר  → שבוע
//   4H  — שבוע         → חודש          1D  — רבע-רבעון → שנה
//   1W  — רבעון        → שנה           Mo  — שנה       → מחזור 4 שנים
//
// הצנרת (זמן, סייקלים, תת-מחזור/מיכל) זהה ל-SSMT+HSSMT.
// ═══════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════
// הגדרות משתמש
// ═══════════════════════════════════════════════════════════════════

grpSym = "סימבולים"
// "אוטומטי" מתאים את סט החוזים לגרף. גרף MNQ שקורא נתוני NQ (או להפך) נותן
// גבולות גאפ שנכונים מתמטית אבל לא יושבים על הנרות שרואים — שתי הסדרות
// הרציפות מתגלגלות בתאריכים שונים ומחיריהן ההיסטוריים אינם זהים.
contractSet = input.string("אוטומטי", "סט חוזים", options = ["אוטומטי", "רגיל", "מיקרו"], group = grpSym)
symNQ_std = input.symbol("CME_MINI:NQ1!",   "NQ רגיל", group = grpSym)
symES_std = input.symbol("CME_MINI:ES1!",   "ES רגיל", group = grpSym)
symYM_std = input.symbol("CBOT_MINI:YM1!",  "YM רגיל", group = grpSym)
symNQ_mic = input.symbol("CME_MINI:MNQ1!",  "NQ מיקרו", group = grpSym)
symES_mic = input.symbol("CME_MINI:MES1!",  "ES מיקרו", group = grpSym)
symYM_mic = input.symbol("CBOT_MINI:MYM1!", "YM מיקרו", group = grpSym)

grpGap = "הגדרת גאפ"
extendBodies = input.bool(true, "הרחב גאפ לגופי הנרות (רווח סגירה/פתיחה)", group = grpGap)
// סוג גאפ שני, על **שני נרות** ולא על שלושה: נר נסגר ב-24200 והנר שאחריו
// נפתח ב-24201 — שתי הנקודות האלה לא נסחרו ברגע המעבר, וזה גאפ שמיש.
// **רצף — שני הנרות חייבים ללכת לאותו כיוון.** לא נר יורד ואחריו נר עולה.
// רווח כלפי מעלה נספר רק כששני הנרות עולים, וכלפי מטה רק כששניהם יורדים.
// **חוץ ממעבר סייקל** — פתיחת יום, שבוע או סשן לפי הזמנים שלנו. שם הרווח
// נולד מהמעבר עצמו (סגירה של אתמול מול פתיחה של היום) ולא מתנועה של
// הנרות, ולכן אין טעם לדרוש רצף והוא נספר כמו שהוא.
// VI ו-FVG נספרים יחד לאותו גאפ קולקטיבי: NQ עם VI ו-ES עם FVG באותו נר
// זה גאפ תקף. **הגודל לא משנה** — רווח של 0.25 הוא רווח בדיוק כמו 15 נק',
// ועליו יכולות להירשם כל הדרגות.
// **ולנכס שיש לו גם FVG וגם VI באותו נר — הם מתאחדים לגאפ אחד גדול**,
// min של התחתונים ו-max של העליונים. FVG מורחב, לא שני גאפים נפרדים.
// מסומן V בהצצה רק כשאף נכס משתתף לא נתן FVG.
volImbOn     = input.bool(true, "זהה גם גאפ סגירה/פתיחה בין שני נרות", tooltip = "Volume Imbalance — הרווח בין הסגירה של נר לפתיחה של הנר שאחריו. נספר יחד עם FVG רגיל לאותו גאפ קולקטיבי, ומסומן V בהצצה כשכל הרגליים הן VI.", group = grpGap)
// כיבוי מחזיר את ההתנהגות הישנה: רק NQ מול ES, YM לא משתתף בכלל.
useYM        = input.bool(true, "כלול את YM כנכס חלש", group = grpGap)
// השאר על 0. האסימטריה בין הנכסים היא הסיגנל עצמו — סינון לפי גודל
// חותך דווקא את השבירות החזקות (גאפ גדול בנכס אחד מול גאפ קטן בשני).
minGapPct    = input.float(0.0, "גודל גאפ מינימלי (% מהמחיר)", minval = 0.0, maxval = 1.0, step = 0.01, group = grpGap)
maxGaps      = input.int(60, "מקסימום גאפים במיכל", minval = 5, maxval = 200, group = grpGap)

grpVis = "תצוגה"
colBull   = input.color(#26a69a, "צבע שורי", group = grpVis)
colBear   = input.color(#ef5350, "צבע דובי", group = grpVis)
// הכיתוב יכול להגיע ל-"F2 NQ+ES+YM" ולכן ברירת המחדל קטנה — אחרת הוא
// נפרס על כל רוחב הקופסה.
capSize   = input.string("tiny", "גודל הכיתוב", options = ["tiny", "small", "normal"], group = grpVis)
offsetMlt = input.float(1.5, "מרחק התווית מהנר (ATR)", minval = 0.1, maxval = 6.0, step = 0.1, group = grpVis)
showBox   = input.bool(true, "הצג קופסת גאפ", group = grpVis)
boxTransp = input.int(90, "שקיפות המילוי", minval = 50, maxval = 98, group = grpVis)
boxBorder = input.int(45, "שקיפות המסגרת", minval = 0, maxval = 95, group = grpVis)
boxLen    = input.string("עד הנר הנוכחי", "אורך הקופסה", options = ["עד הנר הנוכחי", "עד נר השבירה", "קצר (12 נרות)"], group = grpVis)
// כיתוב אחד בלבד, לא שניים. "בתוך הקופסה" דורש שהקופסה עצמה תהיה דלוקה.
labelMode = input.string("בתוך הקופסה", "סגנון הכיתוב", options = ["בתוך הקופסה", "תג בקצה הקופסה", "תווית ליד הנר", "בלי כיתוב"], group = grpVis)
showCE    = input.bool(false, "הצג קו CE (חצי גאפ)", group = grpVis)
// מצייר את הגאפים הקולקטיביים ה**דרוכים**, לא רק את זה שנושא את השבירה —
// כלומר אלה של תת-המחזורים שהסתיימו בתוך המיכל הנוכחי, אותם ואת אלה בלבד
// יכולה שבירה להיווצר עליהם עכשיו. מסומן #id ושם תת-המחזור.
// דלוק = תמיד, בכל מסגרת.
showAllGaps = input.bool(false, "הצג את הגאפים הדרוכים (תמיד)", group = grpVis)
// הצצה אוטומטית: ב-4H ומטה אותם גאפים דרוכים נצבעים לכמה שניות בכל טעינה
// של הסקריפט — כלומר בכל פעם שמחליפים מסגרת זמן או פותחים את הגרף — ואז
// נעלמים מעצמם. ככה רואים מיד איזה גאפים באמת במשחק בלי להיכנס להגדרות,
// והגרף נשאר נקי אחרי זה. ההגדרה שמעל נשארת למי שרוצה אותם קבוע.
autoAllGaps = input.bool(true, "הצצה: הגאפים הדרוכים בהחלפת מסגרת (4H ומטה)", group = grpVis)
autoAllSec  = input.int(20, "כמה שניות להשאיר את ההצצה", minval = 1, maxval = 600, group = grpVis)
// לאבחון בלבד: מצייר גם את הגאפים שבוטלו ב-IFVG, באפור ועם ✕. זה מה שעונה
// על "הגאפ הזה בכלל נוצר?" — אם הוא לא מופיע גם ככה, הוא פשוט לא נוצר
// (לא היו שני נכסים באותו כיוון באותו נר). כבוי כברירת מחדל.
showDeadGaps = input.bool(false, "הצג גם גאפים שבוטלו ב-IFVG (✕)", tooltip = "לאבחון: גאפ אפור עם ✕ נוצר אבל נסגר נר מעבר לו. אם הגאפ שאתה מחפש לא מופיע גם עם זה דלוק — הוא לא נוצר מלכתחילה.", group = grpVis)
showDebug   = input.bool(false, "הצג טבלת בדיקה", group = grpVis)

grpLogic = "לוגיקה"
blockDeadWeek = input.bool(true, "חסום שבירות בשבוע מת (4H בלבד)", group = grpLogic)

grpAlert = "התראות"
// ההתראה רצה בשרתי TradingView, לא בדפדפן — אפשר להקים אותה על גרף 15 דקות
// והיא תקפוץ גם כשיושבים על 5 דקות או כשהגרף סגור.
alertOn     = input.bool(true, "שלח התראה על שבירה חדשה", group = grpAlert)
alertMinDeg = input.int(1, "דרגה מינימלית להתראה", minval = 1, maxval = 3, group = grpAlert)

grpMtf = "מסגרות זמן"
// המנוע רץ שוב, בנפרד לגמרי, על כל מסגרת זמן אחרת — עם אותם חוקים בדיוק.
// כך אפשר לשבת על 5 דקות ולראות שנסגר נר 15 דקות שיצר שבירה, בלי להחליף
// גרף ובלי להקים התראה נפרדת לכל מסגרת.
// הפאנל כבוי כברירת מחדל — הוא נותן תמונה מלאה של כל המסגרות, אבל תופס
// מקום על המסך. הדלק אותו כשאתה רוצה להיכנס לפרטים.
showMtf      = input.bool(false, "הצג פאנל מסגרות זמן", group = grpMtf)
// מסגרות נמוכות נמשכות כתת-נרות (request.security_lower_tf). טריידינגויו מגביל
// את כמות תת-הנרות, ולכן ככל שיורדים יותר מדרגות ההיסטוריה מתקצרת והחישוב כבד
// יותר. 2 מדרגות זו נקודת האיזון; 0 מכבה את זה לגמרי.
lowerLevels  = input.int(2, "כמה מדרגות מתחת לגרף", minval = 0, maxval = 3, group = grpMtf)
mtfPos       = input.string("ימין למטה", "מיקום הפאנל", options = ["ימין למטה", "ימין למעלה", "ימין באמצע", "שמאל למטה", "שמאל למעלה"], group = grpMtf)
// זה מה שרץ כשהפאנל כבוי: שורת טקסט זעירה בפינת המסך שאומרת שנסגרה שבירה
// במסגרת אחרת. במצב "רק כששבירה נולדת" היא מופיעה ונעלמת אחרי כמה שניות;
// במצב השני היא נשארת כל עוד יש שבירה חיה במסגרת אחרת — שימושי כדי לראות
// שזה בכלל עובד, בלי לחכות לאירוע.
mtfFlash     = input.bool(true, "הצג סימון זעיר משאר המסגרות", group = grpMtf)
flashMode    = input.string("רק כששבירה נולדת", "מתי להציג", options = ["רק כששבירה נולדת", "כל עוד יש שבירה חיה"], group = grpMtf)
// 15–30 שניות זה הטווח שעובד. הסימון מצויר רק כשהסקריפט רץ מחדש על הנר
// החי, וזה קורה רק כשמגיע טיק — ולכן חלון של 2–3 שניות קטן מהמרווח בין
// טיקים בשוק שקט, והסימון או שלא נראה בכלל או שנתקע עד הטיק הבא. מתחת
// ל-5 שניות ההתנהגות כבר לא צפויה, ולכן זה המינימום.
mtfFlashSec  = input.int(20, "כמה שניות להשאיר את הסימון", minval = 5, maxval = 300, tooltip = "מומלץ 15–30. הסימון נעלם בטיק הראשון אחרי שהחלון נגמר, ולכן בשוק שקט הוא יכול להישאר עוד כמה שניות.", group = grpMtf)
flashPos     = input.string("שמאל למטה", "מיקום הסימון", options = ["שמאל למטה", "שמאל למעלה", "ימין למטה", "ימין למעלה", "אמצע למטה"], group = grpMtf)
// טריידינגויו מדביק טבלאות של אינדיקטורים שונים באותה פינה זו לצד זו. שורות
// ריקות מרימות את השורה שלנו מעל השורה של האינדיקטור השני, בלי לשנות כלום
// בעיצוב עצמו. 0 = צמוד לקצה כמו קודם.
flashLift    = input.int(1, "הרם את הסימון (שורות)", minval = 0, maxval = 6, group = grpMtf)
// זוג האותיות שפותח את השורה, בדיוק כמו ה-QT של האינדיקטור השני.
flashTag     = input.string("SF", "תווית פתיחה לשורה", group = grpMtf)
flashTagCol  = input.color(color.gray, "צבע התווית", group = grpMtf)
mtfAlert     = input.bool(true, "כלול שבירות ממסגרות אחרות בהתראה", group = grpMtf)

// ═══════════════════════════════════════════════════════════════════
// בחירת סימבולים
// ═══════════════════════════════════════════════════════════════════

cs           = syminfo.tickerid
isNQc        = str.contains(cs, "NQ")
isESc        = str.contains(cs, "ES")
isYMc        = str.contains(cs, "YM")
chartIsMicro = str.contains(cs, "MNQ") or str.contains(cs, "MES") or str.contains(cs, "MYM")
useMicro     = contractSet == "מיקרו" or (contractSet == "אוטומטי" and chartIsMicro)

sNQ = useMicro ? symNQ_mic : symNQ_std
sES = useMicro ? symES_mic : symES_std
sYM = useMicro ? symYM_mic : symYM_std

// ═══════════════════════════════════════════════════════════════════
// זיהוי Timeframe
// ═══════════════════════════════════════════════════════════════════

// 1 = 1m · 2 = 5m · 3 = 15m · 4 = 1H · 5 = 4H · 6 = יומי · 7 = שבועי · 8 = חודשי
tfMin   = timeframe.in_seconds() / 60
tfClass = tfMin <= 1 ? 1 : tfMin <= 5 ? 2 : tfMin <= 15 ? 3 : tfMin <= 60 ? 4 : tfMin <= 240 ? 5 : tfMin <= 1440 ? 6 : tfMin <= 10080 ? 7 : tfMin <= 44640 ? 8 : 0

// ═══════════════════════════════════════════════════════════════════
// חישובי זמן EST
// ═══════════════════════════════════════════════════════════════════

TZ = "America/New_York"
estHour = hour(time, TZ)
estMin  = minute(time, TZ)

minutesOfDay = estHour * 60 + estMin

isPostOpen       = minutesOfDay >= 1080
minsFromDayStart = isPostOpen ? minutesOfDay - 1080 : minutesOfDay + 360

tradeDayTime = isPostOpen ? time + 86400000 : time
tdYear = year(tradeDayTime, TZ)
tdMon  = month(tradeDayTime, TZ)
tdDom  = dayofmonth(tradeDayTime, TZ)
tdDow  = dayofweek(tradeDayTime, TZ)

sessionIdx    = math.floor(minsFromDayStart / 360)
minsInSession = minsFromDayStart % 360
microIdx      = math.floor(minsInSession / 90)
minsInMicro   = minsInSession % 90
quarterIdx    = math.floor(minsInMicro / 22.5)

// ═══════════════════════════════════════════════════════════════════
// מספור שבועות לפי QT
// ═══════════════════════════════════════════════════════════════════

daysSinceMonday = tdDow == dayofweek.sunday ? 6 : tdDow - 2
mondayTime      = tradeDayTime - daysSinceMonday * 86400000
tuesdayTime     = mondayTime + 86400000
thursdayTime    = mondayTime + 3 * 86400000

monMonth = month(mondayTime, TZ)
monDom   = dayofmonth(mondayTime, TZ)
monYear  = year(mondayTime, TZ)
tueMonth = month(tuesdayTime, TZ)
tueDom   = dayofmonth(tuesdayTime, TZ)
tueYear  = year(tuesdayTime, TZ)
thuMonth = month(thursdayTime, TZ)

// שבוע שייך לחודש שבו נמצאים לפחות 4 מתוך 5 ימי המסחר שלו. אם אין חודש כזה —
// שבוע מת. **העוגן הוא יום שלישי**, וזה מימוש שקול ופשוט של אותו כלל:
//   שני 31.8, אחריו 1–4.9  → שלישי בספטמבר → שבוע 1 של ספטמבר (4 מ-5 ימים שם)
//   שני+שלישי בחודש הישן   → שלישי וחמישי בחודשים שונים → שבוע מת
//   שני–חמישי בחודש הישן   → שלישי וחמישי באותו חודש ישן → השבוע האחרון שלו
// עיגון ליום שני היה מזיז את המיכל החודשי לשבוע הלא נכון, וכל תחילת חודש
// נשארה בלי אף תת-מחזור להשוות אליו.
// תוצאת לוואי: המספור הזה מיישר את "שבוע 2" עם שבוע פרסום ה-CPI ברוב
// החודשים, בלי יומן מאקרו (שאין אליו גישה ב-Pine).
isDeadWeek = tueMonth != thuMonth
qtWeekNum  = isDeadWeek ? 0 : math.floor((tueDom - 1) / 7) + 1

// ═══════════════════════════════════════════════════════════════════
// מזהי מחזורים
// ═══════════════════════════════════════════════════════════════════

tradeDayId = tdYear * 10000 + tdMon * 100 + tdDom
// weekId הוא רק מזהה ייחודי לשבוע, ולכן יום שני מספיק לו.
weekId     = monYear * 10000 + monMonth * 100 + monDom
// monthId הוא זה שקובע מתי המיכל החודשי מתאפס, ולכן הוא **לפי יום שלישי** —
// אותו עוגן של isDeadWeek ו-qtWeekNum. כך הגבול נופל תמיד בתחילת שבוע, ושבוע
// שרק יום שני שלו בחודש הקודם נספר נכון לחודש החדש.
// **שבוע מת הוא מיכל בפני עצמו.** הוא לא שייך לאף חודש לפי כלל 4-מתוך-5,
// ולכן אסור לו לגרור את החודש הקודם עוד שבוע: הוא מקבל את weekId שלו,
// והמיכל מתאפס כבר בשני שלו ולא רק בשני של החודש הבא. בלי זה שבירה 4H
// מ-18.9 הייתה שורדת עד 5.10 רק כי העוגן נפל על 29.9.
// אין התנגשות: monthId אמיתי הוא שש ספרות (202609) ו-weekId שמונה (20260928).
monthId    = isDeadWeek ? weekId : tueYear * 100 + tueMonth
sessionId  = tradeDayId * 10 + sessionIdx
microId    = sessionId * 10 + microIdx
quarterId  = microId * 10 + quarterIdx

// כמה ימים יש בחודש — כולל שנה מעוברת לפי הכלל המלא (מתחלק ב-4, חוץ
// ממאות שלא מתחלקות ב-400). משמש את חלוקת הרבעון לארבעה.
f_dim(int y, int m) =>
    m == 2 ? (((y % 4 == 0 and y % 100 != 0) or y % 400 == 0) ? 29 : 28) : (m == 4 or m == 6 or m == 9 or m == 11 ? 30 : 31)

// הרמות שמעל החודש — משמשות את היומי, השבועי והחודשי.
// רבעון = שלושה חודשים קלנדריים: ינו–מרץ · אפר–יוני · יולי–ספט · אוק–דצמ.
// מחזור 4 שנים = בלוק שמתחיל בשנת בחירות (2024, 2028, ...).
qOfYear = int(math.ceil(tdMon / 3.0))
qtrId   = tdYear * 10 + qOfYear
yearId  = tdYear
quadId  = int(math.floor(tdYear / 4.0))

// ── רבע-רבעון — תת-המחזור של הגרף היומי ──
// כל רבעון נמדד בנפרד ומחולק לארבעה חלקים שווים. אין כאן מספר קבוע:
// אורך הרבעון הוא סכום שלושת החודשים שלו בפועל, ולכן Q1 של שנה רגילה
// הוא 90 יום (23+22+23+22) ו-Q3 הוא 92 יום (23+23+23+23).
//   Q1 90/91 · Q2 91 · Q3 92 · Q4 92
// החישוב הוא בימי לוח שלמים מתוך התאריך עצמו — לא בחותמות זמן — ולכן
// מעבר שעון קיץ לא מזיז את הגבול ברבע יום כמו קודם.
qStartMon = (qOfYear - 1) * 3 + 1
// אורך הרבעון בימים
qLenD     = f_dim(tdYear, qStartMon) + f_dim(tdYear, qStartMon + 1) + f_dim(tdYear, qStartMon + 2)
// כמה ימים עברו מתחילת הרבעון (0 = היום הראשון שלו)
qDayInQ   = (tdDom - 1) + (tdMon > qStartMon ? f_dim(tdYear, qStartMon) : 0) + (tdMon > qStartMon + 1 ? f_dim(tdYear, qStartMon + 1) : 0)
qqIdx     = math.min(3, math.max(0, int(math.floor(qDayInQ * 4.0 / qLenD))))
qqId      = qtrId * 10 + qqIdx

refCycleId = 0
if tfClass == 8
    refCycleId := yearId
else if tfClass == 7
    refCycleId := qtrId
else if tfClass == 6
    refCycleId := qqId
else if tfClass == 5
    refCycleId := weekId
else if tfClass == 4
    refCycleId := tradeDayId
else if tfClass == 3
    refCycleId := sessionId
else if tfClass == 2
    refCycleId := microId
else if tfClass == 1
    refCycleId := quarterId

lifeCycleId = 0
if tfClass == 8
    lifeCycleId := quadId
else if tfClass == 7
    lifeCycleId := yearId
// היומי שומר על מיכל שנתי. מיכל רבעוני היה מוחק את הרשימה ארבע פעמים
// בשנה, ומיד אחרי כל מחיקה הגרף היומי נשאר על 0 גאפים חיים לשבועות.
else if tfClass == 6
    lifeCycleId := yearId
else if tfClass == 5
    lifeCycleId := monthId
else if tfClass == 4
    lifeCycleId := weekId
else if tfClass == 3
    lifeCycleId := tradeDayId
else if tfClass == 2
    lifeCycleId := sessionId
else if tfClass == 1
    lifeCycleId := microId

newRefCycle  = ta.change(refCycleId)  != 0
newLifeCycle = ta.change(lifeCycleId) != 0

// "זרע": התת-מחזור הראשון של מיכל חדש משווה גם לגאפים של התת-מחזור האחרון
// של המיכל הקודם, והזרע נמחק כשהתת-מחזור הראשון נגמר. בלעדיו כל תחילת מיכל
// שותקת — אין לה שום תת-מחזור להשוות אליו עד שהראשון שלה נסגר בעצמו.
//   1M — הרבע האחרון של מיקרו אחד מול הרבע הראשון של המיקרו הבא.
//   5M — המיקרו האחרון של לונדון מול הראשון של NY-AM. חל בכל החלפת סשן,
//        כולל PM→אסיה של היום הבא וכולל שישי→פתיחת יום ראשון בערב.
//   1H — יום שני משווה גם לגאפי יום שישי, שנמחקים בסוף יום שני.
//   1D — הרבע-רבעון הראשון של השנה משווה גם לאחרון של השנה הקודמת.
//   1W — הרבעון הראשון בשנה משווה גם לגאפי Q4 של השנה הקודמת.
//   Mo — השנה הראשונה במחזור משווה גם לגאפי השנה האחרונה שלפניה.
// אין זרע ב-15M (סשנים מושווים רק בתוך אותו יום מסחר) ואין ב-4H (שבועות
// מושווים רק בתוך אותו חודש). לכבות זרע במסגרת = להוריד אותה מהתנאי כאן.
keepLast = tfClass <= 2 or tfClass == 4 or tfClass >= 6

// ═══════════════════════════════════════════════════════════════════
// משיכת נתוני שלושת הנכסים (open נדרש להרחבת הגאפ לגופים)
// ═══════════════════════════════════════════════════════════════════

[rNqO, rNqH, rNqL, rNqC] = request.security(sNQ, timeframe.period, [open, high, low, close], lookahead = barmerge.lookahead_off)
[rEsO, rEsH, rEsL, rEsC] = request.security(sES, timeframe.period, [open, high, low, close], lookahead = barmerge.lookahead_off)
[rYmO, rYmH, rYmL, rYmC] = request.security(sYM, timeframe.period, [open, high, low, close], lookahead = barmerge.lookahead_off)

// **כל המדידות משלוש הסדרות של request.security, בלי יוצא מן הכלל.**
// קודם הנכס שהגרף מציג נקרא מהגרף עצמו, והשאר מ-request.security. זה נתן
// שתי תוצאות שונות לאותה שבירה: על גרף NQ נמדד NQ מהגרף ו-ES מהסדרה, ועל
// גרף ES בדיוק הפוך. ההגדרה "Adjust for contract changes" מתקנת אחורה את
// ההיסטוריה של החוזה הרציף ו-request.security לא מקבל אותה, ולכן שתי
// הסדרות נפרדות בגובהן — והעומקים, ואיתם הדרגה, יצאו שונים. ככה אותה
// שבירה שבועית הופיעה F3 על MNQ ו-F2 על MES.
// עכשיו המדידה אחידה בכל גרף, בדיוק כמו המנועים של שאר המסגרות (שתמיד
// קראו את שלושתם מהסדרה — ולכן הם תמיד הסכימו ביניהם).
nqO = rNqO
nqH = rNqH
nqL = rNqL
nqC = rNqC
esO = rEsO
esH = rEsH
esL = rEsL
esC = rEsC
ymO = rYmO
ymH = rYmH
ymL = rYmL
ymC = rYmC

// ── הגבולות שמצוירים ──
// המלכודת המקורית בעינה עומדת: קופסה שמצוירת לפי הסדרה הגולמית על גרף
// מתוקן יוצאת מוזזת במאות נקודות. לכן הגבולות של **הציור בלבד** נלקחים
// מהגרף עצמו, ונשמרים בנפרד ב-drwBot/drwTop. המדידה לא נוגעת בהם.

// ═══════════════════════════════════════════════════════════════════
// טיפוס הגאפ הקולקטיבי
//
// גבול na פירושו שלנכס הזה אין את הגאפ. כך אותו טיפוס מכסה גאפ של שניים
// ושל שלושה, בלי דגלים נפרדים.
// ═══════════════════════════════════════════════════════════════════

type Gap
    int    id
    int    dir      // 1 = שורי (יושב מתחת למחיר), -1 = דובי
    float  nqBot    // הגבולות הסופיים — פתיל, מורחב לגוף היכן שיש רווח אמיתי
    float  nqTop
    float  esBot
    float  esTop
    float  ymBot
    float  ymTop
    float  nqRawBot // ה-FVG הקלאסי בפתילים בלבד, בלי הרחבה — לאבחון
    float  nqRawTop
    float  esRawBot
    float  esRawTop
    // תת-המחזור של **הנר האמצעי** — הנר שיצר את חוסר האיזון. הנר השלישי רק
    // מאשר אותו, ולכן גאפ שנוצר ב-23:45 שייך לאסיה גם אם האישור הגיע ב-00:00.
    int    refId
    int    birth    // הנר השלישי — הנר שסגר את ה-FVG (משמש למניעת IFVG על נר הלידה)
    int    birthT   // זמן הפתיחה של הנר האמצעי — הזמן שבו הגאפ באמת נוצר
    int    origin   // הנר הראשון של ה-FVG — משם מתחילה הקופסה
    float  nqExt    // הקיצוניות בביקור הנוכחי (min ל-bull, max ל-bear)
    float  esExt
    float  ymExt
    int    nqExtB   // הנר של הקיצוניות — לאבחון
    int    esExtB
    int    armB     // הנר שבו הגאפ נדרך — לאבחון
    int    visits   // כמה פעמים המחיר חזר לגאפ
    bool   inVisit  // האם אנחנו כרגע בתוך ביקור
    bool   dead     // הפך ל-IFVG — הרעיון מתבטל
    bool   armed    // תת-המחזור שבו נולד הסתיים — רק עכשיו הוא יכול לייצר שבירה
    // true = גאפ סגירה/פתיחה בין שני נרות (Volume Imbalance), ולא FVG של
    // שלושה. משמש לכיתוב (V בהצצה) — כל שאר הלוגיקה זהה לשני הסוגים.
    bool   volImb
    // ── השבירה של הגאפ הזה. כל גאפ מחזיק את שלו, הן לא מתחרות על מקום אחד ──
    int    fDeg     // 0 = עוד לא נרשמה שבירה. 1..3, יכול רק לעלות.
    string fLead    // המשתתפים לפי סדר עומק, למשל "NQ+ES+YM"
    int    fSigB    // הנר שבו נרשמה
    int    fSeq     // מונה רץ — הגבוה ביותר הוא זה שמצויר
    float  fYPos    // גובה התווית
    // ── גבולות לציור בלבד, בסקאלה של הגרף עצמו ──
    // na = לנכס שהגרף מציג אין את הגאפ הזה, ואז פשוט אין קופסה.
    float  drwBot
    float  drwTop

var array<Gap> gaps = array.new<Gap>()
var int gapCounter  = 0

f_name(int a) =>
    a == 0 ? "NQ" : a == 1 ? "ES" : "YM"

// ── הרשימה מלאה: מי יוצא ──
// array.shift הוציא תמיד את הגאפ ה**ישן ביותר**, ולכן גאפ אמיתי מיום שני
// שנושא שבירה חיה הוצא כדי לפנות מקום לגאפ בן שלושה טיקים שמת מיד אחריו.
// סדר הפינוי עכשיו הוא לפי ערך: קודם המת הישן ביותר (הוא כבר לא משחק),
// אחריו הישן ביותר בלי שבירה, ורק אם לכולם יש שבירה — הישן ביותר.
// האיבר ב-0 הוא הישן ביותר, כי הדחיפה תמיד לסוף.
f_trim(array<Gap> a) =>
    if array.size(a) > maxGaps
        int k = -1
        for i = 0 to array.size(a) - 1
            if k == -1 and array.get(a, i).dead
                k := i
        if k == -1
            for i = 0 to array.size(a) - 1
                if k == -1 and array.get(a, i).fDeg == 0
                    k := i
        array.remove(a, k == -1 ? 0 : k)

// עומק החדירה של נכס לתוך הגאפ שלו, כאחוז מהגאפ שלו (פתיל).
// ההשוואה בין הנכסים היא תמיד יחסית — כל נכס מול הגאפ שלו.
// 0 = לא נגע · 0.5 = CE · 1.0 = הקצה הרחוק · >1 = מעבר לגאפ בפתיל
// na = לנכס הזה אין את הגאפ, הוא לא משתתף.
method depthOf(Gap g, int a) =>
    float top = a == 0 ? g.nqTop : a == 1 ? g.esTop : g.ymTop
    float bot = a == 0 ? g.nqBot : a == 1 ? g.esBot : g.ymBot
    float ext = a == 0 ? g.nqExt : a == 1 ? g.esExt : g.ymExt
    float d = na
    if not na(top) and not na(ext) and top - bot > 0
        d := g.dir == 1 ? (top - ext) / (top - bot) : (ext - bot) / (top - bot)
        d := math.max(d, 0.0)
    d

// הנכס המוביל — העמוק ביותר. בגאפ שורי YM פסול לתפקיד: נפילה עמוקה שלו היא
// החולשה הצפויה שלו ואין בה מידע.
method leadIdx(Gap g) =>
    int   best = -1
    float bd   = -1.0
    for a = 0 to 2
        if not (g.dir == 1 and a == 2)
            float d = g.depthOf(a)
            if not na(d) and d > bd
                bd   := d
                best := a
    best

// הנכס המפגר — הרדוד ביותר. בגאפ דובי YM פסול לתפקיד: אי-כניסה שלו לגאפ
// שמעל המחיר היא בדיוק מה שמצפים מנכס חלש.
method lagIdx(Gap g) =>
    int   worst = -1
    float wd    = 1e12
    for a = 0 to 2
        if not (g.dir == -1 and a == 2)
            float d = g.depthOf(a)
            if not na(d) and d < wd
                wd    := d
                worst := a
    worst

// דרגת השבירה — הגבוהה ביותר שמתקיימת. 0 = אין שבירה.
f_degree(float dLead, float dLag) =>
    int deg = 0
    if dLead >= 1.0 and dLag < 1.0
        deg := 3
    else if dLead >= 0.5 and dLag < 0.5
        deg := 2
    else if dLead > 0.0 and dLag <= 0.0
        deg := 1
    deg

// הדרגה כפי שהיא מוצגת למשתמש
f_degTxt(int d) =>
    "F" + str.tostring(d)
// אותו דבר בלי האות, ועם "-" כשאין שבירה בכלל — לטבלאות האבחון
f_degNum(int d) =>
    d == 0 ? "-" : str.tostring(d)

// הדרגה של הגאפ ברגע הזה, אחרי מגבלות התפקיד של YM.
method fracDeg(Gap g) =>
    int li = g.leadIdx()
    int gi = g.lagIdx()
    int deg = 0
    if li != -1 and gi != -1 and li != gi
        deg := f_degree(g.depthOf(li), g.depthOf(gi))
    deg

// "NQ+ES" או "NQ+ES+YM" — המוביל ראשון, המפגר אחרון, והשלישי באמצע.
method fracTxt(Gap g) =>
    int li = g.leadIdx()
    int gi = g.lagIdx()
    string t = ""
    if li != -1 and gi != -1 and li != gi
        t := f_name(li)
        for a = 0 to 2
            if a != li and a != gi and not na(g.depthOf(a))
                t := t + "+" + f_name(a)
        t := t + "+" + f_name(gi)
    t

// שם קריא למחלקת מסגרת זמן. החודשי הוא "Mo" ולא "1M", כדי שלא יתבלבל עם
// "1m" של הדקה בשורת הסימון הזעירה בפינה.
f_clsName(int c) =>
    c == 8 ? "Mo" : c == 7 ? "1W" : c == 6 ? "1D" : c == 5 ? "4H" : c == 4 ? "1H" : c == 3 ? "15m" : c == 2 ? "5m" : c == 1 ? "1m" : "?"

// שם קצר לתת-המחזור שבו נולד הגאפ, לפי מחלקת מסגרת הזמן. מקבל את birthT —
// זמן הנר האמצעי, זה שיצר את חוסר האיזון.
// זה מה שמאשר בעין שמוצגים רק הגאפים הרלוונטיים: בגרף שעה ביום שלישי
// יופיע רק Mon, ובגרף 15 דקות ב-NY-AM רק Asia ו-London.
// באנגלית ובקצרה בכוונה — זה טקסט בתוך קופסה על הגרף, ועברית מעורבת שם
// יוצאת הפוכה ודוחפת את הכיתוב.
f_subName(int c, int t) =>
    int  eh   = hour(t, TZ)
    int  mnd  = eh * 60 + minute(t, TZ)
    bool post = mnd >= 1080
    int  tdt  = post ? t + 86400000 : t
    int  mfd  = post ? mnd - 1080 : mnd + 360
    int  sIdx = math.floor(mfd / 360)
    int  mInS = mfd % 360
    int  uIdx = math.floor(mInS / 90)
    int  qIdx = math.floor((mInS % 90) / 22.5)
    int  dw   = dayofweek(tdt, TZ)
    int  yy   = year(tdt, TZ)
    int  mm   = month(tdt, TZ)
    int  dd   = dayofmonth(tdt, TZ)
    string ss = sIdx == 0 ? "Asia" : sIdx == 1 ? "London" : sIdx == 2 ? "AM" : "PM"
    string dn = dw == dayofweek.monday ? "Mon" : dw == dayofweek.tuesday ? "Tue" : dw == dayofweek.wednesday ? "Wed" : dw == dayofweek.thursday ? "Thu" : dw == dayofweek.friday ? "Fri" : "WE"
    string r  = ""
    if c == 1
        r := ss + " " + str.tostring(uIdx + 1) + "." + str.tostring(qIdx + 1)
    else if c == 2
        r := ss + " " + str.tostring(uIdx + 1)
    else if c == 3
        r := ss
    else if c == 4
        r := dn
    else if c == 5
        // שבוע בתוך החודש — אותו עוגן יום-שלישי של המיכל החודשי
        int dsm  = dw == dayofweek.sunday ? 6 : dw - 2
        int tueT = tdt - dsm * 86400000 + 86400000
        r := "W" + str.tostring(math.floor((dayofmonth(tueT, TZ) - 1) / 7) + 1)
    else if c == 6
        // רבע-רבעון, אותו חישוב של הגרף: אורך הרבעון בפועל חלקי ארבע
        int qOf  = int(math.ceil(mm / 3.0))
        int qsM  = (qOf - 1) * 3 + 1
        int qLn  = f_dim(yy, qsM) + f_dim(yy, qsM + 1) + f_dim(yy, qsM + 2)
        int qDiQ = (dd - 1) + (mm > qsM ? f_dim(yy, qsM) : 0) + (mm > qsM + 1 ? f_dim(yy, qsM + 1) : 0)
        r := "QQ" + str.tostring(math.min(3, math.max(0, int(math.floor(qDiQ * 4.0 / qLn)))) + 1)
    else if c == 7
        r := "Q" + str.tostring(int(math.ceil(mm / 3.0)))
    else if c == 8
        r := str.tostring(yy)
    r

// ═══════════════════════════════════════════════════════════════════
// מנוע עצמאי למסגרת זמן אחרת
//
// אותם חוקים בדיוק כמו הגרף הראשי, רק שהם רצים על נרות של מסגרת אחרת.
// כל נכס מגיע כמערך של תשעה מספרים משלושת הנרות האחרונים שנסגרו:
//   [0]=open0 [1]=high0 [2]=low0 [3]=close0 [4]=open1 [5]=close1
//   [6]=high2 [7]=low2  [8]=close2
// כל המצב יושב באובייקט Engine, כך שאפשר להריץ כמה מנועים במקביל.
//
// הפאנל לא מציג מחירים, רק כיוון ודרגה — ולכן כאן אין את בעיית
// "Adjust for contract changes": העומק של כל נכס מנורמל לגאפ של עצמו.
// ═══════════════════════════════════════════════════════════════════

type Engine
    int          cls        // מחלקת מסגרת הזמן (1..8)
    array<Gap>   gaps
    array<float> hN         // שני הנרות הקודמים של NQ: [o1,h1,l1,c1,o2,h2,l2,c2]
    array<float> hE         // אותו דבר ל-ES
    array<float> hY         // אותו דבר ל-YM. משמש רק את מסלול המסגרות הנמוכות.
    int          gapCounter
    int          seqCounter
    bool         seedActive
    int          seedRefId
    int          refId      // תת-המחזור של הצעד הקודם
    int          lifeId     // המיכל של הצעד הקודם
    bool         started
    int          lastT      // זמן הפתיחה של הנר שכבר עובד — מונע צעד כפול
    int          shownDir
    int          curRef     // המחזורים של הנר הנוכחי, נכתבים ע"י f_setCycles
    int          curLife
    bool         curDead
    int          curDow
    int          fDir       // השבירה המוצגת של המנוע
    int          fDeg
    string       fLead
    int          fSeq
    int          fTime      // זמן הסגירה שבו נרשמה — לחישוב "טרייה"
    int          fGapId     // הגאפ שנושא את השבירה המוצגת
    int          fWhen      // ומתי הוא נולד
    bool         justFired

// כל מזהי המחזורים מתוך חותמת זמן של נר, לפי מחלקת מסגרת הזמן.
// זהה לחישוב שרץ למעלה על נרות הגרף, רק שהוא מקבל את הזמן כפרמטר.
// התוצאה נכתבת לתוך המנוע ולא מוחזרת כטאפל, כדי שאפשר יהיה לקרוא לזה גם
// מתוך לולאה על תת-נרות.
f_setCycles(Engine e, int t) =>
    int  c    = e.cls
    int  eh   = hour(t, TZ)
    int  em   = minute(t, TZ)
    int  mnd  = eh * 60 + em
    bool post = mnd >= 1080
    int  tdt  = post ? t + 86400000 : t
    int  yy   = year(tdt, TZ)
    int  mm   = month(tdt, TZ)
    int  dd   = dayofmonth(tdt, TZ)
    int  dw   = dayofweek(tdt, TZ)
    int  mfd  = post ? mnd - 1080 : mnd + 360
    int  sIdx = math.floor(mfd / 360)
    int  mInS = mfd % 360
    int  uIdx = math.floor(mInS / 90)
    int  mInU = mInS % 90
    int  qIdx = math.floor(mInU / 22.5)
    int  dsm  = dw == dayofweek.sunday ? 6 : dw - 2
    int  monT = tdt - dsm * 86400000
    int  tueT = monT + 86400000
    int  thuT = monT + 3 * 86400000
    int  moM  = month(monT, TZ)
    int  moD  = dayofmonth(monT, TZ)
    int  moY  = year(monT, TZ)
    // אותו עוגן יום-שלישי של הגרף הראשי: שבוע שייך לחודש שבו לפחות 4 מ-5 ימי
    // המסחר שלו. wkId נשאר לפי יום שני כי הוא רק מזהה ייחודי; mnId — המיכל
    // החודשי — חייב להיות לפי שלישי.
    int  tuM  = month(tueT, TZ)
    int  tuY  = year(tueT, TZ)
    bool dead = tuM != month(thuT, TZ)
    int  tdId = yy * 10000 + mm * 100 + dd
    int  wkId = moY * 10000 + moM * 100 + moD
    // שבוע מת = מיכל נפרד משלו, בדיוק כמו בגרף
    int  mnId = dead ? wkId : tuY * 100 + tuM
    int  ssId = tdId * 10 + sIdx
    int  ucId = ssId * 10 + uIdx
    int  qrId = ucId * 10 + qIdx
    int  qOf  = int(math.ceil(mm / 3.0))
    int  qtId = yy * 10 + qOf
    int  qdId = int(math.floor(yy / 4.0))
    // רבע-רבעון, אותו חישוב בדיוק של הגרף: אורך הרבעון בפועל חלקי ארבע,
    // בימי לוח שלמים מתוך התאריך. תת-המחזור של היומי.
    int  qsM  = (qOf - 1) * 3 + 1
    int  qLn  = f_dim(yy, qsM) + f_dim(yy, qsM + 1) + f_dim(yy, qsM + 2)
    int  qDiQ = (dd - 1) + (mm > qsM ? f_dim(yy, qsM) : 0) + (mm > qsM + 1 ? f_dim(yy, qsM + 1) : 0)
    int  qqIx = math.min(3, math.max(0, int(math.floor(qDiQ * 4.0 / qLn))))
    int  qqId = qtId * 10 + qqIx
    int  rf   = c == 8 ? yy   : c == 7 ? qtId : c == 6 ? qqId : c == 5 ? wkId : c == 4 ? tdId : c == 3 ? ssId : c == 2 ? ucId : qrId
    int  lf   = c == 8 ? qdId : c == 7 ? yy   : c == 6 ? yy   : c == 5 ? mnId : c == 4 ? wkId : c == 3 ? tdId : c == 2 ? ssId : ucId
    e.curRef  := rf
    e.curLife := lf
    e.curDead := dead
    e.curDow  := dw
    rf

// המיכל בלבד, מחושב מזמן כלשהו ובלי לגעת במצב של שום מנוע.
// משמש לבדיקת פג-תוקף בכל נר של הגרף: מנוע צועד רק כשנסגר נר במסגרת שלו,
// ולכן בלעדי הבדיקה הזאת שבירה 4H מסוף החודש הייתה ממשיכה להופיע עד שייסגר
// נר 4H חדש. **חייב להיות זהה ל-lf של f_setCycles.**
f_lifeId(int c, int t) =>
    int  eh   = hour(t, TZ)
    int  em   = minute(t, TZ)
    int  mnd  = eh * 60 + em
    bool post = mnd >= 1080
    int  tdt  = post ? t + 86400000 : t
    int  yy   = year(tdt, TZ)
    int  mm   = month(tdt, TZ)
    int  dd   = dayofmonth(tdt, TZ)
    int  dw   = dayofweek(tdt, TZ)
    int  mfd  = post ? mnd - 1080 : mnd + 360
    int  sIdx = math.floor(mfd / 360)
    int  uIdx = math.floor((mfd % 360) / 90)
    int  dsm  = dw == dayofweek.sunday ? 6 : dw - 2
    int  monT = tdt - dsm * 86400000
    int  tueT = monT + 86400000
    int  thuT = monT + 3 * 86400000
    int  tdId = yy * 10000 + mm * 100 + dd
    int  wkId = year(monT, TZ) * 10000 + month(monT, TZ) * 100 + dayofmonth(monT, TZ)
    // שבוע מת = מיכל נפרד משלו, בדיוק כמו בגרף וב-f_setCycles
    bool dead = month(tueT, TZ) != month(thuT, TZ)
    int  mnId = dead ? wkId : year(tueT, TZ) * 100 + month(tueT, TZ)
    int  ssId = tdId * 10 + sIdx
    int  ucId = ssId * 10 + uIdx
    int  qdId = int(math.floor(yy / 4.0))
    c == 8 ? qdId : c == 7 ? yy : c == 6 ? yy : c == 5 ? mnId : c == 4 ? wkId : c == 3 ? tdId : c == 2 ? ssId : ucId

// צעד אחד של המנוע.
f_step(Engine e, int tOpen, array<float> n, array<float> s, array<float> y) =>
    float nc0 = array.get(n, 3)
    float ec0 = array.get(s, 3)
    if not na(tOpen) and tOpen != e.lastT and (not na(nc0) or not na(ec0))
        // הצעד הקודם עיבד בדיוק את הנר שהוא כאן הנר האמצעי של השלישייה, ולכן
        // e.lastT (לפני הדריסה) הוא הזמן שבו הגאפ נוצר. מחשבים ממנו את
        // תת-המחזור, ואז קוראים שוב עם tOpen כדי להחזיר את שדות cur* לנר הנוכחי.
        int  tMid  = e.lastT
        int  rfMid = tMid == 0 ? 0 : f_setCycles(e, tMid)
        e.lastT := tOpen
        f_setCycles(e, tOpen)
        int  rf    = e.curRef
        int  lf    = e.curLife
        bool deadW = e.curDead
        int  dow   = e.curDow

        // ── החלפת מיכל + זרע ──
        // חייב להיות זהה ל-keepLast של הגרף, אחרת השורה בפינה תסתור את
        // מה שרואים על הגרף באותה מסגרת.
        bool keepL   = e.cls <= 2 or e.cls == 4 or e.cls >= 6
        bool newLife = e.started and lf != e.lifeId
        bool newRef  = e.started and rf != e.refId
        int  prevRef = e.refId
        if newLife
            if keepL
                if array.size(e.gaps) > 0
                    for i = array.size(e.gaps) - 1 to 0
                        if array.get(e.gaps, i).refId != prevRef
                            array.remove(e.gaps, i)
                if array.size(e.gaps) > 0
                    for i = 0 to array.size(e.gaps) - 1
                        Gap gc = array.get(e.gaps, i)
                        gc.fDeg := 0
                e.seedRefId  := prevRef
                e.seedActive := array.size(e.gaps) > 0
            else
                array.clear(e.gaps)
                e.seedActive := false
            e.shownDir := 0
        else if newRef and e.seedActive
            if array.size(e.gaps) > 0
                for i = array.size(e.gaps) - 1 to 0
                    if array.get(e.gaps, i).refId == e.seedRefId
                        array.remove(e.gaps, i)
            e.seedActive := false
        e.refId   := rf
        e.lifeId  := lf
        e.started := true

        float nh0 = array.get(n, 1)
        float nl0 = array.get(n, 2)
        float eh0 = array.get(s, 1)
        float el0 = array.get(s, 2)
        float yh0 = array.get(y, 1)
        float yl0 = array.get(y, 2)
        float yc0 = array.get(y, 3)

        // ── דריכה · מדידת ביקור · מוות ב-IFVG ──
        if array.size(e.gaps) > 0
            for i = 0 to array.size(e.gaps) - 1
                Gap gu = array.get(e.gaps, i)
                if not gu.dead
                    if not gu.armed and gu.refId != rf
                        gu.armed := true
                    if gu.armed
                        bool outN = na(gu.nqTop) or (gu.dir == 1 ? nl0 > gu.nqTop : nh0 < gu.nqBot)
                        bool outE = na(gu.esTop) or (gu.dir == 1 ? el0 > gu.esTop : eh0 < gu.esBot)
                        bool outY = na(gu.ymTop) or (gu.dir == 1 ? yl0 > gu.ymTop : yh0 < gu.ymBot)
                        if outN and outE and outY
                            gu.inVisit := false
                            gu.nqExt   := gu.dir == 1 ? gu.nqTop : gu.nqBot
                            gu.esExt   := gu.dir == 1 ? gu.esTop : gu.esBot
                            gu.ymExt   := gu.dir == 1 ? gu.ymTop : gu.ymBot
                        else
                            if not gu.inVisit
                                gu.inVisit := true
                                gu.visits  := gu.visits + 1
                            if gu.dir == 1
                                if not na(gu.nqTop)
                                    gu.nqExt := math.min(gu.nqExt, nl0)
                                if not na(gu.esTop)
                                    gu.esExt := math.min(gu.esExt, el0)
                                if not na(gu.ymTop)
                                    gu.ymExt := math.min(gu.ymExt, yl0)
                            else
                                if not na(gu.nqTop)
                                    gu.nqExt := math.max(gu.nqExt, nh0)
                                if not na(gu.esTop)
                                    gu.esExt := math.max(gu.esExt, eh0)
                                if not na(gu.ymTop)
                                    gu.ymExt := math.max(gu.ymExt, yh0)
                    // IFVG. YM הורג רק גאפ דובי — סגירה שלו מתחת לגאפ שורי
                    // היא החולשה הצפויה שלו ולא מבטלת שום רעיון.
                    if gu.dir == 1
                        if (not na(gu.nqBot) and nc0 < gu.nqBot) or (not na(gu.esBot) and ec0 < gu.esBot)
                            gu.dead := true
                    else
                        if (not na(gu.nqTop) and nc0 > gu.nqTop) or (not na(gu.esTop) and ec0 > gu.esTop) or (not na(gu.ymTop) and yc0 > gu.ymTop)
                            gu.dead := true

        // ── זיהוי גאפ קולקטיבי: אותו כיוון, אותו נר, לפחות שני נכסים ──
        float no1 = array.get(n, 4)
        float nc1 = array.get(n, 5)
        float nh2 = array.get(n, 6)
        float nl2 = array.get(n, 7)
        float nc2 = array.get(n, 8)
        float eo1 = array.get(s, 4)
        float ec1 = array.get(s, 5)
        float eh2 = array.get(s, 6)
        float el2 = array.get(s, 7)
        float ec2 = array.get(s, 8)
        float yo1 = array.get(y, 4)
        float yc1 = array.get(y, 5)
        float yh2 = array.get(y, 6)
        float yl2 = array.get(y, 7)
        float yc2 = array.get(y, 8)

        float no0 = array.get(n, 0)
        float eo0 = array.get(s, 0)
        float yo0 = array.get(y, 0)

        bool okN = not na(nh2) and not na(no1) and not na(nc0)
        bool okE = not na(eh2) and not na(eo1) and not na(ec0)
        bool okY = useYM and not na(yh2) and not na(yo1) and not na(yc0)

        // FVG של שלושה נרות — הפתיל של נר 1 והפתיל של נר 3 לא נוגעים
        bool fBullN = okN and nl0 > nh2
        bool fBullE = okE and el0 > eh2
        bool fBullY = okY and yl0 > yh2
        bool fBearN = okN and nh0 < nl2
        bool fBearE = okE and eh0 < el2
        bool fBearY = okY and yh0 < yl2

        // VI של שני נרות — נר 2 ונר 3 של אותה שלישייה (אינדקסים 4,5 ו-0,3).
        // **רצף**: שני הנרות חייבים ללכת לאותו כיוון של הרווח —
        // **אלא אם הנר הזה פותח תת-מחזור חדש** (newRef), כלומר זה המעבר
        // עצמו: סגירת הסייקל הקודם מול פתיחת החדש. חייב להיות זהה לגרף.
        bool cycEdge = newRef
        bool vBullN = volImbOn and okN and no0 > nc1 and (cycEdge or (nc1 > no1 and nc0 > no0))
        bool vBullE = volImbOn and okE and eo0 > ec1 and (cycEdge or (ec1 > eo1 and ec0 > eo0))
        bool vBullY = volImbOn and okY and yo0 > yc1 and (cycEdge or (yc1 > yo1 and yc0 > yo0))
        bool vBearN = volImbOn and okN and no0 < nc1 and (cycEdge or (nc1 < no1 and nc0 < no0))
        bool vBearE = volImbOn and okE and eo0 < ec1 and (cycEdge or (ec1 < eo1 and ec0 < eo0))
        bool vBearY = volImbOn and okY and yo0 < yc1 and (cycEdge or (yc1 < yo1 and yc0 < yo0))

        // שני הסוגים נספרים יחד — גאפ קולקטיבי יכול להיות FVG ב-NQ ו-VI ב-ES
        bool bullN = fBullN or vBullN
        bool bullE = fBullE or vBullE
        bool bullY = fBullY or vBullY
        bool bearN = fBearN or vBearN
        bool bearE = fBearE or vBearE
        bool bearY = fBearY or vBearY

        int cBull = (bullN ? 1 : 0) + (bullE ? 1 : 0) + (bullY ? 1 : 0)
        int cBear = (bearN ? 1 : 0) + (bearE ? 1 : 0) + (bearY ? 1 : 0)
        int nd = cBull >= 2 ? 1 : cBear >= 2 ? -1 : 0

        if nd != 0
            float nb = na
            float nt = na
            float eb = na
            float et = na
            float yb = na
            float yt = na
            float nrb = na
            float nrt = na
            float erb = na
            float ert = na
            // FVG ו-VI לאותו נכס **מתאחדים** לגאפ אחד: min של התחתונים
            // ו-max של העליונים. זהה לגרף.
            if nd == 1
                if fBullN
                    nb  := (extendBodies and no1 > nh2) ? nc2 : nh2
                    nt  := (extendBodies and nl0 > nc1) ? no0 : nl0
                    nrb := nh2
                    nrt := nl0
                if vBullN
                    nb  := na(nb) ? nc1 : math.min(nb, nc1)
                    nt  := na(nt) ? no0 : math.max(nt, no0)
                if fBullE
                    eb  := (extendBodies and eo1 > eh2) ? ec2 : eh2
                    et  := (extendBodies and el0 > ec1) ? eo0 : el0
                    erb := eh2
                    ert := el0
                if vBullE
                    eb  := na(eb) ? ec1 : math.min(eb, ec1)
                    et  := na(et) ? eo0 : math.max(et, eo0)
                if fBullY
                    yb := (extendBodies and yo1 > yh2) ? yc2 : yh2
                    yt := (extendBodies and yl0 > yc1) ? yo0 : yl0
                if vBullY
                    yb := na(yb) ? yc1 : math.min(yb, yc1)
                    yt := na(yt) ? yo0 : math.max(yt, yo0)
            else
                if fBearN
                    nt  := (extendBodies and no1 < nl2) ? nc2 : nl2
                    nb  := (extendBodies and nh0 < nc1) ? no0 : nh0
                    nrb := nh0
                    nrt := nl2
                if vBearN
                    nt  := na(nt) ? nc1 : math.max(nt, nc1)
                    nb  := na(nb) ? no0 : math.min(nb, no0)
                if fBearE
                    et  := (extendBodies and eo1 < el2) ? ec2 : el2
                    eb  := (extendBodies and eh0 < ec1) ? eo0 : eh0
                    erb := eh0
                    ert := el2
                if vBearE
                    et  := na(et) ? ec1 : math.max(et, ec1)
                    eb  := na(eb) ? eo0 : math.min(eb, eo0)
                if fBearY
                    yt := (extendBodies and yo1 < yl2) ? yc2 : yl2
                    yb := (extendBodies and yh0 < yc1) ? yo0 : yh0
                if vBearY
                    yt := na(yt) ? yc1 : math.max(yt, yc1)
                    yb := na(yb) ? yo0 : math.min(yb, yo0)
            // גאפ שקטן מהסף נפסל לאותו נכס בלבד, ואם נשאר רק אחד — אין גאפ
            if not na(nt) and nt - nb <= minGapPct / 100 * nc0
                nb := na
                nt := na
            if not na(et) and et - eb <= minGapPct / 100 * ec0
                eb := na
                et := na
            if not na(yt) and yt - yb <= minGapPct / 100 * yc0
                yb := na
                yt := na
            int parts = (na(nt) ? 0 : 1) + (na(et) ? 0 : 1) + (na(yt) ? 0 : 1)
            if parts >= 2
                e.gapCounter := e.gapCounter + 1
                // האם רגל משתתפת כלשהי היא FVG. אם כן — התיוג לפי הנר
                // האמצעי של השלישייה; אם הגאפ כולו VI — לפי הנר הנוכחי,
                // כי שם הריק נוצר ברגע שהנר נפתח.
                bool anyFvg = (not na(nt) and (nd == 1 ? fBullN : fBearN)) or (not na(et) and (nd == 1 ? fBullE : fBearE)) or (not na(yt) and (nd == 1 ? fBullY : fBearY))
                // **גאפ מעבר שייך לסייקל שהוא פותח, לא לזה שנגמר.** זהה לגרף.
                bool anyVi  = (not na(nt) and (nd == 1 ? vBullN : vBearN)) or (not na(et) and (nd == 1 ? vBullE : vBearE)) or (not na(yt) and (nd == 1 ? vBullY : vBearY))
                bool tagNow = (cycEdge and anyVi) or not anyFvg
                int  gRef   = tagNow ? rf : (rfMid == 0 ? rf : rfMid)
                int  gWhen  = tagNow ? tOpen : (tMid == 0 ? tOpen : tMid)
                Gap gn = Gap.new(e.gapCounter, nd, nb, nt, eb, et, yb, yt, nrb, nrt, erb, ert, gRef, bar_index, gWhen, bar_index, nd == 1 ? nt : nb, nd == 1 ? et : eb, nd == 1 ? yt : yb, 0, 0, 0, 0, false, false, false, not anyFvg, 0, "", 0, 0, na, na, na)
                array.push(e.gaps, gn)
                f_trim(e.gaps)

        // ── רישום שבירות ──
        bool blockDW  = e.cls == 5 and blockDeadWeek and deadW
        bool blockFri = (e.cls == 5 or e.cls == 4) and dow == dayofweek.friday
        if not blockDW and not blockFri and array.size(e.gaps) > 0
            for i = 0 to array.size(e.gaps) - 1
                Gap gr = array.get(e.gaps, i)
                if not gr.dead and gr.armed
                    int deg = gr.fracDeg()
                    if deg > gr.fDeg
                        e.seqCounter := e.seqCounter + 1
                        gr.fSeq  := e.seqCounter
                        gr.fSigB := bar_index
                        gr.fDeg  := deg
                        gr.fLead := gr.fracTxt()

        // ── בחירת השבירה המוצגת (החיה העדכנית ביותר) ──
        int selI = -1
        int selS = -1
        if array.size(e.gaps) > 0
            for i = 0 to array.size(e.gaps) - 1
                Gap gv = array.get(e.gaps, i)
                if not gv.dead and gv.fDeg > 0 and gv.fSeq > selS
                    selS := gv.fSeq
                    selI := i
        if selI == -1
            e.fDir   := 0
            e.fDeg   := 0
            e.fLead  := ""
            e.fGapId := 0
            e.fWhen  := 0
        else
            Gap gd = array.get(e.gaps, selI)
            e.shownDir := gd.dir
            e.fGapId   := gd.id
            e.fWhen    := gd.birthT
            e.fDir     := gd.dir
            e.fDeg     := gd.fDeg
            e.fLead    := gd.fLead
            if gd.fSeq > e.fSeq
                e.fSeq      := gd.fSeq
                // שעון הסימון מתחיל ברגע האמיתי שבו הוא נהיה גלוי, לא בזמן
                // הנומינלי של הנר. בטעינת הסקריפט כל הנרות הסגורים עוברים
                // כהיסטוריה, ושם time_close הוא לפני דקות — ולכן חלון של
                // 3 שניות היה פג עוד לפני שהסימון הספיק להיראות פעם אחת.
                // בהיסטוריה נשאר time_close, כדי ששבירה מלפני שלושה ימים לא
                // תהבהב כאילו היא נולדה עכשיו בכל פתיחת גרף.
                e.fTime     := barstate.isrealtime ? timenow : time_close
                e.justFired := true
    e.fDeg

// הזנת נר בודד ממסגרת נמוכה מהגרף. שם אין דרך לבקש נרות מוסטים, ולכן המנוע
// מחזיק בעצמו את שני הנרות הקודמים ומזיז אותם אחרי כל צעד.
f_pushLtf(Engine e, int t, float no, float nh, float nl, float nc, float eo, float eh, float el, float ec, float yo, float yh, float yl, float yc) =>
    if not na(t) and t != e.lastT and (not na(nc) or not na(ec))
        f_step(e, t, array.from(no, nh, nl, nc, array.get(e.hN, 0), array.get(e.hN, 3), array.get(e.hN, 5), array.get(e.hN, 6), array.get(e.hN, 7)), array.from(eo, eh, el, ec, array.get(e.hE, 0), array.get(e.hE, 3), array.get(e.hE, 5), array.get(e.hE, 6), array.get(e.hE, 7)), array.from(yo, yh, yl, yc, array.get(e.hY, 0), array.get(e.hY, 3), array.get(e.hY, 5), array.get(e.hY, 6), array.get(e.hY, 7)))
        for q = 0 to 3
            array.set(e.hN, q + 4, array.get(e.hN, q))
            array.set(e.hE, q + 4, array.get(e.hE, q))
            array.set(e.hY, q + 4, array.get(e.hY, q))
        array.set(e.hN, 0, no)
        array.set(e.hN, 1, nh)
        array.set(e.hN, 2, nl)
        array.set(e.hN, 3, nc)
        array.set(e.hE, 0, eo)
        array.set(e.hE, 1, eh)
        array.set(e.hE, 2, el)
        array.set(e.hE, 3, ec)
        array.set(e.hY, 0, yo)
        array.set(e.hY, 1, yh)
        array.set(e.hY, 2, yl)
        array.set(e.hY, 3, yc)
    e.fDeg

// ═══════════════════════════════════════════════════════════════════
// איפוס מיכל + מנגנון הזרע
// (1M: רבע/רבע · 5M: מיקרו/מיקרו · 1H: שני/שישי · 1D: רבע-רבעון ראשון/אחרון
//  של השנה · 1W: Q1/Q4 · Mo: שנה ראשונה/אחרונה. ב-15M וב-4H אין זרע.)
// ═══════════════════════════════════════════════════════════════════

var bool seedActive = false
var int  seedRefId  = 0

if newLifeCycle
    int prevRef = nz(refCycleId[1], 0)
    if keepLast
        if array.size(gaps) > 0
            for i = array.size(gaps) - 1 to 0
                if array.get(gaps, i).refId != prevRef
                    array.remove(gaps, i)
        // גאפי הזרע עוברים למיכל החדש, אבל השבירות שנרשמו עליהם לא —
        // החלפת מיכל מבטלת שבירה, וזה נכון גם לגאפ ששרד את המעבר.
        if array.size(gaps) > 0
            for i = 0 to array.size(gaps) - 1
                Gap gc = array.get(gaps, i)
                gc.fDeg := 0
        seedRefId  := prevRef
        seedActive := array.size(gaps) > 0
    else
        array.clear(gaps)
        seedActive := false
else if newRefCycle and seedActive
    if array.size(gaps) > 0
        for i = array.size(gaps) - 1 to 0
            if array.get(gaps, i).refId == seedRefId
                array.remove(gaps, i)
    seedActive := false

// ═══════════════════════════════════════════════════════════════════
// דריכה · מדידת ביקור · מוות ב-IFVG
//
// דריכה: גאפ נהיה זמין לשבירה רק אחרי שתת-המחזור שבו נולד הסתיים.
// חזרה לגאפ באותו תת-מחזור שבו נוצר אינה שבירה ואינה נספרת.
// (1H: תת-מחזור = יום מסחר · 4H: שבוע · 15M: סשן · 5M: מיקרו-סשן · 1M: רבע
//  יומי: רבע-רבעון (~23 יום) · שבועי: רבעון · חודשי: שנה)
//
// ביקור: כשאף נכס משתתף לא נוגע בגאפ — הביקור נגמר והעומקים מתאפסים. YM
// נספר גם הוא. כך מילוי משותף בביקור אחד לא חוסם שבירה בביקור הבא.
// ═══════════════════════════════════════════════════════════════════

if array.size(gaps) > 0
    for i = 0 to array.size(gaps) - 1
        Gap gu = array.get(gaps, i)
        if not gu.dead
            if not gu.armed and gu.refId != refCycleId
                gu.armed := true
                gu.armB  := bar_index

            if gu.armed
                bool outN = na(gu.nqTop) or (gu.dir == 1 ? nqL > gu.nqTop : nqH < gu.nqBot)
                bool outE = na(gu.esTop) or (gu.dir == 1 ? esL > gu.esTop : esH < gu.esBot)
                bool outY = na(gu.ymTop) or (gu.dir == 1 ? ymL > gu.ymTop : ymH < gu.ymBot)
                if outN and outE and outY
                    // הביקור נגמר — מאפסים לקראת ביקור חדש
                    gu.inVisit := false
                    gu.nqExt   := gu.dir == 1 ? gu.nqTop : gu.nqBot
                    gu.esExt   := gu.dir == 1 ? gu.esTop : gu.esBot
                    gu.ymExt   := gu.dir == 1 ? gu.ymTop : gu.ymBot
                else
                    if not gu.inVisit
                        gu.inVisit := true
                        gu.visits  := gu.visits + 1
                    if gu.dir == 1
                        if not na(gu.nqTop) and nqL < gu.nqExt
                            gu.nqExt  := nqL
                            gu.nqExtB := bar_index
                        if not na(gu.esTop) and esL < gu.esExt
                            gu.esExt  := esL
                            gu.esExtB := bar_index
                        if not na(gu.ymTop) and ymL < gu.ymExt
                            gu.ymExt  := ymL
                    else
                        if not na(gu.nqTop) and nqH > gu.nqExt
                            gu.nqExt  := nqH
                            gu.nqExtB := bar_index
                        if not na(gu.esTop) and esH > gu.esExt
                            gu.esExt  := esH
                            gu.esExtB := bar_index
                        if not na(gu.ymTop) and ymH > gu.ymExt
                            gu.ymExt  := ymH

            // IFVG: סגירה מעבר לגאפ הופכת אותו — הרעיון מתבטל (גם לפני הדריכה).
            // YM הורג רק גאפ דובי; סגירה שלו מתחת לגאפ שורי היא חולשה צפויה.
            if barstate.isconfirmed and bar_index > gu.birth
                if gu.dir == 1
                    if (not na(gu.nqBot) and nqC < gu.nqBot) or (not na(gu.esBot) and esC < gu.esBot)
                        gu.dead := true
                else
                    if (not na(gu.nqTop) and nqC > gu.nqTop) or (not na(gu.esTop) and esC > gu.esTop) or (not na(gu.ymTop) and ymC > gu.ymTop)
                        gu.dead := true

// ═══════════════════════════════════════════════════════════════════
// זיהוי גאפ קולקטיבי — באותו כיוון, באותו נר, בלפחות שני נכסים
//
// נרות: 1 = [2] · 2 = [1] · 3 = [0]
//
// **שני סוגי גאפ, ושניהם נספרים יחד לאותו גאפ קולקטיבי.** הוא יכול להיות
// FVG ב-NQ ו-VI ב-ES — מה שחשוב זה אותו כיוון ואותו נר.
//
// 1) **FVG של שלושה נרות** — הפתיל של נר 1 והפתיל של נר 3 לא נוגעים.
//    הגבול נמדד בפתיל, ומורחב לגוף רק כשיש באותו צד רווח אמיתי שלא נסחר —
//    כלומר הנר הבא נפתח מעבר לפתיל של הנר הקודם, ולא רק מעבר לסגירה שלו.
//    (סגירה ופתיחה שנבדלות בטיק אחד בתוך הפתיל אינן רווח.)
//      שורי  — תחתון: high[2] → close[2] אם open[1] > high[2]
//               עליון:  low[0]  → open[0]  אם low[0]  > close[1]
//      דובי  — עליון:  low[2]   → close[2] אם open[1] < low[2]
//               תחתון: high[0]  → open[0]  אם high[0] < close[1]
//
// 2) **VI של שני נרות** (`volImbOn`) — נר [1] נסגר ב-24200 ונר [0] נפתח
//    ב-24201. הגבולות הם הסגירה והפתיחה עצמן, בלי הרחבה ובלי פתילים.
//    **רצף — שני הנרות חייבים ללכת לאותו כיוון של הרווח.** רווח כלפי
//    מעלה נספר רק כשנר [1] עלה **וגם** נר [0] עלה; לא נר יורד ואחריו נר
//    עולה. זה מה שמפריד רצף אמיתי מריצוד.
//
// 3) **רווח המעבר** — אותו VI, אבל על נר שפותח תת-מחזור חדש (`cycEdge`):
//    הסגירה האחרונה של הסייקל הקודם מול הפתיחה הראשונה של החדש. **שם
//    תנאי הרצף לא חל**, כי הרווח נולד מהשבר בזמן ולא מתנועה של הנרות.
//    זה מה שתופס את גאפ פתיחת יום המסחר (17:00→18:00 EST) ואת גאפ
//    פתיחת השבוע, ובמסגרות הנמוכות גם את המעבר בין סשנים ומיקרו-סשנים.
//    כל מסגרת רואה את המעבר שלה: 1m את הרבע · 5m את המיקרו והסשן ·
//    15m את אסיה→לונדון ואת פתיחת היום · 1H את היום והשבוע · 4H את
//    השבוע והחודש, וכך הלאה עד שאין יותר שבר אמיתי בזמן.
//    **הגודל לא משנה** — רווח של 0.25 הוא רווח בדיוק כמו 15 נקודות, ועליו
//    יכולות להירשם כל הדרגות בדיוק כמו על FVG.
//
// **FVG ו-VI של אותו נכס מתאחדים לגאפ אחד.** זה לא "או-או": כשלנכס יש את
// שניהם באותו נר, הגבולות הם האיחוד — `min` של התחתונים ו-`max` של
// העליונים, כלומר FVG מורחב ולא שני גאפים נפרדים.
//
// בין הנכסים אין שום דרישה שיהיו מאותו סוג: NQ עם VI ו-ES עם FVG באותו
// נר הוא גאפ קולקטיבי תקף, וכך גם כל צירוף אחר. מה שחשוב זה שזה קרה
// **באותו נר ובאותו כיוון**.
// אם אף רגל משתתפת אינה FVG הגאפ הוא `volImb`, ואז התיוג הוא לפי הנר
// הנוכחי — שם הריק נוצר — ולא לפי הנר האמצעי של השלישייה.
//
// **נר בלי פתיל אינו מקרה מיוחד.** נר שנסגר ב-24100 בלי פתיל למעלה —
// ה-high שלו **הוא** הסגירה שלו, ולכן low[0] > high[2] תופס כרגיל
// והגבול התחתון יוצא בדיוק על הסגירה. אין כאן מה להוסיף.
// ═══════════════════════════════════════════════════════════════════

// מה כל נכס נתן בנר האחרון שנסגר — נשמר לטבלת הבדיקה
var string dgN = "·"
var string dgE = "·"
var string dgY = "·"
// האם הנר האחרון שנסגר היה נר של מעבר סייקל (ואז תנאי הרצף לא חל)
var bool   dgEdge = false

if barstate.isconfirmed and tfClass != 0 and bar_index > 2
    bool okY = useYM and not na(ymH[2]) and not na(ymL[2])

    bool fBullN = nqL > nqH[2]
    bool fBullE = esL > esH[2]
    bool fBullY = okY and ymL > ymH[2]
    bool fBearN = nqH < nqL[2]
    bool fBearE = esH < esL[2]
    bool fBearY = okY and ymH < ymL[2]

    // ── מעבר סייקל: פתיחת יום / שבוע / סשן לפי הזמנים שלנו ──
    // הנר הזה פותח תת-מחזור חדש, ולכן הרווח בינו לבין הנר הקודם הוא
    // **רווח המעבר** — סגירת הסייקל הקודם מול פתיחת החדש. הוא לא נולד
    // מתנועה של הנרות אלא מהשבר בזמן, ולכן תנאי הרצף לא חל עליו.
    // כל מסגרת רואה את המעבר שלה: 1m את הרבע, 5m את המיקרו והסשן,
    // 15m את המעבר אסיה→לונדון ואת פתיחת יום המסחר, 1H את היום והשבוע,
    // וכך הלאה עד שאין יותר שבר אמיתי בזמן.
    bool cycEdge = newRefCycle

    // VI בין נר [1] לנר [0] — **רצף**: שני הנרות לאותו כיוון של הרווח,
    // אלא אם זה נר של מעבר סייקל. חייב להיות זהה למנוע.
    bool vBullN = volImbOn and nqO > nqC[1] and (cycEdge or (nqC[1] > nqO[1] and nqC > nqO))
    bool vBullE = volImbOn and esO > esC[1] and (cycEdge or (esC[1] > esO[1] and esC > esO))
    bool vBullY = volImbOn and okY and ymO > ymC[1] and (cycEdge or (ymC[1] > ymO[1] and ymC > ymO))
    bool vBearN = volImbOn and nqO < nqC[1] and (cycEdge or (nqC[1] < nqO[1] and nqC < nqO))
    bool vBearE = volImbOn and esO < esC[1] and (cycEdge or (esC[1] < esO[1] and esC < esO))
    bool vBearY = volImbOn and okY and ymO < ymC[1] and (cycEdge or (ymC[1] < ymO[1] and ymC < ymO))

    bool bullN = fBullN or vBullN
    bool bullE = fBullE or vBullE
    bool bullY = fBullY or vBullY
    bool bearN = fBearN or vBearN
    bool bearE = fBearE or vBearE
    bool bearY = fBearY or vBearY

    // ── אבחון: מה כל נכס נתן בנר האחרון שנסגר ──
    // זה מה שעונה על "למה לא נוצר כאן גאפ":
    //   F+ / F-   FVG של שלושה נרות
    //   V+ / V-   VI של שני נרות
    //   FV+ / FV- **שניהם באותו נר** — הם התאחדו לגאפ אחד מורחב
    //   v+ / v-   **אות קטנה**: היה רווח סגירה/פתיחה, אבל שני הנרות לא
    //             הלכו לאותו כיוון ולכן אין רצף והוא נפסל.
    //   ·         כלום.
    // זה מפריד "אין רווח" מ"יש רווח שנפסל" — ההבדל שאי אפשר לראות על הגרף.
    // צריך **שניים** מתוך השלושה באותו כיוון; נכס בודד לא מספיק.
    dgEdge := cycEdge
    dgN := fBullN and vBullN ? "FV+" : fBearN and vBearN ? "FV-" : fBullN ? "F+" : fBearN ? "F-" : vBullN ? "V+" : vBearN ? "V-" : nqO > nqC[1] ? "v+" : nqO < nqC[1] ? "v-" : "·"
    dgE := fBullE and vBullE ? "FV+" : fBearE and vBearE ? "FV-" : fBullE ? "F+" : fBearE ? "F-" : vBullE ? "V+" : vBearE ? "V-" : esO > esC[1] ? "v+" : esO < esC[1] ? "v-" : "·"
    dgY := fBullY and vBullY ? "FV+" : fBearY and vBearY ? "FV-" : fBullY ? "F+" : fBearY ? "F-" : vBullY ? "V+" : vBearY ? "V-" : ymO > ymC[1] ? "v+" : ymO < ymC[1] ? "v-" : "·"

    int cBull = (bullN ? 1 : 0) + (bullE ? 1 : 0) + (bullY ? 1 : 0)
    int cBear = (bearN ? 1 : 0) + (bearE ? 1 : 0) + (bearY ? 1 : 0)
    int newDir = cBull >= 2 ? 1 : cBear >= 2 ? -1 : 0

    if newDir != 0
        float nb = na
        float nt = na
        float eb = na
        float et = na
        float yb = na
        float yt = na
        // ה-FVG הקלאסי בפתילים בלבד — נשמר כדי שאפשר יהיה לראות בטבלה
        // בדיוק מה ההרחבה לגופים עשתה לגבולות
        float nrb = na
        float nrt = na
        float erb = na
        float ert = na

        // ── FVG ו-VI לאותו נכס מתאחדים לגאפ אחד ──
        // לא "או-או": כשלנכס יש את שניהם באותו נר, הגאפ הוא האיחוד שלהם —
        // min של התחתונים ו-max של העליונים. בפועל זה FVG מורחב.
        if newDir == 1
            if fBullN
                nb  := (extendBodies and nqO[1] > nqH[2]) ? nqC[2] : nqH[2]
                nt  := (extendBodies and nqL    > nqC[1]) ? nqO    : nqL
                nrb := nqH[2]
                nrt := nqL
            if vBullN
                nb  := na(nb) ? nqC[1] : math.min(nb, nqC[1])
                nt  := na(nt) ? nqO    : math.max(nt, nqO)
            if fBullE
                eb  := (extendBodies and esO[1] > esH[2]) ? esC[2] : esH[2]
                et  := (extendBodies and esL    > esC[1]) ? esO    : esL
                erb := esH[2]
                ert := esL
            if vBullE
                eb  := na(eb) ? esC[1] : math.min(eb, esC[1])
                et  := na(et) ? esO    : math.max(et, esO)
            if fBullY
                yb := (extendBodies and ymO[1] > ymH[2]) ? ymC[2] : ymH[2]
                yt := (extendBodies and ymL    > ymC[1]) ? ymO    : ymL
            if vBullY
                yb := na(yb) ? ymC[1] : math.min(yb, ymC[1])
                yt := na(yt) ? ymO    : math.max(yt, ymO)
        else
            if fBearN
                nt  := (extendBodies and nqO[1] < nqL[2]) ? nqC[2] : nqL[2]
                nb  := (extendBodies and nqH    < nqC[1]) ? nqO    : nqH
                nrb := nqH
                nrt := nqL[2]
            if vBearN
                nt  := na(nt) ? nqC[1] : math.max(nt, nqC[1])
                nb  := na(nb) ? nqO    : math.min(nb, nqO)
            if fBearE
                et  := (extendBodies and esO[1] < esL[2]) ? esC[2] : esL[2]
                eb  := (extendBodies and esH    < esC[1]) ? esO    : esH
                erb := esH
                ert := esL[2]
            if vBearE
                et  := na(et) ? esC[1] : math.max(et, esC[1])
                eb  := na(eb) ? esO    : math.min(eb, esO)
            if fBearY
                yt := (extendBodies and ymO[1] < ymL[2]) ? ymC[2] : ymL[2]
                yb := (extendBodies and ymH    < ymC[1]) ? ymO    : ymH
            if vBearY
                yt := na(yt) ? ymC[1] : math.max(yt, ymC[1])
                yb := na(yb) ? ymO    : math.min(yb, ymO)

        // גאפ שקטן מהסף נפסל לאותו נכס בלבד. אם נשאר רק אחד — אין גאפ.
        if not na(nt) and nt - nb <= minGapPct / 100 * nqC
            nb := na
            nt := na
        if not na(et) and et - eb <= minGapPct / 100 * esC
            eb := na
            et := na
        if not na(yt) and yt - yb <= minGapPct / 100 * ymC
            yb := na
            yt := na

        int parts = (na(nt) ? 0 : 1) + (na(et) ? 0 : 1) + (na(yt) ? 0 : 1)
        if parts >= 2
            // ── הגבולות לציור, בסקאלה של הגרף ──
            // אותן נוסחאות בדיוק, רק על open/high/low/close של הגרף עצמו.
            // נכנסות רק אם הנכס שהגרף מציג באמת משתתף בגאפ **וגם** הגרף
            // עצמו רואה שם את אותו גאפ. אם לא — אין קופסה, רק תווית.
            bool legOnChart = (isNQc and not na(nt)) or (isESc and not na(et)) or (isYMc and not na(yt))
            float cb = na
            float ct = na
            if legOnChart and newDir == 1
                if low > high[2]
                    cb := (extendBodies and open[1] > high[2]) ? close[2] : high[2]
                    ct := (extendBodies and low      > close[1]) ? open  : low
                if volImbOn and open > close[1] and (cycEdge or (close[1] > open[1] and close > open))
                    cb := na(cb) ? close[1] : math.min(cb, close[1])
                    ct := na(ct) ? open     : math.max(ct, open)
            if legOnChart and newDir == -1
                if high < low[2]
                    ct := (extendBodies and open[1] < low[2])  ? close[2] : low[2]
                    cb := (extendBodies and high     < close[1]) ? open  : high
                if volImbOn and open < close[1] and (cycEdge or (close[1] < open[1] and close < open))
                    ct := na(ct) ? close[1] : math.max(ct, close[1])
                    cb := na(cb) ? open     : math.min(cb, open)
            // ── לאיזה תת-מחזור הגאפ שייך ──
            // FVG רגיל מתויג לפי **הנר האמצעי** — הוא זה שיצר את חוסר
            // האיזון, והשלישי רק מאשר.
            // **גאפ מעבר שייך לסייקל שהוא פותח, לא לזה שנגמר.** הרווח בין
            // הסגירה האחרונה של אתמול לפתיחה הראשונה של היום נולד ברגע
            // הפתיחה, ולכן ב-15 דקות הוא של **אסיה** ולא של ה-PM של אתמול,
            // ובגרף שעה הוא של **יום שלישי** ולא של יום שני. בלי זה נר מעבר
            // שבמקרה נתן גם רגל FVG נתפס ב-refCycleId[1] ונרשם לסייקל הישן,
            // ואז הוא נדרך מוקדם מדי ומקבל את השם הלא נכון בקופסה.
            bool anyFvg = (not na(nt) and (newDir == 1 ? fBullN : fBearN)) or (not na(et) and (newDir == 1 ? fBullE : fBearE)) or (not na(yt) and (newDir == 1 ? fBullY : fBearY))
            bool anyVi  = (not na(nt) and (newDir == 1 ? vBullN : vBearN)) or (not na(et) and (newDir == 1 ? vBullE : vBearE)) or (not na(yt) and (newDir == 1 ? vBullY : vBearY))
            // תיוג לפי הנר הנוכחי: גאפ מעבר, או גאפ שכולו VI.
            bool tagNow = (cycEdge and anyVi) or not anyFvg
            // origin נשאר לפי anyFvg — הוא רק קצה הקופסה, וכשיש FVG היא
            // צריכה לכסות את כל השלישייה.
            gapCounter += 1
            Gap gn = Gap.new(gapCounter, newDir, nb, nt, eb, et, yb, yt, nrb, nrt, erb, ert, tagNow ? refCycleId : refCycleId[1], bar_index, tagNow ? time : time[1], anyFvg ? bar_index - 2 : bar_index - 1, newDir == 1 ? nt : nb, newDir == 1 ? et : eb, newDir == 1 ? yt : yb, 0, 0, 0, 0, false, false, false, not anyFvg, 0, "", 0, 0, na, cb, ct)
            array.push(gaps, gn)
            f_trim(gaps)

// ═══════════════════════════════════════════════════════════════════
// חסימות
// ═══════════════════════════════════════════════════════════════════

cycleOK  = not (tfClass == 5 and blockDeadWeek and isDeadWeek)
friBlock = (tfClass == 5 or tfClass == 4) and tdDow == dayofweek.friday

// ═══════════════════════════════════════════════════════════════════
// רישום שבירות — לכל גאפ השבירה שלו
//
// שבירה היא אירוע שקרה על גאפ מסוים. היא נרשמת על הגאפ עצמו ונשארת שם,
// והדרגה יכולה רק לעלות. פתיל של הנכס המפגר אינו מבטל אותה.
// שבירות של גאפים שונים אינן מתחרות על מקום אחד — כל אחת נרשמת בנפרד,
// ומה שמצויר על הגרף זו פשוט העדכנית ביותר.
// ═══════════════════════════════════════════════════════════════════

atr = ta.atr(14)

// שם קריא למסגרת הזמן — כדי שבהתראה בנייד יהיה ברור מיד מאיפה היא הגיעה
f_tfName() =>
    f_clsName(tfClass)

var int seqCounter = 0

// נאסף במהלך הסריקה ונשלח פעם אחת בסוף הנר, כדי שכמה שבירות באותו נר
// יגיעו כהתראה אחת ולא כמה נפרדות.
string alertMsg = ""

if barstate.isconfirmed and tfClass != 0 and not friBlock and cycleOK and array.size(gaps) > 0
    for i = 0 to array.size(gaps) - 1
        Gap gr = array.get(gaps, i)
        if not gr.dead and gr.armed
            int deg = gr.fracDeg()
            if deg > gr.fDeg
                // כל עליית דרגה היא אירוע חדש ומרעננת את המונה, כך שמה
                // שמוצג הוא תמיד השבירה שקרתה אחרונה.
                seqCounter += 1
                gr.fSeq   := seqCounter
                gr.fSigB  := bar_index
                gr.fYPos  := gr.dir == 1 ? low - atr * offsetMlt : high + atr * offsetMlt
                gr.fDeg   := deg
                gr.fLead  := gr.fracTxt()
                if alertOn and deg >= alertMinDeg
                    string one = "[" + f_tfName() + "] " + syminfo.ticker + " · שבירה " + (gr.dir == 1 ? "שורית" : "דובית") + " " + f_degTxt(deg) + " · " + gr.fLead
                    alertMsg := alertMsg == "" ? one : alertMsg + "\n" + one

// ההתראה עצמה נשלחת בסוף הקובץ, אחרי שגם המנועים של שאר המסגרות
// הספיקו להוסיף את השבירות שלהם לאותה הודעה.

// ═══════════════════════════════════════════════════════════════════
// בחירת מה מוצג — השבירה החיה העדכנית ביותר
//
// שבירה חיה עד סוף המיכל, בכל מסגרות הזמן. מה שמוציא אותה מהרשימה זה
// IFVG על הגאפ שלה, או החלפת מיכל.
//   15M — שבירה של לונדון מלווה את שאר יום המסחר (NY-AM ו-NY-PM)
//   1H  — של יום שני, עד סוף השבוע · 4H — של שבוע, עד סוף החודש
//   1D  — של רבע-רבעון, עד סוף השנה · 1W — של רבעון, עד סוף השנה
//   Mo  — של שנה, עד סוף מחזור 4 השנים
// מבין השבירות החיות מצוירת זו שקרתה אחרונה. שבירה נגדית לא מוחקת את
// הקודמות — היא רק חדשה יותר ולכן קופצת לתצוגה. אם היא מתה ב-IFVG,
// הקודמת בכיוון ההפוך חוזרת מעצמה.
// ═══════════════════════════════════════════════════════════════════

int selIdx = -1
int selSeq = -1
if array.size(gaps) > 0
    for i = 0 to array.size(gaps) - 1
        Gap gv = array.get(gaps, i)
        if not gv.dead and gv.fDeg > 0 and gv.fSeq > selSeq
            selSeq := gv.fSeq
            selIdx := i

// שבירה נגדית דוחקת את הקודמות מהתצוגה, אבל לא מוחקת אותן. הבחירה למעלה
// לוקחת תמיד את החיה העדכנית ביותר, ולכן כשהגאפ של הנגדית הופך ל-IFVG הוא
// יוצא מהרשימה והשבירה הקודמת בכיוון ההפוך חוזרת מעצמה. ‏5 שבירות לירידות,
// אחת לעליות שנשברת — וחוזרים לירידות, עד שהמיכל מתחלף.
var int shownDir = 0
if newLifeCycle
    shownDir := 0
if selIdx != -1
    shownDir := array.get(gaps, selIdx).dir

// ═══════════════════════════════════════════════════════════════════
// מסגרות זמן אחרות — מנוע נפרד לכל אחת
//
// שישה מנועים מעל מסגרת הגרף ושלושה מתחתיה. מדרגה שלא קיימת פשוט לא נצעדת
// ולא מוצגת.
//
// מעל הגרף: כל מנוע מקבל את שלושת הנרות האחרונים שנסגרו במסגרת שלו, כשההיסט
// נעשה בתוך request.security — כלומר בזמן של אותה מסגרת. לכן אין ריפיינט:
// נר 15 דקות נכנס לחישוב רק ברגע שהוא נסגר.
//
// מתחת לגרף: אין שם נרות מוסטים, ולכן מושכים את כל תת-הנרות של נר הגרף
// (request.security_lower_tf) ומזינים אותם למנוע אחד-אחד, כשהוא מחזיק בעצמו
// את שני הנרות הקודמים. טריידינגויו מגביל את כמות תת-הנרות שאפשר למשוך,
// ולכן ההיסטוריה שם קצרה יותר — המצב מתייצב אחרי שהמיכל הראשון מתחלף.
// ═══════════════════════════════════════════════════════════════════

mtfOn = (showMtf or mtfAlert or mtfFlash) and tfClass != 0

c1 = math.min(tfClass + 1, 8)
c2 = math.min(tfClass + 2, 8)
c3 = math.min(tfClass + 3, 8)
c4 = math.min(tfClass + 4, 8)
c5 = math.min(tfClass + 5, 8)
c6 = math.min(tfClass + 6, 8)

cL1 = math.max(tfClass - 1, 1)
cL2 = math.max(tfClass - 2, 1)
cL3 = math.max(tfClass - 3, 1)

// אילו מדרגות באמת קיימות ונצעדות. מחושב כאן ולא למטה, כי זה מה שקובע
// אילו request.* באמת צריכים להביא נתונים.
useH1 = tfClass + 1 <= 8
useH2 = tfClass + 2 <= 8
useH3 = tfClass + 3 <= 8
useH4 = tfClass + 4 <= 8
useH5 = tfClass + 5 <= 8
useH6 = tfClass + 6 <= 8
useL1 = lowerLevels >= 1 and tfClass >= 2
useL2 = lowerLevels >= 2 and tfClass >= 3
useL3 = lowerLevels >= 3 and tfClass >= 4

// ── ביצועים: לא לבקש נתונים למדרגה שלא תיצעד ──
// request.security רץ גם כשהתוצאה לא בשימוש, ו-math.min חסם את c3..c6
// לאותה מחלקה — כלומר על גרף יומי נשלחו ארבע בקשות זהות לנתונים חודשיים
// לכל נכס, סתם. מדרגה שלא בשימוש מקבלת את מסגרת הגרף עצמה: הסדרה הזאת
// כבר טעונה, ולכן זה בלי עלות במקום משיכה של מסגרת שלמה נוספת.
tfs1 = not useH1 ? timeframe.period : c1 == 2 ? "5" : c1 == 3 ? "15" : c1 == 4 ? "60" : c1 == 5 ? "240" : c1 == 6 ? "D" : c1 == 7 ? "W" : "M"
tfs2 = not useH2 ? timeframe.period : c2 == 2 ? "5" : c2 == 3 ? "15" : c2 == 4 ? "60" : c2 == 5 ? "240" : c2 == 6 ? "D" : c2 == 7 ? "W" : "M"
tfs3 = not useH3 ? timeframe.period : c3 == 2 ? "5" : c3 == 3 ? "15" : c3 == 4 ? "60" : c3 == 5 ? "240" : c3 == 6 ? "D" : c3 == 7 ? "W" : "M"
tfs4 = not useH4 ? timeframe.period : c4 == 2 ? "5" : c4 == 3 ? "15" : c4 == 4 ? "60" : c4 == 5 ? "240" : c4 == 6 ? "D" : c4 == 7 ? "W" : "M"
tfs5 = not useH5 ? timeframe.period : c5 == 2 ? "5" : c5 == 3 ? "15" : c5 == 4 ? "60" : c5 == 5 ? "240" : c5 == 6 ? "D" : c5 == 7 ? "W" : "M"
tfs6 = not useH6 ? timeframe.period : c6 == 2 ? "5" : c6 == 3 ? "15" : c6 == 4 ? "60" : c6 == 5 ? "240" : c6 == 6 ? "D" : c6 == 7 ? "W" : "M"

// אותו דבר למטה, ושם זה כבד הרבה יותר — security_lower_tf מחזיר מערך
// תת-נרות לכל נר גרף. מדרגה שלא בשימוש (lowerLevels נמוך, או שאין מתחת
// לגרף) מקבלת "12M", שהוא תמיד **מעל** הגרף ולכן לא חוקי כאן, ועם
// ignore_invalid_timeframe הוא נזרק בלי למשוך שום נתון.
tfl1 = not useL1 ? "12M" : cL1 == 1 ? "1" : cL1 == 2 ? "5" : cL1 == 3 ? "15" : cL1 == 4 ? "60" : cL1 == 5 ? "240" : cL1 == 6 ? "D" : "W"
tfl2 = not useL2 ? "12M" : cL2 == 1 ? "1" : cL2 == 2 ? "5" : cL2 == 3 ? "15" : cL2 == 4 ? "60" : cL2 == 5 ? "240" : cL2 == 6 ? "D" : "W"
tfl3 = not useL3 ? "12M" : cL3 == 1 ? "1" : cL3 == 2 ? "5" : cL3 == 3 ? "15" : cL3 == 4 ? "60" : cL3 == 5 ? "240" : cL3 == 6 ? "D" : "W"

[t1, n1o0, n1h0, n1l0, n1c0, n1o1, n1c1, n1h2, n1l2, n1c2] = request.security(sNQ, tfs1, [time[1], open[1], high[1], low[1], close[1], open[2], close[2], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)
[t2, n2o0, n2h0, n2l0, n2c0, n2o1, n2c1, n2h2, n2l2, n2c2] = request.security(sNQ, tfs2, [time[1], open[1], high[1], low[1], close[1], open[2], close[2], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)
[t3, n3o0, n3h0, n3l0, n3c0, n3o1, n3c1, n3h2, n3l2, n3c2] = request.security(sNQ, tfs3, [time[1], open[1], high[1], low[1], close[1], open[2], close[2], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)
[t4, n4o0, n4h0, n4l0, n4c0, n4o1, n4c1, n4h2, n4l2, n4c2] = request.security(sNQ, tfs4, [time[1], open[1], high[1], low[1], close[1], open[2], close[2], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)
[t5, n5o0, n5h0, n5l0, n5c0, n5o1, n5c1, n5h2, n5l2, n5c2] = request.security(sNQ, tfs5, [time[1], open[1], high[1], low[1], close[1], open[2], close[2], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)
[t6, n6o0, n6h0, n6l0, n6c0, n6o1, n6c1, n6h2, n6l2, n6c2] = request.security(sNQ, tfs6, [time[1], open[1], high[1], low[1], close[1], open[2], close[2], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)

[u1, s1o0, s1h0, s1l0, s1c0, s1o1, s1c1, s1h2, s1l2, s1c2] = request.security(sES, tfs1, [time[1], open[1], high[1], low[1], close[1], open[2], close[2], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)
[u2, s2o0, s2h0, s2l0, s2c0, s2o1, s2c1, s2h2, s2l2, s2c2] = request.security(sES, tfs2, [time[1], open[1], high[1], low[1], close[1], open[2], close[2], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)
[u3, s3o0, s3h0, s3l0, s3c0, s3o1, s3c1, s3h2, s3l2, s3c2] = request.security(sES, tfs3, [time[1], open[1], high[1], low[1], close[1], open[2], close[2], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)
[u4, s4o0, s4h0, s4l0, s4c0, s4o1, s4c1, s4h2, s4l2, s4c2] = request.security(sES, tfs4, [time[1], open[1], high[1], low[1], close[1], open[2], close[2], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)
[u5, s5o0, s5h0, s5l0, s5c0, s5o1, s5c1, s5h2, s5l2, s5c2] = request.security(sES, tfs5, [time[1], open[1], high[1], low[1], close[1], open[2], close[2], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)
[u6, s6o0, s6h0, s6l0, s6c0, s6o1, s6c1, s6h2, s6l2, s6c2] = request.security(sES, tfs6, [time[1], open[1], high[1], low[1], close[1], open[2], close[2], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)

[v1, y1o0, y1h0, y1l0, y1c0, y1o1, y1c1, y1h2, y1l2, y1c2] = request.security(sYM, tfs1, [time[1], open[1], high[1], low[1], close[1], open[2], close[2], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)
[v2, y2o0, y2h0, y2l0, y2c0, y2o1, y2c1, y2h2, y2l2, y2c2] = request.security(sYM, tfs2, [time[1], open[1], high[1], low[1], close[1], open[2], close[2], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)
[v3, y3o0, y3h0, y3l0, y3c0, y3o1, y3c1, y3h2, y3l2, y3c2] = request.security(sYM, tfs3, [time[1], open[1], high[1], low[1], close[1], open[2], close[2], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)
[v4, y4o0, y4h0, y4l0, y4c0, y4o1, y4c1, y4h2, y4l2, y4c2] = request.security(sYM, tfs4, [time[1], open[1], high[1], low[1], close[1], open[2], close[2], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)
[v5, y5o0, y5h0, y5l0, y5c0, y5o1, y5c1, y5h2, y5l2, y5c2] = request.security(sYM, tfs5, [time[1], open[1], high[1], low[1], close[1], open[2], close[2], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)
[v6, y6o0, y6h0, y6l0, y6c0, y6o1, y6c1, y6h2, y6l2, y6c2] = request.security(sYM, tfs6, [time[1], open[1], high[1], low[1], close[1], open[2], close[2], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)

// ignore_invalid_timeframe מחזיר na במקום לעצור את הסקריפט כשהמדרגה הזאת
// לא באמת מתחת לגרף (למשל גרף דקה, שאין מתחתיו כלום).
[q1nt, q1no, q1nh, q1nl, q1nc] = request.security_lower_tf(sNQ, tfl1, [time, open, high, low, close], ignore_invalid_timeframe = true)
[q2nt, q2no, q2nh, q2nl, q2nc] = request.security_lower_tf(sNQ, tfl2, [time, open, high, low, close], ignore_invalid_timeframe = true)
[q3nt, q3no, q3nh, q3nl, q3nc] = request.security_lower_tf(sNQ, tfl3, [time, open, high, low, close], ignore_invalid_timeframe = true)

[q1eo, q1eh, q1el, q1ec] = request.security_lower_tf(sES, tfl1, [open, high, low, close], ignore_invalid_timeframe = true)
[q2eo, q2eh, q2el, q2ec] = request.security_lower_tf(sES, tfl2, [open, high, low, close], ignore_invalid_timeframe = true)
[q3eo, q3eh, q3el, q3ec] = request.security_lower_tf(sES, tfl3, [open, high, low, close], ignore_invalid_timeframe = true)

[q1yo, q1yh, q1yl, q1yc] = request.security_lower_tf(sYM, tfl1, [open, high, low, close], ignore_invalid_timeframe = true)
[q2yo, q2yh, q2yl, q2yc] = request.security_lower_tf(sYM, tfl2, [open, high, low, close], ignore_invalid_timeframe = true)
[q3yo, q3yh, q3yl, q3yc] = request.security_lower_tf(sYM, tfl3, [open, high, low, close], ignore_invalid_timeframe = true)

var Engine eg1 = Engine.new(c1, array.new<Gap>(), array.new_float(8, na), array.new_float(8, na), array.new_float(8, na), 0, 0, false, 0, 0, 0, false, 0, 0, 0, 0, false, 0, 0, 0, "", 0, 0, 0, 0, false)
var Engine eg2 = Engine.new(c2, array.new<Gap>(), array.new_float(8, na), array.new_float(8, na), array.new_float(8, na), 0, 0, false, 0, 0, 0, false, 0, 0, 0, 0, false, 0, 0, 0, "", 0, 0, 0, 0, false)
var Engine eg3 = Engine.new(c3, array.new<Gap>(), array.new_float(8, na), array.new_float(8, na), array.new_float(8, na), 0, 0, false, 0, 0, 0, false, 0, 0, 0, 0, false, 0, 0, 0, "", 0, 0, 0, 0, false)
var Engine eg4 = Engine.new(c4, array.new<Gap>(), array.new_float(8, na), array.new_float(8, na), array.new_float(8, na), 0, 0, false, 0, 0, 0, false, 0, 0, 0, 0, false, 0, 0, 0, "", 0, 0, 0, 0, false)
var Engine eg5 = Engine.new(c5, array.new<Gap>(), array.new_float(8, na), array.new_float(8, na), array.new_float(8, na), 0, 0, false, 0, 0, 0, false, 0, 0, 0, 0, false, 0, 0, 0, "", 0, 0, 0, 0, false)
var Engine eg6 = Engine.new(c6, array.new<Gap>(), array.new_float(8, na), array.new_float(8, na), array.new_float(8, na), 0, 0, false, 0, 0, 0, false, 0, 0, 0, 0, false, 0, 0, 0, "", 0, 0, 0, 0, false)

var Engine el1 = Engine.new(cL1, array.new<Gap>(), array.new_float(8, na), array.new_float(8, na), array.new_float(8, na), 0, 0, false, 0, 0, 0, false, 0, 0, 0, 0, false, 0, 0, 0, "", 0, 0, 0, 0, false)
var Engine el2 = Engine.new(cL2, array.new<Gap>(), array.new_float(8, na), array.new_float(8, na), array.new_float(8, na), 0, 0, false, 0, 0, 0, false, 0, 0, 0, 0, false, 0, 0, 0, "", 0, 0, 0, 0, false)
var Engine el3 = Engine.new(cL3, array.new<Gap>(), array.new_float(8, na), array.new_float(8, na), array.new_float(8, na), 0, 0, false, 0, 0, 0, false, 0, 0, 0, 0, false, 0, 0, 0, "", 0, 0, 0, 0, false)

// כל המנועים ברשימה אחת, באותו סדר של useH1..useL3, כדי שאפשר יהיה לעבור
// עליהם בלולאה במקום לחזור על אותו קוד תשע פעמים.
var array<Engine> allEng = array.new<Engine>()
if barstate.isfirst
    array.push(allEng, eg1)
    array.push(allEng, eg2)
    array.push(allEng, eg3)
    array.push(allEng, eg4)
    array.push(allEng, eg5)
    array.push(allEng, eg6)
    array.push(allEng, el1)
    array.push(allEng, el2)
    array.push(allEng, el3)

f_useSlot(int k) =>
    k == 0 ? useH1 : k == 1 ? useH2 : k == 2 ? useH3 : k == 3 ? useH4 : k == 4 ? useH5 : k == 5 ? useH6 : k == 6 ? useL1 : k == 7 ? useL2 : useL3

// ── גודל של מערך שעלול להיות na, בלי להתרסק ──
// request.security_lower_tf על מסגרת לא חוקית (או בלי נתונים) מחזיר מערך
// **na**, ו-array.size עליו זורק RE10052.
// **ב-Pine האופרטור `and` לא עושה short-circuit** — שני האגפים מחושבים
// תמיד, ולכן `useL3 and array.size(q3nc) > 0` התרסק גם כש-useL3 שקרי.
// `if` מקונן הוא כן זרימת בקרה אמיתית, ולכן הבדיקה חייבת לשבת כאן.
// -1 = אין מערך בכלל, וכל ההשוואות למטה הן על מספרים שלמים ולכן בטוחות.
f_aszF(array<float> a) =>
    int n = -1
    if not na(a)
        n := array.size(a)
    n

f_aszI(array<int> a) =>
    int n = -1
    if not na(a)
        n := array.size(a)
    n

// הצעד נעשה רק בסגירת נר של הגרף. הסיבה טכנית: בנר חי הסקריפט רץ מחדש בכל
// טיק ומצב ה-var מוחזר אחורה, ולכן צעד שרץ באמצע הנר היה נספר פעמיים.
if mtfOn and barstate.isconfirmed
    // איפוס דגלי "נשברה עכשיו" פעם אחת לנר גרף. אסור לאפס בתוך f_step: במסגרת
    // נמוכה הוא רץ פעם לכל תת-נר, ושבירה מתת-נר מוקדם הייתה נמחקת.
    if array.size(allEng) > 0
        for k = 0 to array.size(allEng) - 1
            Engine er = array.get(allEng, k)
            er.justFired := false
    if useH1
        f_step(eg1, t1, array.from(n1o0, n1h0, n1l0, n1c0, n1o1, n1c1, n1h2, n1l2, n1c2), array.from(s1o0, s1h0, s1l0, s1c0, s1o1, s1c1, s1h2, s1l2, s1c2), array.from(y1o0, y1h0, y1l0, y1c0, y1o1, y1c1, y1h2, y1l2, y1c2))
    if useH2
        f_step(eg2, t2, array.from(n2o0, n2h0, n2l0, n2c0, n2o1, n2c1, n2h2, n2l2, n2c2), array.from(s2o0, s2h0, s2l0, s2c0, s2o1, s2c1, s2h2, s2l2, s2c2), array.from(y2o0, y2h0, y2l0, y2c0, y2o1, y2c1, y2h2, y2l2, y2c2))
    if useH3
        f_step(eg3, t3, array.from(n3o0, n3h0, n3l0, n3c0, n3o1, n3c1, n3h2, n3l2, n3c2), array.from(s3o0, s3h0, s3l0, s3c0, s3o1, s3c1, s3h2, s3l2, s3c2), array.from(y3o0, y3h0, y3l0, y3c0, y3o1, y3c1, y3h2, y3l2, y3c2))
    if useH4
        f_step(eg4, t4, array.from(n4o0, n4h0, n4l0, n4c0, n4o1, n4c1, n4h2, n4l2, n4c2), array.from(s4o0, s4h0, s4l0, s4c0, s4o1, s4c1, s4h2, s4l2, s4c2), array.from(y4o0, y4h0, y4l0, y4c0, y4o1, y4c1, y4h2, y4l2, y4c2))
    if useH5
        f_step(eg5, t5, array.from(n5o0, n5h0, n5l0, n5c0, n5o1, n5c1, n5h2, n5l2, n5c2), array.from(s5o0, s5h0, s5l0, s5c0, s5o1, s5c1, s5h2, s5l2, s5c2), array.from(y5o0, y5h0, y5l0, y5c0, y5o1, y5c1, y5h2, y5l2, y5c2))
    if useH6
        f_step(eg6, t6, array.from(n6o0, n6h0, n6l0, n6c0, n6o1, n6c1, n6h2, n6l2, n6c2), array.from(s6o0, s6h0, s6l0, s6c0, s6o1, s6c1, s6h2, s6l2, s6c2), array.from(y6o0, y6h0, y6l0, y6c0, y6o1, y6c1, y6h2, y6l2, y6c2))

    // תת-נרות: כל נר של המסגרת הנמוכה מוזן בנפרד, לפי הסדר.
    // הגדלים נמדדים קודם דרך f_asz*, ואחר כך כל התנאים הם על מספרים
    // שלמים — זה מה שמונע את RE10052 כשהמסגרת לא חוקית והמערך הוא na.
    // שמות עם קידומת sz — t1/t2/t3 כבר תפוסים לזמן של המנועים שמעל הגרף.
    int szN1 = f_aszF(q1nc)
    int szE1 = f_aszF(q1ec)
    int szY1 = f_aszF(q1yc)
    int szT1 = f_aszI(q1nt)
    int szN2 = f_aszF(q2nc)
    int szE2 = f_aszF(q2ec)
    int szY2 = f_aszF(q2yc)
    int szT2 = f_aszI(q2nt)
    int szN3 = f_aszF(q3nc)
    int szE3 = f_aszF(q3ec)
    int szY3 = f_aszF(q3yc)
    int szT3 = f_aszI(q3nt)

    if useL1 and szN1 > 0 and szE1 == szN1 and szT1 == szN1
        for j = 0 to szN1 - 1
            float yo = na
            float yh = na
            float yl = na
            float yc = na
            // YM נקרא רק כשבאמת יש לו מערך באותו אורך — גם כאן אסור לסמוך
            // על short-circuit, ולכן זה if ולא ביטוי מותנה.
            if szY1 == szN1
                yo := array.get(q1yo, j)
                yh := array.get(q1yh, j)
                yl := array.get(q1yl, j)
                yc := array.get(q1yc, j)
            f_pushLtf(el1, array.get(q1nt, j), array.get(q1no, j), array.get(q1nh, j), array.get(q1nl, j), array.get(q1nc, j), array.get(q1eo, j), array.get(q1eh, j), array.get(q1el, j), array.get(q1ec, j), yo, yh, yl, yc)
    if useL2 and szN2 > 0 and szE2 == szN2 and szT2 == szN2
        for j = 0 to szN2 - 1
            float yo = na
            float yh = na
            float yl = na
            float yc = na
            if szY2 == szN2
                yo := array.get(q2yo, j)
                yh := array.get(q2yh, j)
                yl := array.get(q2yl, j)
                yc := array.get(q2yc, j)
            f_pushLtf(el2, array.get(q2nt, j), array.get(q2no, j), array.get(q2nh, j), array.get(q2nl, j), array.get(q2nc, j), array.get(q2eo, j), array.get(q2eh, j), array.get(q2el, j), array.get(q2ec, j), yo, yh, yl, yc)
    if useL3 and szN3 > 0 and szE3 == szN3 and szT3 == szN3
        for j = 0 to szN3 - 1
            float yo = na
            float yh = na
            float yl = na
            float yc = na
            if szY3 == szN3
                yo := array.get(q3yo, j)
                yh := array.get(q3yh, j)
                yl := array.get(q3yl, j)
                yc := array.get(q3yc, j)
            f_pushLtf(el3, array.get(q3nt, j), array.get(q3no, j), array.get(q3nh, j), array.get(q3nl, j), array.get(q3nc, j), array.get(q3eo, j), array.get(q3eh, j), array.get(q3el, j), array.get(q3ec, j), yo, yh, yl, yc)

// ═══════════════════════════════════════════════════════════════════
// פג-תוקף של מיכל — שבירה מתה ברגע שהמיכל שלה נגמר
//
// שבירה שייכת למיכל שבו היא נרשמה, ואסור שהיא תמשיך להופיע אחרי שהמיכל
// הזה נגמר. מנוע צועד רק כשנסגר נר **במסגרת שלו**, ולכן בלי הבדיקה הזאת
// שבירה 4H מסוף החודש המשיכה להיות מוצגת בשורת הפינה ובפאנל עד שנסגר נר
// 4H חדש בחודש החדש. כאן המיכל נבדק מול השעון של הגרף, בכל נר, ולכן
// הניקוי מיידי — גם בשורה בצד, גם בפאנל וגם בהתראה.
// מנקים רק את השבירה המוצגת ולא את רשימת הגאפים: הרשימה והזרע מטופלים
// בצעד הבא של המנוע עצמו, עם כל הלוגיקה של keepL.
// ═══════════════════════════════════════════════════════════════════

// רק בנר האחרון: זה מה שמוצג, ואין טעם להריץ תשע בדיקות תאריך על כל נר
// בהיסטוריה. זה היה חלק נכבד מזמן הטעינה.
if mtfOn and barstate.islast and array.size(allEng) > 0
    for k = 0 to array.size(allEng) - 1
        Engine ex = array.get(allEng, k)
        if f_useSlot(k) and ex.started and ex.fDeg > 0 and ex.lifeId != f_lifeId(ex.cls, time)
            ex.fDir   := 0
            ex.fDeg   := 0
            ex.fLead  := ""
            ex.fGapId := 0
            ex.fWhen  := 0

// ═══════════════════════════════════════════════════════════════════
// ריכוז המצב של כל המסגרות לפי מחלקה (אינדקס 0 = 1m ... אינדקס 7 = חודשי)
// ═══════════════════════════════════════════════════════════════════

var array<int>    pDir  = array.new_int(8, -9)   // -9 = אין נתונים למסגרת הזאת
var array<int>    pDeg  = array.new_int(8, 0)
var array<string> pLead = array.new_string(8, "")
var array<int>    pTime = array.new_int(8, 0)

// טריות השבירה של מסגרת הגרף עצמה
var int chartFSeq  = 0
var int chartFTime = 0
if selIdx != -1
    Gap gfr = array.get(gaps, selIdx)
    if gfr.fSeq > chartFSeq
        chartFSeq  := gfr.fSeq
        chartFTime := barstate.isrealtime ? timenow : time_close

f_fill(array<int> ad, array<int> ag, array<string> al, array<int> ab, Engine e) =>
    int ix = e.cls - 1
    array.set(ad, ix, e.fDir)
    array.set(ag, ix, e.fDeg)
    array.set(al, ix, e.fLead)
    array.set(ab, ix, e.fTime)

if barstate.islast and tfClass != 0
    for ix = 0 to 7
        array.set(pDir, ix, -9)
    // מסגרת הגרף
    array.set(pDir,  tfClass - 1, selIdx == -1 ? 0 : array.get(gaps, selIdx).dir)
    array.set(pDeg,  tfClass - 1, selIdx == -1 ? 0 : array.get(gaps, selIdx).fDeg)
    array.set(pLead, tfClass - 1, selIdx == -1 ? "" : array.get(gaps, selIdx).fLead)
    array.set(pTime, tfClass - 1, chartFTime)
    if mtfOn and array.size(allEng) > 0
        for k = 0 to array.size(allEng) - 1
            if f_useSlot(k)
                f_fill(pDir, pDeg, pLead, pTime, array.get(allEng, k))

// ── שבירה טרייה במסגרת אחרת: סימון זעיר על הגרף + שורה בהתראה ──
var string flashTxt  = ""
var int    flashDir  = 0
var int    flashTime = 0
// המסגרת והמיכל שמהם הסימון הגיע — כדי שגם הוא ייעלם מיד כשהמיכל נגמר,
// ולא ישרוד את השעון רק בגלל שהוא "טרי".
var int    flashCls  = 0
var int    flashLife = 0

// כל מנוע שנשבר בנר הזה נכנס להתראה. הסימון הקטן על הגרף מציג את האחרון
// שנמצא — הפרטים המלאים ממילא יושבים בפאנל.
if mtfOn and barstate.isconfirmed and array.size(allEng) > 0
    for k = 0 to array.size(allEng) - 1
        Engine ek = array.get(allEng, k)
        if f_useSlot(k) and ek.justFired
            flashTxt  := f_clsName(ek.cls) + " " + (ek.fDir == 1 ? "▲" : "▼") + str.tostring(ek.fDeg)
            flashDir  := ek.fDir
            flashTime := barstate.isrealtime ? timenow : time_close
            flashCls  := ek.cls
            flashLife := ek.lifeId
            if mtfAlert and alertOn and ek.fDeg >= alertMinDeg
                string one = "[" + f_clsName(ek.cls) + "] " + syminfo.ticker + " · שבירה " + (ek.fDir == 1 ? "שורית" : "דובית") + " " + f_degTxt(ek.fDeg) + " · " + ek.fLead
                alertMsg := alertMsg == "" ? one : alertMsg + "\n" + one

// ═══════════════════════════════════════════════════════════════════
// פאנל מסגרות הזמן — מסודר מלמעלה למטה, Mo ועד 1m
// ═══════════════════════════════════════════════════════════════════

f_stTxt(int dir, int deg, string lead) =>
    dir == 0 ? "—" : (dir == 1 ? "▲" : "▼") + " " + f_degTxt(deg) + (lead == "" ? "" : " " + lead)

f_mtfRow(table t, int row, string nm, int dir, int deg, string lead, bool fresh, bool cur) =>
    color bg = dir == 0 ? color.new(color.gray, 85) : color.new(dir == 1 ? colBull : colBear, fresh ? 5 : 55)
    table.cell(t, 0, row, (cur ? "▶ " : "") + nm, bgcolor = color.new(color.gray, 75), text_color = color.white, text_size = size.small)
    table.cell(t, 1, row, f_stTxt(dir, deg, lead), bgcolor = bg, text_color = color.white, text_size = size.small)

mtfPosition = mtfPos == "ימין למעלה" ? position.top_right : mtfPos == "ימין באמצע" ? position.middle_right : mtfPos == "שמאל למטה" ? position.bottom_left : mtfPos == "שמאל למעלה" ? position.top_left : position.bottom_right

var table mtfT = table.new(mtfPosition, 2, 9, border_width = 1)

if showMtf and barstate.islast and tfClass != 0
    for rr = 0 to 8
        table.cell(mtfT, 0, rr, "", bgcolor = color.new(color.black, 100))
        table.cell(mtfT, 1, rr, "", bgcolor = color.new(color.black, 100))

    table.cell(mtfT, 0, 0, "SSMT Fill", bgcolor = color.new(color.gray, 25), text_color = color.white, text_size = size.small)
    table.cell(mtfT, 1, 0, "שבירה", bgcolor = color.new(color.gray, 25), text_color = color.white, text_size = size.small)

    int rowN = 0
    for cc = 8 to 1
        if array.get(pDir, cc - 1) != -9
            rowN := rowN + 1
            f_mtfRow(mtfT, rowN, f_clsName(cc), array.get(pDir, cc - 1), array.get(pDeg, cc - 1), array.get(pLead, cc - 1), timenow - array.get(pTime, cc - 1) <= mtfFlashSec * 1000, cc == tfClass)

// ── סימון זעיר בפינת המסך כששבירה קרתה במסגרת אחרת ──
//
// זה הדבר היחיד שרואים כשהפאנל כבוי. שורה אחת, רקע שקוף, מקום קבוע — לא
// תווית שמרחפת מעל הנר ויכולה לצאת מהמסך. כשאין מה להגיד היא ריקה ולכן
// בלתי נראית לגמרי. עמודה 0 היא תווית הפתיחה (SF), כמו ה-QT של
// האינדיקטור השני, בצבע נפרד משלה.

flashPosition = flashPos == "שמאל למעלה" ? position.top_left : flashPos == "ימין למטה" ? position.bottom_right : flashPos == "ימין למעלה" ? position.top_right : flashPos == "אמצע למטה" ? position.bottom_center : position.bottom_left

// כשהטבלה עוגנת למטה, השורה האמיתית היא העליונה והריקות דוחפות אותה כלפי
// מעלה. כשהיא עוגנת למעלה — הפוך.
flashTop = flashPos == "שמאל למעלה" or flashPos == "ימין למעלה"
flashRow = flashTop ? flashLift : 0

// תא נפרד לכל מסגרת ולא מחרוזת אחת, כדי שכל אחת תיצבע לפי הכיוון שלה:
// ירוק לעליות, אדום לירידות — אותם צבעים של הקופסאות על הגרף.
var table flashT = table.new(flashPosition, 9, flashLift + 1)

if barstate.islast
    for rr = 0 to flashLift
        for cx = 0 to 8
            table.cell(flashT, cx, rr, "", bgcolor = color.new(color.black, 100))
        // מרווח בלתי נראה ששומר על גובה השורה
        if rr != flashRow
            table.cell(flashT, 0, rr, "·", bgcolor = color.new(color.black, 100), text_color = color.new(color.white, 100), text_size = size.small)
    if mtfFlash and mtfOn and tfClass != 0
        int cx = 1
        if flashMode == "כל עוד יש שבירה חיה"
            // כל המסגרות האחרות שיש עליהן שבירה חיה, מהגבוהה לנמוכה
            for cc = 8 to 1
                int cd = array.get(pDir, cc - 1)
                if cc != tfClass and cd != -9 and cd != 0
                    table.cell(flashT, cx, flashRow, f_clsName(cc) + (cd == 1 ? " ▲" : " ▼") + str.tostring(array.get(pDeg, cc - 1)) + "  ", bgcolor = color.new(color.black, 100), text_color = cd == 1 ? colBull : colBear, text_size = size.small)
                    cx := cx + 1
        else if flashTxt != "" and timenow - flashTime <= mtfFlashSec * 1000 and flashLife == f_lifeId(flashCls, time)
            table.cell(flashT, 1, flashRow, flashTxt, bgcolor = color.new(color.black, 100), text_color = flashDir == 1 ? colBull : colBear, text_size = size.small)
            cx := 2
        // תווית הפתיחה מופיעה רק כשיש מה להגיד, כדי שהשורה תישאר נעלמת
        if cx > 1
            table.cell(flashT, 0, flashRow, flashTag + "  ", bgcolor = color.new(color.black, 100), text_color = flashTagCol, text_size = size.small)

// ═══════════════════════════════════════════════════════════════════
// ציור — קופסת הגאפ של נכס הגרף + כיתוב אחד (רק השבירה המוצגת)
//
// אם לנכס שהגרף מציג אין את הגאפ הזה (הוא קיים רק בשני האחרים), אין מה
// לצייר עליו קופסה — במקרה כזה מוצגת רק התווית ליד הנר.
// ═══════════════════════════════════════════════════════════════════

var label aLbl = na
var box   aBox = na
var line  aCE  = na
var int   drawnSeq = -999
var int   drawnDeg = -999

int shownSeq = selIdx == -1 ? -999 : array.get(gaps, selIdx).fSeq
int shownDeg = selIdx == -1 ? -999 : array.get(gaps, selIdx).fDeg

if shownSeq != drawnSeq or shownDeg != drawnDeg
    if not na(aLbl)
        label.delete(aLbl)
        aLbl := na
    if not na(aBox)
        box.delete(aBox)
        aBox := na
    if not na(aCE)
        line.delete(aCE)
        aCE := na
    if selIdx != -1
        Gap    gd   = array.get(gaps, selIdx)
        color  col  = gd.dir == 1 ? colBull : colBear
        // הדרגה משנה רק את עוצמת המסגרת. המילוי נשאר שקוף באותה מידה כדי
        // שהנרות מתחתיו יישארו קריאים.
        color  cEdge = color.new(col, gd.fDeg == 3 ? boxBorder : gd.fDeg == 2 ? math.min(boxBorder + 20, 95) : math.min(boxBorder + 35, 95))
        // הטקסט לא הולך אחרי שקיפות המסגרת — הוא חייב להישאר קריא גם ב-F1.
        color  cTxt  = color.new(col, gd.fDeg == 3 ? 0 : gd.fDeg == 2 ? 15 : 30)
        float  gTop = gd.drwTop
        float  gBot = gd.drwBot
        bool   onChart = not na(gTop)
        float  gMid = (gTop + gBot) / 2
        string txt  = f_degTxt(gd.fDeg) + " " + gd.fLead
        int    xEnd = boxLen == "עד נר השבירה" ? gd.fSigB : boxLen == "קצר (12 נרות)" ? gd.fSigB + 12 : bar_index
        xEnd := math.max(xEnd, gd.origin + 1)
        bool inBox = labelMode == "בתוך הקופסה" and onChart and showBox
        if showBox and onChart
            // הקופסה מתחילה מהנר הראשון של ה-FVG כדי שתשב על התבנית שיצרה
            // את הגאפ, והכיתוב יושב בתוכה — צמוד לימין, בגובה האמצע.
            aBox := box.new(gd.origin, gTop, xEnd, gBot, border_color = cEdge, border_width = 1, bgcolor = color.new(col, boxTransp), text = inBox ? txt : "", text_color = cTxt, text_size = capSize, text_halign = text.align_right, text_valign = text.align_center)
        if labelMode == "תג בקצה הקופסה" and onChart
            // תג צמוד לקצה הימני, בגובה אמצע הגאפ — נקרא גם כשהקופסה דקה מאוד.
            aLbl := label.new(xEnd, gMid, txt, style = label.style_label_left, color = color.new(col, 20), textcolor = color.white, size = capSize)
        else if labelMode != "בלי כיתוב" and not inBox
            aLbl := label.new(gd.fSigB, gd.fYPos, txt, style = label.style_none, textcolor = cTxt, size = capSize, textalign = text.align_center)
        if showCE and onChart
            aCE := line.new(gd.origin, gMid, xEnd, gMid, color = color.new(col, 40), style = line.style_dashed, width = 1)
    drawnSeq := shownSeq
    drawnDeg := shownDeg

// הקופסה, הקו והתג עוקבים אחרי הנר הנוכחי — רק במצב "עד הנר הנוכחי"
if selIdx != -1 and boxLen == "עד הנר הנוכחי"
    if not na(aLbl) and not na(aBox) and labelMode == "תג בקצה הקופסה"
        label.set_x(aLbl, bar_index)
    if not na(aBox)
        box.set_right(aBox, bar_index)
    if not na(aCE)
        line.set_x2(aCE, bar_index)

// ═══════════════════════════════════════════════════════════════════
// ציור הגאפים שרלוונטיים לשבירה
//
// **רק גאפים דרוכים.** גאפ נהיה רלוונטי לשבירה רק אחרי שתת-המחזור שבו
// נולד הסתיים, ולכן גאפ שנולד בתת-המחזור הנוכחי לא מוצג — אין שום דרך
// שהוא ייצור שבירה עכשיו. ביחד עם זה שהרשימה ממילא נקייה למיכל הנוכחי,
// מה שמוצג הוא בדיוק "הגאפים של תת-המחזורים שהסתיימו בתוך המיכל":
//   1H  ביום שלישי  → רק של יום שני (ברביעי: שני + שלישי)
//   15m ב-NY-AM     → רק של אסיה ולונדון של אותו יום מסחר
//   4H  בשבוע 3     → רק של שבוע 1 ושבוע 2 של אותו חודש
// כל קופסה מסומנת ב-#id ובשם תת-המחזור שבו נולדה, כדי שאפשר יהיה לראות
// את זה בעין. (קודם הוצגו גם גאפים לא דרוכים, עם ✕ — זה הוסר.)
// ═══════════════════════════════════════════════════════════════════

var array<box> dbgBoxes = array.new<box>()

// הרגע שבו הסקריפט התחיל לרוץ. החלפת מסגרת זמן מריצה אותו מחדש מאפס, ולכן
// זה בדיוק "מתי עברתי מסגרת". timenow על נר היסטורי הוא גם כן השעון הנוכחי,
// ולכן הערך נקבע פעם אחת ונשאר.
var int bootT = timenow
drawAllGaps = showAllGaps or (autoAllGaps and tfClass != 0 and tfClass <= 5 and timenow - bootT <= autoAllSec * 1000)

// המחיקה רצה תמיד, גם כשלא מציירים — אחרת ההצצה לא הייתה נעלמת כשהחלון נגמר.
if barstate.islast
    if array.size(dbgBoxes) > 0
        for i = 0 to array.size(dbgBoxes) - 1
            box.delete(array.get(dbgBoxes, i))
        array.clear(dbgBoxes)
    if drawAllGaps and array.size(gaps) > 0
        for i = 0 to array.size(gaps) - 1
            Gap gz = array.get(gaps, i)
            // armed הוא כל התנאי: גאפ שתת-המחזור שלו עוד לא נגמר אינו
            // מועמד לשבירה, ולכן אין לו מה לעשות על המסך.
            // showDeadGaps מוסיף לאבחון גם את מי שבוטל ב-IFVG, באפור.
            if (not gz.dead and gz.armed) or (showDeadGaps and gz.dead)
                float zTop = gz.drwTop
                float zBot = gz.drwBot
                if not na(zTop)
                    color  zCol = gz.dead ? color.gray : gz.dir == 1 ? colBull : colBear
                    // V = גאפ סגירה/פתיחה בין שני נרות, ולא FVG של שלושה
                    string zTxt = "#" + str.tostring(gz.id) + " " + f_subName(tfClass, gz.birthT) + (gz.volImb ? " V" : "") + (gz.dead ? " ✕" : "")
                    array.push(dbgBoxes, box.new(gz.origin, zTop, bar_index, zBot, border_color = color.new(zCol, 35), border_width = 1, bgcolor = color.new(zCol, 94), text = zTxt, text_color = color.new(zCol, 20), text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_top))

// ═══════════════════════════════════════════════════════════════════
// טבלת בדיקה (אבחון — כבויה כברירת מחדל)
// ═══════════════════════════════════════════════════════════════════

f_num(float x) => na(x) ? "-" : str.tostring(x, format.mintick)
f_pct(float x) => na(x) ? "-" : str.tostring(math.round(x * 100)) + "%"
// שעת EST של נר לפי bar_index
f_time(int b) =>
    int off = bar_index - b
    b <= 0 or off < 0 ? "-" : str.format_time(time[off], "HH:mm", TZ)
// תת-מחזור ומיכל בשמות, לאימות שהמיפוי נכון למסגרת הזמן שנבחרה
f_cycleNames() =>
    tfClass == 8 ? "שנה>4 שנים" : tfClass == 7 ? "רבעון>שנה" : tfClass == 6 ? "רבע-רבעון>שנה" : tfClass == 5 ? "שבוע>חודש" : tfClass == 4 ? "יום>שבוע" : tfClass == 3 ? "סשן>יום" : tfClass == 2 ? "מיקרו>סשן" : tfClass == 1 ? "רבע>מיקרו" : "לא נתמך"

var table dbg = table.new(position.top_right, 4, 13, border_width = 1)
if showDebug and barstate.islast
    hc = color.gray
    wc = color.white

    int tLive  = 0
    int tArmed = 0
    int tFrac  = 0
    if array.size(gaps) > 0
        for i = 0 to array.size(gaps) - 1
            if not array.get(gaps, i).dead
                tLive += 1
                if array.get(gaps, i).armed
                    tArmed += 1
                if array.get(gaps, i).fDeg > 0
                    tFrac += 1

    // הגאפ שמוצג בטבלה: זה של השבירה המוצגת, ואם אין — הגאפ החי האחרון
    int dIdx = selIdx
    if dIdx == -1 and array.size(gaps) > 0
        for i = array.size(gaps) - 1 to 0
            if dIdx == -1 and not array.get(gaps, i).dead
                dIdx := i

    float  tN      = na
    float  tE      = na
    float  tY      = na
    int    tDir    = 0
    bool   tArm    = false
    int    tId     = -1
    int    tNow    = 0
    int    tReg    = 0
    int    tVisits = 0
    string tLd     = ""
    float  tNqTop  = na
    float  tNqBot  = na
    float  tEsTop  = na
    float  tEsBot  = na
    float  tYmTop  = na
    float  tYmBot  = na
    int    tArmB   = 0
    int    tBirthT = 0
    if dIdx != -1
        Gap gt   = array.get(gaps, dIdx)
        tN      := gt.depthOf(0)
        tE      := gt.depthOf(1)
        tY      := gt.depthOf(2)
        tDir    := gt.dir
        tArm    := gt.armed
        tId     := gt.id
        tNow    := gt.fracDeg()
        tReg    := gt.fDeg
        tVisits := gt.visits
        tLd     := gt.fLead
        tNqTop  := gt.nqTop
        tNqBot  := gt.nqBot
        tEsTop  := gt.esTop
        tEsBot  := gt.esBot
        tYmTop  := gt.ymTop
        tYmBot  := gt.ymBot
        tArmB   := gt.armB
        tBirthT := gt.birthT

    table.cell(dbg, 0, 0, "SSMT Fill", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 0, "NQ", bgcolor = hc, text_color = wc)
    table.cell(dbg, 2, 0, "ES", bgcolor = hc, text_color = wc)
    table.cell(dbg, 3, 0, "YM", bgcolor = hc, text_color = wc)

    table.cell(dbg, 0, 1, "סייקל", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 1, f_cycleNames(), bgcolor = wc)
    table.cell(dbg, 2, 1, str.tostring(tArmed) + " arm", bgcolor = wc)
    table.cell(dbg, 3, 1, str.tostring(tLive) + " live", bgcolor = wc)

    // שלושתם נמדדים מהסדרה, תמיד — זה מה שמבטיח שאותה שבירה תקבל אותה
    // דרגה בכל גרף. חייבות להתאים למשפחת החוזים של הגרף.
    table.cell(dbg, 0, 2, "מקור נתונים", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 2, useMicro ? "מיקרו" : "רגיל", bgcolor = wc)
    table.cell(dbg, 2, 2, useMicro ? "מיקרו" : "רגיל", bgcolor = wc)
    table.cell(dbg, 3, 2, not useYM ? "כבוי" : (useMicro ? "מיקרו" : "רגיל"), bgcolor = wc)

    table.cell(dbg, 0, 3, "שבירות פעילות", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 3, str.tostring(tFrac), bgcolor = wc)
    table.cell(dbg, 2, 3, shownDir == 0 ? "-" : (shownDir == 1 ? "שורית" : "דובית"), bgcolor = wc)
    table.cell(dbg, 3, 3, tDir == 0 ? "-" : (tDir == 1 ? "שורי" : "דובי"), bgcolor = wc)

    table.cell(dbg, 0, 4, "── הגאפ המוצג ──", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 4, "id " + str.tostring(tId), bgcolor = wc)
    table.cell(dbg, 2, 4, tLd == "" ? "-" : tLd, bgcolor = wc)
    table.cell(dbg, 3, 4, tArm ? "arm" : "—", bgcolor = wc)

    // deg נרשם = הדרגה שנרשמה בפועל ונשארת · deg עכשיו = מה שהעומקים נותנים
    table.cell(dbg, 0, 5, "deg נרשם/עכשיו", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 5, f_degNum(tReg), bgcolor = wc)
    table.cell(dbg, 2, 5, f_degNum(tNow), bgcolor = wc)
    table.cell(dbg, 3, 5, "ביקור " + str.tostring(tVisits), bgcolor = wc)

    // העומק הוא של הביקור הנוכחי בלבד. "-" = לנכס אין את הגאפ הזה.
    table.cell(dbg, 0, 6, "עומק", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 6, f_pct(tN), bgcolor = wc)
    table.cell(dbg, 2, 6, f_pct(tE), bgcolor = wc)
    table.cell(dbg, 3, 6, f_pct(tY), bgcolor = wc)

    table.cell(dbg, 0, 7, "gapTop", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 7, f_num(tNqTop), bgcolor = wc)
    table.cell(dbg, 2, 7, f_num(tEsTop), bgcolor = wc)
    table.cell(dbg, 3, 7, f_num(tYmTop), bgcolor = wc)

    table.cell(dbg, 0, 8, "gapBot", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 8, f_num(tNqBot), bgcolor = wc)
    table.cell(dbg, 2, 8, f_num(tEsBot), bgcolor = wc)
    table.cell(dbg, 3, 8, f_num(tYmBot), bgcolor = wc)

    table.cell(dbg, 0, 9, "נולד / נדרך", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 9, tBirthT == 0 ? "-" : str.format_time(tBirthT, "dd/MM HH:mm", TZ), bgcolor = wc)
    table.cell(dbg, 2, 9, f_time(tArmB), bgcolor = wc)
    table.cell(dbg, 3, 9, "Q" + str.tostring(qtWeekNum), bgcolor = wc)

    table.cell(dbg, 0, 10, "שבוע/זרע/שישי", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 10, isDeadWeek ? "DEAD" : "-", bgcolor = wc)
    table.cell(dbg, 2, 10, seedActive ? "זרע" : "-", bgcolor = wc)
    table.cell(dbg, 3, 10, friBlock ? "FRI" : "-", bgcolor = wc)

    // המזהים הגולמיים של תת-המחזור והמיכל, ואיפה אנחנו בתוך הרבעון. זה מה
    // שאומר מיד אם גאפ אמור להיות דרוך: תת-מחזור שלא זז = שום דבר לא נדרך,
    // ומיכל שהתחלף עכשיו = הרשימה נוקתה ולכן אין עדיין מה להציג.
    table.cell(dbg, 0, 11, "ref / life", bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 11, str.tostring(refCycleId), bgcolor = wc)
    table.cell(dbg, 2, 11, str.tostring(lifeCycleId), bgcolor = wc)
    table.cell(dbg, 3, 11, "רבע " + str.tostring(qqIdx + 1) + "/4 · יום " + str.tostring(qDayInQ + 1) + "/" + str.tostring(qLenD), bgcolor = wc)

    // מה כל נכס נתן בנר האחרון שנסגר. F = FVG · V = VI · FV = שניהם, ואז
    // הם התאחדו לגאפ אחד · v באות קטנה = היה רווח אבל בלי רצף · + שורי ·
    // - דובי · · כלום.
    // **צריך שניים מהשלושה באותו כיוון.** שורה שנראית "V+ · ·" מסבירה
    // בדיוק למה לא נוצר גאפ: רק נכס אחד נתן משהו.
    // ⟐ בכותרת = הנר האחרון פתח תת-מחזור חדש, ולכן תנאי הרצף לא חל עליו
    // והרווח נספר כמו שהוא.
    table.cell(dbg, 0, 12, "גאפ בנר האחרון" + (dgEdge ? " ⟐" : ""), bgcolor = hc, text_color = wc)
    table.cell(dbg, 1, 12, dgN, bgcolor = wc)
    table.cell(dbg, 2, 12, dgE, bgcolor = wc)
    table.cell(dbg, 3, 12, not useYM ? "כבוי" : dgY, bgcolor = wc)

// ═══════════════════════════════════════════════════════════════════
// רשימת הגאפים של מסגרת הגרף — "האם הגאפ הזה בכלל קיים?"
//
// הטבלה הראשית מראה **גאפ אחד בלבד**, וההצצה על הגרף נעלמת אחרי כמה
// שניות, ולכן לא הייתה שום דרך לענות על "הגאפ מיום שלישי — הוא לא נוצר,
// הוא מת, או שהוא חי ופשוט אין עליו שבירה?". שלוש התשובות דורשות תיקון
// שונה לגמרי, וזה מה שמפריד ביניהן.
//
// שמונת הגאפים האחרונים של המיכל הנוכחי, מהחדש לישן:
//   #id ותת-המחזור שבו נולד (V = VI בלבד) · כיוון · deg שנרשם (deg עכשיו)
//   · המצב: arm = דרוך ומחכה · wait = תת-המחזור שלו עוד לא נגמר ·
//   IFVG = נסגר נר מעבר לו והוא בוטל.
//
// "deg נרשם 2 (3)" = נרשמה F2 ועכשיו העומקים כבר נותנים F3 — היא תתעדכן
// בסגירת הנר. "- (-)" על גאפ arm = הוא חי, דרוך, ופשוט אין סטייה.
// ═══════════════════════════════════════════════════════════════════

var table gdbg = table.new(position.middle_right, 4, 9, border_width = 1)
if showDebug and barstate.islast
    color ghc = color.gray
    color gwc = color.white
    for rr = 0 to 8
        for cx = 0 to 3
            table.cell(gdbg, cx, rr, "", bgcolor = color.new(color.black, 100))
    table.cell(gdbg, 0, 0, "גאפי " + f_clsName(tfClass), bgcolor = ghc, text_color = gwc, text_size = size.tiny)
    table.cell(gdbg, 1, 0, "כיוון", bgcolor = ghc, text_color = gwc, text_size = size.tiny)
    table.cell(gdbg, 2, 0, "deg", bgcolor = ghc, text_color = gwc, text_size = size.tiny)
    table.cell(gdbg, 3, 0, "מצב", bgcolor = ghc, text_color = gwc, text_size = size.tiny)
    int grw = 0
    if array.size(gaps) > 0
        for i = array.size(gaps) - 1 to 0
            if grw < 8
                Gap gl = array.get(gaps, i)
                grw += 1
                table.cell(gdbg, 0, grw, "#" + str.tostring(gl.id) + " " + f_subName(tfClass, gl.birthT) + (gl.volImb ? " V" : ""), bgcolor = gwc, text_size = size.tiny)
                table.cell(gdbg, 1, grw, gl.dir == 1 ? "▲" : "▼", bgcolor = gwc, text_color = gl.dir == 1 ? colBull : colBear, text_size = size.tiny)
                table.cell(gdbg, 2, grw, f_degNum(gl.fDeg) + " (" + f_degNum(gl.fracDeg()) + ")", bgcolor = gwc, text_size = size.tiny)
                table.cell(gdbg, 3, grw, gl.dead ? "IFVG" : gl.armed ? "arm" : "wait", bgcolor = gwc, text_size = size.tiny)

// ═══════════════════════════════════════════════════════════════════
// אבחון המנועים — מה כל מסגרת באמת מחזיקה
//
// נדלק יחד עם טבלת הבדיקה. לכל מסגרת פעילה: כמה גאפים חיים יש לה, כמה מהם
// נדרכו, מה הדרגה שנרשמה ומי המשתתפים. זה מה שמפריד בין "הזיהוי לא מצא
// גאפ", "הגאפ נמצא אבל לא נדרך" ו"הכול קיים אבל העומקים לא נותנים דרגה".
// ═══════════════════════════════════════════════════════════════════

var table edbg = table.new(position.middle_left, 6, 10, border_width = 1)
if showDebug and barstate.islast and array.size(allEng) > 0
    color ehc = color.gray
    color ewc = color.white
    for rr = 0 to 9
        for cx = 0 to 5
            table.cell(edbg, cx, rr, "", bgcolor = color.new(color.black, 100))
    table.cell(edbg, 0, 0, "מנוע", bgcolor = ehc, text_color = ewc, text_size = size.tiny)
    table.cell(edbg, 1, 0, "גאפים", bgcolor = ehc, text_color = ewc, text_size = size.tiny)
    table.cell(edbg, 2, 0, "נדרכו", bgcolor = ehc, text_color = ewc, text_size = size.tiny)
    table.cell(edbg, 3, 0, "deg", bgcolor = ehc, text_color = ewc, text_size = size.tiny)
    table.cell(edbg, 4, 0, "משתתפים", bgcolor = ehc, text_color = ewc, text_size = size.tiny)
    table.cell(edbg, 5, 0, "הגאפ", bgcolor = ehc, text_color = ewc, text_size = size.tiny)
    int er = 0
    for k = 0 to array.size(allEng) - 1
        if f_useSlot(k) and er < 9
            Engine ee = array.get(allEng, k)
            int egLive = 0
            int egArm  = 0
            int egMax  = 0
            if array.size(ee.gaps) > 0
                for i = 0 to array.size(ee.gaps) - 1
                    Gap gq = array.get(ee.gaps, i)
                    if not gq.dead
                        egLive += 1
                        if gq.armed
                            egArm += 1
                        egMax := math.max(egMax, gq.fracDeg())
            er += 1
            table.cell(edbg, 0, er, f_clsName(ee.cls), bgcolor = ehc, text_color = ewc, text_size = size.tiny)
            table.cell(edbg, 1, er, str.tostring(egLive), bgcolor = ewc, text_size = size.tiny)
            table.cell(edbg, 2, er, str.tostring(egArm), bgcolor = ewc, text_size = size.tiny)
            // deg = מה שנרשם · (deg) = מה שהעומקים נותנים כרגע על הגאפ הכי חזק
            table.cell(edbg, 3, er, f_degNum(ee.fDeg) + " (" + f_degNum(egMax) + ")", bgcolor = ewc, text_size = size.tiny)
            table.cell(edbg, 4, er, ee.fLead == "" ? "-" : ee.fLead, bgcolor = ewc, text_size = size.tiny)
            // על איזה גאפ בדיוק יושבת השבירה המוצגת, ומתי הוא נולד
            table.cell(edbg, 5, er, ee.fGapId == 0 ? "-" : "#" + str.tostring(ee.fGapId) + " " + str.format_time(ee.fWhen, "dd/MM HH:mm", TZ), bgcolor = ewc, text_size = size.tiny)

// ═══════════════════════════════════════════════════════════════════
// שליחת ההתראה — פעם אחת בסוף הנר
//
// ההודעה נאספה משבירות של מסגרת הגרף וגם של כל המסגרות האחרות, ולכן
// התראה אחת שמוקמת על גרף אחד מכסה את כולן.
// ═══════════════════════════════════════════════════════════════════

if alertMsg != ""
    alert(alertMsg, alert.freq_once_per_bar_close)
