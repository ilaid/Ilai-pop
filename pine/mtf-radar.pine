//@version=5
indicator("MTF Radar | Quarterly Theory", shorttitle = "MTF Radar", overlay = true)

// ═══════════════════════════════════════════════════════════════════
// MTF Radar — מודעות רב-טיימפריימית בלי עומס על הגרף
//
// הבעיה: כל אחד משלושת האינדיקטורים (SSMT+HSSMT, SSMT Fill, ADI PCP/PSP)
// מראה רק את מסגרת הזמן של הגרף שפתוח. כדי לדעת אם יש שבירה ב-1H או ב-4H,
// או אם נולדה שבירה דקתית שעלולה להביא תיקון נגד עסקה פתוחה, צריך להחליף
// גרף — ובדיוק אז מפספסים את מה שקורה.
//
// הפתרון: הסקריפט הזה מחשב את כל מסגרות הזמן בו-זמנית ולא מצייר כלום על
// פאנל המחיר — רק טבלה זעירה בפינה והתראה דינמית. שלושת האינדיקטורים
// הקיימים ממשיכים לעבוד לצידו בלי שינוי.
//
// ── התובנה שמאפשרת את זה ──
// הלוגיקה לא תלויה באגרגציה של נרות אלא ב-refCycleId/lifeCycleId, שמחושבים
// מזמן (EST, עוגן 18:00). לכן על גרף 15 דקות אפשר להריץ במקביל את התצוגה
// של 1H, 4H, 1D ו-1W מאותם נרות בדיוק, בלי אף request.security נוסף.
//
// ── המגבלה שמכתיבה את המבנה ──
// אי אפשר לעטוף את הלוגיקה ב-request.security על TF אחר, כי בפנים כבר יש
// request.security ל-NQ/ES/YM ו-Pine אוסר קינון. לכן ירידה מתחת ל-TF של
// הגרף עוברת דרך request.security_lower_tf ומעבדת אינטרה-בארים אחד-אחד.
//
// ── רשת המחזורים ──
//   class 1 = 1m   ref רבע 22.5m   life מיקרו 90m
//   class 2 = 5m   ref מיקרו 90m   life סשן 6h
//   class 3 = 15m  ref סשן 6h      life יום מסחר
//   class 4 = 1H   ref יום מסחר    life שבוע
//   class 5 = 4H   ref שבוע        life חודש
//   class 6 = 1D   ref רבעון QT    life שנת QT
//   class 7 = 1W   ref שנת QT      life מחזור 4 שנים
//
// מחזורי-העל לפי QT (שנה מאפריל), כמו ב-SSMT+HSSMT — ולא לפי ההגדרה
// הקלנדרית שב-SSMT Fill.
// ═══════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════
// הגדרות משתמש
// ═══════════════════════════════════════════════════════════════════

grpSym = "סימבולים"
contractSet = input.string("אוטומטי", "סט חוזים", options = ["אוטומטי", "רגיל", "מיקרו"], group = grpSym)
symNQ_std = input.symbol("CME_MINI:NQ1!",  "NQ רגיל", group = grpSym)
symES_std = input.symbol("CME_MINI:ES1!",  "ES רגיל", group = grpSym)
symYM_std = input.symbol("CBOT_MINI:YM1!", "YM רגיל", group = grpSym)
symNQ_mic = input.symbol("CME_MINI:MNQ1!",  "NQ מיקרו", group = grpSym)
symES_mic = input.symbol("CME_MINI:MES1!",  "ES מיקרו", group = grpSym)
symYM_mic = input.symbol("CBOT_MINI:MYM1!", "YM מיקרו", group = grpSym)

grpTF = "מסגרות זמן ברדאר"
useC1 = input.bool(true, "1m",  group = grpTF, inline = "tfa")
useC2 = input.bool(true, "5m",  group = grpTF, inline = "tfa")
useC3 = input.bool(true, "15m", group = grpTF, inline = "tfa")
useC4 = input.bool(true, "1H",  group = grpTF, inline = "tfb")
useC5 = input.bool(true, "4H",  group = grpTF, inline = "tfb")
useC6 = input.bool(true, "1D",  group = grpTF, inline = "tfb")
useC7 = input.bool(true, "1W",  group = grpTF, inline = "tfb")

grpVis = "תצוגה"
tblPos    = input.string("ימין־תחתון", "מיקום הטבלה", options = ["ימין־תחתון", "ימין־עליון", "ימין־אמצע", "שמאל־תחתון", "שמאל־עליון"], group = grpVis)
txtSize   = input.string("small", "גודל טקסט", options = ["tiny", "small", "normal"], group = grpVis)
colBull   = input.color(#26a69a, "צבע שורי", group = grpVis)
colBear   = input.color(#ef5350, "צבע דובי", group = grpVis)
hideEmpty = input.bool(false, "הסתר מסגרות בלי סיגנל", group = grpVis, tooltip = "מצב מינימלי — הרדאר מציג רק מסגרות זמן שיש בהן סטייה חיה כרגע.")
showConf  = input.bool(true, "הצג שורת קונפליקט", group = grpVis, tooltip = "מופיעה רק כשמסגרת זמן נמוכה מצביעה לכיוון ההפוך מגבוהה שמעליה — בדיוק המצב שבו אתה בעסקה ומגיע תיקון נגדך.")
myBias    = input.string("אין", "כיוון הפוזיציה שלי", options = ["אין", "לונג", "שורט"], group = grpVis, tooltip = "כשמוגדר, כל מסגרת זמן שהסיגנל שלה מנוגד לפוזיציה מסומנת ב-⚠.")

grpFam = "משפחות סיגנל"
useSSMT = input.bool(true, "SSMT / HSSMT — סטיית פתיל וסגירה", group = grpFam)
useFill = input.bool(true, "Fill — סטייה לפי עומק מילוי גאפ", group = grpFam, tooltip = "מ-5m ומעלה בלבד. גאפ דקתי אינו מספיק משמעותי כדי להיספר.")
usePSP  = input.bool(true, "PCP / PSP — סטיית כיוון נר וסווינג", group = grpFam, tooltip = "מ-5m ומעלה בלבד.")

grpGap = "הגדרת גאפ (Fill)"
extendBodies = input.bool(true, "הרחב גאפ לגופי הנרות (רווח סגירה/פתיחה)", group = grpGap)
// השאר על 0. האסימטריה בין הנכסים היא הסיגנל עצמו — סינון לפי גודל חותך
// דווקא את השבירות החזקות (גאפ גדול בנכס אחד מול גאפ קטן בשני).
minGapPct = input.float(0.0, "גודל גאפ מינימלי (% מהמחיר)", minval = 0.0, maxval = 1.0, step = 0.01, group = grpGap)
maxGaps   = input.int(25, "מקסימום גאפים במיכל לכל מסגרת", minval = 5, maxval = 80, group = grpGap, tooltip = "הרדאר צריך רק את קיום השבירה ולא ציור קופסאות היסטוריות, ולכן המספר נמוך מזה שבאינדיקטור המקורי.")

grpLogic = "לוגיקה"
blockDeadWeek   = input.bool(true, "חסום שבירות בשבוע מת (מחלקת 4H)", group = grpLogic)
requireTrueOpen = input.bool(false, "סנן לפי True Open (פרימיום/דיסקאונט)", group = grpLogic)

grpAlert = "התראות"
alertOn    = input.bool(true, "הפעל התראות", group = grpAlert)
alertS     = input.bool(true, "SSMT", group = grpAlert, inline = "af")
alertF     = input.bool(true, "Fill", group = grpAlert, inline = "af")
alertP     = input.bool(false, "PSP", group = grpAlert, inline = "af")
alertScope = input.string("הגרף ומדרגה אחת מתחת", "אילו מסגרות יורות התראה", options = ["הכל", "הגרף ומעלה", "הגרף ומדרגה אחת מתחת"], group = grpAlert, tooltip = "מגביל את ההצפה ממסגרות זמן נמוכות. ההתראה עצמה היא קריאה אחת עם טקסט דינמי, כך שמספיק להגדיר אותה פעם אחת.")

// ═══════════════════════════════════════════════════════════════════
// בחירת סימבולים
// ═══════════════════════════════════════════════════════════════════

cs           = syminfo.tickerid
isNQc        = str.contains(cs, "NQ")
isESc        = str.contains(cs, "ES")
isYMc        = str.contains(cs, "YM")
chartIsMicro = str.contains(cs, "MNQ") or str.contains(cs, "MES") or str.contains(cs, "MYM")
useMicro     = contractSet == "מיקרו" or (contractSet == "אוטומטי" and chartIsMicro)

sNQ = useMicro ? symNQ_mic : symNQ_std
sES = useMicro ? symES_mic : symES_std
sYM = useMicro ? symYM_mic : symYM_std

// ═══════════════════════════════════════════════════════════════════
// משיכת נתוני שלושת הנכסים
//
// לנכס שהגרף מציג לוקחים את נתוני הגרף עצמם ולא את request.security:
// ההגדרה "Adjust for contract changes" מתקנת אחורה את היסטוריית החוזה
// הרציף, אבל request.security לא מקבל אותה ומחזיר סדרה גולמית. בלי זה
// הרמות מחושבות בעולם אחד ומושוות לנרות מעולם אחר.
// ═══════════════════════════════════════════════════════════════════

[rNqO, rNqH, rNqL, rNqC] = request.security(sNQ, timeframe.period, [open, high, low, close], lookahead = barmerge.lookahead_off)
[rEsO, rEsH, rEsL, rEsC] = request.security(sES, timeframe.period, [open, high, low, close], lookahead = barmerge.lookahead_off)
[rYmO, rYmH, rYmL, rYmC] = request.security(sYM, timeframe.period, [open, high, low, close], lookahead = barmerge.lookahead_off)

nqO = isNQc ? open  : rNqO
nqH = isNQc ? high  : rNqH
nqL = isNQc ? low   : rNqL
nqC = isNQc ? close : rNqC
esO = isESc ? open  : rEsO
esH = isESc ? high  : rEsH
esL = isESc ? low   : rEsL
esC = isESc ? close : rEsC
ymO = isYMc ? open  : rYmO
ymH = isYMc ? high  : rYmH
ymL = isYMc ? low   : rYmL
ymC = isYMc ? close : rYmC

// ═══════════════════════════════════════════════════════════════════
// רשת זמן EST
// ═══════════════════════════════════════════════════════════════════

TZ = "America/New_York"

// מזהי הנר הסינתטי של שבע המחלקות, עבור חותמת זמן נתונה.
// מחושב פעמיים בכל בר — ל-time (תחילת הבר) ול-time_close (סופו) — כדי לזהות
// בדיוק באיזה בר נסגר נר של כל מחלקה, בלי פיגור של בר.
var array<int> cxBarO = array.new_int(7, 0)   // מזהה הנר בתחילת הבר
var array<int> cxBarC = array.new_int(7, 0)   // מזהה הנר בסופו

f_fillBarIds(t, dst) =>
    int  md   = hour(t, TZ) * 60 + minute(t, TZ)
    bool post = md >= 1080
    int  mfd  = post ? md - 1080 : md + 360
    int  tdt  = post ? t + 86400000 : t
    int  tday = year(tdt, TZ) * 10000 + month(tdt, TZ) * 100 + dayofmonth(tdt, TZ)
    int  tdw  = dayofweek(tdt, TZ)
    int  dsm  = tdw == dayofweek.sunday ? 6 : tdw - 2
    int  mont = tdt - dsm * 86400000
    array.set(dst, 0, tday * 10000 + mfd)
    array.set(dst, 1, tday * 10000 + mfd / 5)
    array.set(dst, 2, tday * 10000 + mfd / 15)
    array.set(dst, 3, tday * 10000 + mfd / 60)
    array.set(dst, 4, tday * 10000 + mfd / 240)
    array.set(dst, 5, tday)
    array.set(dst, 6, year(mont, TZ) * 10000 + month(mont, TZ) * 100 + dayofmonth(mont, TZ))
    0

// כל הרשת התלויה בזמן — מזהי תת-מחזור, מיכל, Q2, יום בשבוע ושבוע מת —
// מחושבת לחותמת זמן נתונה ונכתבת למערכים גלובליים.
//
// למה מערכים ולא ערכי החזרה: Pine אוסר על פונקציה לשנות משתנה גלובלי, אבל
// תוכן של מערך כן ניתן לשינוי דרך ההפניה — וכך אפשר להחזיר עשרות ערכים בלי
// טאפל ענק. אותה פונקציה משרתת גם את נרות הגרף וגם כל אינטרה-בר בשלב ב',
// כך שיש הגדרה אחת בלבד לרשת הזמן ואי אפשר שהשתיים יסטו זו מזו.
var array<int>  cxRef  = array.new_int(7, 0)
var array<int>  cxLife = array.new_int(7, 0)
var array<bool> cxQ2   = array.new_bool(7, false)
var array<int>  cxMisc = array.new_int(2, 0)   // 0 = dayofweek · 1 = שבוע מת (0/1)

f_ctx(t) =>
    int  md   = hour(t, TZ) * 60 + minute(t, TZ)
    bool post = md >= 1080
    int  mfd  = post ? md - 1080 : md + 360
    int  tdt  = post ? t + 86400000 : t
    int  tdY  = year(tdt, TZ)
    int  tdM  = month(tdt, TZ)
    int  tdD  = dayofmonth(tdt, TZ)
    int  tdW  = dayofweek(tdt, TZ)

    int sIdx = mfd / 360
    int mIdx = (mfd % 360) / 90
    int qIdx = math.floor((mfd % 90) / 22.5)

    int  dsm  = tdW == dayofweek.sunday ? 6 : tdW - 2
    int  mont = tdt - dsm * 86400000
    int  monY = year(mont, TZ)
    int  monM = month(mont, TZ)
    int  monD = dayofmonth(mont, TZ)
    int  thuM = month(mont + 3 * 86400000, TZ)

    // שבוע מת = יום שני עד יום חמישי אינם באותו חודש. שבוע נספר לחודש רק
    // אם שני–חמישי שלו באותו חודש.
    bool dead = monM != thuM
    int  wkNo = dead ? 0 : (monD - 1) / 7 + 1

    // שנת QT מתחילה באפריל: Q1 = אפר/מאי/יונ ... Q4 = ינו/פבר/מרץ
    int qMon = tdM >= 4 ? tdM - 4 : tdM + 8
    int qYr  = tdM >= 4 ? tdY : tdY - 1
    int qQtr = qMon / 3 + 1

    int tday = tdY * 10000 + tdM * 100 + tdD
    int wid  = monY * 10000 + monM * 100 + monD
    int mid  = monY * 100 + monM
    int sid  = tday * 10 + sIdx
    int miid = sid * 10 + mIdx

    array.set(cxRef, 0, miid * 10 + qIdx)
    array.set(cxRef, 1, miid)
    array.set(cxRef, 2, sid)
    array.set(cxRef, 3, tday)
    array.set(cxRef, 4, wid)
    array.set(cxRef, 5, qYr * 10 + qQtr)
    array.set(cxRef, 6, qYr)

    array.set(cxLife, 0, miid)
    array.set(cxLife, 1, sid)
    array.set(cxLife, 2, tday)
    array.set(cxLife, 3, wid)
    array.set(cxLife, 4, mid)
    array.set(cxLife, 5, qYr)
    array.set(cxLife, 6, math.floor(qYr / 4))

    // True Open של מחלקה = הפתיחה של Q2 של המיכל שלה
    array.set(cxQ2, 0, qIdx == 1)
    array.set(cxQ2, 1, mIdx == 1)
    array.set(cxQ2, 2, mfd >= 360 and mfd < 720)
    array.set(cxQ2, 3, tdW == dayofweek.tuesday)
    array.set(cxQ2, 4, wkNo == 2)
    array.set(cxQ2, 5, qQtr == 2)
    array.set(cxQ2, 6, qYr % 4 == 1)

    array.set(cxMisc, 0, tdW)
    array.set(cxMisc, 1, dead ? 1 : 0)
    0

// ═══════════════════════════════════════════════════════════════════
// טיפוס המחלקה — נר סינתטי + מנוע SSMT/HSSMT + מצב תצוגה
// ═══════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════
// שלושת הנרות הסגורים האחרונים של מחלקה, לנכס אחד.
// [0] = האחרון · [1] = שלפניו · [2] = שלפני-פניו.
// Fill מזהה FVG על שלושתם; PSP מחפש סווינג שבו [1] הוא הקיצון.
// ═══════════════════════════════════════════════════════════════════

type Bar3
    float o0 = na
    float h0 = na
    float l0 = na
    float c0 = na
    float o1 = na
    float h1 = na
    float l1 = na
    float c1 = na
    float o2 = na
    float h2 = na
    float l2 = na
    float c2 = na

method push(Bar3 b, o, h, l, c) =>
    b.o2 := b.o1
    b.h2 := b.h1
    b.l2 := b.l1
    b.c2 := b.c1
    b.o1 := b.o0
    b.h1 := b.h0
    b.l1 := b.l0
    b.c1 := b.c0
    b.o0 := o
    b.h0 := h
    b.l0 := l
    b.c0 := c
    0

// ═══════════════════════════════════════════════════════════════════
// גאפ קולקטיבי — FVG באותו כיוון, באותו נר, גם ב-NQ וגם ב-ES.
// גאפ שקיים בנכס אחד בלבד לא נחשב כלל.
// מועבר מ-SSMT Fill בלי שדות הציור, שהרדאר לא צריך.
// ═══════════════════════════════════════════════════════════════════

type Gap
    int    dir     = 0      // 1 = שורי · -1 = דובי
    float  nqBot   = na
    float  nqTop   = na
    float  esBot   = na
    float  esTop   = na
    int    refId   = 0      // תת-המחזור שבו נולד
    float  nqExt   = na     // הקיצוניות בביקור הנוכחי
    float  esExt   = na
    bool   inVisit = false
    bool   dead    = false  // הפך ל-IFVG
    bool   armed   = false  // תת-המחזור שבו נולד הסתיים — רק עכשיו הוא יכול לשבור
    int    fDeg    = 0      // דרגת השבירה שנרשמה. יכולה רק לעלות.
    string fLead   = ""
    int    fSeq    = 0
    int    fRefId  = 0
    int    fBar    = 0

// עומק החדירה של נכס לגאפ שלו, כאחוז מהגאפ שלו. ההשוואה בין הנכסים היא
// תמיד יחסית — כל נכס מול הגאפ שלו.
// 0 = לא נגע · 0.5 = CE · 1.0 = הקצה הרחוק · >1 = מעבר לגאפ בפתיל
method depth(Gap g, isNQ) =>
    float top = isNQ ? g.nqTop : g.esTop
    float bot = isNQ ? g.nqBot : g.esBot
    float ext = isNQ ? g.nqExt : g.esExt
    float rng = top - bot
    float d = 0.0
    if rng > 0 and not na(ext)
        d := g.dir == 1 ? (top - ext) / rng : (ext - bot) / rng
    math.max(d, 0.0)

// דרגת השבירה — הגבוהה ביותר שמתקיימת. 0 = אין שבירה.
//   1 — נכס אחד נגע, השני לא נגע בכלל
//   2 — נכס אחד הגיע ל-CE, השני לא
//   3 — נכס אחד הגיע לקצה הרחוק, השני לא
f_degree(dLead, dLag) =>
    int deg = 0
    if dLead >= 1.0 and dLag < 1.0
        deg := 3
    else if dLead >= 0.5 and dLag < 0.5
        deg := 2
    else if dLead > 0.0 and dLag <= 0.0
        deg := 1
    deg

type Cls
    int    idx      = 0
    string nm       = ""
    int    tf       = 0
    bool   on       = false     // מחושבת בגרף הנוכחי?
    bool   keepLast = false     // המיכל שומר את התת-מחזור האחרון של הקודם ("זרע")
    // ── הנר הסינתטי המתגבש ──
    int    barId    = na
    bool   emitted  = false     // הנר הנוכחי כבר עובד (נסגר בדיוק בסוף בר של הגרף)
    float  bNqO = na
    float  bNqH = na
    float  bNqL = na
    float  bNqC = na
    float  bEsO = na
    float  bEsH = na
    float  bEsL = na
    float  bEsC = na
    float  bYmO = na
    float  bYmH = na
    float  bYmL = na
    float  bYmC = na
    // הקשר הנר — נתפס בפתיחתו, וקבוע לאורכו בהגדרה
    int    bRef  = 0
    int    bLife = 0
    int    bDow  = 0
    bool   bDead = false
    bool   bQ2   = false
    // ── מנוע SSMT/HSSMT ──
    bool   started  = false
    int    eRef     = 0
    int    eLife    = 0
    bool   warm     = false     // נצפה גבול מיכל → יש מספיק היסטוריה לתשובה אמיתית
    bool   seedOn   = false
    bool   pQ2      = false
    float  trueOpen = na
    float  nqCH  = na
    float  nqCL  = na
    float  nqCHC = na
    float  nqCLC = na
    float  esCH  = na
    float  esCL  = na
    float  esCHC = na
    float  esCLC = na
    float  ymCH  = na
    float  ymCL  = na
    float  ymCHC = na
    float  ymCLC = na
    array<float> nqHiA  = na
    array<float> nqLoA  = na
    array<float> nqHiCA = na
    array<float> nqLoCA = na
    array<float> esHiA  = na
    array<float> esLoA  = na
    array<float> esHiCA = na
    array<float> esLoCA = na
    array<float> ymHiA  = na
    array<float> ymLoA  = na
    array<float> ymHiCA = na
    array<float> ymLoCA = na
    // ── מצב התצוגה ──
    int    bearT    = 0
    string bearS    = ""
    int    bearRefI = -1
    int    bearSeq  = 0
    int    bearBar  = 0
    int    bullT    = 0
    string bullS    = ""
    int    bullRefI = -1
    int    bullSeq  = 0
    int    bullBar  = 0
    // ── היסטוריית שלושת הנרות הסגורים האחרונים ──
    Bar3   hNq = na
    Bar3   hEs = na
    Bar3   hCh = na          // נכס הגרף — הסווינג של PSP נמדד עליו
    // ── מנוע Fill ──
    array<Gap> gaps = na
    int    gapSeedRef = 0
    bool   gapSeedOn  = false
    int    fillDir  = 0
    int    fillDeg  = 0
    string fillLead = ""
    int    fillSeq  = 0
    int    fillBar  = 0
    int    fillRef  = 0
    int    shownDir = 0      // הכיוון שהוצג לאחרונה, לביטול בשבירה נגדית
    // ── מנוע PCP/PSP ──
    bool   pcp0    = false   // סטיית כיוון בנר האחרון
    bool   pcp1    = false   // ובזה שלפניו — הסווינג נשען עליו
    int    pspDir  = 0
    int    pspSeq  = 0
    int    pspBar  = 0
    int    pspRef  = 0

// ═══════════════════════════════════════════════════════════════════
// זיהוי הסטייה — מועבר מ-SSMT+HSSMT ללא שינוי לוגי.
// HSSMT = סגירה מעבר · SSMT = פתיל מעבר. לקיחה מצטברת: הסריקה מתחילה
// מהתת-מחזור הקרוב-ביותר ומצטברת אחורה, כך שרמה שכבר נלקחה לא מחייה
// סטייה ישנה.
//
// האסימטריה מכוונת ונשמרת: בדובי הגרעין הוא NQ+ES (הסכמה שלהם מבטלת),
// בשורי צריך ששלושתם יסכימו כדי לבטל, ו-YM מושמט מתווית שורית.
//
// ההבדל היחיד מהמקור: הושמטו מערכי אינדקסי-הנרות, כי הרדאר לא מצייר
// קווים ולא צריך לדעת באיזה נר נוצרה הרמה.
// ═══════════════════════════════════════════════════════════════════

f_str(bNQ, bES, bYM, isBull) =>
    s = ""
    s := bNQ ? s + "NQ " : s
    s := bES ? s + "ES " : s
    s := (bYM and not isBull) ? s + "YM " : s
    str.trim(s)

f_findBear(nqHiA, esHiA, ymHiA, nqHiCA, esHiCA, ymHiCA, nqCH, esCH, ymCH, nqCHC, esCHC, ymCHC) =>
    bT = 0
    bI = -1
    bS = ""
    n = array.size(nqHiA)
    if n > 0
        float nqMH  = nqCH
        float esMH  = esCH
        float ymMH  = ymCH
        float nqMHc = nqCHC
        float esMHc = esCHC
        float ymMHc = ymCHC
        bool stopped = false
        for i = n - 1 to 0
            if bT == 0 and not stopped
                nw = nqMH > array.get(nqHiA, i)
                ew = esMH > array.get(esHiA, i)
                yw = ymMH > array.get(ymHiA, i)
                nc = nqMHc > array.get(nqHiCA, i)
                ec = esMHc > array.get(esHiCA, i)
                yc = ymMHc > array.get(ymHiCA, i)
                hValid = (nc or ec or yc) and not (nc and ec)
                wValid = (nw or ew or yw) and not (nw and ew)
                if hValid or wValid
                    hN = hValid and nc
                    hE = hValid and ec
                    hY = hValid and yc
                    hs = f_str(hN, hE, hY, false)
                    ss = f_str(nw and not hN, ew and not hE, yw and not hY, false)
                    ss := wValid ? ss : ""
                    lbl = hs != "" ? "H " + hs : ""
                    lbl := ss != "" ? (lbl != "" ? lbl + " S " + ss : "S " + ss) : lbl
                    if not hValid and nc and ec
                        lbl := lbl + (yc ? " (all closed)" : " (core closed)")
                    bT := hs != "" ? 2 : 1
                    bI := i
                    bS := lbl
                else if (nw and ew) or (nc and ec)
                    stopped := true
            nqMH  := math.max(nqMH,  array.get(nqHiA, i))
            esMH  := math.max(esMH,  array.get(esHiA, i))
            ymMH  := math.max(ymMH,  array.get(ymHiA, i))
            nqMHc := math.max(nqMHc, array.get(nqHiCA, i))
            esMHc := math.max(esMHc, array.get(esHiCA, i))
            ymMHc := math.max(ymMHc, array.get(ymHiCA, i))
    [bT, bI, bS]

f_findBull(nqLoA, esLoA, ymLoA, nqLoCA, esLoCA, ymLoCA, nqCL, esCL, ymCL, nqCLC, esCLC, ymCLC) =>
    bT = 0
    bI = -1
    bS = ""
    n = array.size(nqLoA)
    if n > 0
        float nqML  = nqCL
        float esML  = esCL
        float ymML  = ymCL
        float nqMLc = nqCLC
        float esMLc = esCLC
        float ymMLc = ymCLC
        bool stopped = false
        for i = n - 1 to 0
            if bT == 0 and not stopped
                nw = nqML < array.get(nqLoA, i)
                ew = esML < array.get(esLoA, i)
                yw = ymML < array.get(ymLoA, i)
                nc = nqMLc < array.get(nqLoCA, i)
                ec = esMLc < array.get(esLoCA, i)
                yc = ymMLc < array.get(ymLoCA, i)
                hValid = (nc or ec) and not (nc and ec and yc)
                wValid = (nw or ew) and not (nw and ew and yw)
                if hValid or wValid
                    hN = hValid and nc
                    hE = hValid and ec
                    hY = hValid and yc
                    hs = f_str(hN, hE, hY, true)
                    ss = f_str(nw and not hN, ew and not hE, yw and not hY, true)
                    ss := wValid ? ss : ""
                    lbl = hs != "" ? "H " + hs : ""
                    lbl := ss != "" ? (lbl != "" ? lbl + " S " + ss : "S " + ss) : lbl
                    if not hValid and nc and ec and yc
                        lbl := lbl + " (all closed)"
                    bT := hs != "" ? 2 : 1
                    bI := i
                    bS := lbl
                else if (nw and ew and yw) or (nc and ec and yc)
                    stopped := true
            nqML  := math.min(nqML,  array.get(nqLoA, i))
            esML  := math.min(esML,  array.get(esLoA, i))
            ymML  := math.min(ymML,  array.get(ymLoA, i))
            nqMLc := math.min(nqMLc, array.get(nqLoCA, i))
            esMLc := math.min(esMLc, array.get(esLoCA, i))
            ymMLc := math.min(ymMLc, array.get(ymLoCA, i))
    [bT, bI, bS]

// ═══════════════════════════════════════════════════════════════════
// צעד המנוע — נקרא בדיוק פעם אחת לכל נר סינתטי שנסגר.
//
// זהו אותו רצף פעולות של הסקריפט המקורי בכל בר מאושר: קודם דגלי הזרע
// (בעוד המצברים מחזיקים את התת-מחזור הקודם), אחר כך דחיפה/ניקוי, אחר כך
// עדכון המצברים, ורק בסוף הזיהוי.
//
// מונה הסדר יושב במערך ולא במשתנה גלובלי, כי Pine אוסר על פונקציה לשנות
// משתנה גלובלי — אבל תוכן של מערך כן ניתן לשינוי דרך ההפניה.
// ═══════════════════════════════════════════════════════════════════

var array<int> seqBox = array.new_int(1, 0)

// דגלי "נרשם סיגנל חדש בנר הזה", פר מחלקה ופר משפחה. המנועים כותבים
// לתוכם ישירות — Pine אוסר על פונקציה לשנות משתנה גלובלי, אבל תוכן של
// מערך כן ניתן לשינוי, וזה חוסך החזרת מסכות ביטים דרך כל שרשרת הקריאות.
var array<bool> firedS = array.new_bool(7, false)
var array<bool> firedF = array.new_bool(7, false)
var array<bool> firedP = array.new_bool(7, false)

// ═══════════════════════════════════════════════════════════════════
// מנוע Fill — סטייה לפי עומק מילוי גאפ קולקטיבי.
// מועבר מ-SSMT Fill, ורץ פעם אחת לכל נר סינתטי שנסגר במקום פעם לכל בר.
//
// כל ביקור בגאפ נמדד מאפס: מילוי משותף בביקור אחד לא חוסם שבירה בביקור
// הבא. הגאפ נשאר תקף עד IFVG בלבד. השבירה נרשמת על הגאפ עצמו ונשארת שם,
// והדרגה יכולה רק לעלות — רק IFVG, שבירה נגדית או החלפת מיכל מבטלים אותה.
// ═══════════════════════════════════════════════════════════════════

method stepFill(Cls c, newRef, newLife, prevRef) =>
    int ref = c.bRef

    // ── איפוס מיכל + מנגנון הזרע ──
    // במחלקות עם keepLast (1H · 1D · 1W) המיכל החדש יורש את הגאפים של
    // תת-המחזור האחרון של הקודם, והזרע נמחק בתום תת-המחזור הראשון.
    // (1H: יום שני יורש את גאפי שישי · 1D: Q1 יורש את גאפי Q4 הקודם)
    // ב-4H אין זרע: המחזור החודשי עומד בפני עצמו.
    if newLife
        if c.keepLast
            if array.size(c.gaps) > 0
                for gi = array.size(c.gaps) - 1 to 0
                    if array.get(c.gaps, gi).refId != prevRef
                        array.remove(c.gaps, gi)
            c.gapSeedRef := prevRef
            c.gapSeedOn  := array.size(c.gaps) > 0
        else
            array.clear(c.gaps)
            c.gapSeedOn := false
        c.fillDeg  := 0
        c.shownDir := 0
    else if newRef and c.gapSeedOn
        if array.size(c.gaps) > 0
            for gi = array.size(c.gaps) - 1 to 0
                if array.get(c.gaps, gi).refId == c.gapSeedRef
                    array.remove(c.gaps, gi)
        c.gapSeedOn := false

    float nqHi = c.hNq.h0
    float nqLo = c.hNq.l0
    float nqCl = c.hNq.c0
    float esHi = c.hEs.h0
    float esLo = c.hEs.l0
    float esCl = c.hEs.c0
    bool  ok   = not na(nqHi) and not na(esHi)

    // ── דריכה · מדידת ביקור · מוות ב-IFVG ──
    if ok and array.size(c.gaps) > 0
        for gi = 0 to array.size(c.gaps) - 1
            Gap g = array.get(c.gaps, gi)
            if not g.dead
                // גאפ זמין לשבירה רק אחרי שתת-המחזור שבו נולד הסתיים.
                // חזרה אליו באותו תת-מחזור שבו נוצר אינה שבירה.
                if not g.armed and g.refId != ref
                    g.armed := true

                if g.armed
                    bool bothOut = g.dir == 1 ? (nqLo > g.nqTop and esLo > g.esTop) : (nqHi < g.nqBot and esHi < g.esBot)
                    if bothOut
                        g.inVisit := false
                        g.nqExt   := g.dir == 1 ? g.nqTop : g.nqBot
                        g.esExt   := g.dir == 1 ? g.esTop : g.esBot
                    else
                        g.inVisit := true
                        if g.dir == 1
                            g.nqExt := math.min(g.nqExt, nqLo)
                            g.esExt := math.min(g.esExt, esLo)
                        else
                            g.nqExt := math.max(g.nqExt, nqHi)
                            g.esExt := math.max(g.esExt, esHi)

                // IFVG: סגירה מעבר לגאפ הופכת אותו — הרעיון מתבטל.
                // הגאפ שנוצר בנר הזה נדחף רק בהמשך, ולכן לא נבדק על נר לידתו.
                if g.dir == 1
                    if nqCl < g.nqBot or esCl < g.esBot
                        g.dead := true
                else
                    if nqCl > g.nqTop or esCl > g.esTop
                        g.dead := true

    // ── זיהוי גאפ קולקטיבי חדש ──
    if ok and not na(c.hNq.h2) and not na(c.hEs.h2)
        bool bullNQ = c.hNq.l0 > c.hNq.h2
        bool bullES = c.hEs.l0 > c.hEs.h2
        bool bearNQ = c.hNq.h0 < c.hNq.l2
        bool bearES = c.hEs.h0 < c.hEs.l2
        int  nd = (bullNQ and bullES) ? 1 : (bearNQ and bearES) ? -1 : 0

        if nd != 0
            float nb = na
            float nt = na
            float eb = na
            float et = na
            // הגבול נמדד בפתיל ומורחב לגוף רק כשיש באותו צד רווח שלא נסחר,
            // כלומר הנר הבא נפתח מעבר לפתיל הקודם ולא רק מעבר לסגירה שלו.
            if nd == 1
                nb := (extendBodies and c.hNq.o1 > c.hNq.h2) ? c.hNq.c2 : c.hNq.h2
                nt := (extendBodies and c.hNq.l0 > c.hNq.c1) ? c.hNq.o0 : c.hNq.l0
                eb := (extendBodies and c.hEs.o1 > c.hEs.h2) ? c.hEs.c2 : c.hEs.h2
                et := (extendBodies and c.hEs.l0 > c.hEs.c1) ? c.hEs.o0 : c.hEs.l0
            else
                nt := (extendBodies and c.hNq.o1 < c.hNq.l2) ? c.hNq.c2 : c.hNq.l2
                nb := (extendBodies and c.hNq.h0 < c.hNq.c1) ? c.hNq.o0 : c.hNq.h0
                et := (extendBodies and c.hEs.o1 < c.hEs.l2) ? c.hEs.c2 : c.hEs.l2
                eb := (extendBodies and c.hEs.h0 < c.hEs.c1) ? c.hEs.o0 : c.hEs.h0

            if nt - nb > minGapPct / 100 * nqCl and et - eb > minGapPct / 100 * esCl
                array.push(c.gaps, Gap.new(nd, nb, nt, eb, et, ref, nd == 1 ? nt : nb, nd == 1 ? et : eb))
                if array.size(c.gaps) > maxGaps
                    array.shift(c.gaps)

    // ── רישום שבירות — לכל גאפ השבירה שלו ──
    bool cycleOK  = not (c.idx == 5 and blockDeadWeek and c.bDead)
    bool friBlock = (c.idx == 4 or c.idx == 5) and c.bDow == dayofweek.friday

    if ok and not friBlock and cycleOK and array.size(c.gaps) > 0
        for gi = 0 to array.size(c.gaps) - 1
            Gap g = array.get(c.gaps, gi)
            if not g.dead and g.armed
                float dN  = g.depth(true)
                float dE  = g.depth(false)
                int   deg = f_degree(math.max(dN, dE), math.min(dN, dE))
                if deg > g.fDeg
                    // כל עליית דרגה היא אירוע חדש: היא מרעננת את המונה ואת
                    // תת-המחזור, כך שמה שמוצג הוא תמיד מה שקרה אחרון.
                    array.set(seqBox, 0, array.get(seqBox, 0) + 1)
                    g.fSeq   := array.get(seqBox, 0)
                    g.fRefId := ref
                    g.fBar   := bar_index
                    g.fDeg   := deg
                    g.fLead  := dN > dE ? "NQ" : "ES"
                    array.set(firedF, c.idx - 1, true)

    // ── בחירת המוצג: השבירה העדכנית ביותר מתת-המחזור הנוכחי ──
    // שבירה מייצגת את תת-המחזור שבו קרתה ולכן יורדת מהמסך כשהוא נגמר, גם
    // אם הגאפ עצמו עדיין חי.
    int selIdx = -1
    int selSeq = -1
    if array.size(c.gaps) > 0
        for gi = 0 to array.size(c.gaps) - 1
            Gap g = array.get(c.gaps, gi)
            if not g.dead and g.fDeg > 0 and g.fRefId == ref and g.fSeq > selSeq
                selSeq := g.fSeq
                selIdx := gi

    if selIdx == -1
        c.fillDeg := 0
    else
        Gap gs = array.get(c.gaps, selIdx)
        // שבירה נגדית מבטלת את השבירות בכיוון הישן
        if c.shownDir != 0 and gs.dir != c.shownDir
            for gi = 0 to array.size(c.gaps) - 1
                Gap gk = array.get(c.gaps, gi)
                if gk.dir == c.shownDir
                    gk.fDeg := 0
        c.shownDir := gs.dir
        c.fillDir  := gs.dir
        c.fillDeg  := gs.fDeg
        c.fillLead := gs.fLead
        c.fillSeq  := gs.fSeq
        c.fillBar  := gs.fBar
        c.fillRef  := gs.fRefId
    0

// ═══════════════════════════════════════════════════════════════════
// מנוע PCP/PSP — סטיית כיוון נר, ואישור סווינג 3-נרות.
//
// PCP = לא כל הנכסים סגרו באותו כיוון באותו נר.
// PSP = סווינג מאושר: הנר האמצעי הוא הקיצון, והנר שאחריו כבר נסגר.
// הסווינג נמדד על נכס הגרף; ה-PCP נמדד על שלושת הנכסים.
// ═══════════════════════════════════════════════════════════════════

method stepPsp(Cls c, newLife) =>
    if newLife
        c.pspDir := 0

    int dN = na(c.bNqC) or na(c.bNqO) ? 0 : c.bNqC > c.bNqO ? 1 : c.bNqC < c.bNqO ? -1 : 0
    int dE = na(c.bEsC) or na(c.bEsO) ? 0 : c.bEsC > c.bEsO ? 1 : c.bEsC < c.bEsO ? -1 : 0
    int dY = na(c.bYmC) or na(c.bYmO) ? 0 : c.bYmC > c.bYmO ? 1 : c.bYmC < c.bYmO ? -1 : 0

    // בלי נתוני YM משווים רק את הגרעין, במקום לספור נכס חסר כדוג'י ולייצר PCP מדומה
    bool hasY   = not na(c.bYmC) and not na(c.bYmO)
    bool pcpNow = hasY ? not (dN == dE and dE == dY) : dN != dE

    // ההיסטוריה כבר נדחפה, ולכן pcp1 מתיישר עם הנר שנמצא כעת ב-[1]
    c.pcp1 := c.pcp0
    c.pcp0 := pcpNow

    bool cycleOK  = not (c.idx == 5 and blockDeadWeek and c.bDead)
    bool friBlock = (c.idx == 4 or c.idx == 5) and c.bDow == dayofweek.friday

    if c.pcp1 and not friBlock and cycleOK and not na(c.hCh.h2) and not na(c.hCh.h0)
        bool swHigh = c.hCh.h1 > c.hCh.h2 and c.hCh.h1 > c.hCh.h0   // סווינג גבוה = דובי
        bool swLow  = c.hCh.l1 < c.hCh.l2 and c.hCh.l1 < c.hCh.l0   // סווינג נמוך = שורי
        int  nd = swHigh ? -1 : swLow ? 1 : 0
        if nd != 0
            array.set(seqBox, 0, array.get(seqBox, 0) + 1)
            c.pspDir := nd
            c.pspSeq := array.get(seqBox, 0)
            c.pspBar := bar_index
            c.pspRef := c.bRef
            array.set(firedP, c.idx - 1, true)
    0

method step(Cls c) =>
    bool newRef  = not c.started or c.bRef  != c.eRef
    bool newLife = not c.started or c.bLife != c.eLife
    int  prevRef = c.eRef        // נתפס לפני העדכון — הזרע של Fill נשען עליו

    // גבול מיכל שנצפה בפועל = מכאן והלאה יש היסטוריה מלאה למחלקה הזו
    if newLife and c.started
        c.warm := true

    // רמת ייחוס נדחפת רק אם היא שלמה בשלושת הנכסים. אם לנכס אחד חסרו נתונים
    // בתת-המחזור הזה, המערכים חייבים לדלג עליו יחד — הם מיושרים באינדקס,
    // ורמת na אחת הייתה מרעילה את המקסימום הרץ ומשתיקה את הנכס בשקט.
    bool pushOK   = not na(c.nqCH) and not na(c.esCH) and not na(c.ymCH)
    bool seedPush = newRef and newLife and c.keepLast and pushOK
    bool dropSeed = newRef and (not newLife) and c.seedOn

    if newRef
        if newLife
            array.clear(c.nqHiA)
            array.clear(c.nqLoA)
            array.clear(c.nqHiCA)
            array.clear(c.nqLoCA)
            array.clear(c.esHiA)
            array.clear(c.esLoA)
            array.clear(c.esHiCA)
            array.clear(c.esLoCA)
            array.clear(c.ymHiA)
            array.clear(c.ymLoA)
            array.clear(c.ymHiCA)
            array.clear(c.ymLoCA)
        if ((not newLife) or c.keepLast) and pushOK
            array.push(c.nqHiA,  c.nqCH)
            array.push(c.nqLoA,  c.nqCL)
            array.push(c.nqHiCA, c.nqCHC)
            array.push(c.nqLoCA, c.nqCLC)
            array.push(c.esHiA,  c.esCH)
            array.push(c.esLoA,  c.esCL)
            array.push(c.esHiCA, c.esCHC)
            array.push(c.esLoCA, c.esCLC)
            array.push(c.ymHiA,  c.ymCH)
            array.push(c.ymLoA,  c.ymCL)
            array.push(c.ymHiCA, c.ymCHC)
            array.push(c.ymLoCA, c.ymCLC)
        if dropSeed and array.size(c.nqHiA) > 0
            array.remove(c.nqHiA,  0)
            array.remove(c.nqLoA,  0)
            array.remove(c.nqHiCA, 0)
            array.remove(c.nqLoCA, 0)
            array.remove(c.esHiA,  0)
            array.remove(c.esLoA,  0)
            array.remove(c.esHiCA, 0)
            array.remove(c.esLoCA, 0)
            array.remove(c.ymHiA,  0)
            array.remove(c.ymLoA,  0)
            array.remove(c.ymHiCA, 0)
            array.remove(c.ymLoCA, 0)
        c.nqCH  := c.bNqH
        c.nqCL  := c.bNqL
        c.nqCHC := c.bNqC
        c.nqCLC := c.bNqC
        c.esCH  := c.bEsH
        c.esCL  := c.bEsL
        c.esCHC := c.bEsC
        c.esCLC := c.bEsC
        c.ymCH  := c.bYmH
        c.ymCL  := c.bYmL
        c.ymCHC := c.bYmC
        c.ymCLC := c.bYmC
    else
        // נר סינתטי ריק בנכס מסוים לא דורס מצבר תקין — math.max מול na
        // מחזיר na, וזה היה מוחק את הרמה שכבר נצברה.
        if not na(c.bNqH)
            c.nqCH  := na(c.nqCH)  ? c.bNqH : math.max(c.nqCH,  c.bNqH)
            c.nqCL  := na(c.nqCL)  ? c.bNqL : math.min(c.nqCL,  c.bNqL)
            c.nqCHC := na(c.nqCHC) ? c.bNqC : math.max(c.nqCHC, c.bNqC)
            c.nqCLC := na(c.nqCLC) ? c.bNqC : math.min(c.nqCLC, c.bNqC)
        if not na(c.bEsH)
            c.esCH  := na(c.esCH)  ? c.bEsH : math.max(c.esCH,  c.bEsH)
            c.esCL  := na(c.esCL)  ? c.bEsL : math.min(c.esCL,  c.bEsL)
            c.esCHC := na(c.esCHC) ? c.bEsC : math.max(c.esCHC, c.bEsC)
            c.esCLC := na(c.esCLC) ? c.bEsC : math.min(c.esCLC, c.bEsC)
        if not na(c.bYmH)
            c.ymCH  := na(c.ymCH)  ? c.bYmH : math.max(c.ymCH,  c.bYmH)
            c.ymCL  := na(c.ymCL)  ? c.bYmL : math.min(c.ymCL,  c.bYmL)
            c.ymCHC := na(c.ymCHC) ? c.bYmC : math.max(c.ymCHC, c.bYmC)
            c.ymCLC := na(c.ymCLC) ? c.bYmC : math.min(c.ymCLC, c.bYmC)

    if newRef and newLife
        c.seedOn := seedPush
    else if newRef
        c.seedOn := false

    // מחיקת הזרע מזיזה את כל האינדקסים ב-1 — יישור כדי שלא ייחשב ייחוס חדש
    if dropSeed
        c.bearRefI := c.bearRefI > 0 ? c.bearRefI - 1 : -1
        c.bullRefI := c.bullRefI > 0 ? c.bullRefI - 1 : -1

    // פקיעת מיכל מאפסת את מצב התצוגה
    if newLife
        c.bearT    := 0
        c.bullT    := 0
        c.bearRefI := -1
        c.bullRefI := -1

    // ── True Open של המחלקה ──
    if c.bQ2 and not c.pQ2
        c.trueOpen := isESc ? c.bEsO : isYMc ? c.bYmO : c.bNqO
    c.pQ2 := c.bQ2

    float chartClose = isESc ? c.bEsC : isYMc ? c.bYmC : c.bNqC
    bool  bearOK = not requireTrueOpen or (not na(c.trueOpen) and chartClose > c.trueOpen)
    bool  bullOK = not requireTrueOpen or (not na(c.trueOpen) and chartClose < c.trueOpen)

    // ── חסימות פר-מחלקה, כמו במקור ──
    // שבוע מת חוסם את מחלקת 4H; שישי חוסם את 1H ו-4H, כי שבירה שעתית
    // מייצגת את השבוע (שני–חמישי) וביום שישי היא כבר לא רלוונטית.
    bool cycleOK  = not (c.idx == 5 and blockDeadWeek and c.bDead)
    bool friBlock = (c.idx == 4 or c.idx == 5) and c.bDow == dayofweek.friday

    c.started := true
    c.eRef    := c.bRef
    c.eLife   := c.bLife

    // ── זיהוי SSMT/HSSMT ──
    if useSSMT and not friBlock and cycleOK and array.size(c.nqHiA) > 0
        [nbT, nbI, nbS] = f_findBear(c.nqHiA, c.esHiA, c.ymHiA, c.nqHiCA, c.esHiCA, c.ymHiCA, c.nqCH, c.esCH, c.ymCH, c.nqCHC, c.esCHC, c.ymCHC)
        if nbT != 0 and bearOK
            // שבירה חדשה = כיוון שהיה כבוי, או התעגנות לתת-מחזור ייחוס אחר
            if c.bearT == 0 or nbI != c.bearRefI
                array.set(seqBox, 0, array.get(seqBox, 0) + 1)
                c.bearSeq := array.get(seqBox, 0)
                c.bearBar := bar_index
                array.set(firedS, c.idx - 1, true)
            c.bearRefI := nbI
            c.bearT    := nbT
            c.bearS    := nbS
        else
            c.bearT    := 0
            c.bearRefI := -1

        [nuT, nuI, nuS] = f_findBull(c.nqLoA, c.esLoA, c.ymLoA, c.nqLoCA, c.esLoCA, c.ymLoCA, c.nqCL, c.esCL, c.ymCL, c.nqCLC, c.esCLC, c.ymCLC)
        if nuT != 0 and bullOK
            if c.bullT == 0 or nuI != c.bullRefI
                array.set(seqBox, 0, array.get(seqBox, 0) + 1)
                c.bullSeq := array.get(seqBox, 0)
                c.bullBar := bar_index
                array.set(firedS, c.idx - 1, true)
            c.bullRefI := nuI
            c.bullT    := nuT
            c.bullS    := nuS
        else
            c.bullT    := 0
            c.bullRefI := -1
    else
        c.bearT    := 0
        c.bullT    := 0
        c.bearRefI := -1
        c.bullRefI := -1

    // ── היסטוריית הנרות, ואז שתי המשפחות שנשענות עליה ──
    // הדחיפה קורית אחרי SSMT ולפני Fill/PSP, כי שניהם קוראים את הנר שזה
    // עתה נסגר בתור [0]. SSMT לעומתם עובד על המצברים ולא על ההיסטוריה.
    c.hNq.push(c.bNqO, c.bNqH, c.bNqL, c.bNqC)
    c.hEs.push(c.bEsO, c.bEsH, c.bEsL, c.bEsC)
    if isESc
        c.hCh.push(c.bEsO, c.bEsH, c.bEsL, c.bEsC)
    else if isYMc
        c.hCh.push(c.bYmO, c.bYmH, c.bYmL, c.bYmC)
    else
        c.hCh.push(c.bNqO, c.bNqH, c.bNqL, c.bNqC)

    // גאפ דקתי ו-PSP דקתי לא נספרים — רק מ-5m ומעלה
    if useFill and c.idx >= 2
        c.stepFill(newRef, newLife, prevRef)
    if usePSP and c.idx >= 2
        c.stepPsp(newLife)
    0

// ═══════════════════════════════════════════════════════════════════
// בונה הנר הסינתטי של מחלקה אחת, ומריץ את המנוע ברגע שהנר נסגר.
//
// נר נסגר באחד משני אופנים, וזה שקורה ראשון קובע:
//   (א) המזהה בסוף הבר הנוכחי שונה מזה שבתחילתו — הבר הזה סוגר את הנר.
//       זה המקרה הרגיל, בלי פיגור של אף בר.
//   (ב) המזהה של הבר החדש שונה מזה של הנר השמור — קורה כשיש פער בנתונים
//       (הפסקת 17:00–18:00, סופ"ש), ואז הנר נסגר רטרואקטיבית.
// דגל emitted מונע עיבוד כפול של אותו נר.
//
// המחירים מגיעים דרך pxA ולא כפרמטרים, כדי לא להעביר עשרים ארגומנטים.
// אותו בונה משרת גם את נרות הגרף וגם את האינטרה-בארים של שלב ב'.
// ═══════════════════════════════════════════════════════════════════

var array<float> pxA = array.new_float(12, na)   // 0-3 NQ · 4-7 ES · 8-11 YM (OHLC)

method feed(Cls c, idNow, idNext, i) =>
    if na(c.barId) or idNow != c.barId
        if not na(c.barId) and not c.emitted
            c.step()
        c.barId   := idNow
        c.emitted := false
        c.bNqO := array.get(pxA, 0)
        c.bNqH := array.get(pxA, 1)
        c.bNqL := array.get(pxA, 2)
        c.bNqC := array.get(pxA, 3)
        c.bEsO := array.get(pxA, 4)
        c.bEsH := array.get(pxA, 5)
        c.bEsL := array.get(pxA, 6)
        c.bEsC := array.get(pxA, 7)
        c.bYmO := array.get(pxA, 8)
        c.bYmH := array.get(pxA, 9)
        c.bYmL := array.get(pxA, 10)
        c.bYmC := array.get(pxA, 11)
        c.bRef  := array.get(cxRef, i)
        c.bLife := array.get(cxLife, i)
        c.bDow  := array.get(cxMisc, 0)
        c.bDead := array.get(cxMisc, 1) == 1
        c.bQ2   := array.get(cxQ2, i)
    else
        // נכס בלי נתון באינטרה-בר הזה פשוט לא מתעדכן, ונר שנפתח בלי נתון
        // מאותחל בהזדמנות הראשונה שבה הנתון מופיע. בלי זה דקה חסרה בנכס
        // אחד הייתה מרעילה את כל הנר הסינתטי שלו ב-na.
        if not na(array.get(pxA, 0))
            c.bNqO := na(c.bNqO) ? array.get(pxA, 0) : c.bNqO
            c.bNqH := na(c.bNqH) ? array.get(pxA, 1) : math.max(c.bNqH, array.get(pxA, 1))
            c.bNqL := na(c.bNqL) ? array.get(pxA, 2) : math.min(c.bNqL, array.get(pxA, 2))
            c.bNqC := array.get(pxA, 3)
        if not na(array.get(pxA, 4))
            c.bEsO := na(c.bEsO) ? array.get(pxA, 4) : c.bEsO
            c.bEsH := na(c.bEsH) ? array.get(pxA, 5) : math.max(c.bEsH, array.get(pxA, 5))
            c.bEsL := na(c.bEsL) ? array.get(pxA, 6) : math.min(c.bEsL, array.get(pxA, 6))
            c.bEsC := array.get(pxA, 7)
        if not na(array.get(pxA, 8))
            c.bYmO := na(c.bYmO) ? array.get(pxA, 8) : c.bYmO
            c.bYmH := na(c.bYmH) ? array.get(pxA, 9) : math.max(c.bYmH, array.get(pxA, 9))
            c.bYmL := na(c.bYmL) ? array.get(pxA, 10) : math.min(c.bYmL, array.get(pxA, 10))
            c.bYmC := array.get(pxA, 11)

    if idNext != idNow and not c.emitted
        c.step()
        c.emitted := true
    0

// כיוון מוצג = הסטייה שנרשמה אחרונה. מחזיר [dir, type, str, bar, refI]
f_show(Cls c) =>
    int    d = 0
    if c.bearT != 0 and c.bullT != 0
        d := c.bearSeq > c.bullSeq ? -1 : 1
    else if c.bearT != 0
        d := -1
    else if c.bullT != 0
        d := 1
    int    t = d == -1 ? c.bearT    : d == 1 ? c.bullT    : 0
    string s = d == -1 ? c.bearS    : d == 1 ? c.bullS    : ""
    int    b = d == -1 ? c.bearBar  : d == 1 ? c.bullBar  : 0
    int    r = d == -1 ? c.bearRefI : d == 1 ? c.bullRefI : -1
    [d, t, s, b, r]

// ═══════════════════════════════════════════════════════════════════
// אתחול שבע המחלקות
//
// מחלקה שהנר שלה ≥ נר הגרף נבנית מנרות הגרף עצמם, בתנאי שהיא מתחלקת בו
// בלי שארית — אחרת הנר הסינתטי לא יושב על רשת הגרף והתשובה תהיה קירוב.
// מחלקה שמתחת ל-TF של הגרף נבנית מאינטרה-בארים (ראה למטה).
// מחלקה שאי אפשר לחשב מסומנת בטבלה ולא מנחשת.
// ═══════════════════════════════════════════════════════════════════

chartTf = math.floor(timeframe.in_seconds() / 60)

// אינדקס המחלקה שמתאימה לגרף הנוכחי (0..6). משמש לסימון השורה בטבלה
// ולתיחום ההתראות. המרווח בין מחלקות סמוכות אינו קבוע (5→15 פי 3,
// 15→60 פי 4), ולכן "מדרגה אחת מתחת" נמדד באינדקס ולא ביחס דקות.
chartIdx = chartTf <= 1 ? 0 : chartTf <= 5 ? 1 : chartTf <= 15 ? 2 : chartTf <= 60 ? 3 : chartTf <= 240 ? 4 : chartTf <= 1440 ? 5 : 6

// ═══════════════════════════════════════════════════════════════════
// מסגרות זמן נמוכות מהגרף
//
// זה התרחיש שבשבילו נבנה הרדאר: אתה בעסקה על 15 דקות, ופתאום נולדת שבירה
// דקתית שעלולה להביא תיקון נגדך. request.security רגיל לא יכול לשרת את זה
// (בפנים כבר יש request.security ל-NQ/ES/YM, ו-Pine אוסר קינון), ולכן
// המסלול היחיד הוא request.security_lower_tf — שמחזיר מערך אינטרה-בארים
// לכל בר של הגרף.
//
// נמשכת מסגרת אחת בלבד — העדינה ביותר שנדרשת בפועל — וכל המחלקות שמתחת
// לגרף נבנות ממנה באגרגציה. על גרף 15 דקות עם הכל דלוק זו משיכת 1m אחת
// לכל נכס, ומחלקת 5m נבנית מאותו זרם. סה"כ שש קריאות request בסקריפט.
//
// מעל 4H המשיכה מושבתת: מספר האינטרה-בארים לבר הופך בלתי-סביר, והמחלקות
// הנמוכות מסומנות n/a במקום להציג מצב שגוי.
//
// הערה על עומק: TradingView מגביל את סך האינטרה-בארים לפי סוג המנוי, ומעבר
// לתקרה הוא מחזיר מערכים ריקים לברים ישנים. זה בסדר כאן — המנועים פשוט
// מתחממים מהנקודה שבה יש נתונים, ומחלקת 1m צריכה 90 דקות היסטוריה בלבד.
// ═══════════════════════════════════════════════════════════════════

lowerCap = chartTf >= 5 and chartTf <= 240
fineIdx  = not lowerCap ? -1 : (chartIdx > 0 and useC1) ? 0 : (chartIdx > 1 and useC2) ? 1 : (chartIdx > 2 and useC3) ? 2 : (chartIdx > 3 and useC4) ? 3 : (chartIdx > 4 and useC5) ? 4 : -1
lowerOn  = fineIdx >= 0

// Pine דורש שקריאת request תופיע בסקופ הגלובלי בלי תנאי, ולכן כשאין צורך
// במסגרת נמוכה מבקשים את מסגרת הגרף עצמה — קריאה זולה שתוצאתה לא נצרכת.
fineTf = fineIdx == 0 ? "1" : fineIdx == 1 ? "5" : fineIdx == 2 ? "15" : fineIdx == 3 ? "60" : fineIdx == 4 ? "240" : timeframe.period
fineMs = (fineIdx == 0 ? 1 : fineIdx == 1 ? 5 : fineIdx == 2 ? 15 : fineIdx == 3 ? 60 : fineIdx == 4 ? 240 : chartTf) * 60000

[nqTa, nqOa, nqHa, nqLa, nqCa] = request.security_lower_tf(sNQ, fineTf, [time, open, high, low, close])
[esTa, esOa, esHa, esLa, esCa] = request.security_lower_tf(sES, fineTf, [time, open, high, low, close])
[ymTa, ymOa, ymHa, ymLa, ymCa] = request.security_lower_tf(sYM, fineTf, [time, open, high, low, close])

f_clsOn(idx, cTf, userOn) =>
    bool r = false
    if userOn and chartTf >= 1
        if idx - 1 >= chartIdx
            r := idx <= 5 ? (cTf >= chartTf and cTf % chartTf == 0) : chartTf <= cTf
        else
            r := lowerOn and idx - 1 >= fineIdx
    r

var array<Cls> CLS = array.new<Cls>()
if barstate.isfirst
    array.push(CLS, Cls.new(1, "1m",  1,     f_clsOn(1, 1,     useC1), false))
    array.push(CLS, Cls.new(2, "5m",  5,     f_clsOn(2, 5,     useC2), false))
    array.push(CLS, Cls.new(3, "15m", 15,    f_clsOn(3, 15,    useC3), false))
    array.push(CLS, Cls.new(4, "1H",  60,    f_clsOn(4, 60,    useC4), true))
    array.push(CLS, Cls.new(5, "4H",  240,   f_clsOn(5, 240,   useC5), false))
    array.push(CLS, Cls.new(6, "1D",  1440,  f_clsOn(6, 1440,  useC6), true))
    array.push(CLS, Cls.new(7, "1W",  10080, f_clsOn(7, 10080, useC7), true))
    for i = 0 to 6
        Cls ci = array.get(CLS, i)
        ci.nqHiA  := array.new_float()
        ci.nqLoA  := array.new_float()
        ci.nqHiCA := array.new_float()
        ci.nqLoCA := array.new_float()
        ci.esHiA  := array.new_float()
        ci.esLoA  := array.new_float()
        ci.esHiCA := array.new_float()
        ci.esLoCA := array.new_float()
        ci.ymHiA  := array.new_float()
        ci.ymLoA  := array.new_float()
        ci.ymHiCA := array.new_float()
        ci.ymLoCA := array.new_float()
        ci.hNq := Bar3.new()
        ci.hEs := Bar3.new()
        ci.hCh := Bar3.new()
        ci.gaps := array.new<Gap>()

// ═══════════════════════════════════════════════════════════════════
// הרצת שני המסלולים
//
// חשוב שהסדר יישמר: מסלול ב' דורס את מערכי ההקשר (cxRef/cxLife/cxBarO...)
// עם הזמן של כל אינטרה-בר, ולכן מסלול א' ממלא אותם מחדש לפני שהוא רץ.
// ═══════════════════════════════════════════════════════════════════

if array.size(CLS) == 7
    for i = 0 to 6
        array.set(firedS, i, false)
        array.set(firedF, i, false)
        array.set(firedP, i, false)

// ── מסלול ב': מחלקות מתחת ל-TF של הגרף, מוזנות מאינטרה-בארים ──
//
// שלושת הנכסים לא בהכרח מחזירים אותו מספר אינטרה-בארים — דקה בלי עסקאות
// פשוט חסרה מהמערך — ולכן הזיווג הוא לפי חותמת זמן ולא לפי אינדקס. זיווג
// לפי אינדקס היה מחליק נכס שלם בדקה ומייצר סטיות מדומות. NQ משמש כשעון,
// והנכסים האחרים מסונכרנים אליו בהליכת מיזוג.
if barstate.isconfirmed and lowerOn and array.size(CLS) == 7 and array.size(nqTa) > 0
    int esN   = array.size(esTa)
    int ymN   = array.size(ymTa)
    int esCur = 0
    int ymCur = 0

    for k = 0 to array.size(nqTa) - 1
        int t = array.get(nqTa, k)

        while esCur < esN - 1 and array.get(esTa, esCur) < t
            esCur += 1
        while ymCur < ymN - 1 and array.get(ymTa, ymCur) < t
            ymCur += 1

        // הבדיקות מפורשות ולא בתוך and/טרנרי: Pine לא מבטיח short-circuit,
        // ו-array.get על מערך ריק הוא שגיאת זמן-ריצה שמפילה את הסקריפט.
        bool esHit = false
        bool ymHit = false
        if esN > 0
            esHit := array.get(esTa, esCur) == t
        if ymN > 0
            ymHit := array.get(ymTa, ymCur) == t

        array.set(pxA, 0, array.get(nqOa, k))
        array.set(pxA, 1, array.get(nqHa, k))
        array.set(pxA, 2, array.get(nqLa, k))
        array.set(pxA, 3, array.get(nqCa, k))

        if esHit
            array.set(pxA, 4, array.get(esOa, esCur))
            array.set(pxA, 5, array.get(esHa, esCur))
            array.set(pxA, 6, array.get(esLa, esCur))
            array.set(pxA, 7, array.get(esCa, esCur))
        else
            array.set(pxA, 4, na)
            array.set(pxA, 5, na)
            array.set(pxA, 6, na)
            array.set(pxA, 7, na)

        if ymHit
            array.set(pxA, 8,  array.get(ymOa, ymCur))
            array.set(pxA, 9,  array.get(ymHa, ymCur))
            array.set(pxA, 10, array.get(ymLa, ymCur))
            array.set(pxA, 11, array.get(ymCa, ymCur))
        else
            array.set(pxA, 8,  na)
            array.set(pxA, 9,  na)
            array.set(pxA, 10, na)
            array.set(pxA, 11, na)

        f_ctx(t)
        f_fillBarIds(t, cxBarO)
        f_fillBarIds(t + fineMs, cxBarC)

        // ‏for מ-0 עד chartIdx-1 היה רץ אחורה כש-chartIdx הוא 0, ולכן התנאי בפנים
        for i = 0 to 6
            if i < chartIdx
                Cls c = array.get(CLS, i)
                if c.on
                    c.feed(array.get(cxBarO, i), array.get(cxBarC, i), i)

// ── מסלול א': מחלקות שהנר שלהן ≥ נר הגרף, מוזנות מנרות הגרף עצמם ──
if barstate.isconfirmed and array.size(CLS) == 7
    f_ctx(time)
    f_fillBarIds(time, cxBarO)
    f_fillBarIds(time_close, cxBarC)

    array.set(pxA, 0,  nqO)
    array.set(pxA, 1,  nqH)
    array.set(pxA, 2,  nqL)
    array.set(pxA, 3,  nqC)
    array.set(pxA, 4,  esO)
    array.set(pxA, 5,  esH)
    array.set(pxA, 6,  esL)
    array.set(pxA, 7,  esC)
    array.set(pxA, 8,  ymO)
    array.set(pxA, 9,  ymH)
    array.set(pxA, 10, ymL)
    array.set(pxA, 11, ymC)

    for i = 0 to 6
        if i >= chartIdx
            Cls c = array.get(CLS, i)
            if c.on
                c.feed(array.get(cxBarO, i), array.get(cxBarC, i), i)

// ═══════════════════════════════════════════════════════════════════
// הרדאר — טבלה זעירה בפינה. שום ציור על פאנל המחיר.
// ═══════════════════════════════════════════════════════════════════

f_tblPos() =>
    tblPos == "ימין־עליון" ? position.top_right : tblPos == "ימין־אמצע" ? position.middle_right : tblPos == "שמאל־תחתון" ? position.bottom_left : tblPos == "שמאל־עליון" ? position.top_left : position.bottom_right

// מצב Fill המוצג: חי רק כל עוד תת-המחזור שבו נרשם עדיין נמשך.
// מחזיר [dir, deg, lead, bar]
f_showFill(Cls c) =>
    bool live = c.fillDeg > 0 and c.fillRef == c.eRef
    [live ? c.fillDir : 0, live ? c.fillDeg : 0, live ? c.fillLead : "", c.fillBar]

// מצב PSP המוצג — אותו כלל תפוגה. מחזיר [dir, bar]
f_showPsp(Cls c) =>
    bool live = c.pspDir != 0 and c.pspRef == c.eRef
    [live ? c.pspDir : 0, c.pspBar]

// הכיוון שהמחלקה "אומרת" כרגע — הסיגנל החי שנרשם אחרון מבין שלוש המשפחות.
// זה מה שמזין את שורת הקונפליקט ואת סימון הפוזיציה.
f_netDir(Cls c) =>
    [d, t, s, b, r]       = f_show(c)
    [fd, fdeg, flead, fb] = f_showFill(c)
    [pd, pb]              = f_showPsp(c)
    int best = -1
    int nd   = 0
    if d != 0 and useSSMT
        int sq = d == -1 ? c.bearSeq : c.bullSeq
        if sq > best
            best := sq
            nd   := d
    if fd != 0 and useFill and c.fillSeq > best
        best := c.fillSeq
        nd   := fd
    if pd != 0 and usePSP and c.pspSeq > best
        best := c.pspSeq
        nd   := pd
    nd

// סיגנל "טרי" = נרשם בתוך נר אחד של המחלקה שלו. מסגרות נמוכות מהגרף
// נמדדות בנר אחד של הגרף, כי שם נרשם המידע.
f_fresh(Cls c, b) =>
    b > 0 and bar_index - b <= math.max(1, c.tf / chartTf)

biasDir = myBias == "לונג" ? 1 : myBias == "שורט" ? -1 : 0

var table rad = table.new(f_tblPos(), 4, 10, border_width = 1, border_color = color.new(color.gray, 60))

if barstate.islast and array.size(CLS) == 7
    table.clear(rad, 0, 0, 3, 9)

    color hdrBg  = color.new(color.gray, 30)
    color cellBg = color.new(#0d1117, 20)
    color dimTxt = color.new(color.gray, 30)

    table.cell(rad, 0, 0, "MTF",  bgcolor = hdrBg, text_color = color.white, text_size = txtSize)
    table.cell(rad, 1, 0, "SSMT", bgcolor = hdrBg, text_color = color.white, text_size = txtSize)
    table.cell(rad, 2, 0, "Fill", bgcolor = hdrBg, text_color = color.white, text_size = txtSize)
    table.cell(rad, 3, 0, "PSP",  bgcolor = hdrBg, text_color = color.white, text_size = txtSize)

    int row = 1
    for i = 0 to 6
        Cls c = array.get(CLS, i)
        [d, t, s, b, r]     = f_show(c)
        [fd, fdeg, flead, fb] = f_showFill(c)
        [pd, pb]            = f_showPsp(c)

        bool isChartTf = i == chartIdx

        // ── עמודת SSMT ──
        string sTxt = "·"
        string sTip = ""
        color  sTxtC = dimTxt
        color  sBg   = cellBg

        if not c.on
            sTxt := "n/a"
            sTip := c.nm + " — לא מחושבת בגרף הנוכחי.\n" + (i < chartIdx ? (lowerCap ? "המסגרת כבויה בהגדרות, או נמוכה מזו שנמשכת בפועל." : "מעל 4H משיכת נתוני אינטרה-בר מושבתת — מספר האינטרה-בארים לבר בלתי-סביר.") : "הנר שלה לא מתחלק בנר הגרף בלי שארית, ולכן הוא לא יושב על הרשת שלו.")
        else if not c.warm
            sTxt := "?"
            sTip := c.nm + " — אין עדיין מספיק היסטוריה בגרף הזה.\nהמיכל של המחלקה ארוך ממה שנטען, ולכן אין תשובה אמיתית להציג.\nעבור לגרף גבוה יותר כדי לקרוא את השורה הזו."
        else if not useSSMT
            sTxt := "—"
            sTip := "משפחת SSMT כבויה בהגדרות."
        else if d == 0
            sTip := c.nm + " — אין סטיית SSMT תקפה כרגע."
        else
            color dc = d == 1 ? colBull : colBear
            // H = סטיית סגירה (חזקה) · S = סטיית פתיל בלבד
            sTxtC := t == 2 ? dc : color.new(dc, 35)
            sBg   := color.new(dc, 88)
            sTxt  := (d == 1 ? "▲ " : "▼ ") + s
            sTip  := c.nm + " · " + (d == 1 ? "שורי" : "דובי") + " · " + (t == 2 ? "HSSMT — סטיית סגירה" : "SSMT — סטיית פתיל") + "\nנכסים: " + s + "\nנרשם לפני " + str.tostring(bar_index - b) + " נרות של הגרף\nתת-מחזור ייחוס #" + str.tostring(r)

        // ── עמודת Fill ──
        string fTxt = "·"
        string fTip = ""
        color  fTxtC = dimTxt
        color  fBg   = cellBg

        if not c.on or not c.warm
            fTxt := not c.on ? "n/a" : "?"
            fTip := sTip
        else if not useFill or c.idx < 2
            fTxt := "—"
            fTip := c.idx < 2 ? "גאפ דקתי אינו נספר — Fill פעיל מ-5m ומעלה." : "משפחת Fill כבויה בהגדרות."
        else if fd == 0
            fTip := c.nm + " — אין שבירת מילוי תקפה כרגע."
        else
            color dc = fd == 1 ? colBull : colBear
            // דרגה גבוהה = צבע חזק יותר
            fTxtC := fdeg == 3 ? dc : fdeg == 2 ? color.new(dc, 25) : color.new(dc, 45)
            fBg   := color.new(dc, 88)
            fTxt  := (fd == 1 ? "▲ F" : "▼ F") + str.tostring(fdeg) + " " + flead
            fTip  := c.nm + " · " + (fd == 1 ? "שורי" : "דובי") + " · דרגה " + str.tostring(fdeg) + (fdeg == 3 ? " (קצה רחוק)" : fdeg == 2 ? " (CE)" : " (נגיעה)") + "\nמוביל: " + flead + "\nנרשם לפני " + str.tostring(bar_index - fb) + " נרות של הגרף"

        // ── עמודת PSP ──
        string pTxt = "·"
        string pTip = ""
        color  pTxtC = dimTxt
        color  pBg   = cellBg

        if not c.on or not c.warm
            pTxt := not c.on ? "n/a" : "?"
            pTip := sTip
        else if not usePSP or c.idx < 2
            pTxt := "—"
            pTip := c.idx < 2 ? "PSP דקתי אינו נספר — פעיל מ-5m ומעלה." : "משפחת PCP/PSP כבויה בהגדרות."
        else if pd == 0
            pTip := c.nm + " — אין סווינג PSP מאושר כרגע."
        else
            color dc = pd == 1 ? colBull : colBear
            pTxtC := dc
            pBg   := color.new(dc, 88)
            pTxt  := pd == 1 ? "▲" : "▼"
            pTip  := c.nm + " · " + (pd == 1 ? "שורי — סווינג נמוך מאושר" : "דובי — סווינג גבוה מאושר") + "\nנרשם לפני " + str.tostring(bar_index - pb) + " נרות של הגרף"

        // ── תווית ה-TF: נושאת טריות, סימון הגרף הנוכחי, וקונפליקט עם הפוזיציה ──
        int  nd    = f_netDir(c)
        bool fresh = (d != 0 and f_fresh(c, b)) or (fd != 0 and f_fresh(c, fb)) or (pd != 0 and f_fresh(c, pb))
        bool vsMe  = biasDir != 0 and nd != 0 and nd != biasDir

        string nmTxt = (isChartTf ? "▸ " : "") + (fresh ? "• " : "") + c.nm + (vsMe ? " ⚠" : "")
        color  nmBg  = isChartTf ? color.new(color.gray, 55) : cellBg
        color  nmTxtC = isChartTf ? color.white : color.new(color.silver, 20)
        if fresh and nd != 0
            nmBg := color.new(nd == 1 ? colBull : colBear, 75)
            nmTxtC := color.white
        string nmTip = sTip + (vsMe ? "\n\n⚠ הכיוון כאן מנוגד לפוזיציה שהגדרת." : "") + (fresh ? "\n\n• נרשם עכשיו — בתוך נר אחד של המסגרת הזו." : "")

        bool quiet = c.on and c.warm and d == 0 and fd == 0 and pd == 0
        if not (hideEmpty and quiet)
            table.cell(rad, 0, row, nmTxt, bgcolor = nmBg, text_color = nmTxtC, text_size = txtSize, tooltip = nmTip)
            table.cell(rad, 1, row, sTxt, bgcolor = sBg, text_color = sTxtC, text_size = txtSize, tooltip = sTip)
            table.cell(rad, 2, row, fTxt, bgcolor = fBg, text_color = fTxtC, text_size = txtSize, tooltip = fTip)
            table.cell(rad, 3, row, pTxt, bgcolor = pBg, text_color = pTxtC, text_size = txtSize, tooltip = pTip)
            row += 1

    // ── שורת קונפליקט ──
    // מופיעה רק כשהמסגרת המהירה ביותר שיש בה סיגנל מצביעה הפוך מהאיטית
    // ביותר שיש בה סיגנל. זה התרחיש של עסקה פתוחה שמגיע אליה תיקון:
    // אין צורך לפרש את הטבלה, השורה אומרת את זה במפורש.
    if showConf and row <= 8
        int fastI = -1
        int slowI = -1
        int fastD = 0
        int slowD = 0
        for i = 0 to 6
            Cls c = array.get(CLS, i)
            if c.on and c.warm
                int cnd = f_netDir(c)
                if cnd != 0
                    if fastI == -1
                        fastI := i
                        fastD := cnd
                    slowI := i
                    slowD := cnd

        if fastI != -1 and slowI != fastI and fastD != slowD
            Cls cf = array.get(CLS, fastI)
            Cls cs2 = array.get(CLS, slowI)
            string ct = "⚠ " + cf.nm + (fastD == 1 ? " ▲" : " ▼") + " מול " + cs2.nm + (slowD == 1 ? " ▲" : " ▼")
            color  cc = color.new(#f9a825, 0)
            table.cell(rad, 0, row, ct, bgcolor = color.new(#f9a825, 82), text_color = cc, text_size = txtSize, tooltip = "המסגרת המהירה מצביעה הפוך מהאיטית.\nאם אתה בפוזיציה לכיוון האיטית, זה בדיוק המצב שבו יכול לבוא תיקון נגדך.")
            table.cell(rad, 1, row, "", bgcolor = color.new(#f9a825, 82))
            table.cell(rad, 2, row, "", bgcolor = color.new(#f9a825, 82))
            table.cell(rad, 3, row, "", bgcolor = color.new(#f9a825, 82))

// ═══════════════════════════════════════════════════════════════════
// התראה — קריאה אחת עם טקסט דינמי, כדי שמספיק להגדיר אותה פעם אחת
// ═══════════════════════════════════════════════════════════════════

f_alertOK(i) =>
    alertScope == "הכל" ? true : alertScope == "הגרף ומעלה" ? i >= chartIdx : i >= chartIdx - 1

if alertOn and barstate.isconfirmed and array.size(CLS) == 7
    string body = ""
    for i = 0 to 6
        Cls c = array.get(CLS, i)
        if f_alertOK(i)
            if alertS and array.get(firedS, i)
                [ad, at, astr, abar, aref] = f_show(c)
                if ad != 0
                    body := body + (body != "" ? " | " : "") + c.nm + " " + (ad == 1 ? "שורי" : "דובי") + " " + (at == 2 ? "HSSMT" : "SSMT") + " · " + astr
            if alertF and array.get(firedF, i)
                [fad, fadeg, falead, fabar] = f_showFill(c)
                if fad != 0
                    body := body + (body != "" ? " | " : "") + c.nm + " " + (fad == 1 ? "שורי" : "דובי") + " Fill F" + str.tostring(fadeg) + " · " + falead
            if alertP and array.get(firedP, i)
                [pad, pabar] = f_showPsp(c)
                if pad != 0
                    body := body + (body != "" ? " | " : "") + c.nm + " " + (pad == 1 ? "שורי" : "דובי") + " PSP"

    if body != ""
        // אם הוגדרה פוזיציה, ההתראה אומרת מיד אם הסיגנל נגדה — זה ההבדל
        // בין "קרה משהו" לבין "קרה משהו שנוגע לך".
        string tail = ""
        if biasDir != 0
            for i = 0 to 6
                Cls c = array.get(CLS, i)
                bool anyFired = array.get(firedS, i) or array.get(firedF, i) or array.get(firedP, i)
                if anyFired and f_alertOK(i) and f_netDir(c) != 0 and f_netDir(c) != biasDir
                    tail := "  ⚠ נגד הפוזיציה"
        alert(syminfo.ticker + " · " + body + tail, alert.freq_once_per_bar_close)
