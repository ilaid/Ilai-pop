//@version=5
indicator("Sav FX - Semi / Quarterly Cycles", shorttitle="Sav FX", overlay=false, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
//  MULTI-LEVEL QUARTERLY CYCLES
//
//  Every unit of time is split into four sub units, so each level is a quarter
//  of the level above it:
//
//    row              cell          numbers
//    1 Quadrennial     1 year        which year of the four year cycle, 2023 .. 2026
//    2 Yearly          1 quarter     which quarter of the year, Q1 Jan-Mar .. Q4 Oct-Dec
//    3 Quarter Split   ~16 bars      which quarter of the quarter, daily chart only
//    4 Weekly          1 week        which week of the month
//    5 Daily           1 day         which day of the week, Mon 1 .. Thu 4
//    6 6 Hour          6 hours       which session: Asia 1, London 2, AM 3, PM 4
//    7 90 Minute       90 min        which 90 min of the session
//    8 22.5 Minute     22.5 min      which 22.5 min of the 90 min
//    9 5.625 Minute    5.625 min     which 5.625 min of the 22.5 min
//
//  Every cell is labelled with the chain of quarters that leads to it, from the
//  highest of three levels down to its own: a 22.5 min cell reading  1-3-4  is
//  Asia session -> 3rd 90 min -> 4th 22.5 min, and the 5.625 min cells inside it
//  read 3-4-1 .. 3-4-4.  "Levels Per Label" sets how many links are printed, and
//  a level that carries no number is skipped, so the chain keeps its length.
//
//  The quarter split is the quarter's three months divided in four by MARKET
//  days. Counting calendar days made the cells 14 to 17 bars wide, because a
//  quarter holds 90 to 92 days but only 61 to 65 of them are opens: 1 January is
//  not one. Counted in market days Q1 2026 is 64 of them and every cell holds
//  16. The calendar month is three per quarter, not four, so it carries no
//  number of its own and is only what the week is numbered inside. The split row
//  is numbered Q1 to Q4 like the quarter above it.
//
//  Every cell measures its edges off the open of the bar it starts on, in whole
//  days, rather than off a calendar midnight: a midnight falls inside a bar, and
//  a box edge inside a bar is pushed on to the next one, which across a weekend
//  moves it three days. The year, quarter and split rows then step half a bar
//  back, so the edge lands in the gap between two candles instead of through the
//  middle of one, and a quarter holds its last day whole without reaching into
//  the month after it.
//
//  The slow rows read as names and the fast ones as numbers, so the day row says
//  Wed where the 22.5 min row says 1-3-4: on a high timeframe those cells are far
//  too narrow to hold a three link chain. "Names Instead Of Numbers" moves the
//  line between the two, and the numbers can be printed after the name as well.
//
//  A numbered cell whose three link chain is one of the marked sequences takes
//  its quarter's strong colour, the same colour as the rest of the row only
//  stronger. The sequences are an input, and default to every chain built only
//  of 1s and 4s plus the same number three times.
//
//  Per timeframe: the monthly and weekly charts show the four year cycle and its
//  quarters, the daily chart the current year, its quarters and their splits, and
//  the week row starts on 12H and below.
//
//  Levels that carry no quarter number are drawn without colour and without a
//  number, and they contribute no link to the chain:
//    - Friday, the fifth trading day of the week
//    - a dead week, whose Tuesday and Thursday fall in different months
//    - Saturday and Sunday, on symbols that trade them
//
//  Time base: the day opens at 18:00 on the same (exchange time + 1h) scale the
//  original script used, so the intraday grid sits exactly where it did before.
// ═══════════════════════════════════════════════════════════════════════════════


// ───────────────────────────────── inputs ─────────────────────────────────────
g_cyc = "Time Cycles"
showCyc4   = input.bool(true, "Quadrennial Cycles", group = g_cyc, tooltip = "One cell per year: which year of the four year cycle it is. 2023 opens the cycle and 2026 closes it, so 2023 is year 1 and 2026 is year 4.")
showQtYear = input.bool(true, "Yearly Cycles",      group = g_cyc, tooltip = "One cell per quarter: which quarter of the year it is. Q1 Jan-Mar, Q2 Apr-Jun, Q3 Jul-Sep, Q4 Oct-Dec. April opens Q2, which is the true open of the year.")
showSplit  = input.bool(true, "Quarter Split",      group = g_cyc, tooltip = "One cell per quarter of a quarter, on the daily chart only. The quarter's three months are divided in four by market days rather than calendar days, so each cell holds about 16 of them: Q1 2026 is 64 market days and splits 16 16 16 16. A public holiday can leave a cell one bar short, since Pine is not handed the exchange's holiday calendar.")
showWeekly = input.bool(true, "Weekly Cycles",      group = g_cyc, tooltip = "One cell per week: which week of the month it is. A week belongs to the month holding its Tuesday.")
showDaily  = input.bool(true, "Daily Cycles",       group = g_cyc, tooltip = "One cell per trading day: which day of the week it is, Mon 1 .. Thu 4. Friday carries no number.")
show6H     = input.bool(true, "6 Hour Cycles",      group = g_cyc, tooltip = "One cell per session: Asia 1, London 2, AM 3, PM 4.")
show90     = input.bool(true, "90 Minute",          group = g_cyc)
show225    = input.bool(true, "22.5 Minute",        group = g_cyc)
show5625   = input.bool(true, "5.625 Minute",       group = g_cyc)

g_lab = "Labels"
showLabels  = input.bool(true, "Show Labels", group = g_lab)
nameRows    = input.string("Down to the session", "Names Instead Of Numbers", options = ["Down to the session", "Down to the day", "Off"], group = g_lab, tooltip = "The slow rows read better as names than as numbers, and their cells are too narrow for a three link chain on a high timeframe. This picks how far down the names go: to the session row (2026, Q3, Week 3, Wed, Asia), only to the daily row, or off for numbers everywhere. Everything below the line prints numbers.")
appendNums  = input.bool(false, "Add Numbers After The Name", group = g_lab, tooltip = "Prints both, as Wed 3-3-3. Leave it off where the cell is too narrow to hold the two of them.")
labelDepth  = input.int(3, "Levels Per Label", minval = 1, maxval = 3, group = g_lab, tooltip = "How many levels of the hierarchy each numbered cell prints. 3 gives 3-4-2 (grandparent-parent-self), 2 gives 4-2, 1 gives 2.")
sepStr      = input.string("-", "Separator", options = ["-", ".", " "], group = g_lab)
gapMark     = input.string("·", "Mark For A Level With No Number", group = g_lab, tooltip = "What a level that carries no number prints inside a chain: Friday, and a dead week. It holds the link's place, so every row keeps reading the same levels in the same order on a Friday as on a Monday. Empty drops the link instead, and the chain then pulls the level above it in to stay three long.")
textSizeIn  = input.string("small", "Text Size", options = ["tiny", "small", "normal", "large"], group = g_lab)
textCol     = input.color(color.new(#000000, 10), "Text Color", group = g_lab)

g_col = "Colors"
c1    = input.color(#c8cbd0, "Q1", group = g_col, inline = "q")
c2    = input.color(#f0a8b0, "Q2", group = g_col, inline = "q")
c3    = input.color(#a6d6a6, "Q3", group = g_col, inline = "q")
c4    = input.color(#a3b8e8, "Q4", group = g_col, inline = "q")
c5    = input.color(#dcd3ea, "W5", group = g_col, inline = "q", tooltip = "A fifth week, in months whose Tuesdays run to the 29th or later.")
cNone = input.color(color.new(#e3e4e6, 100), "None", group = g_col, inline = "q", tooltip = "The cells that carry no quarter number: Friday, a dead week, and the weekend on symbols that trade it. Transparent by default, so only the border shows.")
h1    = input.color(#9ea4ae, "Q1+", group = g_col, inline = "h")
h2    = input.color(#e8808e, "Q2+", group = g_col, inline = "h")
h3    = input.color(#76c276, "Q3+", group = g_col, inline = "h")
h4    = input.color(#7898dd, "Q4+", group = g_col, inline = "h", tooltip = "The fill a cell takes when it lands on one of the marked sequences: the same colour as its quarter, only stronger. Set each of them to whatever reads best against the row above.")
hiOn  = input.bool(true, "Mark These Sequences", group = g_col, inline = "hs")
hotList = input.string("111,114,141,144,411,414,441,444,222,333", "", group = g_col, inline = "hs", tooltip = "The three link chains that take the marked colour, separated by commas. The default is every chain built only of 1s and 4s, plus the same number three times. Only the rows that print numbers are marked.")

g_dsp = "Display"
borderW   = input.int(1, "Border Thickness", minval = 1, maxval = 10, group = g_dsp)
cellsKept = input.int(100, "Cells Kept Per Row", minval = 4, maxval = 500, group = g_dsp, tooltip = "How much history each row keeps. TradingView allows 500 boxes in total, so a smaller number here leaves room for the slower rows.")


// ──────────────────────────── border colour ───────────────────────────────────
isDarkBg() =>
    bg   = chart.bg_color
    luma = (0.299 * color.r(bg) + 0.587 * color.g(bg) + 0.114 * color.b(bg)) / 255
    luma < 0.5

borderCol = isDarkBg() ? #787b86 : color.new(color.black, 10)


// ─────────────────────── which rows are drawn, and where ──────────────────────
tfs     = timeframe.in_seconds()
isDay1  = timeframe.isdaily and timeframe.multiplier == 1

en1 = showCyc4   and tfs >= 21600 and tfs <= 10368000   // cell = 1 year
en2 = showQtYear and tfs >= 21600 and tfs <= 10368000   // cell = 1 quarter
en3 = showSplit  and isDay1                             // cell = a quarter of a quarter
en4 = showWeekly and tfs >= 1800  and tfs <= 43200      // cell = 1 week, off on 1D and up
en5 = showDaily  and tfs >= 60    and tfs <= 43200      // cell = 1 trading day
en6 = show6H     and tfs >= 60    and tfs <= 21600      // cell = 1 session
en7 = show90     and tfs <= 2700                        // cell = 90 min
en8 = show225    and tfs <= 540                         // cell = 22.5 min
en9 = show5625   and tfs <= 120                         // cell = 5.625 min

// each row owns one unit of vertical space; the slowest cycle sits at the bottom
y1 = 1
y2 = y1 + (en1 ? 1 : 0)
y3 = y2 + (en2 ? 1 : 0)
y4 = y3 + (en3 ? 1 : 0)
y5 = y4 + (en4 ? 1 : 0)
y6 = y5 + (en5 ? 1 : 0)
y7 = y6 + (en6 ? 1 : 0)
y8 = y7 + (en7 ? 1 : 0)
y9 = y8 + (en8 ? 1 : 0)


// ─────────────────────────── intraday: 18:00 onwards ──────────────────────────
MS_DAY  = 86400000
MS_6H   = 21600000
MS_90   = 5400000
MS_225  = 1350000
MS_5625 = 337500

// same +1h / exchange-time scale as the original script
adj = time + 3600000

// milliseconds elapsed since the 18:00 open of the current trading day.
// tod is measured against midnight rather than built from hour()/minute()/
// second(), so it stays exact on sub-minute charts: a 5.625 min boundary falls
// on a half second, which whole-second components would round into the wrong cell
tod = adj - timestamp(year(adj), month(adj), dayofmonth(adj), 0, 0, 0)
md  = (tod - 18 * 3600000 + MS_DAY) % MS_DAY

// offset inside each cell -> exact cell boundaries, free of rounding
off6    = md % MS_6H
off90   = md % MS_90
off225  = md % MS_225
off5625 = md % MS_5625

iSess  = int(math.floor(md     / MS_6H))   + 1   // 1 Asia, 2 London, 3 AM, 4 PM
i90    = int(math.floor(off6   / MS_90))   + 1
i225   = int(math.floor(off90  / MS_225))  + 1
i5625  = int(math.floor(off225 / MS_5625)) + 1

dayStart = time - md


// ──────────────────────── day, week and month ─────────────────────────────────
// from 18:00 the trading day belongs to tomorrow, and +6h lands it on midnight
tday   = adj + MS_6H
dw     = dayofweek(tday)                 // 1 = Sunday .. 7 = Saturday
rawDay = dw == 1 ? 7 : dw - 1            // Mon 1 .. Fri 5, Sat 6, Sun 7
iDay   = rawDay <= 4 ? rawDay : na       // only Mon..Thu are quarters of the week

weekStart = dayStart - (rawDay - 1) * MS_DAY

// midday of the trading date, so adding whole days cannot slip across a DST edge
tdayMid = timestamp(year(tday), month(tday), dayofmonth(tday), 12, 0, 0)

// a week belongs to the month holding its Tuesday, and is dead when its Tuesday
// and Thursday fall in different months
tueTs = tdayMid + (2 - rawDay) * MS_DAY
thuTs = tdayMid + (4 - rawDay) * MS_DAY
dead  = year(tueTs) * 100 + month(tueTs) != year(thuTs) * 100 + month(thuTs)
iWeek = dead ? na : int(math.floor((dayofmonth(tueTs) - 1) / 7)) + 1


// ───────────────────── year, quarter and the four year cycle ──────────────────
mth = month(tday)
yr  = year(tday)

// plain calendar quarters: Q1 Jan-Mar, Q2 Apr-Jun, Q3 Jul-Sep, Q4 Oct-Dec.
// April is not a year boundary, it opens Q2 and with it the true open of the year
iQtr = int(math.floor((mth - 1) / 3)) + 1

// the four year cycle runs 2023 2024 2025 2026: 2023 opens it, 2026 closes it.
// 2023 is 3 mod 4, so (yr + 1) mod 4 numbers it without ever going negative
iCyc4  = int((yr + 1) % 4) + 1
cycBeg = timestamp("GMT-5", yr, 1, 1, 0, 0)

yNoon  = timestamp(yr, 1, 1, 12, 0, 0)
yDays  = int(math.round((timestamp(yr + 1, 1, 1, 12, 0, 0) - yNoon) / MS_DAY))
dayInY = math.max(0, math.min(yDays - 1, int(math.round((tdayMid - yNoon) / MS_DAY))))

// Monday 0 .. Sunday 6
dowMon(int t) =>
    int d = dayofweek(t)
    d == 1 ? 6 : d - 2

// how many Mon-Fri days sit in the n days that open on weekday w0. Closed form,
// so it costs the same whether the span is a day or a quarter
wdCount(int w0, int n) =>
    int c = int(math.floor(n / 7)) * 5
    int r = n % 7
    for i = 0 to 5
        if i < r and (w0 + i) % 7 < 5
            c := c + 1
    c

// the day offset of market day number k, counting off the quarter's first day
wdOffset(int first, int w, int k) =>
    first + int(math.floor((w + k) / 5)) * 7 + (w + k) % 5 - w

// The quarter runs from the first of its first month to the last of its third,
// and its three months are divided in four by MARKET days, not calendar days:
// 1 January is not an open, so counting calendar days put a third of the cells
// 14 bars wide and a third 17. Counted this way Q1 2026 is 64 market days and
// every cell holds 16 of them. A public holiday can still leave a cell a bar
// short, since Pine is not given the exchange's holiday calendar.
qFirstM = (iQtr - 1) * 3 + 1
qNoon   = timestamp(yr, qFirstM, 1, 12, 0, 0)
qNoonEnd = iQtr == 4 ? timestamp(yr + 1, 1, 1, 12, 0, 0) : timestamp(yr, qFirstM + 3, 1, 12, 0, 0)

// both ends are midday, so the day count is exact across a daylight saving edge
qDays  = int(math.round((qNoonEnd - qNoon) / MS_DAY))
dayInQ = math.max(0, math.min(qDays - 1, int(math.round((tdayMid - qNoon) / MS_DAY))))

qW0    = dowMon(qNoon)                   // weekday the quarter opens on
qFirst = qW0 < 5 ? 0 : 7 - qW0           // days to its first market day
qW     = (qW0 + qFirst) % 7              // 0 .. 4
qWd    = wdCount(qW0, qDays)             // market days in the whole quarter
dW     = wdCount(qW0, dayInQ)            // market days before this bar

v1 = int(math.floor(qWd     / 4))
v2 = int(math.floor(qWd * 2 / 4))
v3 = int(math.floor(qWd * 3 / 4))

iSplit = en3 ? (dW < v1 ? 1 : dW < v2 ? 2 : dW < v3 ? 3 : 4) : na
sDay0  = dW < v1 ? 0 : dW < v2 ? wdOffset(qFirst, qW, v1) : dW < v3 ? wdOffset(qFirst, qW, v2) : wdOffset(qFirst, qW, v3)
sDay1  = dW < v1 ? wdOffset(qFirst, qW, v1) : dW < v2 ? wdOffset(qFirst, qW, v2) : dW < v3 ? wdOffset(qFirst, qW, v3) : qDays

// Edges are measured off the open of the bar the cell starts on, in whole days,
// never off a calendar midnight. A midnight lands inside a bar, and a box edge
// inside a bar is pushed to the next one, which over a weekend throws the edge
// three days out: Friday 24 July would draw on Monday the 27th. Measured this
// way the edge sits exactly on the bar that opens the cell, and the same number
// of days forward lands exactly where the next cell opens.
//
// Then half a bar back. A bar's time is drawn at the middle of its candle, so an
// edge sitting on the opening bar's time cuts that candle in half and leaves one
// half in the cell before: Q1 reached into the candle of 1 April, a fourth month.
// Half a bar back drops the edge into the gap between the two candles, so the
// quarter holds the whole of 31 March and nothing of 1 April.
halfBar = tfs * 500

cycLeft   = dayStart - dayInY * MS_DAY - halfBar
cycRight  = dayStart + (yDays - dayInY) * MS_DAY - halfBar
qtrLeft   = dayStart - dayInQ * MS_DAY - halfBar
qtrRight  = dayStart + (qDays - dayInQ) * MS_DAY - halfBar
splitLeft = dayStart - (dayInQ - sDay0) * MS_DAY - halfBar
splitRight = dayStart + (sDay1 - dayInQ) * MS_DAY - halfBar

// a cell is new when its own number changes, not when its left edge moves, so
// the edges above are read once, on the bar that opens it
cycId   = yr
qtrId   = yr * 10 + iQtr
splitId = yr * 100 + iQtr * 10 + nz(iSplit, 0)

// how far back the slow rows keep their cells: inside the current four year
// cycle from the weekly chart up, where the whole cycle is the point, and inside
// the current year below it, where older years are only clutter
cycFirst = timestamp("GMT-5", yr - (iCyc4 - 1), 1, 1, 0, 0)
// two days of slack, because a cell opens on the evening before its first date
slowTrim = (tfs >= 604800 ? cycFirst : cycBeg) - 2 * MS_DAY


// ──────────────────────────── label construction ──────────────────────────────
var int[] idx = array.new_int(9, na)
array.set(idx, 0, iCyc4)
array.set(idx, 1, iQtr)
array.set(idx, 2, iSplit)
array.set(idx, 3, iWeek)
array.set(idx, 4, iDay)
array.set(idx, 5, iSess)
array.set(idx, 6, i90)
array.set(idx, 7, i225)
array.set(idx, 8, i5625)

// The chain of quarters ending at level `lvl`, highest level first.
//
// A level that carries no number but is on the chart all the same, Friday and a
// dead week, holds its place with gapMark, so the session row reads week - day -
// session on a Friday just as it does on a Monday. Were the link dropped, the
// chain would pull the level above it in to stay three long and the same row
// would silently read quarter - week - session instead.
//
// The split level is different: off the daily chart it is not on the chart at
// all, so it is passed over without taking a place.
chainOf(int lvl, int depth, string sep) =>
    string out = ""
    int    n   = 0
    if not na(array.get(idx, lvl - 1))
        for i = lvl to 1
            if n < depth
                int    v     = array.get(idx, i - 1)
                bool   onChart = i != 3 or en3
                string piece = na(v) ? (onChart ? gapMark : "") : str.tostring(v)
                if piece != ""
                    out := piece + (out == "" ? "" : sep) + out
                    n   := n + 1
    out

dayName() =>
    switch rawDay
        1 => "Mon"
        2 => "Tue"
        3 => "Wed"
        4 => "Thu"
        5 => "Fri"
        6 => "Sat"
        => "Sun"

sessName() =>
    switch iSess
        1 => "Asia"
        2 => "Lon"
        3 => "AM"
        4 => "PM"
        => ""

// what a row shows when it is named rather than numbered
nameFor(int lvl) =>
    switch lvl
        1 => str.tostring(yr)
        2 => "Q" + str.tostring(iQtr)
        3 => na(iSplit) ? "" : "Q" + str.tostring(iSplit)
        4 => na(iWeek) ? "" : "Week " + str.tostring(iWeek)
        5 => dayName()
        6 => sessName()
        => ""

// names reach down to this level, numbers take over below it
namedDepth = nameRows == "Off" ? 0 : nameRows == "Down to the day" ? 5 : 6
numbered(int lvl) =>
    lvl > namedDepth

cellText(int lvl) =>
    string nm  = showLabels and not numbered(lvl) ? nameFor(lvl) : ""
    string num = not numbered(lvl) and not appendNums ? "" : showLabels ? chainOf(lvl, labelDepth, sepStr) : ""
    nm + (nm != "" and num != "" ? " " : "") + num

// is this cell's three link chain one of the marked ones
hotSeq(string s) =>
    str.length(s) == 3 and str.contains("," + str.replace_all(hotList, " ", "") + ",", "," + s + ",")

// the quarter's own colour, in its strong shade on a marked sequence, or the
// colourless fill for a level that carries no quarter number
fillFor(int lvl, int i) =>
    bool hot = hiOn and numbered(lvl) and hotSeq(chainOf(lvl, 3, ""))
    na(i) ? cNone : i == 1 ? (hot ? h1 : c1) : i == 2 ? (hot ? h2 : c2) : i == 3 ? (hot ? h3 : c3) : i == 4 ? (hot ? h4 : c4) : c5


// ───────────────────────────────── drawing ────────────────────────────────────
var box[] bx1 = array.new_box()
var box[] bx2 = array.new_box()
var box[] bx3 = array.new_box()
var box[] bx4 = array.new_box()
var box[] bx5 = array.new_box()
var box[] bx6 = array.new_box()
var box[] bx7 = array.new_box()
var box[] bx8 = array.new_box()
var box[] bx9 = array.new_box()

// one box per cell: created when a new cell opens, and the row keeps only the
// last `cellsKept` of them so the slower rows never lose their boxes to the
// 500 box budget
cell(box[] store, bool fresh, int left, int right, int top, string txt, color bg, int keepFrom) =>
    if fresh or array.size(store) == 0
        array.push(store, box.new(left = left, top = top, right = right, bottom = top - 1, xloc = xloc.bar_time, bgcolor = bg, border_color = borderCol, border_width = borderW, border_style = line.style_solid, text = txt, text_color = textCol, text_size = textSizeIn))
        if array.size(store) > cellsKept
            box.delete(array.shift(store))
    // and drop whatever now sits before this row's own cycle
    while array.size(store) > 1 and box.get_left(array.get(store, 0)) < keepFrom
        box.delete(array.shift(store))

l6   = time - off6
l90  = time - off90
l225 = time - off225
l562 = time - off5625

if en1
    cell(bx1, cycId != cycId[1], cycLeft, cycRight, y1, cellText(1), fillFor(1, iCyc4), slowTrim)

if en2
    cell(bx2, qtrId != qtrId[1], qtrLeft, qtrRight, y2, cellText(2), fillFor(2, iQtr), slowTrim)

if en3
    cell(bx3, splitId != splitId[1], splitLeft, splitRight, y3, cellText(3), fillFor(3, iSplit), slowTrim)

if en4
    cell(bx4, weekStart != weekStart[1], weekStart, weekStart + 5 * MS_DAY, y4, cellText(4), fillFor(4, iWeek), 0)

if en5
    cell(bx5, dayStart != dayStart[1], dayStart, dayStart + MS_DAY, y5, cellText(5), fillFor(5, iDay), 0)

if en6
    cell(bx6, l6 != l6[1], l6, l6 + MS_6H, y6, cellText(6), fillFor(6, iSess), 0)

if en7
    cell(bx7, l90 != l90[1], l90, l90 + MS_90, y7, cellText(7), fillFor(7, i90), 0)

if en8
    cell(bx8, l225 != l225[1], l225, l225 + MS_225, y8, cellText(8), fillFor(8, i225), 0)

if en9
    cell(bx9, l562 != l562[1], l562, l562 + MS_5625, y9, cellText(9), fillFor(9, i5625), 0)

// the rows are drawn entirely with boxes; this hidden plot only satisfies Pine's
// "at least one output" rule and is excluded from the pane and the scale
plot(0, "", display = display.none, editable = false)
