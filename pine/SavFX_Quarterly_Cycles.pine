//@version=5
indicator("Sav FX - Cycles, True Opens & Devil Marks", shorttitle="Sav FX", overlay=false, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
//  MULTI-LEVEL QUARTERLY CYCLES
//
//  Every unit of time is split into four sub units, so each level is a quarter
//  of the level above it:
//
//    row              cell          numbers
//    1 Quadrennial     1 year        which year of the four year cycle, 2023 .. 2026
//    2 Yearly          1 quarter     which quarter of the year, Q1 Jan-Mar .. Q4 Oct-Dec
//    3 Quarter Split   ~16 bars      which quarter of the quarter, daily chart only
//    4 Weekly          1 week        which week of the month
//    5 Daily           1 day         which day of the week, Mon 1 .. Thu 4
//    6 6 Hour          6 hours       which session: Asia 1, London 2, AM 3, PM 4
//    7 90 Minute       90 min        which 90 min of the session
//    8 22.5 Minute     22.5 min      which 22.5 min of the 90 min
//    9 5.625 Minute    5.625 min     which 5.625 min of the 22.5 min
//
//  Every cell is labelled with the chain of quarters that leads to it, from the
//  highest of three levels down to its own: a 22.5 min cell reading  1-3-4  is
//  Asia session -> 3rd 90 min -> 4th 22.5 min, and the 5.625 min cells inside it
//  read 3-4-1 .. 3-4-4.  "Levels Per Label" sets how many links are printed. A
//  level that is on the chart but carries no number, Friday and a dead week,
//  holds its place with a mark, so a row reads the same levels in the same order
//  whatever the day.
//
//  The quarter split is the quarter's three months divided in four by MARKET
//  days. Counting calendar days made the cells 14 to 17 bars wide, because a
//  quarter holds 90 to 92 days but only 61 to 65 of them are opens: 1 January is
//  not one. Counted in market days Q1 2026 is 64 of them and every cell holds
//  16. The calendar month is three per quarter, not four, so it carries no
//  number of its own and is only what the week is numbered inside. The split row
//  is numbered Q1 to Q4 like the quarter above it.
//
//  Every cell measures its edges off the open of the bar it starts on, in whole
//  days, rather than off a calendar midnight: a midnight falls inside a bar, and
//  a box edge inside a bar is pushed on to the next one, which across a weekend
//  moves it three days. The year, quarter and split rows then step half a bar
//  back, so the edge lands in the gap between two candles instead of through the
//  middle of one, and a quarter holds its last day whole without reaching into
//  the month after it.
//
//  The slow rows read as names and the fast ones as numbers, so the day row says
//  Wed where the 22.5 min row says 1-3-4: on a high timeframe those cells are far
//  too narrow to hold a three link chain. "Names Instead Of Numbers" moves the
//  line between the two, and the numbers can be printed after the name as well.
//
//  A cell whose three link chain is one of the marked sequences takes its
//  quarter's strong colour, the same colour as the rest of the row only
//  stronger. The sequences are an input, and default to every chain built only
//  of 1s and 4s plus the same number three times. The mark goes off the chain,
//  so it shows on every timeframe and on a row that prints a name just as much
//  as on one that prints numbers.
//
//  Every row whose cells are a fixed length also draws the next blocks ahead of
//  the last bar, dashed, so the one running and the ones after it are read off
//  the same ladder. The year, the quarter and the quarter split vary in length
//  and are left out.
//
//  Per timeframe: the monthly and weekly charts show the four year cycle and its
//  quarters, the daily chart the current year, its quarters and their splits, and
//  the week row starts on 12H and below. Lower down a row drops off its own end
//  as a finer one comes in, so the pane never stacks more than four of them: the
//  week row ends below 30m, the daily row below 10m, and the 5.625 min row comes
//  in at 5m. A cell a bar or two wide has no room for a three link chain, so
//  drop "Levels Per Label" on the fastest charts.
//
//  Levels that carry no quarter number are drawn without colour and without a
//  number, and they contribute no link to the chain:
//    - Friday, the fifth trading day of the week
//    - a dead week, whose Tuesday and Thursday fall in different months
//    - Saturday and Sunday, on symbols that trade them
//
//  TIME BASE, shared by everything in this script
//
//  The trading day opens at 18:00 on one clock, picked in "Time Base". New York
//  is the model's own clock and the default; Exchange is whatever the symbol
//  trades on. The shift is added on top and is what to reach for when the grid
//  sits an hour out: the two zones do not change over to winter time on the same
//  date, so for a week or two a year a fixed offset is wrong by an hour. On New
//  York with a shift of 0 that cannot happen, because the DST is TradingView's
//  to work out. A shift of 1 reproduces the exchange + 1h scale this script used
//  before the merge.
//
//  TRUE OPENS, drawn on the candles rather than in this pane
//
//  Every level is the open of the SECOND sub cycle inside its container, except
//  TYO which marks the QT year's own start in April. A level lives only as long
//  as its container: when the container closes the line goes until the next
//  container prints its own open. They read off the same grid as the rows below,
//  so a T90O always lands on a 90 min row boundary.
//
//  DEVIL MARKS, also on the candles
//
//  A candle whose body runs to one end with no wick there leaves a short line at
//  that edge, born on close and removed once price trades back through it.
// ═══════════════════════════════════════════════════════════════════════════════


// ───────────────────────────────── inputs ─────────────────────────────────────
g_tz = "Time Base"
tzMode = input.string("New York", "Clock", options = ["New York", "Exchange"], group = g_tz, tooltip = "The clock the 18:00 day open is read on, for the rows and for the true opens alike. New York is the model's own and handles both daylight saving changes by itself. Exchange follows the symbol, which drifts by an hour whenever its zone and New York change over on different dates.")
shiftH = input.float(0, "Shift (hours)", minval = -12, maxval = 12, step = 0.25, group = g_tz, tooltip = "Added on top of the clock above. Reach for this when the whole grid sits an hour out: a quarter of an hour at a time, either way. A shift of 1 on the Exchange clock is the scale this script ran on before the true opens were merged in.")

gridTZ  = tzMode == "New York" ? "America/New_York" : syminfo.timezone
shiftMs = int(shiftH * 3600000)

g_cyc = "Time Cycles"
showCyc4   = input.bool(true, "Quadrennial Cycles", group = g_cyc, tooltip = "One cell per year: which year of the four year cycle it is. 2023 opens the cycle and 2026 closes it, so 2023 is year 1 and 2026 is year 4.")
showQtYear = input.bool(true, "Yearly Cycles",      group = g_cyc, tooltip = "One cell per quarter: which quarter of the year it is. Q1 Jan-Mar, Q2 Apr-Jun, Q3 Jul-Sep, Q4 Oct-Dec. April opens Q2, which is the true open of the year.")
showSplit  = input.bool(true, "Quarter Split",      group = g_cyc, tooltip = "One cell per quarter of a quarter, on the daily chart only. The quarter's three months are divided in four by market days rather than calendar days, so each cell holds about 16 of them: Q1 2026 is 64 market days and splits 16 16 16 16. A public holiday can leave a cell one bar short, since Pine is not handed the exchange's holiday calendar.")
showWeekly = input.bool(true, "Weekly Cycles",      group = g_cyc, tooltip = "One cell per week: which week of the month it is. A week belongs to the month holding its Tuesday.")
showDaily  = input.bool(true, "Daily Cycles",       group = g_cyc, tooltip = "One cell per trading day: which day of the week it is, Mon 1 .. Thu 4. Friday carries no number.")
show6H     = input.bool(true, "6 Hour Cycles",      group = g_cyc, tooltip = "One cell per session: Asia 1, London 2, AM 3, PM 4.")
show90     = input.bool(true, "90 Minute",          group = g_cyc)
show225    = input.bool(true, "22.5 Minute",        group = g_cyc)
show5625   = input.bool(true, "5.625 Minute",       group = g_cyc)

g_lab = "Labels"
showLabels  = input.bool(true, "Show Labels", group = g_lab)
nameRows    = input.string("Down to the session", "Names Instead Of Numbers", options = ["Down to the session", "Down to the day", "Off"], group = g_lab, tooltip = "The slow rows read better as names than as numbers, and their cells are too narrow for a three link chain on a high timeframe. This picks how far down the names go: to the session row (2026, Q3, Week 3, Wed, Asia), only to the daily row, or off for numbers everywhere. Everything below the line prints numbers.")
appendNums  = input.bool(false, "Add Numbers After The Name", group = g_lab, tooltip = "Prints both, as Wed 3-3-3. Leave it off where the cell is too narrow to hold the two of them.")
labelDepth  = input.int(3, "Levels Per Label", minval = 1, maxval = 3, group = g_lab, tooltip = "How many levels of the hierarchy each numbered cell prints. 3 gives 3-4-2 (grandparent-parent-self), 2 gives 4-2, 1 gives 2.")
sepStr      = input.string("-", "Separator", options = ["-", ".", " "], group = g_lab)
chainOrder  = input.string("Highest level first", "Chain Order", options = ["Highest level first", "Own level first"], group = g_lab, tooltip = "Which end of the chain the cell's own number sits at. Highest level first reads 1-4-2 as week 1, Thursday, London, with the cell itself last; own level first turns the same cell into 2-4-1. Every row uses the one setting, so the chain always reads the same way down the whole ladder.")
gapMark     = input.string("·", "Mark For A Level With No Number", group = g_lab, tooltip = "What a level that carries no number prints inside a chain: Friday, and a dead week. It holds the link's place, so every row keeps reading the same levels in the same order on a Friday as on a Monday. Empty drops the link instead, and the chain then pulls the level above it in to stay three long.")
textSizeIn  = input.string("small", "Text Size", options = ["tiny", "small", "normal", "large"], group = g_lab)
textCol     = input.color(color.new(#000000, 10), "Text Color", group = g_lab)

g_col = "Colors"
c1    = input.color(#c8cbd0, "Q1", group = g_col, inline = "q")
c2    = input.color(#f0a8b0, "Q2", group = g_col, inline = "q")
c3    = input.color(#a6d6a6, "Q3", group = g_col, inline = "q")
c4    = input.color(#a3b8e8, "Q4", group = g_col, inline = "q")
c5    = input.color(#dcd3ea, "W5", group = g_col, inline = "q", tooltip = "A fifth week, in months whose Tuesdays run to the 29th or later.")
cNone = input.color(color.new(#e3e4e6, 100), "None", group = g_col, inline = "q", tooltip = "The cells that carry no quarter number: Friday, a dead week, and the weekend on symbols that trade it. Transparent by default, so only the border shows.")
h1    = input.color(#9ea4ae, "Q1+", group = g_col, inline = "h")
h2    = input.color(#e8808e, "Q2+", group = g_col, inline = "h")
h3    = input.color(#76c276, "Q3+", group = g_col, inline = "h")
h4    = input.color(#7898dd, "Q4+", group = g_col, inline = "h", tooltip = "The fill a cell takes when it lands on one of the marked sequences: the same colour as its quarter, only stronger. Set each of them to whatever reads best against the row above.")
hiOn  = input.bool(true, "Mark These Sequences", group = g_col, inline = "hs")
hotList = input.string("111,114,141,144,411,414,441,444,222,333", "", group = g_col, inline = "hs", tooltip = "The three link chains that take the marked colour, separated by commas. The default is every chain built only of 1s and 4s, plus the same number three times. A cell is marked off its chain whatever the row prints, so a session cell reading Asia is marked just the same when it sits on one.")

g_dsp = "Display"
borderW   = input.int(1, "Border Thickness", minval = 1, maxval = 10, group = g_dsp)
aheadN    = input.int(2, "Blocks Ahead", minval = 0, maxval = 4, group = g_dsp, tooltip = "How many blocks past the last bar each row draws, dashed, so you can read what is coming next off the same ladder: in the first 90 min of AM it draws the second and the third as well. Only the rows whose cells are a fixed length are drawn ahead, the week and everything below it. Set it to 0 to draw nothing ahead.")
cellsKept = input.int(100, "Cells Kept Per Row", minval = 4, maxval = 500, group = g_dsp, tooltip = "How much history each row keeps. TradingView allows 500 boxes in total, so a smaller number here leaves room for the slower rows.")


// ──────────────────────────── border colour ───────────────────────────────────
isDarkBg() =>
    bg   = chart.bg_color
    luma = (0.299 * color.r(bg) + 0.587 * color.g(bg) + 0.114 * color.b(bg)) / 255
    luma < 0.5

borderCol = isDarkBg() ? #787b86 : color.new(color.black, 10)


// ─────────────────────── which rows are drawn, and where ──────────────────────
tfs     = timeframe.in_seconds()
isDay1  = timeframe.isdaily and timeframe.multiplier == 1

en1 = showCyc4   and tfs >= 21600 and tfs <= 10368000   // cell = 1 year
en2 = showQtYear and tfs >= 21600 and tfs <= 10368000   // cell = 1 quarter
en3 = showSplit  and isDay1                             // cell = a quarter of a quarter
en4 = showWeekly and tfs >= 1800  and tfs <= 43200      // cell = 1 week, off on 1D and up
en5 = showDaily  and tfs >= 600   and tfs <= 43200      // cell = 1 trading day, off below 10m
en6 = show6H     and tfs >= 60    and tfs <= 21600      // cell = 1 session
en7 = show90     and tfs <= 2700                        // cell = 90 min
en8 = show225    and tfs <= 540                         // cell = 22.5 min, down to 9m
en9 = show5625   and tfs <= 300                         // cell = 5.625 min, down to 5m

// each row owns one unit of vertical space; the slowest cycle sits at the bottom
y1 = 1
y2 = y1 + (en1 ? 1 : 0)
y3 = y2 + (en2 ? 1 : 0)
y4 = y3 + (en3 ? 1 : 0)
y5 = y4 + (en4 ? 1 : 0)
y6 = y5 + (en5 ? 1 : 0)
y7 = y6 + (en6 ? 1 : 0)
y8 = y7 + (en7 ? 1 : 0)
y9 = y8 + (en8 ? 1 : 0)


// ─────────────────────────── intraday: 18:00 onwards ──────────────────────────
MS_DAY  = 86400000
MS_6H   = 21600000
MS_90   = 5400000
MS_225  = 1350000
MS_5625 = 337500

// the shared clock: real time pushed by the shift, read in gridTZ
adj = time + shiftMs

// milliseconds elapsed since the 18:00 open of the current trading day.
// tod is measured against midnight rather than built from hour()/minute()/
// second(), so it stays exact on sub-minute charts: a 5.625 min boundary falls
// on a half second, which whole-second components would round into the wrong cell
tod = adj - timestamp(gridTZ, year(adj, gridTZ), month(adj, gridTZ), dayofmonth(adj, gridTZ), 0, 0, 0)
md  = (tod - 18 * 3600000 + MS_DAY) % MS_DAY

// offset inside each cell -> exact cell boundaries, free of rounding
off6    = md % MS_6H
off90   = md % MS_90
off225  = md % MS_225
off5625 = md % MS_5625

iSess  = int(math.floor(md     / MS_6H))   + 1   // 1 Asia, 2 London, 3 AM, 4 PM
i90    = int(math.floor(off6   / MS_90))   + 1
i225   = int(math.floor(off90  / MS_225))  + 1
i5625  = int(math.floor(off225 / MS_5625)) + 1

dayStart = time - md


// ──────────────────────── day, week and month ─────────────────────────────────
// from 18:00 the trading day belongs to tomorrow, and +6h lands it on midnight
tday   = adj + MS_6H
dw     = dayofweek(tday, gridTZ)         // 1 = Sunday .. 7 = Saturday
rawDay = dw == 1 ? 7 : dw - 1            // Mon 1 .. Fri 5, Sat 6, Sun 7
iDay   = rawDay <= 4 ? rawDay : na       // only Mon..Thu are quarters of the week

weekStart = dayStart - (rawDay - 1) * MS_DAY

// midday of the trading date, so adding whole days cannot slip across a DST edge
tdayMid = timestamp(gridTZ, year(tday, gridTZ), month(tday, gridTZ), dayofmonth(tday, gridTZ), 12, 0, 0)

// a week belongs to the month holding its Tuesday, and is dead when its Tuesday
// and Thursday fall in different months
tueTs = tdayMid + (2 - rawDay) * MS_DAY
thuTs = tdayMid + (4 - rawDay) * MS_DAY
dead  = year(tueTs, gridTZ) * 100 + month(tueTs, gridTZ) != year(thuTs, gridTZ) * 100 + month(thuTs, gridTZ)
iWeek = dead ? na : int(math.floor((dayofmonth(tueTs, gridTZ) - 1) / 7)) + 1


// ───────────────────── year, quarter and the four year cycle ──────────────────
mth = month(tday, gridTZ)
yr  = year(tday, gridTZ)

// plain calendar quarters: Q1 Jan-Mar, Q2 Apr-Jun, Q3 Jul-Sep, Q4 Oct-Dec.
// April is not a year boundary, it opens Q2 and with it the true open of the year
iQtr = int(math.floor((mth - 1) / 3)) + 1

// the four year cycle runs 2023 2024 2025 2026: 2023 opens it, 2026 closes it.
// 2023 is 3 mod 4, so (yr + 1) mod 4 numbers it without ever going negative
iCyc4  = int((yr + 1) % 4) + 1
cycBeg = timestamp(gridTZ, yr, 1, 1, 0, 0)

yNoon  = timestamp(gridTZ, yr, 1, 1, 12, 0, 0)
yDays  = int(math.round((timestamp(gridTZ, yr + 1, 1, 1, 12, 0, 0) - yNoon) / MS_DAY))
dayInY = math.max(0, math.min(yDays - 1, int(math.round((tdayMid - yNoon) / MS_DAY))))

// Monday 0 .. Sunday 6
dowMon(int t) =>
    int d = dayofweek(t, gridTZ)
    d == 1 ? 6 : d - 2

// how many Mon-Fri days sit in the n days that open on weekday w0. Closed form,
// so it costs the same whether the span is a day or a quarter
wdCount(int w0, int n) =>
    int c = int(math.floor(n / 7)) * 5
    int r = n % 7
    for i = 0 to 5
        if i < r and (w0 + i) % 7 < 5
            c := c + 1
    c

// the day offset of market day number k, counting off the quarter's first day
wdOffset(int first, int w, int k) =>
    first + int(math.floor((w + k) / 5)) * 7 + (w + k) % 5 - w

// The quarter runs from the first of its first month to the last of its third,
// and its three months are divided in four by MARKET days, not calendar days:
// 1 January is not an open, so counting calendar days put a third of the cells
// 14 bars wide and a third 17. Counted this way Q1 2026 is 64 market days and
// every cell holds 16 of them. A public holiday can still leave a cell a bar
// short, since Pine is not given the exchange's holiday calendar.
qFirstM = (iQtr - 1) * 3 + 1
qNoon   = timestamp(gridTZ, yr, qFirstM, 1, 12, 0, 0)
qNoonEnd = iQtr == 4 ? timestamp(gridTZ, yr + 1, 1, 1, 12, 0, 0) : timestamp(gridTZ, yr, qFirstM + 3, 1, 12, 0, 0)

// both ends are midday, so the day count is exact across a daylight saving edge
qDays  = int(math.round((qNoonEnd - qNoon) / MS_DAY))
dayInQ = math.max(0, math.min(qDays - 1, int(math.round((tdayMid - qNoon) / MS_DAY))))

qW0    = dowMon(qNoon)                   // weekday the quarter opens on
qFirst = qW0 < 5 ? 0 : 7 - qW0           // days to its first market day
qW     = (qW0 + qFirst) % 7              // 0 .. 4
qWd    = wdCount(qW0, qDays)             // market days in the whole quarter
dW     = wdCount(qW0, dayInQ)            // market days before this bar

v1 = int(math.floor(qWd     / 4))
v2 = int(math.floor(qWd * 2 / 4))
v3 = int(math.floor(qWd * 3 / 4))

iSplit = en3 ? (dW < v1 ? 1 : dW < v2 ? 2 : dW < v3 ? 3 : 4) : na
sDay0  = dW < v1 ? 0 : dW < v2 ? wdOffset(qFirst, qW, v1) : dW < v3 ? wdOffset(qFirst, qW, v2) : wdOffset(qFirst, qW, v3)
sDay1  = dW < v1 ? wdOffset(qFirst, qW, v1) : dW < v2 ? wdOffset(qFirst, qW, v2) : dW < v3 ? wdOffset(qFirst, qW, v3) : qDays

// Edges are measured off the open of the bar the cell starts on, in whole days,
// never off a calendar midnight. A midnight lands inside a bar, and a box edge
// inside a bar is pushed to the next one, which over a weekend throws the edge
// three days out: Friday 24 July would draw on Monday the 27th. Measured this
// way the edge sits exactly on the bar that opens the cell, and the same number
// of days forward lands exactly where the next cell opens.
//
// Then half a bar back. A bar's time is drawn at the middle of its candle, so an
// edge sitting on the opening bar's time cuts that candle in half and leaves one
// half in the cell before: Q1 reached into the candle of 1 April, a fourth month.
// Half a bar back drops the edge into the gap between the two candles, so the
// quarter holds the whole of 31 March and nothing of 1 April.
halfBar = tfs * 500

cycLeft   = dayStart - dayInY * MS_DAY - halfBar
cycRight  = dayStart + (yDays - dayInY) * MS_DAY - halfBar
qtrLeft   = dayStart - dayInQ * MS_DAY - halfBar
qtrRight  = dayStart + (qDays - dayInQ) * MS_DAY - halfBar
splitLeft = dayStart - (dayInQ - sDay0) * MS_DAY - halfBar
splitRight = dayStart + (sDay1 - dayInQ) * MS_DAY - halfBar

// a cell is new when its own number changes, not when its left edge moves, so
// the edges above are read once, on the bar that opens it
cycId   = yr
qtrId   = yr * 10 + iQtr
splitId = yr * 100 + iQtr * 10 + nz(iSplit, 0)

// how far back the slow rows keep their cells: inside the current four year
// cycle from the weekly chart up, where the whole cycle is the point, and inside
// the current year below it, where older years are only clutter
cycFirst = timestamp(gridTZ, yr - (iCyc4 - 1), 1, 1, 0, 0)
// two days of slack, because a cell opens on the evening before its first date
slowTrim = (tfs >= 604800 ? cycFirst : cycBeg) - 2 * MS_DAY


// ──────────────────────────── label construction ──────────────────────────────
var int[] idx = array.new_int(9, na)
array.set(idx, 0, iCyc4)
array.set(idx, 1, iQtr)
array.set(idx, 2, iSplit)
array.set(idx, 3, iWeek)
array.set(idx, 4, iDay)
array.set(idx, 5, iSess)
array.set(idx, 6, i90)
array.set(idx, 7, i225)
array.set(idx, 8, i5625)

// The chain of quarters ending at level `lvl`, highest level first.
//
// A level that carries no number but is on the chart all the same, Friday and a
// dead week, holds its place with gapMark, so the session row reads week - day -
// session on a Friday just as it does on a Monday. Were the link dropped, the
// chain would pull the level above it in to stay three long and the same row
// would silently read quarter - week - session instead.
//
// The split level is different: off the daily chart it is not on the chart at
// all, so it is passed over without taking a place.
chainOf(int lvl, int depth, string sep) =>
    string out      = ""
    int    n        = 0
    bool   topFirst = chainOrder == "Highest level first"
    if not na(array.get(idx, lvl - 1))
        for i = lvl to 1
            if n < depth
                int    v       = array.get(idx, i - 1)
                bool   onChart = i != 3 or en3
                string piece   = na(v) ? (onChart ? gapMark : "") : str.tostring(v)
                if piece != ""
                    // the loop walks from the cell upwards, so the highest level
                    // first order is built by putting each new link in front
                    out := topFirst ? piece + (out == "" ? "" : sep) + out : out + (out == "" ? "" : sep) + piece
                    n   := n + 1
    out

dayNameOf(int d) =>
    switch d
        1 => "Mon"
        2 => "Tue"
        3 => "Wed"
        4 => "Thu"
        5 => "Fri"
        6 => "Sat"
        => "Sun"

sessNameOf(int sv) =>
    switch sv
        1 => "Asia"
        2 => "Lon"
        3 => "AM"
        4 => "PM"
        => ""

// What a row shows when it is named rather than numbered. The numbers come in
// as arguments, so a block that has not happened yet can be named off its own.
nameOf(int lvl, int yrV, int qV, int spV, int wkV, int rawV, int sessV) =>
    switch lvl
        1 => str.tostring(yrV)
        2 => "Q" + str.tostring(qV)
        3 => na(spV) ? "" : "Q" + str.tostring(spV)
        4 => na(wkV) ? "" : "Week " + str.tostring(wkV)
        5 => dayNameOf(rawV)
        6 => sessNameOf(sessV)
        => ""

nameFor(int lvl) =>
    nameOf(lvl, yr, iQtr, iSplit, iWeek, rawDay, iSess)

// names reach down to this level, numbers take over below it
namedDepth = nameRows == "Off" ? 0 : nameRows == "Down to the day" ? 5 : 6
numbered(int lvl) =>
    lvl > namedDepth

cellTextOf(int lvl, string nm0) =>
    string nm  = showLabels and not numbered(lvl) ? nm0 : ""
    string num = not numbered(lvl) and not appendNums ? "" : showLabels ? chainOf(lvl, labelDepth, sepStr) : ""
    nm + (nm != "" and num != "" ? " " : "") + num

cellText(int lvl) =>
    cellTextOf(lvl, nameFor(lvl))

// is this cell's three link chain one of the marked ones
hotSeq(string s) =>
    str.length(s) == 3 and str.contains("," + str.replace_all(hotList, " ", "") + ",", "," + s + ",")

// the quarter's own colour, in its strong shade on a marked sequence, or the
// colourless fill for a level that carries no quarter number
fillFor(int lvl, int i) =>
    bool hot = hiOn and hotSeq(chainOf(lvl, 3, ""))
    na(i) ? cNone : i == 1 ? (hot ? h1 : c1) : i == 2 ? (hot ? h2 : c2) : i == 3 ? (hot ? h3 : c3) : i == 4 ? (hot ? h4 : c4) : c5


// The numbers a timestamp falls on, worked out from that timestamp alone, so
// the same arithmetic can be pointed at a block that has not happened yet. The
// quarter split is left out: it is a daily chart row and is not drawn ahead.
idxAt(int t) =>
    int adjT  = t + shiftMs
    int todT  = adjT - timestamp(gridTZ, year(adjT, gridTZ), month(adjT, gridTZ), dayofmonth(adjT, gridTZ), 0, 0, 0)
    int mdT   = (todT - 18 * 3600000 + MS_DAY) % MS_DAY
    int tdT   = adjT + MS_6H
    int dwT   = dayofweek(tdT, gridTZ)
    int rawT  = dwT == 1 ? 7 : dwT - 1
    int midT  = timestamp(gridTZ, year(tdT, gridTZ), month(tdT, gridTZ), dayofmonth(tdT, gridTZ), 12, 0, 0)
    int tueT  = midT + (2 - rawT) * MS_DAY
    int thuT  = midT + (4 - rawT) * MS_DAY
    int wkT   = year(tueT, gridTZ) * 100 + month(tueT, gridTZ) != year(thuT, gridTZ) * 100 + month(thuT, gridTZ) ? na : int(math.floor((dayofmonth(tueT, gridTZ) - 1) / 7)) + 1
    [int((year(tdT, gridTZ) + 1) % 4) + 1, int(math.floor((month(tdT, gridTZ) - 1) / 3)) + 1, wkT, rawT <= 4 ? rawT : na, rawT, int(math.floor(mdT / MS_6H)) + 1, int(math.floor(mdT % MS_6H / MS_90)) + 1, int(math.floor(mdT % MS_90 / MS_225)) + 1, int(math.floor(mdT % MS_225 / MS_5625)) + 1]


// ───────────────────────────────── drawing ────────────────────────────────────
var box[] bx1 = array.new_box()
var box[] bx2 = array.new_box()
var box[] bx3 = array.new_box()
var box[] bx4 = array.new_box()
var box[] bx5 = array.new_box()
var box[] bx6 = array.new_box()
var box[] bx7 = array.new_box()
var box[] bx8 = array.new_box()
var box[] bx9 = array.new_box()

// one box per cell: created when a new cell opens, and the row keeps only the
// last `cellsKept` of them so the slower rows never lose their boxes to the
// 500 box budget
cell(box[] store, bool fresh, int left, int right, int top, string txt, color bg, int keepFrom) =>
    if fresh or array.size(store) == 0
        array.push(store, box.new(left = left, top = top, right = right, bottom = top - 1, xloc = xloc.bar_time, bgcolor = bg, border_color = borderCol, border_width = borderW, border_style = line.style_solid, text = txt, text_color = textCol, text_size = textSizeIn))
        if array.size(store) > cellsKept
            box.delete(array.shift(store))
    // and drop whatever now sits before this row's own cycle
    while array.size(store) > 1 and box.get_left(array.get(store, 0)) < keepFrom
        box.delete(array.shift(store))

l6   = time - off6
l90  = time - off90
l225 = time - off225
l562 = time - off5625

if en1
    cell(bx1, cycId != cycId[1], cycLeft, cycRight, y1, cellText(1), fillFor(1, iCyc4), slowTrim)

if en2
    cell(bx2, qtrId != qtrId[1], qtrLeft, qtrRight, y2, cellText(2), fillFor(2, iQtr), slowTrim)

if en3
    cell(bx3, splitId != splitId[1], splitLeft, splitRight, y3, cellText(3), fillFor(3, iSplit), slowTrim)

if en4
    cell(bx4, weekStart != weekStart[1], weekStart, weekStart + 5 * MS_DAY, y4, cellText(4), fillFor(4, iWeek), 0)

if en5
    cell(bx5, dayStart != dayStart[1], dayStart, dayStart + MS_DAY, y5, cellText(5), fillFor(5, iDay), 0)

if en6
    cell(bx6, l6 != l6[1], l6, l6 + MS_6H, y6, cellText(6), fillFor(6, iSess), 0)

if en7
    cell(bx7, l90 != l90[1], l90, l90 + MS_90, y7, cellText(7), fillFor(7, i90), 0)

if en8
    cell(bx8, l225 != l225[1], l225, l225 + MS_225, y8, cellText(8), fillFor(8, i225), 0)

if en9
    cell(bx9, l562 != l562[1], l562, l562 + MS_5625, y9, cellText(9), fillFor(9, i5625), 0)


// ───────────────────────────── the blocks ahead ───────────────────────────────
// Drawn dashed, off the last bar, and only for the rows whose cells are a fixed
// length: the week and everything below it. Each one is read off its own start,
// so a block that runs into the next day carries that day's numbers.
//
// This clobbers idx with the projected numbers. Nothing below reads it, and the
// bar's own numbers are written back at the top of the next bar.
var box[] fx = array.new_box()

aheadOne(int lvl, int beg, int len, int probe) =>
    [c, q, w, d, raw, sn, n90, n225, n562] = idxAt(beg + probe)
    array.set(idx, 0, c)
    array.set(idx, 1, q)
    array.set(idx, 2, na)
    array.set(idx, 3, w)
    array.set(idx, 4, d)
    array.set(idx, 5, sn)
    array.set(idx, 6, n90)
    array.set(idx, 7, n225)
    array.set(idx, 8, n562)
    int top = lvl == 4 ? y4 : lvl == 5 ? y5 : lvl == 6 ? y6 : lvl == 7 ? y7 : lvl == 8 ? y8 : y9
    array.push(fx, box.new(left = beg, top = top, right = beg + len, bottom = top - 1, xloc = xloc.bar_time, bgcolor = fillFor(lvl, array.get(idx, lvl - 1)), border_color = borderCol, border_width = borderW, border_style = line.style_dashed, text = cellTextOf(lvl, nameOf(lvl, 0, q, na, w, raw, sn)), text_color = textCol, text_size = textSizeIn))

if barstate.islast
    while array.size(fx) > 0
        box.delete(array.shift(fx))
    if aheadN > 0
        for k = 1 to aheadN
            if en4
                aheadOne(4, weekStart + k * 7 * MS_DAY, 5 * MS_DAY, 2 * MS_DAY)
            if en5
                aheadOne(5, dayStart + k * MS_DAY, MS_DAY, MS_DAY / 2)
            if en6
                aheadOne(6, l6 + k * MS_6H, MS_6H, MS_6H / 2)
            if en7
                aheadOne(7, l90 + k * MS_90, MS_90, MS_90 / 2)
            if en8
                aheadOne(8, l225 + k * MS_225, MS_225, MS_225 / 2)
            if en9
                aheadOne(9, l562 + k * MS_5625, MS_5625, MS_5625 / 2)

// the rows are drawn entirely with boxes; this hidden plot only satisfies Pine's
// "at least one output" rule and is excluded from the pane and the scale
plot(0, "", display = display.none, editable = false)


// ═══════════════════════════════════════════════════════════════════════════════
//  TRUE OPENS
//
//  Drawn on the candles with force_overlay, while the rows above stay in this
//  script's own pane. Every container and every boundary is taken from the grid
//  already worked out above, so a true open can never sit a minute off the row
//  that contains it, whatever the clock and shift are set to.
//
//  Each level is the open of the SECOND sub cycle of its container:
//    TNcP  2nd sub-quarter in the quarter     quarter + 5:37.5
//    TMcO  2nd quarter in the micro           micro + 22:30
//    T90O  2nd micro in the session           session + 90 min
//    TDO   2nd session in the day             midnight
//    TWO   2nd day in the week                Monday 18:00
//    TMO   2nd week in the month              the Sunday opening the week whose
//                                             Tuesday falls on the 8th to 14th
//    TYO   the QT year's own start            1 April, so 31 March 18:00
//    T4YO  2nd year in the four year cycle    1 January of 2024, 2028
// ═══════════════════════════════════════════════════════════════════════════════

g_to = "True Opens"
toOn      = input.bool(true, "Enable", group = g_to)
toCol     = input.color(color.rgb(75, 86, 186, 65), "Colour", group = g_to)
toStyleIn = input.string("Dashed", "Line style", options = ["Solid", "Dotted", "Dashed"], inline = "ts", group = g_to)
toWidth   = input.int(1, "Width", minval = 1, maxval = 5, inline = "ts", group = g_to)
toExpire  = input.bool(true, "Drop a level when its period ends", group = g_to, tooltip = "ON: the line goes the moment its container closes, and comes back once the new container prints its own open. Between 18:00 and midnight there is no TDO at all.\nOFF: the last known level stays on the chart.")

useTNcP = input.bool(true, "TNcP  - 2nd sub-quarter in the quarter", group = g_to)
useTMcO = input.bool(true, "TMcO - 2nd quarter in the micro",        group = g_to)
useT90O = input.bool(true, "T90O - 2nd micro in the session",        group = g_to)
useTDO  = input.bool(true, "TDO   - 2nd session in the day",         group = g_to)
useTWO  = input.bool(true, "TWO  - 2nd day in the week",             group = g_to)
useTMO  = input.bool(true, "TMO  - 2nd week in the month",           group = g_to)
useTYO  = input.bool(true, "TYO   - QT year open, 1 April",          group = g_to)
useT4YO = input.bool(true, "T4YO - 2nd year in the four year cycle", group = g_to)

g_zn = "Zone Box"
showZoneBox  = input.bool(true, "Show", group = g_zn, tooltip = "Premium or discount for the cycle this chart measures, off the chart's own open and the two above it. Hidden above the 4 hour chart. It sits in this script's pane, not on the candles, because a table cannot be forced onto the chart.")
zonePosition = input.string("bottom_right", "Position", options = ["top_right", "top_left", "bottom_right", "bottom_left", "middle_right", "middle_left"], group = g_zn)
showBias     = input.bool(true, "Directional bias label", group = g_zn, tooltip = "Reads bullish or bearish off the T90O through the AM session, and N/A outside it.")

toStyle = toStyleIn == "Solid" ? line.style_solid : toStyleIn == "Dotted" ? line.style_dotted : line.style_dashed

// which levels get a line on this chart
tfMin = tfs / 60.0
band1 = tfMin < 1
band2 = tfMin >= 1    and tfMin < 5
band3 = tfMin >= 5    and tfMin < 15
band4 = tfMin >= 15   and tfMin < 60
band5 = tfMin >= 60   and tfMin < 1440
band6 = tfMin >= 1440

showTNcP = toOn and useTNcP and (band1 or band2)
showTMcO = toOn and useTMcO and (band1 or band2)
showT90O = toOn and useT90O and (band1 or band2 or band3 or band4)
showTDO  = toOn and useTDO  and (band2 or band3 or band4 or band5)
showTWO  = toOn and useTWO  and (band3 or band4 or band5)
showTMO  = toOn and useTMO  and (band4 or band5 or band6)
showTYO  = toOn and useTYO  and band6
showT4YO = toOn and useT4YO and band6

// ---------- where each level opens, all off the grid above ----------
tgtTNcP = l225 + MS_5625          // quarter  + 5.625 min
tgtTMcO = l90  + MS_225           // micro    + 22.5 min
tgtT90O = l6   + MS_90            // session  + 90 min
tgtTDO  = dayStart + MS_6H        // day      + 6 h, which is midnight
tgtTWO  = weekStart + MS_DAY      // week     + 1 day, Monday 18:00

// the month's second week: the Sunday before the Tuesday that falls on the
// 8th to the 14th. Built on the grid clock, then pulled back by the shift so
// it can be compared against real bar time like every other target
wkY         = year(tueTs, gridTZ)
wkM         = month(tueTs, gridTZ)
firstNoon   = timestamp(gridTZ, wkY, wkM, 1, 12, 0, 0)
firstTueDom = ((3 - dayofweek(firstNoon, gridTZ) + 7) % 7) + 1
wk2SunNoon  = timestamp(gridTZ, wkY, wkM, firstTueDom + 7, 12, 0, 0) - 2 * MS_DAY
tgtTMO      = timestamp(gridTZ, year(wk2SunNoon, gridTZ), month(wk2SunNoon, gridTZ), dayofmonth(wk2SunNoon, gridTZ), 18, 0, 0) - shiftMs

qtYearB  = mth >= 4 ? yr : yr - 1
tgtTYO   = timestamp(gridTZ, qtYearB, 3, 31, 18, 0, 0) - shiftMs
cycStart = yr - ((yr - 2023) % 4 + 4) % 4
tgtT4YO  = timestamp(gridTZ, cycStart, 12, 31, 18, 0, 0) - shiftMs

// THE candle that OPENS the level: the first one starting at or after the
// instant, never the one that merely contains it, so a boundary at 09:22:30
// prints on the 09:23 candle. This also carries a level over a weekend gap.
fired(int t) =>
    time >= t and time[1] < t

// ---------- lines ----------
lookahead = 20

newTOLine() =>
    line.new(na, na, na, na, color = toCol, width = toWidth, style = toStyle, force_overlay = true)
newTOLabel(string txt) =>
    label.new(na, na, text = txt, color = #00000000, textcolor = toCol, size = size.small, style = label.style_label_left, force_overlay = true)

var line  lnTNcP = newTOLine()
var label lbTNcP = newTOLabel("TNcP")
var line  lnTMcO = newTOLine()
var label lbTMcO = newTOLabel("TMcO")
var line  lnT90O = newTOLine()
var label lbT90O = newTOLabel("T90O")
var line  lnTDO  = newTOLine()
var label lbTDO  = newTOLabel("TDO")
var line  lnTWO  = newTOLine()
var label lbTWO  = newTOLabel("TWO")
var line  lnTMO  = newTOLine()
var label lbTMO  = newTOLabel("TMO")
var line  lnTYO  = newTOLine()
var label lbTYO  = newTOLabel("TYO")
var line  lnT4YO = newTOLine()
var label lbT4YO = newTOLabel("T4YO")

// Prices are captured on every timeframe, because the zone box needs levels
// that are not necessarily drawn; only the drawing is gated by the band. Each
// level remembers which container it belongs to, so the moment the live
// container stops matching, the price is dropped and the line comes off.
var float pTNcP = na
var int   idTNcP = na
var float pTMcO = na
var int   idTMcO = na
var float pT90O = na
var int   idT90O = na
var float pTDO = na
var int   idTDO = na
var float pTWO = na
var int   idTWO = na
var float pTMO = na
var int   idTMO = na
var float pTYO = na
var int   idTYO = na
var float pT4YO = na
var int   idT4YO = na

place(line ln, label lb, bool show) =>
    if show
        line.set_xy1(ln, bar_index, open)
        line.set_xy2(ln, bar_index, open)
        label.set_xy(lb, bar_index, open)

if toExpire and not na(idTNcP) and idTNcP != l225
    pTNcP := na
if fired(tgtTNcP)
    pTNcP  := open
    idTNcP := l225
    place(lnTNcP, lbTNcP, showTNcP)

if toExpire and not na(idTMcO) and idTMcO != l90
    pTMcO := na
if fired(tgtTMcO)
    pTMcO  := open
    idTMcO := l90
    place(lnTMcO, lbTMcO, showTMcO)

if toExpire and not na(idT90O) and idT90O != l6
    pT90O := na
if fired(tgtT90O)
    pT90O  := open
    idT90O := l6
    place(lnT90O, lbT90O, showT90O)

if toExpire and not na(idTDO) and idTDO != dayStart
    pTDO := na
if fired(tgtTDO)
    pTDO  := open
    idTDO := dayStart
    place(lnTDO, lbTDO, showTDO)

if toExpire and not na(idTWO) and idTWO != tgtTWO
    pTWO := na
if fired(tgtTWO)
    pTWO  := open
    idTWO := tgtTWO
    place(lnTWO, lbTWO, showTWO)

if toExpire and not na(idTMO) and idTMO != tgtTMO
    pTMO := na
if fired(tgtTMO)
    pTMO  := open
    idTMO := tgtTMO
    place(lnTMO, lbTMO, showTMO)

if toExpire and not na(idTYO) and idTYO != qtYearB
    pTYO := na
if fired(tgtTYO)
    pTYO  := open
    idTYO := qtYearB
    place(lnTYO, lbTYO, showTYO)

if toExpire and not na(idT4YO) and idT4YO != cycStart
    pT4YO := na
if fired(tgtT4YO)
    pT4YO  := open
    idT4YO := cycStart
    place(lnT4YO, lbT4YO, showT4YO)

// A live level is extended to the right. A dead one is given na coordinates,
// which takes it off the chart until its container prints a new open.
finish(line ln, label lb, bool live) =>
    if live
        line.set_x2(ln, bar_index + lookahead)
        label.set_x(lb, bar_index + lookahead)
    else
        line.set_xy1(ln, na, na)
        line.set_xy2(ln, na, na)
        label.set_xy(lb, na, na)

if barstate.islast
    finish(lnTNcP, lbTNcP, showTNcP and not na(pTNcP))
    finish(lnTMcO, lbTMcO, showTMcO and not na(pTMcO))
    finish(lnT90O, lbT90O, showT90O and not na(pT90O))
    finish(lnTDO,  lbTDO,  showTDO  and not na(pTDO))
    finish(lnTWO,  lbTWO,  showTWO  and not na(pTWO))
    finish(lnTMO,  lbTMO,  showTMO  and not na(pTMO))
    finish(lnTYO,  lbTYO,  showTYO  and not na(pTYO))
    finish(lnT4YO, lbT4YO, showT4YO and not na(pT4YO))

// ---------- directional bias, through the AM session ----------
bias = iSess == 3 and not na(pT90O) ? (open > pT90O ? "Bullish" : "Bearish") : "N/A"

var label biasLb = label.new(na, na, text = "Directional Bias: N/A", color = #00000000, textcolor = toCol, size = size.normal, style = label.style_label_left, force_overlay = true)
if barstate.islast
    label.set_xy(biasLb, showBias ? bar_index + lookahead : na, showBias ? close : na)
    label.set_text(biasLb, "Directional Bias: " + bias)


// ───────────────────────────── zone box ───────────────────────────────────────
// Premium or discount for the cycle this chart measures: the chart's own open
// and the one above it decide premium, discount or dead zone, and the third one
// above turns it into super premium or super discount. Nothing above 4 hours.
float zOwn = na
float zUp1 = na
float zUp2 = na
bool  zOn  = true

if band1
    zOwn := pTNcP
    zUp1 := pTMcO
    zUp2 := pT90O
else if band2
    zOwn := pTMcO
    zUp1 := pT90O
    zUp2 := pTDO
else if band3
    zOwn := pT90O
    zUp1 := pTDO
    zUp2 := pTWO
else if band4
    zOwn := pTDO
    zUp1 := pTWO
    zUp2 := pTMO
else if tfMin < 240
    zOwn := pTWO
    zUp1 := pTMO
    zUp2 := pTYO
else if tfMin == 240
    zOwn := pTMO
    zUp1 := pTYO
    zUp2 := pT4YO
else
    zOn := false

string zoneTxt = ""
color  zoneCol = na

if zOn and not na(zOwn) and not na(zUp1)
    if close > zOwn and close > zUp1
        bool superP = not na(zUp2) and close > zUp2
        zoneTxt := superP ? "Super Premium" : "Premium"
        zoneCol := color.new(#4b56ba, superP ? 10 : 55)
    else if close < zOwn and close < zUp1
        bool superD = not na(zUp2) and close < zUp2
        zoneTxt := superD ? "Super Discount" : "Discount"
        zoneCol := color.new(#ba4b4b, superD ? 10 : 55)
    else
        zoneTxt := "Dead Zone"
        zoneCol := color.new(#7e7e7e, 55)

zonePos = zonePosition == "top_right" ? position.top_right : zonePosition == "top_left" ? position.top_left : zonePosition == "bottom_left" ? position.bottom_left : zonePosition == "middle_right" ? position.middle_right : zonePosition == "middle_left" ? position.middle_left : position.bottom_right

var table zoneTable = table.new(zonePos, 1, 1, border_width = 0, frame_width = 0)

if barstate.islast
    if showZoneBox and zoneTxt != ""
        table.cell(zoneTable, 0, 0, zoneTxt, bgcolor = zoneCol, text_color = color.white, text_size = size.tiny)
    else
        table.clear(zoneTable, 0, 0)


// ═══════════════════════════════════════════════════════════════════════════════
//  DEVIL MARKS
//
//  Any candle whose body runs to one end with no wick there, or a wick small
//  enough to ignore, leaves a short line at that edge. Direction does not
//  matter. A mark is only born once the candle has CLOSED, because a live
//  candle can still grow the wick that would disqualify it. It then stays only
//  while that area is untouched: once price trades through it the wick has been
//  filled in and the mark is gone, and that part is checked live, not on close.
//  Drawn on the candles with force_overlay, like the true opens.
// ═══════════════════════════════════════════════════════════════════════════════

g_dev = "Devil Marks"
devOn      = input.bool(true, "Enable", group = g_dev)
devWickTol = input.float(2.0, "Count as no wick up to this size", minval = 0, step = 0.25, group = g_dev, tooltip = "Measured in price, not ticks. A wick this size or smaller still counts as missing, so a one point tail on MNQ is still a Devil at the default of 2. Set it to 0 to demand a perfectly flat edge.")
devLen     = input.int(10, "Line length (bars)", minval = 1, maxval = 200, group = g_dev, tooltip = "How far right of its own candle the line runs. It is a fixed stub and does not follow the chart's right edge.")
devClear   = input.bool(true, "Remove once price trades through the level", group = g_dev, tooltip = "ON: the mark goes the moment price trades past it, because the missing wick has now been filled in. Checked on every tick, not only on close.\nOFF: every mark stays until the max pushes it out.")
devMax     = input.int(10, "Max marks kept", minval = 1, maxval = 200, group = g_dev, tooltip = "Once this many marks are live the oldest is dropped. Raise it for more history, lower it if the chart feels crowded.")
devStyleIn = input.string("Solid", "Line style", options = ["Solid", "Dotted", "Dashed"], inline = "ds", group = g_dev)
devWidth   = input.int(1, "Width", minval = 1, maxval = 5, inline = "ds", group = g_dev)
devLabelOn = input.bool(true, "Show label text", group = g_dev)

devLower    = input.bool(true, "Missing LOWER wick", inline = "dl", group = g_dev)
devColLow   = input.color(#26a69a, "Colour", inline = "dl", group = g_dev)
devTextLow  = input.string("Devil 👹", "Lower label text", group = g_dev)

devUpper    = input.bool(true, "Missing UPPER wick", inline = "du", group = g_dev)
devColHigh  = input.color(#ef5350, "Colour", inline = "du", group = g_dev)
devTextHigh = input.string("Devil 👹", "Upper label text", group = g_dev)

devStyle = devStyleIn == "Solid" ? line.style_solid : devStyleIn == "Dotted" ? line.style_dotted : line.style_dashed

var line[]  devLn  = array.new<line>()
var label[] devLb  = array.new<label>()
var float[] devPx  = array.new<float>()
var bool[]  devLow = array.new<bool>()

// Half a tick of slack on top of the chosen size, so float representation can
// never hide an edge that is flat to the tick.
devEps   = syminfo.mintick * 0.5
bodyLow  = math.min(open, close)
bodyHigh = math.max(open, close)
noLowerWick = (bodyLow - low)   <= devWickTol + devEps
noUpperWick = (high - bodyHigh) <= devWickTol + devEps

addDevil(float px, bool isLow, color col, string txt) =>
    array.push(devLn, line.new(bar_index, px, bar_index + devLen, px, color = col, style = devStyle, width = devWidth, force_overlay = true))
    array.push(devLb, label.new(bar_index + devLen, px, devLabelOn ? txt : "", color = #00000000, textcolor = col, size = size.small, style = label.style_label_left, force_overlay = true))
    array.push(devPx, px)
    array.push(devLow, isLow)

dropDevil(int i) =>
    line.delete(array.get(devLn, i))
    label.delete(array.get(devLb, i))
    array.remove(devLn, i)
    array.remove(devLb, i)
    array.remove(devPx, i)
    array.remove(devLow, i)

if devOn
    // born on close only: a live candle has not finished deciding its wicks
    if barstate.isconfirmed
        if devLower and noLowerWick
            addDevil(low, true, devColLow, devTextLow)
        if devUpper and noUpperWick
            addDevil(high, false, devColHigh, devTextHigh)
        while array.size(devLn) > devMax
            dropDevil(0)

    // walk backwards, so removing an entry cannot skip the next one
    if devClear and array.size(devLn) > 0
        for i = array.size(devLn) - 1 to 0
            float px = array.get(devPx, i)
            if array.get(devLow, i) ? low < px - devEps : high > px + devEps
                dropDevil(i)

alertcondition(devOn and devLower and noLowerWick and barstate.isconfirmed, title = "Devil - no lower wick", message = "Sav FX: candle closed with no lower wick")
alertcondition(devOn and devUpper and noUpperWick and barstate.isconfirmed, title = "Devil - no upper wick", message = "Sav FX: candle closed with no upper wick")
