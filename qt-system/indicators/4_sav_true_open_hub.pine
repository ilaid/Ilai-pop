//@version=5
indicator("Sav FX + QT Hub", overlay = true, max_boxes_count = 50, max_labels_count = 500, max_lines_count = 500)

// ══════════════════════════════════════════════════════════════════════════
//  PART A — True Opens  (Quarterly Theory ladder) + Bias + zone box
//  Every time here is New York. The whole model runs on an 18:00-to-18:00
//  trading day, and every level is the open of the SECOND sub-cycle inside
//  its container — except TYO, which marks the QT year's own start (April).
//  T4YO is the second year of the calendar 4 year cycle (2024, 2028).
//  A level lives only as long as its container: when the container closes
//  the line disappears until the next container prints its own open.
// ══════════════════════════════════════════════════════════════════════════

gGlobal = "Global Settings"
customLineColor = input.color(color.rgb(75, 86, 186, 65), "True Open", group = gGlobal)
lineStyleInput  = input.string("Dashed", "Line Style", options = ["Solid", "Dotted", "Dashed"], group = gGlobal)
lineWidthInput  = input.int(1, "Line Width", minval = 1, maxval = 5, group = gGlobal)
expireLevels    = input.bool(true, "Drop a level when its period ends", group = gGlobal, tooltip = "ON  = the line vanishes the moment its container closes, and returns only once the new container prints its own open. Between 18:00 and 00:00 there is no TDO at all.\nOFF = the last known level stays on the chart.")
showZoneBox     = input.bool(true, "Zone box", group = gGlobal, tooltip = "The small premium / discount box. Hidden above the 4 hour chart.")
zonePosition    = input.string("bottom_right", "Zone box position", options = ["top_right", "top_left", "bottom_right", "bottom_left", "middle_right", "middle_left"], group = gGlobal)

trueOpenStyle = lineStyleInput == "Solid" ? line.style_solid : lineStyleInput == "Dotted" ? line.style_dotted : line.style_dashed

gLv = "True Opens"
useTNcP = input.bool(true, "TNcP   - 2nd sub-quarter in the quarter",  group = gLv, tooltip = "The first candle at or after quarter + 5:37.5. Shown up to the 1 minute chart.")
useTMcO = input.bool(true, "TMcO  - 2nd quarter in the micro",         group = gLv, tooltip = "The first candle at or after micro + 22:30, so on a 1 minute chart the 09:00 micro opens it at 09:23 and the 10:30 micro at 10:53. Shown below the 5 minute chart.")
useT90O = input.bool(true, "T90O  - 2nd micro in the session",         group = gLv, tooltip = "19:30 / 01:30 / 07:30 / 13:30. Shown below the 1 hour chart.")
useTDO  = input.bool(true, "TDO    - 2nd session in the day",          group = gLv, tooltip = "00:00. Shown from the 1 minute to the daily chart.")
useTWO  = input.bool(true, "TWO   - 2nd day in the week",              group = gLv, tooltip = "Monday 18:00. Shown from the 5 minute to the daily chart.")
useTMO  = input.bool(true, "TMO   - 2nd week in the month",            group = gLv, tooltip = "The Sunday 18:00 that opens the week whose Tuesday falls on the 8th-14th. Shown from the 15 minute chart up.")
useTYO  = input.bool(true, "TYO    - QT year open (1 April)",          group = gLv, tooltip = "Daily chart and above.")
useT4YO = input.bool(true, "T4YO  - 2nd year in the 4 year cycle (2024, 2028)", group = gLv, tooltip = "The cycle is calendar years 2023–2026, 2027–2030. Its True Open is the first candle of the second year. During the first year there is no T4YO. Daily chart and above.")

IsSession(sess, timezone) =>
    not na(time(timeframe.period, sess, timezone))

is6_00Session  = IsSession("0600-0730", "America/New_York")
is7_30Session  = IsSession("0730-0900", "America/New_York")
is9_00Session  = IsSession("0900-1030", "America/New_York")
is10_30Session = IsSession("1030-1200", "America/New_York")

TZ = "America/New_York"

tfSec = timeframe.in_seconds(timeframe.period)
tfMs  = tfSec * 1000
tfMin = tfSec / 60.0

// Which levels get a line on this chart, band by band.
band1 = tfMin < 1
band2 = tfMin >= 1    and tfMin < 5
band3 = tfMin >= 5    and tfMin < 15
band4 = tfMin >= 15   and tfMin < 60
band5 = tfMin >= 60   and tfMin < 1440
band6 = tfMin >= 1440

showTNcP = useTNcP and (band1 or band2)
showTMcO = useTMcO and (band1 or band2)
showT90O = useT90O and (band1 or band2 or band3 or band4)
showTDO  = useTDO  and (band2 or band3 or band4 or band5)
showTWO  = useTWO  and (band3 or band4 or band5)
showTMO  = useTMO  and (band4 or band5 or band6)
showTYO  = useTYO  and band6
showT4YO = useT4YO and band6

// ---------- The trading day this bar belongs to ----------
// From 18:00 onward the bar already belongs to tomorrow's trading day.
nyHour = hour(time, TZ)
int tdCarrier = time + (nyHour >= 18 ? 86400000 : 0)
int tdY = year(tdCarrier, TZ)
int tdM = month(tdCarrier, TZ)
int tdD = dayofmonth(tdCarrier, TZ)
int tdMid = timestamp(TZ, tdY, tdM, tdD, 0, 0, 0)

// 18:00 of the previous calendar day, found through its noon so a DST switch
// can never move the date by a day.
int prevNoon = tdMid - 43200000
int dayStart = timestamp(TZ, year(prevNoon, TZ), month(prevNoon, TZ), dayofmonth(prevNoon, TZ), 18, 0, 0)

// ---------- Containers and their second sub-cycle ----------
float elapsed  = time - dayStart
int sessStart  = dayStart + int(math.floor(elapsed / 21600000.0)) * 21600000   // 6h session
int microStart = dayStart + int(math.floor(elapsed / 5400000.0))  * 5400000    // 90m micro
int qtrStart   = dayStart + int(math.floor(elapsed / 1350000.0))  * 1350000    // 22.5m quarter

int tgtTDO  = tdMid                   // 2nd session  = 00:00
int tgtT90O = sessStart  + 5400000    // 2nd micro    = session + 90m
int tgtTMcO = microStart + 1350000    // 2nd quarter  = micro + 22.5m
int tgtTNcP = qtrStart   + 337500     // 2nd sub-qtr  = quarter + 5.625m

// ---------- Week ----------
int dowTd = dayofweek(tdCarrier, TZ)
int daysSinceMon = dowTd == dayofweek.sunday ? 6 : dowTd - 2
int monNoon = tdMid + 43200000 - daysSinceMon * 86400000
int tgtTWO = timestamp(TZ, year(monNoon, TZ), month(monNoon, TZ), dayofmonth(monNoon, TZ), 18, 0, 0)

// ---------- Month: the week belongs to the month of its Tuesday ----------
int tueNoon = monNoon + 86400000
int wkY = year(tueNoon, TZ)
int wkM = month(tueNoon, TZ)
int firstNoon = timestamp(TZ, wkY, wkM, 1, 12, 0, 0)
int dow1 = dayofweek(firstNoon, TZ)
int firstTueDom = ((3 - dow1 + 7) % 7) + 1            // first Tuesday, always the 1st-7th
int wk2TueNoon = timestamp(TZ, wkY, wkM, firstTueDom + 7, 12, 0, 0)
int wk2SunNoon = wk2TueNoon - 2 * 86400000            // the week opens on the Sunday before
int tgtTMO = timestamp(TZ, year(wk2SunNoon, TZ), month(wk2SunNoon, TZ), dayofmonth(wk2SunNoon, TZ), 18, 0, 0)

// ---------- QT year and the 4 year cycle ----------
int qtYear = tdM >= 4 ? tdY : tdY - 1
int tgtTYO = timestamp(TZ, qtYear, 3, 31, 18, 0, 0)   // 1 April opens at 31 March 18:00
// The 4 year cycle is calendar years from 2023 (2023–2026, 2027–2030), and
// like every other level its True Open is the SECOND sub-cycle: the opening
// of the cycle's second year. 1 January opens at 31 December 18:00.
int cycStart = tdY - (((tdY - 2023) % 4) + 4) % 4
int tgtT4YO = timestamp(TZ, cycStart, 12, 31, 18, 0, 0)

// ---------- Hit test ----------
// THE candle that OPENS the level: the first one starting at or after the
// instant, never the one that merely contains it. A quarter boundary at
// 09:22:30 therefore prints on the 09:23 candle, not on 09:22. This also
// carries the level across a weekend or a holiday gap.
fired(t) =>
    time >= t and time[1] < t

// ---------- Lines ----------
var lookahead_bars = 20

var line  lnTNcP = line.new(na, na, na, na, color = customLineColor, width = lineWidthInput, style = trueOpenStyle)
var label lbTNcP = label.new(na, na, text = "TNcP", color = #00000000, textcolor = customLineColor, size = size.small, style = label.style_label_left)
var line  lnTMcO = line.new(na, na, na, na, color = customLineColor, width = lineWidthInput, style = trueOpenStyle)
var label lbTMcO = label.new(na, na, text = "TMcO", color = #00000000, textcolor = customLineColor, size = size.small, style = label.style_label_left)
var line  lnT90O = line.new(na, na, na, na, color = customLineColor, width = lineWidthInput, style = trueOpenStyle)
var label lbT90O = label.new(na, na, text = "T90O", color = #00000000, textcolor = customLineColor, size = size.small, style = label.style_label_left)
var line  lnTDO = line.new(na, na, na, na, color = customLineColor, width = lineWidthInput, style = trueOpenStyle)
var label lbTDO = label.new(na, na, text = "TDO", color = #00000000, textcolor = customLineColor, size = size.small, style = label.style_label_left)
var line  lnTWO = line.new(na, na, na, na, color = customLineColor, width = lineWidthInput, style = trueOpenStyle)
var label lbTWO = label.new(na, na, text = "TWO", color = #00000000, textcolor = customLineColor, size = size.small, style = label.style_label_left)
var line  lnTMO = line.new(na, na, na, na, color = customLineColor, width = lineWidthInput, style = trueOpenStyle)
var label lbTMO = label.new(na, na, text = "TMO", color = #00000000, textcolor = customLineColor, size = size.small, style = label.style_label_left)
var line  lnTYO = line.new(na, na, na, na, color = customLineColor, width = lineWidthInput, style = trueOpenStyle)
var label lbTYO = label.new(na, na, text = "TYO", color = #00000000, textcolor = customLineColor, size = size.small, style = label.style_label_left)
var line  lnT4YO = line.new(na, na, na, na, color = customLineColor, width = lineWidthInput, style = trueOpenStyle)
var label lbT4YO = label.new(na, na, text = "T4YO", color = #00000000, textcolor = customLineColor, size = size.small, style = label.style_label_left)

// Prices are captured on every timeframe, because the zone box needs levels
// that are not necessarily drawn. Only the drawing is gated by the band.
// Each level also remembers which container it belongs to: the moment the live
// container stops matching, the price is dropped and the line comes off.
var float pTNcP = na
var int   idTNcP = na
var float pTMcO = na
var int   idTMcO = na
var float pT90O = na
var int   idT90O = na
var float pTDO = na
var int   idTDO = na
var float pTWO = na
var int   idTWO = na
var float pTMO = na
var int   idTMO = na
var float pTYO = na
var int   idTYO = na
var float pT4YO = na
var int   idT4YO = na

if expireLevels and not na(idTNcP) and idTNcP != qtrStart
    pTNcP := na
if fired(tgtTNcP)
    pTNcP := open
    idTNcP := qtrStart
    if showTNcP
        line.set_xy1(lnTNcP, bar_index, open)
        line.set_xy2(lnTNcP, bar_index, open)
        label.set_xy(lbTNcP, bar_index, open)

if expireLevels and not na(idTMcO) and idTMcO != microStart
    pTMcO := na
if fired(tgtTMcO)
    pTMcO := open
    idTMcO := microStart
    if showTMcO
        line.set_xy1(lnTMcO, bar_index, open)
        line.set_xy2(lnTMcO, bar_index, open)
        label.set_xy(lbTMcO, bar_index, open)

if expireLevels and not na(idT90O) and idT90O != sessStart
    pT90O := na
if fired(tgtT90O)
    pT90O := open
    idT90O := sessStart
    if showT90O
        line.set_xy1(lnT90O, bar_index, open)
        line.set_xy2(lnT90O, bar_index, open)
        label.set_xy(lbT90O, bar_index, open)

if expireLevels and not na(idTDO) and idTDO != dayStart
    pTDO := na
if fired(tgtTDO)
    pTDO := open
    idTDO := dayStart
    if showTDO
        line.set_xy1(lnTDO, bar_index, open)
        line.set_xy2(lnTDO, bar_index, open)
        label.set_xy(lbTDO, bar_index, open)

if expireLevels and not na(idTWO) and idTWO != tgtTWO
    pTWO := na
if fired(tgtTWO)
    pTWO := open
    idTWO := tgtTWO
    if showTWO
        line.set_xy1(lnTWO, bar_index, open)
        line.set_xy2(lnTWO, bar_index, open)
        label.set_xy(lbTWO, bar_index, open)

if expireLevels and not na(idTMO) and idTMO != tgtTMO
    pTMO := na
if fired(tgtTMO)
    pTMO := open
    idTMO := tgtTMO
    if showTMO
        line.set_xy1(lnTMO, bar_index, open)
        line.set_xy2(lnTMO, bar_index, open)
        label.set_xy(lbTMO, bar_index, open)

if expireLevels and not na(idTYO) and idTYO != qtYear
    pTYO := na
if fired(tgtTYO)
    pTYO := open
    idTYO := qtYear
    if showTYO
        line.set_xy1(lnTYO, bar_index, open)
        line.set_xy2(lnTYO, bar_index, open)
        label.set_xy(lbTYO, bar_index, open)

if expireLevels and not na(idT4YO) and idT4YO != cycStart
    pT4YO := na
if fired(tgtT4YO)
    pT4YO := open
    idT4YO := cycStart
    if showT4YO
        line.set_xy1(lnT4YO, bar_index, open)
        line.set_xy2(lnT4YO, bar_index, open)
        label.set_xy(lbT4YO, bar_index, open)

// A live level gets extended to the right. A dead one gets na coordinates,
// which takes it off the chart until its container prints a new open.
finish(ln, lb, live) =>
    if live
        line.set_x2(ln, bar_index + lookahead_bars)
        label.set_x(lb, bar_index + lookahead_bars)
    else
        line.set_xy1(ln, na, na)
        line.set_xy2(ln, na, na)
        label.set_xy(lb, na, na)

if barstate.islast
    finish(lnTNcP, lbTNcP, showTNcP and not na(pTNcP))
    finish(lnTMcO, lbTMcO, showTMcO and not na(pTMcO))
    finish(lnT90O, lbT90O, showT90O and not na(pT90O))
    finish(lnTDO,  lbTDO,  showTDO  and not na(pTDO))
    finish(lnTWO,  lbTWO,  showTWO  and not na(pTWO))
    finish(lnTMO,  lbTMO,  showTMO  and not na(pTMO))
    finish(lnTYO,  lbTYO,  showTYO  and not na(pTYO))
    finish(lnT4YO, lbT4YO, showT4YO and not na(pT4YO))

// ---------- Directional Bias ----------
directionalBias = "N/A"
if is6_00Session or is7_30Session or is9_00Session or is10_30Session
    directionalBias := open > pT90O ? "Bullish" : "Bearish"

var directionalBiasLabel = label.new(na, na, text = "Directional Bias: N/A", color = na, textcolor = customLineColor, size = size.normal, style = label.style_label_left)
if barstate.islast
    label.set_x(directionalBiasLabel, bar_index + lookahead_bars)
    label.set_text(directionalBiasLabel, "Directional Bias: " + directionalBias)

// ══════════════════════════════════════════════════════════════════════════
//  Zone box — premium / discount for the cycle this chart measures
//  own open + the open above it decide Premium / Discount / Dead Zone,
//  and the third open above turns it into Super Premium / Super Discount.
//  Nothing is shown above the 4 hour chart.
// ══════════════════════════════════════════════════════════════════════════

float zOwn = na
float zUp1 = na
float zUp2 = na
bool  zOn  = true

if band1
    zOwn := pTNcP
    zUp1 := pTMcO
    zUp2 := pT90O
else if band2
    zOwn := pTMcO
    zUp1 := pT90O
    zUp2 := pTDO
else if band3
    zOwn := pT90O
    zUp1 := pTDO
    zUp2 := pTWO
else if band4
    zOwn := pTDO
    zUp1 := pTWO
    zUp2 := pTMO
else if tfMin < 240
    zOwn := pTWO
    zUp1 := pTMO
    zUp2 := pTYO
else if tfMin == 240
    zOwn := pTMO
    zUp1 := pTYO
    zUp2 := pT4YO
else
    zOn := false

string zoneTxt = ""
color  zoneCol = na

if zOn and not na(zOwn) and not na(zUp1)
    if close > zOwn and close > zUp1
        if not na(zUp2) and close > zUp2
            zoneTxt := "Super Premium"
            zoneCol := color.new(#4b56ba, 10)
        else
            zoneTxt := "Premium"
            zoneCol := color.new(#4b56ba, 55)
    else if close < zOwn and close < zUp1
        if not na(zUp2) and close < zUp2
            zoneTxt := "Super Discount"
            zoneCol := color.new(#ba4b4b, 10)
        else
            zoneTxt := "Discount"
            zoneCol := color.new(#ba4b4b, 55)
    else
        zoneTxt := "Dead Zone"
        zoneCol := color.new(#7e7e7e, 55)

zonePos = zonePosition == "top_right" ? position.top_right : zonePosition == "top_left" ? position.top_left : zonePosition == "bottom_left" ? position.bottom_left : zonePosition == "middle_right" ? position.middle_right : zonePosition == "middle_left" ? position.middle_left : position.bottom_right

var table zoneTable = table.new(zonePos, 1, 1, border_width = 0, frame_width = 0)

if barstate.islast
    if showZoneBox and zoneTxt != ""
        table.cell(zoneTable, 0, 0, zoneTxt, bgcolor = zoneCol, text_color = color.white, text_size = size.tiny)
    else
        table.clear(zoneTable, 0, 0)


// ══════════════════════════════════════════════════════════════════════════
//  PART B — Devil Marks
//  Any candle whose body runs to one end with no wick there — or a wick small
//  enough to ignore — leaves a short line at that edge. Direction does not
//  matter: an up candle and a down candle both qualify. A mark is only born
//  once the candle has CLOSED, because a live candle can still grow the wick
//  that would disqualify it. The mark then stays only while that area is
//  untouched; once price trades through it the wick has been filled in and the
//  mark is gone, and that part is checked live, not on close.
// ══════════════════════════════════════════════════════════════════════════

gDev = "Devil Marks"
devOn      = input.bool(true, "Enable", group = gDev)
devWickTol = input.float(2.0, "Count as no wick up to this size", minval = 0, step = 0.25, group = gDev, tooltip = "Measured in price, not ticks. A wick this size or smaller still counts as missing, so a one point tail on MNQ is still a Devil at the default of 2. Set it to 0 to demand a perfectly flat edge.")
devLen     = input.int(10, "Line length (bars)", minval = 1, maxval = 200, group = gDev, tooltip = "How far right of its own candle the line runs. It is a fixed stub and does not follow the chart's right edge.")
devClear   = input.bool(true, "Remove once price trades through the level", group = gDev, tooltip = "ON  = the mark is deleted the moment price trades past it, because the missing wick has now been filled in. This is checked on every tick, not only on close.\nOFF = every mark stays until the Max marks limit pushes it out.")
devMax     = input.int(10, "Max marks kept", minval = 1, maxval = 200, group = gDev, tooltip = "Once this many marks are live the oldest one is dropped. Raise it to keep more history, lower it if the chart feels crowded.")
devStyleIn = input.string("Solid", "Line style", options = ["Solid", "Dotted", "Dashed"], inline = "ds", group = gDev)
devWidth   = input.int(1, "Width", minval = 1, maxval = 5, inline = "ds", group = gDev)
devLabelOn = input.bool(true, "Show label text", group = gDev)

devLower    = input.bool(true, "Missing LOWER wick", inline = "dl", group = gDev)
devColLow   = input.color(#26a69a, "Color", inline = "dl", group = gDev)
devTextLow  = input.string("Devil 👹", "Lower label text", group = gDev)

devUpper    = input.bool(true, "Missing UPPER wick", inline = "du", group = gDev)
devColHigh  = input.color(#ef5350, "Color", inline = "du", group = gDev)
devTextHigh = input.string("Devil 👹", "Upper label text", group = gDev)

devStyle = devStyleIn == "Solid" ? line.style_solid : devStyleIn == "Dotted" ? line.style_dotted : line.style_dashed

var line[]  devLn  = array.new<line>()
var label[] devLb  = array.new<label>()
var float[] devPx  = array.new<float>()
var bool[]  devLow = array.new<bool>()

// Half a tick of slack on top of the chosen size, so float representation can
// never hide an edge that is flat to the tick.
devEps = syminfo.mintick * 0.5
bodyLow  = math.min(open, close)
bodyHigh = math.max(open, close)
noLowerWick = (bodyLow - low)   <= devWickTol + devEps
noUpperWick = (high - bodyHigh) <= devWickTol + devEps

addDevil(px, isLow, col, txt) =>
    ln = line.new(bar_index, px, bar_index + devLen, px, color = col, style = devStyle, width = devWidth)
    lb = label.new(bar_index + devLen, px, devLabelOn ? txt : "", color = #00000000, textcolor = col, size = size.small, style = label.style_label_left)
    array.push(devLn, ln)
    array.push(devLb, lb)
    array.push(devPx, px)
    array.push(devLow, isLow)

dropDevil(i) =>
    line.delete(array.get(devLn, i))
    label.delete(array.get(devLb, i))
    array.remove(devLn, i)
    array.remove(devLb, i)
    array.remove(devPx, i)
    array.remove(devLow, i)

if devOn
    // Born on close only. A live candle has not finished deciding its wicks.
    if barstate.isconfirmed
        if devLower and noLowerWick
            addDevil(low, true, devColLow, devTextLow)
        if devUpper and noUpperWick
            addDevil(high, false, devColHigh, devTextHigh)

        // Oldest marks fall off the back once the cap is reached.
        while array.size(devLn) > devMax
            dropDevil(0)

    // Walk backwards so removing an entry cannot skip the next one.
    if devClear and array.size(devLn) > 0
        for i = array.size(devLn) - 1 to 0
            px = array.get(devPx, i)
            if array.get(devLow, i) ? low < px - devEps : high > px + devEps
                dropDevil(i)

alertcondition(devOn and devLower and noLowerWick and barstate.isconfirmed, title = "Devil - no lower wick", message = "Sav FX: candle closed with no lower wick")
alertcondition(devOn and devUpper and noUpperWick and barstate.isconfirmed, title = "Devil - no upper wick", message = "Sav FX: candle closed with no upper wick")



// ═══════════════════════════════════════════════════════════════════
// PART C — QT Hub: מרכז ההחלטות (באותו אינדיקטור עם ה-True Opens,
// כדי שכל המערכת תהיה ארבעה אינדיקטורים בלבד)
//
// לא מחשב שבירות בעצמו. קורא את המצב ששלושת האינדיקטורים מייצאים
// (SSMT + HSSMT · SSMT Fill · ADI), ומריץ עליו את ספר החוקים:
//
//   1. חוקי חיים — שבירה משפיעה רק באותה מסגרת. שבירה חדשה בכיוון ההפוך
//      מרדימה את הישנה; כשהחדשה מתה — הרדומה חוזרת. אותו כיוון — שתיהן חיות.
//      PSP לא מרדים SSMT / Fill (הוא פחות רלוונטי), אבל הם כן מרדימים אותו.
//   2. Two-Stage — שתי שבירות חיות באותו כיוון, עד שתי מדרגות זו מזו בסולם
//      4H · 1H · 15m · 5m · 1m. סטאפ A = שתי שבירות SSMT / Fill.
//      סטאפ B = אחת הרגליים PSP. שני PSP — לא סטאפ.
//   3. True Open — לכל רגל, ה-True Open של המיכל שלה (Q2 של המחזור):
//      4H → TMO · 1H → TWO · 15m → TDO · 5m → T90O · 1m → TMcO.
//      לונג = מחיר מתחת לפתיחה · שורט = מעל. נמדד ברגע שהסטאפ נוצר: 2/2, 1/2, 0/2.
//   4. SFP — Fill שנבנה עכשיו על הגרף (4H / 1H / 15m), ו-PSP באותו כיוון
//      בדיוק שתי מדרגות מתחת, שנוצר בתוך הנר הנוכחי של הגרף.
//   5. PSP→HSSMT — PSP שעתי חי, ואחריו HSSMT באותו כיוון ב-15m או ב-1m.
//
// חיבור: בהגדרות, לכל אחד משישת השדות בוחרים את הפלט המתאים (למשל
// "SSMT + HSSMT: HUB · SSMT · A"). המבנה של המספרים — qt-system/docs/HUB.md.
// ═══════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════
// הגדרות
// ═══════════════════════════════════════════════════════════════════

grpSrc = "חיבור לאינדיקטורים"
srcSA = input.source(close, "SSMT · A", group = grpSrc, tooltip = "בחר מהרשימה: SSMT + HSSMT → HUB · SSMT · A")
srcSB = input.source(close, "SSMT · B", group = grpSrc, tooltip = "בחר מהרשימה: SSMT + HSSMT → HUB · SSMT · B")
srcFA = input.source(close, "Fill · A", group = grpSrc, tooltip = "בחר מהרשימה: SSMT Fill → HUB · Fill · A")
srcFB = input.source(close, "Fill · B", group = grpSrc, tooltip = "בחר מהרשימה: SSMT Fill → HUB · Fill · B")
srcAA = input.source(close, "ADI · A",  group = grpSrc, tooltip = "בחר מהרשימה: ADI v5 → HUB · ADI · A")
srcAB = input.source(close, "ADI · B",  group = grpSrc, tooltip = "בחר מהרשימה: ADI v5 → HUB · ADI · B")

grpLog  = "לוגיקה"
usePsp  = input.bool(true, "PSP יכול להיות רגל ב-Two-Stage (סטאפ B)", group = grpLog)
friSkip = input.bool(true, "1H לא רלוונטי ביום שישי", group = grpLog, tooltip = "ספר החוקים §1: שבירה שעתית לא רלוונטית בימי שישי.")
noWeak  = input.bool(true, "SSMT(c) לא נחשב רגל", group = grpLog, tooltip = "SSMT שהנכסים החזקים כבר סגרו מעבר לו (core / all closed) הוא החלש ביותר. כבוי = גם הוא יכול להיות רגל.")

grpAl    = "התראות"
alTwo    = input.string("A + B", "Two-Stage חדש", options = ["A + B", "רק A", "רק A עם 2/2 פתיחות", "כבוי"], group = grpAl)
alSfp    = input.bool(true, "SFP", group = grpAl)
alPh     = input.bool(true, "PSP→HSSMT", group = grpAl)
alRev    = input.bool(true, "שבירה רדומה חזרה לחיים", group = grpAl)

grpVis  = "תצוגה"
posIn   = input.string("ימין למעלה", "מיקום", options = ["ימין למעלה", "ימין באמצע", "ימין למטה", "שמאל למעלה", "שמאל באמצע", "שמאל למטה"], group = grpVis)
szIn    = input.string("small", "גודל טקסט", options = ["tiny", "small", "normal"], group = grpVis)
showTf  = input.bool(false, "הצג שורה לכל מסגרת", group = grpVis, tooltip = "כבוי = טבלה קומפקטית: רק הסטאפ הכי טוב ללונג ולשורט.")
colBull = input.color(#26a69a, "שורי", group = grpVis)
colBear = input.color(#ef5350, "דובי", group = grpVis)
colNeut = input.color(color.gray, "נייטרלי", group = grpVis)
colHead = input.color(#4b56ba, "כותרת", group = grpVis)

// ── סימונים על הגרף, לבדיקה אחורה ──
// הטבלה מראה רק את הרגע הנוכחי (הנר האחרון). כדי לבדוק את המערכת על
// היסטוריה, כל סטאפ מסומן גם על הנר שבו הוא נוצר, ונשאר שם.
grpMk    = "סימונים על הגרף (בדיקה אחורה)"
mkOn     = input.bool(true, "סמן סטאפים על הגרף", group = grpMk, tooltip = "תגית אחת לכל סטאפ, על הנר שבו נפתח: מתחת לנר ללונג, מעליו לשורט. כל עוד הסטאפ חי לא מתווספות תגיות נוספות. מעבר עם העכבר מראה את שתי הרגליים.")
mkMin    = input.string("רק A עם 2/2 פתיחות", "אילו סטאפים לסמן", options = ["רק A עם 2/2 פתיחות", "רק A", "A + B"], group = grpMk)
mkChart  = input.bool(true, "רק סטאפים שכוללים את מסגרת הגרף", group = grpMk, tooltip = "דלוק = על גרף 5m מסומנים רק סטאפים שאחת הרגליים שלהם ב-5m. כך כל גרף מראה את הסטאפים שלו. הטבלה עדיין סורקת הכול.")
mkModels = input.bool(true, "סמן גם SFP ו-PSP→HSSMT", group = grpMk)

// ═══════════════════════════════════════════════════════════════════
// פענוח המספרים שהאינדיקטורים מייצאים
//
// כל מספר: קידומת של שתי ספרות (מי ואיזה חצי) × 10^13, ואחריה עד שלוש
// קבוצות של ארבע ספרות. A = 4H · 1H · 15m. B = 5m · 1m · תוספת.
// בכל קבוצה: שתי ספרות לדובית ושתיים לשורית — סוג, ואז ספרת זהות.
// 9999 = המסגרת לא נסרקת מהגרף הזה. הכול מספרים שלמים מתחת ל-2^53, ולכן מדויק.
// ═══════════════════════════════════════════════════════════════════

f_tag(float s) => na(s) ? -1 : int(math.floor(s / 10000000000000.0))
f_pay(float s) => na(s) ? 0.0 : s - math.floor(s / 10000000000000.0) * 10000000000000.0
f_part(float p, int pos) => int(math.floor(p / (pos == 0 ? 100000000.0 : pos == 1 ? 10000.0 : 1.0))) % 10000

okS = f_tag(srcSA) == 11 and f_tag(srcSB) == 12
okF = f_tag(srcFA) == 21 and f_tag(srcFB) == 22
okA = f_tag(srcAA) == 31 and f_tag(srcAB) == 32

// הערך של אינדיקטור k (0 SSMT · 1 Fill · 2 ADI) במסגרת i (0 4H … 4 1m)
f_tfv(int k, int i) =>
    bool  ok = k == 0 ? okS : k == 1 ? okF : okA
    float a  = k == 0 ? srcSA : k == 1 ? srcFA : srcAA
    float b  = k == 0 ? srcSB : k == 1 ? srcFB : srcAB
    int   v  = 9999
    if ok
        v := i <= 2 ? f_part(f_pay(a), i) : f_part(f_pay(b), i - 3)
    v

// Fill בתהליך על הנר החי של הגרף: 10+דרגה = שורי, 20+דרגה = דובי
fillPot = okF ? f_part(f_pay(srcFB), 2) : 0

// ═══════════════════════════════════════════════════════════════════
// שמות, חוזק, מסגרות
// ═══════════════════════════════════════════════════════════════════

f_tfName(int i) => i == 0 ? "4H" : i == 1 ? "1H" : i == 2 ? "15m" : i == 3 ? "5m" : "1m"

// חוזק: HSSMT > SSMT > F3 > F2 > F1 > SSMT (closed) > PSP, ו-QS (★) מוסיף
f_rank(int k, int c) =>
    int r = 0
    if c > 0
        if k == 0
            int bse = c > 3 ? c - 3 : c
            r := (bse == 3 ? 60 : bse == 2 ? 50 : 15) + (c > 3 ? 5 : 0)
        else if k == 1
            r := c == 3 ? 40 : c == 2 ? 30 : 20
        else
            r := 10
    r

f_kName(int k, int c) =>
    string t = ""
    if k == 0
        int bse = c > 3 ? c - 3 : c
        t := (bse == 3 ? "HSSMT" : bse == 2 ? "SSMT" : "SSMT(c)") + (c > 3 ? "★" : "")
    else if k == 1
        t := "F" + str.tostring(c)
    else
        t := c == 2 ? "PSPw" : "PSP"
    t

f_isH(int c) => c == 3 or c == 6

// מסגרת הגרף בסולם (‎-1 = הגרף לא על אחת מחמש המסגרות)
chSec = timeframe.in_seconds()
chIdx = chSec == 14400 ? 0 : chSec == 3600 ? 1 : chSec == 900 ? 2 : chSec == 300 ? 3 : chSec == 60 ? 4 : -1

// יום המסחר מתחיל ב-18:00 ניו יורק — הזזה של שש שעות הופכת אותו לחצות
fri1h = friSkip and dayofweek(time + 21600000, TZ) == dayofweek.friday

// ═══════════════════════════════════════════════════════════════════
// True Opens — מנרות דקה של נכס הגרף, באותה לוגיקה של Sav FX
//
// נר הפתיחה הוא הראשון שמתחיל ברגע הזה או אחריו. רמה חיה רק כל עוד המיכל
// שלה חי. מחושב בהקשר של 1m, כך שגם על גרף 4H ה-TMcO מדויק.
// ═══════════════════════════════════════════════════════════════════

f_tos() =>
    int   tdC     = time + (hour(time, TZ) >= 18 ? 86400000 : 0)
    int   hTdMid   = timestamp(TZ, year(tdC, TZ), month(tdC, TZ), dayofmonth(tdC, TZ), 0, 0, 0)
    int   pNoon   = hTdMid - 43200000
    int   dStart  = timestamp(TZ, year(pNoon, TZ), month(pNoon, TZ), dayofmonth(pNoon, TZ), 18, 0, 0)
    float el      = time - dStart
    int   sStart  = dStart + int(math.floor(el / 21600000.0)) * 21600000
    int   mStart  = dStart + int(math.floor(el / 5400000.0)) * 5400000
    int   tTDO    = hTdMid
    int   tT90O   = sStart + 5400000
    int   tTMcO   = mStart + 1350000
    int   dw      = dayofweek(tdC, TZ)
    int   dsm     = dw == dayofweek.sunday ? 6 : dw - 2
    int   hMonNoon = hTdMid + 43200000 - dsm * 86400000
    int   tTWO    = timestamp(TZ, year(hMonNoon, TZ), month(hMonNoon, TZ), dayofmonth(hMonNoon, TZ), 18, 0, 0)
    int   hTueNoon = hMonNoon + 86400000
    int   wY      = year(hTueNoon, TZ)
    int   wM      = month(hTueNoon, TZ)
    int   d1      = dayofweek(timestamp(TZ, wY, wM, 1, 12, 0, 0), TZ)
    int   ftDom   = ((3 - d1 + 7) % 7) + 1
    int   w2Sun   = timestamp(TZ, wY, wM, ftDom + 7, 12, 0, 0) - 2 * 86400000
    int   tTMO    = timestamp(TZ, year(w2Sun, TZ), month(w2Sun, TZ), dayofmonth(w2Sun, TZ), 18, 0, 0)
    var float pMcO = na
    var int   iMcO = na
    var float p90O = na
    var int   i90O = na
    var float pDO  = na
    var int   iDO  = na
    var float pWO  = na
    var int   iWO  = na
    var float pMO  = na
    var int   iMO  = na
    if not na(iMcO) and iMcO != mStart
        pMcO := na
    if time >= tTMcO and time[1] < tTMcO
        pMcO := open
        iMcO := mStart
    if not na(i90O) and i90O != sStart
        p90O := na
    if time >= tT90O and time[1] < tT90O
        p90O := open
        i90O := sStart
    if not na(iDO) and iDO != dStart
        pDO := na
    if time >= tTDO and time[1] < tTDO
        pDO := open
        iDO := dStart
    if not na(iWO) and iWO != tTWO
        pWO := na
    if time >= tTWO and time[1] < tTWO
        pWO := open
        iWO := tTWO
    if not na(iMO) and iMO != tTMO
        pMO := na
    if time >= tTMO and time[1] < tTMO
        pMO := open
        iMO := tTMO
    [pMO, pWO, pDO, p90O, pMcO]

[toMO, toWO, toDO, to90O, toMcO] = request.security(syminfo.tickerid, "1", f_tos(), lookahead = barmerge.lookahead_off)

// ה-True Open של המיכל של כל מסגרת
f_to(int i) => i == 0 ? toMO : i == 1 ? toWO : i == 2 ? toDO : i == 3 ? to90O : toMcO
f_toName(int i) => i == 0 ? "TMO" : i == 1 ? "TWO" : i == 2 ? "TDO" : i == 3 ? "T90O" : "TMcO"

// ═══════════════════════════════════════════════════════════════════
// מצב השבירות — 30 משבצות: אינדיקטור × מסגרת × כיוון
//   s = k * 10 + i * 2 + d   (d: 0 = דובי, 1 = שורי)
// לכל משבצת: הסוג, ספרת הזהות, ומתי המרכז ראה אותה לראשונה. שינוי זהות =
// שבירה חדשה. שינוי סוג באותה זהות (S→H, F1→F2) = אותה שבירה, שודרגה.
// ═══════════════════════════════════════════════════════════════════

var array<int>  sCode = array.new_int(30, 0)
var array<int>  sId   = array.new_int(30, -1)
var array<int>  sSeq  = array.new_int(30, 0)
var array<int>  sBar  = array.new_int(30, 0)
var array<bool> sDorm = array.new_bool(30, false)
var array<bool> tfNa  = array.new_bool(15, true)
var int hubSeq = 0

for k = 0 to 2
    for i = 0 to 4
        int v = f_tfv(k, i)
        bool vNa = v == 9999
        array.set(tfNa, k * 5 + i, vNa)
        for d = 0 to 1
            int s  = k * 10 + i * 2 + d
            int dv = vNa ? 0 : d == 0 ? int(math.floor(v / 100.0)) : v % 100
            int c  = int(math.floor(dv / 10.0))
            int id = dv % 10
            if c == 0
                array.set(sCode, s, 0)
                array.set(sId, s, -1)
            else
                if array.get(sCode, s) == 0 or array.get(sId, s) != id
                    hubSeq += 1
                    array.set(sSeq, s, hubSeq)
                    array.set(sBar, s, bar_index)
                array.set(sCode, s, c)
                array.set(sId, s, id)

f_sK(int s) => int(math.floor(s / 10.0))
f_sI(int s) => int(math.floor((s % 10) / 2.0))
f_sDir(int s) => s % 2 == 0 ? -1 : 1
f_live(int s) => array.get(sCode, s) > 0 and not (fri1h and f_sI(s) == 1)

// ── חוקי חיים: הכיוון השולט בכל מסגרת ──
// השבירה החדשה ביותר (SSMT / Fill) קובעת. באותו נר — החזקה. אם אין SSMT /
// Fill חיים במסגרת, PSP קובע באותו כלל.
var array<int> domDir = array.new_int(5, 0)
for i = 0 to 4
    int bestKey = -1
    int bestDir = 0
    for pass = 0 to 1
        if bestKey == -1
            int kFrom = pass == 0 ? 0 : 2
            int kTo   = pass == 0 ? 1 : 2
            for k = kFrom to kTo
                for d = 0 to 1
                    int s = k * 10 + i * 2 + d
                    if f_live(s)
                        int key = array.get(sBar, s) * 100 + f_rank(k, array.get(sCode, s))
                        if key > bestKey
                            bestKey := key
                            bestDir := f_sDir(s)
    array.set(domDir, i, bestDir)

f_dorm(int s) => f_live(s) and f_sDir(s) != array.get(domDir, f_sI(s))

// ── רדומה שחזרה לחיים ──
string revTxt = ""
for s = 0 to 29
    bool dNow = f_dorm(s)
    if array.get(sDorm, s) and f_live(s) and not dNow
        revTxt := revTxt + (revTxt == "" ? "" : " · ") + f_tfName(f_sI(s)) + " " + (f_sDir(s) == 1 ? "▲" : "▼") + " " + f_kName(f_sK(s), array.get(sCode, s))
    array.set(sDorm, s, dNow)

// הרגל הכי חזקה במסגרת i בכיוון dir, מבין החיות שאינן רדומות
f_leg(int i, int dir, bool allowPsp, bool allowWeak) =>
    int best = -1
    int bR   = -1
    int bS   = -1
    for k = 0 to 2
        if k < 2 or allowPsp
            int s = k * 10 + i * 2 + (dir == 1 ? 1 : 0)
            int cc = array.get(sCode, s)
            bool weak = k == 0 and (cc == 1 or cc == 4)
            if f_live(s) and not f_dorm(s) and (allowWeak or not weak)
                int r = f_rank(k, array.get(sCode, s))
                if r > bR or (r == bR and array.get(sSeq, s) > bS)
                    bR   := r
                    bS   := array.get(sSeq, s)
                    best := s
    best

f_slotTxt(int s) => s < 0 ? "" : f_tfName(f_sI(s)) + " " + f_kName(f_sK(s), array.get(sCode, s))

// ═══════════════════════════════════════════════════════════════════
// Two-Stage — שבעה זוגות מסגרות (עד שתי מדרגות), בשני הכיוונים
// ═══════════════════════════════════════════════════════════════════

var array<int> pI = array.from(0, 0, 1, 1, 2, 2, 3)
var array<int> pJ = array.from(1, 2, 2, 3, 3, 4, 4)

// מצב לכל צירוף (זוג × כיוון): המפתח של הרגליים, מתי נוצר, כמה פתיחות
// התקיימו ברגע היצירה, וכמה מהן עוד לא היו ידועות.
var array<int> cKey = array.new_int(14, -1)
var array<int> cBar = array.new_int(14, 0)
var array<int> cTo  = array.new_int(14, 0)
var array<int> cNa  = array.new_int(14, 0)
var array<int> cLgA = array.new_int(14, -1)
var array<int> cLgB = array.new_int(14, -1)

// כמה מ-True Opens של שתי הרגליים מתקיימים עכשיו (לונג = מתחת, שורט = מעל)
f_toCnt(int i, int j, int dir) =>
    int met = 0
    int unk = 0
    float a = f_to(i)
    float b = f_to(j)
    if na(a)
        unk += 1
    else if dir == 1 ? close < a : close > a
        met += 1
    if na(b)
        unk += 1
    else if dir == 1 ? close < b : close > b
        met += 1
    [met, unk]

string newTwo = ""
for p = 0 to 6
    int i = array.get(pI, p)
    int j = array.get(pJ, p)
    for d = 0 to 1
        int dir = d == 0 ? -1 : 1
        int c   = p * 2 + d
        int la  = f_leg(i, dir, usePsp, not noWeak)
        int lb  = f_leg(j, dir, usePsp, not noWeak)
        bool on = la >= 0 and lb >= 0 and not (f_sK(la) == 2 and f_sK(lb) == 2)
        if not on
            array.set(cKey, c, -1)
            array.set(cLgA, c, -1)
            array.set(cLgB, c, -1)
        else
            int key = (la * 10 + array.get(sId, la)) * 1000 + lb * 10 + array.get(sId, lb)
            if array.get(cKey, c) == -1
                // נוצר עכשיו — התמונה של הפתיחות נלקחת ברגע הזה ונשמרת
                [met, unk] = f_toCnt(i, j, dir)
                array.set(cBar, c, bar_index)
                array.set(cTo, c, met)
                array.set(cNa, c, unk)
                bool gA = f_sK(la) < 2 and f_sK(lb) < 2
                bool fire = alTwo == "A + B" or (alTwo == "רק A" and gA) or (alTwo == "רק A עם 2/2 פתיחות" and gA and met == 2)
                if fire
                    newTwo := newTwo + (newTwo == "" ? "" : " · ") + (dir == 1 ? "▲ " : "▼ ") + f_slotTxt(la) + " + " + f_slotTxt(lb) + " " + (gA ? "A" : "B") + " TO " + str.tostring(met) + "/2"
            // רגל שהתחזקה או הוחלפה — אותו סטאפ, תמונת הפתיחות לא משתנה
            array.set(cKey, c, key)
            array.set(cLgA, c, la)
            array.set(cLgB, c, lb)

// הסטאפ הכי טוב בכל כיוון: A לפני B, אחר כך יותר פתיחות, אחר כך רגליים
// חזקות יותר, ובשוויון — החדש יותר. השאר ב-tooltip.
f_best(int dir) =>
    int    bc  = -1
    int    bSc = -1
    string all = ""
    for p = 0 to 6
        int c = p * 2 + (dir == 1 ? 1 : 0)
        if array.get(cKey, c) != -1
            int  la = array.get(cLgA, c)
            int  lb = array.get(cLgB, c)
            bool gA = f_sK(la) < 2 and f_sK(lb) < 2
            int  sc = (gA ? 2 : 1) * 1000000 + array.get(cTo, c) * 100000 + (f_rank(f_sK(la), array.get(sCode, la)) + f_rank(f_sK(lb), array.get(sCode, lb))) * 1000 + array.get(cBar, c) % 1000
            all := all + (all == "" ? "" : "\n") + f_slotTxt(la) + " + " + f_slotTxt(lb) + "  " + (gA ? "A" : "B") + "  TO " + str.tostring(array.get(cTo, c)) + "/2" + (array.get(cNa, c) > 0 ? " (?" + str.tostring(array.get(cNa, c)) + ")" : "")
            if sc > bSc
                bSc := sc
                bc  := c
    [bc, all]

[bestL, allL] = f_best(1)
[bestS, allS] = f_best(-1)

// ── סימון על הגרף: תגית אחת לכל "אפיזודה" ──
// מבין הסטאפים החיים בכיוון, הטוב ביותר שעובר את הסינון. תגית נוצרת רק
// כשכיוון עובר ממצב "אין סטאפ" ל"יש סטאפ", ולא שוב כל עוד הוא נשאר חי —
// גם אם הרגליים מתחלפות בדרך. כך הגרף מראה כמה פעמים באמת נפתחה הזדמנות.
f_mkPick(int dir) =>
    int bc  = -1
    int bSc = -1
    for p = 0 to 6
        int c = p * 2 + (dir == 1 ? 1 : 0)
        if array.get(cKey, c) != -1
            int  la  = array.get(cLgA, c)
            int  lb  = array.get(cLgB, c)
            bool gA  = f_sK(la) < 2 and f_sK(lb) < 2
            int  met = array.get(cTo, c)
            bool okG = mkMin == "A + B" or (mkMin == "רק A" and gA) or (gA and met == 2)
            bool okT = not mkChart or f_sI(la) == chIdx or f_sI(lb) == chIdx
            if okG and okT
                int sc = (gA ? 2 : 1) * 1000000 + met * 100000 + (f_rank(f_sK(la), array.get(sCode, la)) + f_rank(f_sK(lb), array.get(sCode, lb))) * 1000
                if sc > bSc
                    bSc := sc
                    bc  := c
    bc

f_mkDraw(int c, int dir) =>
    int  la = array.get(cLgA, c)
    int  lb = array.get(cLgB, c)
    bool gA = f_sK(la) < 2 and f_sK(lb) < 2
    string tip = (dir == 1 ? "LONG " : "SHORT ") + (gA ? "A" : "B") + "\n" + f_slotTxt(la) + " + " + f_slotTxt(lb) + "\nTO " + str.tostring(array.get(cTo, c)) + "/2"
    label.new(bar_index, dir == 1 ? low : high, (dir == 1 ? "▲" : "▼") + (gA ? "A" : "B"), yloc = dir == 1 ? yloc.belowbar : yloc.abovebar, style = dir == 1 ? label.style_label_up : label.style_label_down, color = color.new(dir == 1 ? colBull : colBear, gA ? 0 : 50), textcolor = color.white, size = size.small, tooltip = tip)

var bool mkWasL = false
var bool mkWasS = false
mkL = f_mkPick(1)
mkS = f_mkPick(-1)
if mkOn and mkL >= 0 and not mkWasL
    f_mkDraw(mkL, 1)
if mkOn and mkS >= 0 and not mkWasS
    f_mkDraw(mkS, -1)
mkWasL := mkL >= 0
mkWasS := mkS >= 0

f_setupTxt(int c, int dir) =>
    string t = "—"
    if c >= 0
        int  la = array.get(cLgA, c)
        int  lb = array.get(cLgB, c)
        bool gA = f_sK(la) < 2 and f_sK(lb) < 2
        t := f_slotTxt(la) + " + " + f_slotTxt(lb) + "  " + (gA ? "A" : "B") + " " + str.tostring(array.get(cTo, c)) + "/2"
    t

// ═══════════════════════════════════════════════════════════════════
// SFP — Fill שנבנה עכשיו על הגרף + PSP שתי מדרגות מתחת, בתוך הנר הזה
// ═══════════════════════════════════════════════════════════════════

int    sfpDir = 0
string sfpTxt = ""
if chIdx >= 0 and chIdx <= 2 and okA
    int potDir = fillPot >= 20 ? -1 : fillPot >= 10 ? 1 : 0
    int potDeg = fillPot % 10
    // גם Fill שנרשם בדיוק בנר הזה נחשב — זה הרגע שבו "בתהליך" נסגר
    for d = 0 to 1
        int dir  = d == 0 ? -1 : 1
        int sF   = 10 + chIdx * 2 + d
        bool fOn = potDir == dir or (f_live(sF) and array.get(sBar, sF) == bar_index)
        int sP   = 20 + (chIdx + 2) * 2 + d
        if sfpDir == 0 and fOn and f_live(sP) and array.get(sBar, sP) == bar_index
            sfpDir := dir
            int fDeg = potDir == dir ? potDeg : array.get(sCode, sF)
            sfpTxt := (dir == 1 ? "▲ " : "▼ ") + "SFP " + f_tfName(chIdx) + " F" + str.tostring(fDeg) + " + " + f_tfName(chIdx + 2) + " PSP"

// ═══════════════════════════════════════════════════════════════════
// PSP→HSSMT — PSP שעתי חי, ואחריו HSSMT באותו כיוון ב-15m או ב-1m
// ═══════════════════════════════════════════════════════════════════

int    phDir = 0
string phTxt = ""
for d = 0 to 1
    int dir = d == 0 ? -1 : 1
    int sP  = 20 + 1 * 2 + d
    if phDir == 0 and f_live(sP)
        for ii = 0 to 1
            int i2 = ii == 0 ? 2 : 4
            int sH = i2 * 2 + d
            if phDir == 0 and f_live(sH) and f_isH(array.get(sCode, sH)) and array.get(sSeq, sH) > array.get(sSeq, sP)
                phDir := dir
                phTxt := (dir == 1 ? "▲ " : "▼ ") + "1H PSP → " + f_tfName(i2) + " " + f_kName(0, array.get(sCode, sH))

var int prevSfp = 0
var int prevPh  = 0
sfpNew = sfpDir != 0 and sfpDir != prevSfp
phNew  = phDir != 0 and phDir != prevPh
prevSfp := sfpDir
prevPh  := phDir

if mkOn and mkModels and sfpNew
    label.new(bar_index, sfpDir == 1 ? low : high, "SFP", yloc = sfpDir == 1 ? yloc.belowbar : yloc.abovebar, style = sfpDir == 1 ? label.style_label_up : label.style_label_down, color = color.new(colHead, 10), textcolor = color.white, size = size.tiny, tooltip = sfpTxt)
if mkOn and mkModels and phNew
    label.new(bar_index, phDir == 1 ? low : high, "P→H", yloc = phDir == 1 ? yloc.belowbar : yloc.abovebar, style = phDir == 1 ? label.style_label_up : label.style_label_down, color = color.new(colHead, 10), textcolor = color.white, size = size.tiny, tooltip = phTxt)

// ═══════════════════════════════════════════════════════════════════
// תצוגה
// ═══════════════════════════════════════════════════════════════════

posT = posIn == "ימין למעלה" ? position.top_right : posIn == "ימין באמצע" ? position.middle_right : posIn == "ימין למטה" ? position.bottom_right : posIn == "שמאל למעלה" ? position.top_left : posIn == "שמאל באמצע" ? position.middle_left : position.bottom_left
szT  = szIn == "tiny" ? size.tiny : szIn == "normal" ? size.normal : size.small

var table hub = table.new(posT, 2, 11, border_width = 1)

f_dirCol(int dir, int tr) => color.new(dir == 1 ? colBull : dir == -1 ? colBear : colNeut, tr)

// השורה של מסגרת אחת: הרגל החזקה בכיוון השולט, ו-(+n) לשאר. ה-tooltip
// מפרט את כולן — חיה, רדומה (zz), ומאיזה אינדיקטור.
f_tfRow(int i) =>
    int    dom  = array.get(domDir, i)
    int    lg   = f_leg(i, dom, true, true)
    int    more = 0
    string tip  = ""
    bool   allNa = array.get(tfNa, i) and array.get(tfNa, 5 + i) and array.get(tfNa, 10 + i)
    for k = 0 to 2
        for d = 0 to 1
            int s = k * 10 + i * 2 + d
            if f_live(s)
                if s != lg
                    more += 1
                tip := tip + (tip == "" ? "" : "\n") + (f_sDir(s) == 1 ? "▲ " : "▼ ") + f_kName(k, array.get(sCode, s)) + (f_dorm(s) ? "  zz" : "")
    string txt = allNa ? "n/a" : (fri1h and i == 1) ? "Fri" : lg < 0 ? "—" : (dom == 1 ? "▲ " : "▼ ") + f_kName(f_sK(lg), array.get(sCode, lg)) + (more > 0 ? " (+" + str.tostring(more) + ")" : "")
    [txt, tip == "" ? "אין שבירות חיות" : tip, lg < 0 ? 0 : dom]

if barstate.islast
    table.clear(hub, 0, 0, 1, 10)
    table.cell(hub, 0, 0, "QT HUB", bgcolor = color.new(colHead, 20), text_color = color.white, text_size = szT)
    string conn = (okS ? "S" : "·") + (okF ? "F" : "·") + (okA ? "A" : "·")
    table.cell(hub, 1, 0, conn, bgcolor = color.new(colHead, 20), text_color = color.white, text_size = szT, tooltip = "S = SSMT · F = Fill · A = ADI\n· = לא מחובר. בהגדרות של המרכז בוחרים לכל שדה את הפלט HUB המתאים.")
    int row = 1
    if showTf
        for i = 0 to 4
            [tt, tp, td] = f_tfRow(i)
            table.cell(hub, 0, row, (i == chIdx ? "▶ " : "") + f_tfName(i), bgcolor = color.new(colNeut, 80), text_color = color.white, text_size = szT)
            table.cell(hub, 1, row, tt, bgcolor = f_dirCol(td, 80), text_color = color.white, text_size = szT, tooltip = tp)
            row += 1
    table.cell(hub, 0, row, "▲ LONG", bgcolor = color.new(colBull, 60), text_color = color.white, text_size = szT)
    table.cell(hub, 1, row, f_setupTxt(bestL, 1), bgcolor = bestL >= 0 ? color.new(colBull, 45) : color.new(colNeut, 85), text_color = color.white, text_size = szT, tooltip = allL == "" ? "אין Two-Stage לעליות" : allL)
    row += 1
    table.cell(hub, 0, row, "▼ SHORT", bgcolor = color.new(colBear, 60), text_color = color.white, text_size = szT)
    table.cell(hub, 1, row, f_setupTxt(bestS, -1), bgcolor = bestS >= 0 ? color.new(colBear, 45) : color.new(colNeut, 85), text_color = color.white, text_size = szT, tooltip = allS == "" ? "אין Two-Stage לירידות" : allS)
    row += 1
    if sfpTxt != ""
        table.cell(hub, 0, row, "SFP", bgcolor = f_dirCol(sfpDir, 40), text_color = color.white, text_size = szT)
        table.cell(hub, 1, row, sfpTxt, bgcolor = f_dirCol(sfpDir, 40), text_color = color.white, text_size = szT)
        row += 1
    if phTxt != ""
        table.cell(hub, 0, row, "PSP→H", bgcolor = f_dirCol(phDir, 40), text_color = color.white, text_size = szT)
        table.cell(hub, 1, row, phTxt, bgcolor = f_dirCol(phDir, 40), text_color = color.white, text_size = szT)
        row += 1
    if not (okS and okF and okA)
        table.cell(hub, 0, row, "!", bgcolor = color.new(color.orange, 30), text_color = color.white, text_size = szT)
        table.cell(hub, 1, row, "connect sources (settings)", bgcolor = color.new(color.orange, 30), text_color = color.white, text_size = szT, tooltip = "פתח את ההגדרות של QT Hub ובחר לכל אחד מששת השדות את הפלט HUB המתאים. שלושת האינדיקטורים צריכים להיות על אותו גרף.")

// ═══════════════════════════════════════════════════════════════════
// התראה אחת לנר — כל מה שקרה
// ═══════════════════════════════════════════════════════════════════

string alTxt = ""
if alTwo != "כבוי" and newTwo != ""
    alTxt := "Two-Stage: " + newTwo
if alSfp and sfpNew
    alTxt := alTxt + (alTxt == "" ? "" : "\n") + sfpTxt
if alPh and phNew
    alTxt := alTxt + (alTxt == "" ? "" : "\n") + phTxt
if alRev and revTxt != ""
    alTxt := alTxt + (alTxt == "" ? "" : "\n") + "חזרה לחיים: " + revTxt
if alTxt != ""
    alert("QT Hub · " + syminfo.ticker + "\n" + alTxt, alert.freq_once_per_bar)
